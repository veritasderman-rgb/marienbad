# ===========================================
# Marienbad.com — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ---- Database (Supabase PostgreSQL) ----
# Get from: https://supabase.com/dashboard → Project → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---- For local development (Docker) ----
# DATABASE_URL=postgresql://marienbad:marienbad_dev_password@localhost:5432/marienbad

# ---- Payload CMS ----
PAYLOAD_SECRET=CHANGE-THIS-TO-A-RANDOM-SECRET-STRING-64-CHARS
PAYLOAD_URL=http://localhost:3001

# ---- Frontend ----
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://marienbad.com

# ---- Supabase (for file storage) ----
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=media

# ---- Google Analytics & Search Console ----
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# GSC verification via meta tag or DNS

# ---- MailerLite (Newsletter) ----
MAILERLITE_API_KEY=[YOUR-API-KEY]
MAILERLITE_GROUP_ID=[YOUR-GROUP-ID]

# ---- Stripe (Phase 3 — Payment Gateway) ----
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---- Vercel ----
# Automatically set by Vercel deployment
# VERCEL_URL=
# VERCEL_ENV=
