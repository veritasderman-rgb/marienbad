# ===========================================
# Marienbad.com — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ---- Database (Supabase PostgreSQL) ----
# Get from: https://supabase.com/dashboard → Project → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---- For local development (Docker) ----
# DATABASE_URL=postgresql://marienbad:marienbad_dev_password@localhost:5432/marienbad

# ---- Payload CMS ----
PAYLOAD_SECRET=CHANGE-THIS-TO-A-RANDOM-SECRET-STRING-64-CHARS
PAYLOAD_URL=http://localhost:3001

# ---- Frontend ----
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://marienbad.vercel.app

# ---- S3 Storage (for media uploads) ----
S3_BUCKET=[YOUR-BUCKET-NAME]
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=[YOUR-ACCESS-KEY]
S3_SECRET_ACCESS_KEY=[YOUR-SECRET-KEY]
# S3_ENDPOINT=              # Optional: for S3-compatible services (MinIO, Cloudflare R2)

# ---- Keystatic CMS (GitHub mode — production only) ----
# Local dev uses `kind: 'local'` and needs none of these.
# In production Keystatic authenticates through the GitHub App
# "marienbad-keystatic-cms". Setup + troubleshooting: docs/keystatic-github-setup.md
# The GitHub App must list this callback URL, or login fails with
# "The redirect_uri is not associated with this application":
#   https://marienbad.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=[GITHUB-APP-CLIENT-ID]
KEYSTATIC_GITHUB_CLIENT_SECRET=[GITHUB-APP-CLIENT-SECRET]
# Signs the Keystatic session cookie — generate with: openssl rand -hex 32
KEYSTATIC_SECRET=[RANDOM-HEX-STRING]
# Exposed to the client bundle — app slug only, never a secret
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=marienbad-keystatic-cms

# ---- Google Analytics 4 (gtag.js) ----
# Astro exposes only PUBLIC_-prefixed vars to the client.
# Defaults to G-QCH8PW51VM in code if unset; set here to override
# (e.g. a separate dev/staging property) or set empty to disable GA.
PUBLIC_GA_MEASUREMENT_ID=G-QCH8PW51VM
# GSC verification via meta tag or DNS

# ---- Analytics (Plausible, cookie-free — optional) ----
# If unset, the Plausible script is not loaded.
PUBLIC_PLAUSIBLE_DOMAIN=marienbad.com

# ---- MailerLite (Newsletter) ----
MAILERLITE_API_KEY=[YOUR-API-KEY]
MAILERLITE_GROUP_ID=[YOUR-GROUP-ID]

# ---- Stripe (Phase 3 — Payment Gateway) ----
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---- Vercel ----
# Automatically set by Vercel deployment
# VERCEL_URL=
# VERCEL_ENV=
