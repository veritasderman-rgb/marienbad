# ===========================================
# Marienbad.com — Environment Variables
# ===========================================
# Zkopírujte do .env.local (je v .gitignore) a doplňte hodnoty.
# Produkce: Vercel Environment Variables (produkce/preview odděleně).
# Nic z tajemství nikdy s prefixem PUBLIC_ — ten Astro posílá do prohlížeče.

# ---- Keystatic CMS (GitHub mode — production only) ----
# Local dev uses `kind: 'local'` and needs none of these.
# In production Keystatic authenticates through the GitHub App
# "marienbad-keystatic-cms". Setup + troubleshooting: docs/keystatic-github-setup.md
# The GitHub App must list this callback URL, or login fails with
# "The redirect_uri is not associated with this application":
#   https://marienbad.com/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=[GITHUB-APP-CLIENT-ID]
KEYSTATIC_GITHUB_CLIENT_SECRET=[GITHUB-APP-CLIENT-SECRET]
# Signs the Keystatic session cookie — generate with: openssl rand -hex 32
KEYSTATIC_SECRET=[RANDOM-HEX-STRING]
# Exposed to the client bundle — app slug only, never a secret
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=marienbad-keystatic-cms

# ---- Google Analytics 4 (gtag.js) ----
# Defaults to G-QCH8PW51VM in code if unset; set empty to disable GA.
PUBLIC_GA_MEASUREMENT_ID=G-QCH8PW51VM

# ---- Analytics (Plausible, cookie-free — optional) ----
PUBLIC_PLAUSIBLE_DOMAIN=marienbad.com

# ---- MailerLite (web: kvíz + newsletter signup; portál: kampaně B2B) ----
MAILERLITE_API_KEY=
MAILERLITE_GROUP_DE=
MAILERLITE_GROUP_EN=
MAILERLITE_GROUP_CS=
MAILERLITE_GROUP_RU=
MAILERLITE_GROUP_QUIZ=

# ===========================================
# Partnerský portál /portal
# (env kontrakt: docs/crm-portal/IMPLEMENTACNI_PLAN.md, sekce 9)
# ===========================================

# Neon Postgres — pooler endpoint pro běh aplikace
DATABASE_URL=
# Neon Postgres — přímý endpoint (bez -pooler) pro migrace a pg_dump
DATABASE_URL_DIRECT=

# Podpis session tokenů a stavů (≥ 32 bajtů náhody, např. `openssl rand -base64 32`)
PORTAL_SESSION_SECRET=
# Klíč pro šifrování TOTP tajemství (≥ 32 znaků náhody)
PORTAL_TOTP_KEY=

# Vercel Cron → /api/portal/cron/* (Authorization: Bearer)
CRON_SECRET=

# Strojové tokeny (vygenerovat ≥ 32 bajtů náhody každý)
NEWSLETTER_DRAFT_TOKEN=
DASHBOARD_INTAKE_TOKEN=
DASHBOARD_EXPORT_TOKEN=

# Cloudflare R2 (EU jurisdikce) — soubory importů + zálohy
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Transakční e-maily portálu (pozvánky, resety, alerty)
RESEND_API_KEY=
PORTAL_MAIL_FROM="Portál Marienbad <portal@marienbad.com>"
PORTAL_ALERT_EMAIL=
