---
interface Props {
  title: string
  description: string
  href: string
  gradient?: string
}

const { title, description, href, gradient = 'from-primary-600 to-primary-800' } = Astro.props
---

<a href={href} class="group block">
  <div class={`relative overflow-hidden rounded-2xl bg-gradient-to-br ${gradient} p-6 md:p-8 min-h-[200px] flex flex-col justify-end transition-transform group-hover:scale-[1.02]`}>
    <h3 class="font-heading text-xl md:text-2xl font-bold text-white mb-2">{title}</h3>
    <p class="text-white/80 text-sm md:text-base">{description}</p>
    <div class="mt-4 flex items-center gap-1 text-white/70 group-hover:text-white transition-colors text-sm font-medium">
      <span>&rarr;</span>
    </div>
  </div>
</a>
