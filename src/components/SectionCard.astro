---
interface Props {
  title: string
  description: string
  href: string
  icon?: string
  variant?: 'indigo' | 'turquoise' | 'beige' | 'dark'
}

const { title, description, href, icon, variant = 'indigo' } = Astro.props
const isExternal = href.startsWith('http')

const bgMap: Record<string, string> = {
  indigo: 'from-indigo-500 to-indigo-700',
  turquoise: 'from-indigo-700 to-turquoise-800',
  beige: 'from-indigo-600 to-indigo-800',
  dark: 'from-beige-950 to-indigo-900',
}
const bgGradient = bgMap[variant] ?? bgMap.indigo

const iconAccent: Record<string, string> = {
  indigo: 'bg-turquoise-400/20 text-turquoise-300',
  turquoise: 'bg-white/15 text-turquoise-300',
  beige: 'bg-turquoise-400/20 text-turquoise-300',
  dark: 'bg-white/10 text-turquoise-400',
}
const iconClasses = iconAccent[variant] ?? iconAccent.indigo

const icons: Record<string, string> = {
  springs: `<path d="M12 2v6" stroke-linecap="round"/><path d="M12 8c0 0-3 2-3 5a3 3 0 006 0c0-3-3-5-3-5z"/><path d="M8 20c0-2.2 1.8-4 4-4s4 1.8 4 4" stroke-linecap="round"/><path d="M6 22h12" stroke-linecap="round"/><circle cx="8" cy="5" r="0.8" fill="currentColor" stroke="none"/><circle cx="16" cy="4" r="0.8" fill="currentColor" stroke="none"/>`,
  activities: `<path d="M14.828 14.828a4 4 0 10-5.656-5.656 4 4 0 005.656 5.656z"/><path d="M21 12h-2.5M5.5 12H3M12 5.5V3M12 21v-2.5" stroke-linecap="round"/><path d="M18.364 5.636l-1.768 1.768M7.404 16.596l-1.768 1.768M18.364 18.364l-1.768-1.768M7.404 7.404L5.636 5.636" stroke-linecap="round"/>`,
  history: `<path d="M3 21h18" stroke-linecap="round"/><path d="M5 21V11" stroke-linecap="round"/><path d="M19 21V11" stroke-linecap="round"/><path d="M9 21V11" stroke-linecap="round"/><path d="M15 21V11" stroke-linecap="round"/><path d="M12 3l9 8H3l9-8z"/><circle cx="12" cy="7" r="1.5"/>`,
  podcast: `<path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2" stroke-linecap="round"/><path d="M12 19v4" stroke-linecap="round"/><path d="M8 23h8" stroke-linecap="round"/>`,
  magazine: `<path d="M4 19.5A2.5 2.5 0 016.5 17H20" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8" stroke-linecap="round"/><path d="M8 11h5" stroke-linecap="round"/>`,
  events: `<path d="M8 2v4M16 2v4" stroke-linecap="round"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" stroke-linecap="round"/>`,
  daytrips: `<circle cx="12" cy="12" r="10"/><path d="M16 8l-2.5 5.5L8 16l2.5-5.5L16 8z" stroke-linejoin="round"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>`,
}
const iconSvg = icon && icons[icon] ? icons[icon] : null
---

<a href={href} class="group block card-hover" {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}>
  <div class={`relative overflow-hidden bg-gradient-to-br ${bgGradient} p-7 md:p-8 min-h-[220px] flex flex-col justify-end`} style={`border-radius: var(--radius-card);`}>
    <!-- Subtle decorative overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(138,216,237,0.1)_0%,_transparent_60%)]"></div>
    <div class="absolute top-0 right-0 w-32 h-32 bg-turquoise-400/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>

    <div class="relative">
      {iconSvg && (
        <div class={`w-11 h-11 rounded-xl ${iconClasses} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300`}>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={iconSvg} />
        </div>
      )}
      <h3 class="font-heading text-xl md:text-2xl font-bold text-white mb-2 group-hover:text-turquoise-300 transition-colors duration-300">{title}</h3>
      <p class="text-white/70 text-sm md:text-base leading-relaxed mb-4">{description}</p>
      <div class="flex items-center gap-2 text-turquoise-300/80 group-hover:text-turquoise-200 group-hover:gap-3 transition-all duration-300 text-sm font-medium">
        <span class="h-px w-6 bg-current group-hover:w-10 transition-all duration-300"></span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    </div>
  </div>
</a>
