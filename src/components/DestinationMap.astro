---
/**
 * Destination Map — Google Maps embed centered on Mariánské Lázně spa district.
 *
 * Replaced Leaflet with hardcoded markers (GPS data was inaccurate — hotels, springs
 * and landmarks were placed ~1.4 km south of their real positions).
 * Google Maps shows correct POI locations automatically from its own data.
 *
 * The embed uses "place" mode centered on the spa colonnade area,
 * showing hotels, springs and landmarks from Google's verified database.
 */
import type { Locale } from '@/i18n/config'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const headingText: Record<Locale, string> = {
  de: 'Interaktive Karte',
  en: 'Interactive Map',
  cs: 'Interaktivní mapa',
  ru: 'Интерактивная карта',
}

const subtitleText: Record<Locale, string> = {
  de: 'Entdecken Sie Hotels, Heilquellen und Sehenswürdigkeiten in Mariánské Lázně',
  en: 'Explore hotels, healing springs and landmarks in Mariánské Lázně',
  cs: 'Prozkoumejte hotely, léčivé prameny a pamětihodnosti v Mariánských Lázních',
  ru: 'Откройте отели, целебные источники и достопримечательности Марианских Лазней',
}

const googleMapsLang: Record<Locale, string> = {
  de: 'de',
  en: 'en',
  cs: 'cs',
  ru: 'ru',
}

const lang = googleMapsLang[locale]

// Embed URL centered on Mariánské Lázně spa colonnade area
// Using search query mode with explicit place name to avoid incorrect Place ID resolution
const embedSrc = `https://maps.google.com/maps?q=Mari%C3%A1nsk%C3%A9+L%C3%A1zn%C4%9B,+Czech+Republic&z=14&hl=${lang}&ie=UTF8&output=embed`
---

<section class="destination-map-section my-10">
  <h2 class="font-heading text-xl md:text-2xl font-semibold text-indigo-800 mb-2">
    {headingText[locale]}
  </h2>
  <p class="text-sm text-beige-600 mb-4">{subtitleText[locale]}</p>

  <div class="map-container rounded-xl overflow-hidden border border-beige-200 shadow-card">
    <iframe
      src={embedSrc}
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={headingText[locale]}
    ></iframe>
  </div>

  <p class="text-xs text-beige-500 mt-3 text-center">
    {locale === 'de' ? 'Klicken Sie auf die Karte, um Hotels, Quellen und Sehenswürdigkeiten zu entdecken.' :
     locale === 'cs' ? 'Klikněte na mapu a objevte hotely, prameny a pamětihodnosti.' :
     locale === 'ru' ? 'Нажмите на карту, чтобы открыть отели, источники и достопримечательности.' :
     'Click the map to explore hotels, springs and landmarks.'}
  </p>
</section>
