---
interface MarkerData {
  lat: number
  lng: number
  name: string
  description: string
  url: string
  category: 'springs' | 'hotels' | 'nature' | 'culture'
}

interface Props {
  locale: string
  markers?: MarkerData[]
}

const { locale, markers } = Astro.props

const defaultMarkers: Record<string, MarkerData[]> = {
  de: [
    { lat: 49.9647, lng: 12.7012, name: 'Hauptkolonnade', description: 'Die neobarocke Hauptkolonnade — das Wahrzeichen von Marienbad.', url: `/${locale}/unternehmungen`, category: 'culture' },
    { lat: 49.9642, lng: 12.7008, name: 'Singende Fontäne', description: 'Die berühmte Singende Fontäne mit Licht- und Musikshow.', url: `/${locale}/unternehmungen`, category: 'culture' },
    { lat: 49.9650, lng: 12.7020, name: 'Kreuzquelle', description: 'Křížový pramen — eine der wichtigsten Heilquellen.', url: `/${locale}/mineralquellen`, category: 'springs' },
    { lat: 49.9660, lng: 12.6990, name: 'Waldquelle', description: 'Lesní pramen — idyllisch im Wald gelegen.', url: `/${locale}/mineralquellen`, category: 'springs' },
    { lat: 49.9635, lng: 12.7030, name: 'Rudolfquelle', description: 'Rudolfův pramen — bekannt für seine Heilwirkung.', url: `/${locale}/mineralquellen`, category: 'springs' },
    { lat: 49.9655, lng: 12.7025, name: 'Nové Lázně', description: 'Historisches Spa-Hotel mit römischem Bad.', url: `/${locale}/unterkunft`, category: 'hotels' },
    { lat: 49.9750, lng: 12.7100, name: 'Royal Golf Club', description: 'Der älteste Golfclub Tschechiens, gegründet 1905.', url: `/${locale}/unternehmungen`, category: 'nature' },
    { lat: 50.0050, lng: 12.6800, name: 'Naturreservat Kladská', description: 'Hochmoor-Naturschutzgebiet mit Lehrpfad.', url: `/${locale}/unternehmungen`, category: 'nature' },
  ],
  en: [
    { lat: 49.9647, lng: 12.7012, name: 'Main Colonnade', description: 'The neo-baroque Main Colonnade — Marienbad\'s iconic landmark.', url: `/${locale}/things-to-do`, category: 'culture' },
    { lat: 49.9642, lng: 12.7008, name: 'Singing Fountain', description: 'The famous Singing Fountain with light and music shows.', url: `/${locale}/things-to-do`, category: 'culture' },
    { lat: 49.9650, lng: 12.7020, name: 'Cross Spring', description: 'Křížový pramen — one of the most important healing springs.', url: `/${locale}/mineral-springs`, category: 'springs' },
    { lat: 49.9660, lng: 12.6990, name: 'Forest Spring', description: 'Lesní pramen — set in an idyllic forest location.', url: `/${locale}/mineral-springs`, category: 'springs' },
    { lat: 49.9635, lng: 12.7030, name: 'Rudolf Spring', description: 'Rudolfův pramen — renowned for its healing properties.', url: `/${locale}/mineral-springs`, category: 'springs' },
    { lat: 49.9655, lng: 12.7025, name: 'Nové Lázně Hotel', description: 'Historic spa hotel featuring a Roman bath.', url: `/${locale}/accommodation`, category: 'hotels' },
    { lat: 49.9750, lng: 12.7100, name: 'Royal Golf Club', description: 'The oldest golf club in the Czech Republic, founded 1905.', url: `/${locale}/things-to-do`, category: 'nature' },
    { lat: 50.0050, lng: 12.6800, name: 'Kladská Nature Reserve', description: 'Peat bog nature reserve with an educational trail.', url: `/${locale}/things-to-do`, category: 'nature' },
  ],
  cs: [
    { lat: 49.9647, lng: 12.7012, name: 'Hlavní kolonáda', description: 'Novobarokní Hlavní kolonáda — symbol Mariánských Lázní.', url: `/${locale}/co-delat`, category: 'culture' },
    { lat: 49.9642, lng: 12.7008, name: 'Zpívající fontána', description: 'Slavná Zpívající fontána se světelnou a hudební show.', url: `/${locale}/co-delat`, category: 'culture' },
    { lat: 49.9650, lng: 12.7020, name: 'Křížový pramen', description: 'Křížový pramen — jeden z nejdůležitějších léčivých pramenů.', url: `/${locale}/mineralni-prameny`, category: 'springs' },
    { lat: 49.9660, lng: 12.6990, name: 'Lesní pramen', description: 'Lesní pramen — idylicky umístěný v lese.', url: `/${locale}/mineralni-prameny`, category: 'springs' },
    { lat: 49.9635, lng: 12.7030, name: 'Rudolfův pramen', description: 'Rudolfův pramen — známý svými léčivými účinky.', url: `/${locale}/mineralni-prameny`, category: 'springs' },
    { lat: 49.9655, lng: 12.7025, name: 'Nové Lázně', description: 'Historický lázeňský hotel s římskými lázněmi.', url: `/${locale}/ubytovani`, category: 'hotels' },
    { lat: 49.9750, lng: 12.7100, name: 'Royal Golf Club', description: 'Nejstarší golfový klub v Česku, založený v roce 1905.', url: `/${locale}/co-delat`, category: 'nature' },
    { lat: 50.0050, lng: 12.6800, name: 'Přírodní rezervace Kladská', description: 'Rašelinná přírodní rezervace s naučnou stezkou.', url: `/${locale}/co-delat`, category: 'nature' },
  ],
  ru: [
    { lat: 49.9647, lng: 12.7012, name: 'Главная колоннада', description: 'Необарочная Главная колоннада — символ Марианских Лазней.', url: `/${locale}/chem-zanyatsya`, category: 'culture' },
    { lat: 49.9642, lng: 12.7008, name: 'Поющий фонтан', description: 'Знаменитый Поющий фонтан со световым и музыкальным шоу.', url: `/${locale}/chem-zanyatsya`, category: 'culture' },
    { lat: 49.9650, lng: 12.7020, name: 'Крестовый источник', description: 'Křížový pramen — один из важнейших целебных источников.', url: `/${locale}/mineralnye-istochniki`, category: 'springs' },
    { lat: 49.9660, lng: 12.6990, name: 'Лесной источник', description: 'Lesní pramen — расположен в живописном лесу.', url: `/${locale}/mineralnye-istochniki`, category: 'springs' },
    { lat: 49.9635, lng: 12.7030, name: 'Рудольфов источник', description: 'Rudolfův pramen — известен своими целебными свойствами.', url: `/${locale}/mineralnye-istochniki`, category: 'springs' },
    { lat: 49.9655, lng: 12.7025, name: 'Nové Lázně', description: 'Исторический спа-отель с римскими банями.', url: `/${locale}/razmeshchenie`, category: 'hotels' },
    { lat: 49.9750, lng: 12.7100, name: 'Royal Golf Club', description: 'Старейший гольф-клуб Чехии, основанный в 1905 году.', url: `/${locale}/chem-zanyatsya`, category: 'nature' },
    { lat: 50.0050, lng: 12.6800, name: 'Природный заповедник Кладска', description: 'Торфяной природный заповедник с познавательной тропой.', url: `/${locale}/chem-zanyatsya`, category: 'nature' },
  ],
}

const mapMarkers = markers ?? defaultMarkers[locale] ?? defaultMarkers['en']

const headingText: Record<string, string> = {
  de: 'Interaktive Karte',
  en: 'Interactive Map',
  cs: 'Interaktivní mapa',
  ru: 'Интерактивная карта',
}

const legendLabels: Record<string, Record<string, string>> = {
  de: { springs: 'Quellen', hotels: 'Hotels', nature: 'Natur', culture: 'Kultur' },
  en: { springs: 'Springs', hotels: 'Hotels', nature: 'Nature', culture: 'Culture' },
  cs: { springs: 'Prameny', hotels: 'Hotely', nature: 'Příroda', culture: 'Kultura' },
  ru: { springs: 'Источники', hotels: 'Отели', nature: 'Природа', culture: 'Культура' },
}

const labels = legendLabels[locale] ?? legendLabels['en']
---

<section class="destination-map-section">
  <h2>{headingText[locale] ?? headingText['en']}</h2>

  <div class="map-legend">
    <span class="legend-item"><span class="legend-dot" style="background:#2563eb"></span> {labels.springs}</span>
    <span class="legend-item"><span class="legend-dot" style="background:#d97706"></span> {labels.hotels}</span>
    <span class="legend-item"><span class="legend-dot" style="background:#16a34a"></span> {labels.nature}</span>
    <span class="legend-item"><span class="legend-dot" style="background:#9333ea"></span> {labels.culture}</span>
  </div>

  <div id="destination-map" data-markers={JSON.stringify(mapMarkers)} data-locale={locale}></div>
</section>

<style>
  .destination-map-section {
    margin: 3rem 0 2rem;
  }

  .destination-map-section h2 {
    margin-bottom: 1rem;
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .legend-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  #destination-map {
    width: 100%;
    height: 400px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    z-index: 0;
  }

  @media (min-width: 768px) {
    #destination-map {
      height: 500px;
    }
  }
</style>

<script>
  function initMap() {
    const container = document.getElementById('destination-map')
    if (!container || (container as any).__leafletReady) return
    ;(container as any).__leafletReady = true

    const markersData = JSON.parse(container.dataset.markers || '[]')
    const locale = container.dataset.locale || 'en'

    const ctaLabels: Record<string, string> = {
      de: 'Mehr erfahren',
      en: 'Learn more',
      cs: 'Zjistit více',
      ru: 'Узнать больше',
    }
    const ctaText = ctaLabels[locale] || ctaLabels['en']

    const categoryColors: Record<string, string> = {
      springs: '#2563eb',
      hotels: '#d97706',
      nature: '#16a34a',
      culture: '#9333ea',
    }

    // Load Leaflet CSS
    if (!document.querySelector('link[href*="leaflet"]')) {
      const link = document.createElement('link')
      link.rel = 'stylesheet'
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
      link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY='
      link.crossOrigin = ''
      document.head.appendChild(link)
    }

    function loadLeafletAndInit() {
      if ((window as any).L) {
        createMap()
        return
      }
      const script = document.createElement('script')
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo='
      script.crossOrigin = ''
      script.onload = () => createMap()
      document.head.appendChild(script)
    }

    function createMap() {
      const L = (window as any).L
      const map = L.map('destination-map').setView([49.9647, 12.7012], 14)

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 18,
      }).addTo(map)

      for (const m of markersData) {
        const color = categoryColors[m.category] || '#6b7280'

        const icon = L.divIcon({
          className: 'custom-map-marker',
          html: `<div style="
            background: ${color};
            width: 28px;
            height: 28px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            border: 2px solid #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
          "></div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 28],
          popupAnchor: [0, -28],
        })

        L.marker([m.lat, m.lng], { icon })
          .addTo(map)
          .bindPopup(`
            <div style="font-size:14px;line-height:1.4;max-width:200px">
              <strong>${m.name}</strong><br/>
              <span style="color:#555">${m.description}</span><br/>
              <a href="${m.url}" style="color:#2563eb;text-decoration:underline;font-size:13px">&rarr; ${ctaText}</a>
            </div>
          `)
      }

      // Fit bounds if markers exist
      if (markersData.length > 0) {
        const bounds = L.latLngBounds(markersData.map((m: any) => [m.lat, m.lng]))
        map.fitBounds(bounds, { padding: [30, 30], maxZoom: 15 })
      }
    }

    loadLeafletAndInit()
  }

  // Use IntersectionObserver for lazy loading
  const mapEl = document.getElementById('destination-map')
  if (mapEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          initMap()
          observer.disconnect()
        }
      },
      { rootMargin: '200px' }
    )
    observer.observe(mapEl)
  }
</script>
