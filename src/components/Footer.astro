---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { getNavItems } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const navItems = getNavItems(locale)
const year = new Date().getFullYear()

const privacyPaths: Record<Locale, string> = { de: '/de/datenschutz', en: '/en/privacy', cs: '/cs/ochrana-soukromi', ru: '/ru/politika-konfidencialnosti' }
const imprintPaths: Record<Locale, string> = { de: '/de/impressum', en: '/en/imprint', cs: '/cs/impressum', ru: '/ru/impressum' }

const discoverLabel = locale === 'de' ? 'Entdecken' : locale === 'cs' ? 'Objevte' : locale === 'ru' ? 'Откройте' : 'Discover'
const magazineLabel = locale === 'de' ? 'Magazin' : locale === 'cs' ? 'Magazín' : locale === 'ru' ? 'Журнал' : 'Magazine'
const contactLabel = locale === 'de' ? 'Kontakt' : locale === 'cs' ? 'Kontakt' : locale === 'ru' ? 'Контакт' : 'Contact'
const ensanaDisclosure = locale === 'de' ? 'Eine Destination von Ensana Health Spa Hotels' : locale === 'cs' ? 'Destinace Ensana Health Spa Hotels' : locale === 'ru' ? 'Направление Ensana Health Spa Hotels' : 'A destination by Ensana Health Spa Hotels'
---

<footer class="bg-beige-950 text-white">
  <!-- Top accent line: turquoise -->
  <div class="h-0.5 bg-gradient-to-r from-transparent via-turquoise-400 to-transparent"></div>

  <div class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-8">
      <!-- Col 1: About + wordmark + social -->
      <div class="lg:col-span-1">
        <a href={`/${locale}`} class="inline-block mb-4" aria-label="Marienbad.com — Mariánské Lázně">
          <img src="/images/logo-header-light.svg" alt="Marienbad" class="h-8 w-auto" />
        </a>
        <p class="text-beige-600 text-sm leading-relaxed mb-6">
          {t(locale, 'footer.aboutText')}
        </p>
      </div>

      <!-- Col 2: Discover (internal links) -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{discoverLabel}</h3>
        <nav aria-label={discoverLabel} class="flex flex-col gap-2.5">
          {navItems.slice(0, 5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Magazine -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{magazineLabel}</h3>
        <nav aria-label={magazineLabel} class="flex flex-col gap-2.5">
          {navItems.slice(5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 4: Contact & Location -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{contactLabel}</h3>
        <div class="space-y-3 text-sm text-beige-600">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Mariánské Lázně<br/>Czech Republic, Europe<br/>UNESCO World Heritage Site</span>
          </p>
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:info@marienbad.com" class="hover:text-turquoise-300 transition-colors">info@marienbad.com</a>
          </p>
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>+420 354 622 474</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-12 pt-8 pb-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-beige-600 text-sm">{ensanaDisclosure}</p>
      <div class="flex items-center gap-6 text-sm">
        <span class="text-beige-700 text-xs">&copy; {year} Marienbad.com</span>
        <a href={privacyPaths[locale]} class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.privacy')}</a>
        <a href={imprintPaths[locale]} class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.imprint')}</a>
      </div>
    </div>
  </div>
</footer>
