---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { getNavItems } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const navItems = getNavItems(locale)
const year = new Date().getFullYear()

const discoverLabel = locale === 'de' ? 'Entdecken' : locale === 'cs' ? 'Objevte' : locale === 'ru' ? 'Откройте' : 'Discover'
const magazineLabel = locale === 'de' ? 'Magazin' : locale === 'cs' ? 'Magazín' : locale === 'ru' ? 'Журнал' : 'Magazine'
const peopleLabel = locale === 'de' ? 'Menschen der Kolonnade' : locale === 'cs' ? 'Lidé z Kolonády' : locale === 'ru' ? 'Люди Колоннады' : 'People of Colonnade'
const ensanaDisclosure = locale === 'de' ? 'Eine Destination von Ensana Health Spa Hotels' : locale === 'cs' ? 'Destinace Ensana Health Spa Hotels' : locale === 'ru' ? 'Направление Ensana Health Spa Hotels' : 'A destination by Ensana Health Spa Hotels'
---

<footer class="bg-beige-950 text-white">
  <!-- Top accent line: turquoise -->
  <div class="h-0.5 bg-gradient-to-r from-transparent via-turquoise-400 to-transparent"></div>

  <div class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-8">
      <!-- Col 1: About + wordmark + social -->
      <div class="lg:col-span-1">
        <a href={`/${locale}`} class="inline-block mb-4">
          <span class="font-heading text-2xl font-bold tracking-tight">marienbad</span>
        </a>
        <p class="text-beige-600 text-sm leading-relaxed mb-6">
          {t(locale, 'footer.aboutText')}
        </p>
        <!-- Social links placeholder -->
        <div class="flex gap-3">
          <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors cursor-pointer">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </span>
          <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors cursor-pointer">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </span>
          <span class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors cursor-pointer">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          </span>
        </div>
      </div>

      <!-- Col 2: Discover (internal links) -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{discoverLabel}</h3>
        <nav class="flex flex-col gap-2.5">
          {navItems.slice(0, 5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Magazine -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{magazineLabel}</h3>
        <nav class="flex flex-col gap-2.5">
          {navItems.slice(5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 4: People of Colonnade -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{peopleLabel}</h3>
        <div class="space-y-3 text-sm text-beige-600">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Mariánské Lázně<br/>Czech Republic, Europe<br/>UNESCO World Heritage Site</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-beige-600 text-sm">{ensanaDisclosure}</p>
      <div class="flex items-center gap-6 text-sm">
        <span class="text-beige-700 text-xs">&copy; {year} Marienbad.com</span>
        <a href="#" class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.privacy')}</a>
        <a href="#" class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.imprint')}</a>
      </div>
    </div>
  </div>
</footer>
