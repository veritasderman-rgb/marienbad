---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { getNavItems } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const navItems = getNavItems(locale)
const year = new Date().getFullYear()
---

<footer class="bg-primary-950 text-white">
  <!-- Top accent line -->
  <div class="h-px bg-gradient-to-r from-transparent via-accent-500/30 to-transparent"></div>

  <div class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href={`/${locale}`} class="inline-flex items-baseline gap-0.5 mb-4">
          <span class="font-heading text-2xl font-semibold tracking-tight">Marienbad</span>
          <span class="text-accent-400 text-lg font-medium">.com</span>
        </a>
        <p class="text-sand-400 text-sm leading-relaxed mb-6">
          {t(locale, 'footer.aboutText')}
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-accent-300">{t(locale, 'footer.quickLinks')}</h3>
        <nav class="flex flex-col gap-2">
          {navItems.slice(0, 5).map(({ navKey, href }) => (
            <a href={href} class="text-sand-400 hover:text-accent-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- More Links -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-accent-300">
          {locale === 'de' ? 'Mehr entdecken' : locale === 'cs' ? 'Objevte více' : locale === 'ru' ? 'Узнать больше' : 'Discover More'}
        </h3>
        <nav class="flex flex-col gap-2">
          {navItems.slice(5).map(({ navKey, href }) => (
            <a href={href} class="text-sand-400 hover:text-accent-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact & Info -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-accent-300">Mariánské Lázně</h3>
        <div class="space-y-3 text-sm text-sand-400">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-accent-500/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Czech Republic, Europe<br/>UNESCO World Heritage Site</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-primary-800/60 mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sand-500 text-sm">&copy; {year} Marienbad.com</p>
      <div class="flex items-center gap-6 text-sm">
        <a href="#" class="text-sand-500 hover:text-accent-300 transition-colors">{t(locale, 'footer.privacy')}</a>
        <a href="#" class="text-sand-500 hover:text-accent-300 transition-colors">{t(locale, 'footer.imprint')}</a>
      </div>
    </div>
  </div>
</footer>
