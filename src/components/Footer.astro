---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { getNavItemsFlat } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const navItems = getNavItemsFlat(locale)
const year = new Date().getFullYear()

const privacyPaths: Record<Locale, string> = { de: '/de/datenschutz', en: '/en/privacy', cs: '/cs/ochrana-soukromi', ru: '/ru/politika-konfidencialnosti' }
const imprintPaths: Record<Locale, string> = { de: '/de/impressum', en: '/en/imprint', cs: '/cs/impressum', ru: '/ru/impressum' }

const discoverLabel = t(locale, 'footer.discover')
const magazineLabel = t(locale, 'footer.magazine')
const contactLabel = t(locale, 'footer.contact')
const ensanaDisclosure = t(locale, 'footer.ensanaDisclosure')
---

<footer class="bg-beige-950 text-white">
  <!-- Top accent line: turquoise -->
  <div class="h-0.5 bg-gradient-to-r from-transparent via-turquoise-400 to-transparent"></div>

  <div class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-8">
      <!-- Col 1: About + wordmark + social -->
      <div class="lg:col-span-1">
        <a href={`/${locale}`} class="inline-block mb-4" aria-label="Marienbad.com — Mariánské Lázně">
          <img src="/images/logo-header-light.svg" alt="Marienbad" class="h-8 w-auto" />
        </a>
        <p class="text-beige-600 text-sm leading-relaxed mb-6">
          {t(locale, 'footer.aboutText')}
        </p>
        <div class="flex gap-3">
          <a href="https://www.instagram.com/ensanahotels.cz/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com/Ensana.CZECHIA" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          </a>
          <a href="https://www.youtube.com/@EnsanaCzech" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center text-turquoise-400 hover:bg-white/20 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Discover (internal links) -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{discoverLabel}</h3>
        <nav aria-label={discoverLabel} class="flex flex-col gap-2.5">
          {navItems.slice(0, 5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Magazine -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{magazineLabel}</h3>
        <nav aria-label={magazineLabel} class="flex flex-col gap-2.5">
          {navItems.slice(5).map(({ navKey, href }) => (
            <a href={href} class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
              {t(locale, navKey as any)}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3b: Useful links -->
      <div class="lg:col-span-1">
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{{ de: 'Nützliche Links', en: 'Useful Links', cs: 'Užitečné odkazy', ru: 'Полезные ссылки' }[locale]}</h3>
        <nav aria-label={{ de: 'Nützliche Links', en: 'Useful Links', cs: 'Užitečné odkazy', ru: 'Полезные ссылки' }[locale]} class="flex flex-col gap-2.5">
          <a href={`https://ensanahotels.com/${locale === 'cs' ? 'cs' : locale === 'ru' ? 'ru' : locale}/destinace/ceska-republika/marianske-lazne`} target="_blank" rel="noopener noreferrer" class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
            {{ de: 'Unterkunft in Marienbad buchen', en: 'Book accommodation in Mariánské Lázně', cs: 'Objednejte si ubytování v Mariánských Lázních', ru: 'Забронировать проживание в Марианских Лазнях' }[locale]}
          </a>
          <a href="https://news.lazneml.cz" target="_blank" rel="noopener noreferrer" class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
            {{ de: 'Neuigkeiten aus dem Kurort', en: 'Spa Town News', cs: 'Novinky z lázní — Kulturní program', ru: 'Новости курорта' }[locale]}
          </a>
          <a href="https://www.lazneml.cz/lazenska-pece" target="_blank" rel="noopener noreferrer" class="text-beige-600 hover:text-turquoise-300 text-sm transition-colors duration-200">
            {{ de: 'Informationen für Versicherte', en: 'Health insurance spa care info', cs: 'Informace pro klienty zdravotních pojišťoven', ru: 'Информация для застрахованных' }[locale]}
          </a>
        </nav>
      </div>

      <!-- Col 4: Contact & Location -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-4 text-turquoise-400">{contactLabel}</h3>
        <div class="space-y-3 text-sm text-beige-600">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>Léčebné lázně Mariánské Lázně a.s.<br/>Masarykova 22/5<br/>353 01 Mariánské Lázně</span>
          </p>
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:webmaster.cz@ensanahotels.com" class="hover:text-turquoise-300 transition-colors">webmaster.cz@ensanahotels.com</a>
          </p>
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-turquoise-400/70 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <span>+420 354 655 514</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-12 pt-8 pb-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-beige-600 text-sm">{ensanaDisclosure}</p>
      <div class="flex items-center gap-6 text-sm">
        <span class="text-beige-700 text-xs">&copy; {year} Marienbad.com</span>
        <a href={privacyPaths[locale]} class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.privacy')}</a>
        <a href={imprintPaths[locale]} class="text-beige-600 hover:text-turquoise-300 transition-colors">{t(locale, 'footer.imprint')}</a>
      </div>
    </div>
  </div>
</footer>
