---
interface Props {
  name: string
  stars: number
  description: string
  bookingUrl: string
  bookingLabel: string
  badge?: string
}

const { name, stars, description, bookingUrl, bookingLabel, badge } = Astro.props
---

<aside class="my-8 bg-beige-200 rounded-xl p-6 md:p-8 border-l-4 border-turquoise-400">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div>
      <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Empfehlung</span>
      <h3 class="font-heading text-xl font-bold text-indigo-700 mt-1">{name}</h3>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-yellow-500 text-sm">{'★'.repeat(stars)}</span>
      {badge && <span class="px-2 py-0.5 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full">{badge}</span>}
    </div>
  </div>
  <p class="text-beige-700 text-sm leading-relaxed mb-4">{description}</p>
  <a
    href={bookingUrl}
    class="inline-flex items-center gap-1.5 text-indigo-500 hover:text-indigo-700 text-sm font-semibold transition-colors"
    target="_blank"
    rel="noopener"
  >
    {bookingLabel}
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </a>
</aside>
