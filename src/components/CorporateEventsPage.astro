<script>
  // Stejná brána souhlasu jako u svateb — gtag existuje i před souhlasem,
  // takže se nesmí posílat naslepo (viz GoogleAnalytics.astro).
  let consentGranted = false
  try {
    consentGranted = localStorage.getItem('ml-consent') === 'granted'
  } catch {
    /* localStorage může být nedostupné */
  }
  document.addEventListener('ml:consent-granted', () => { consentGranted = true })
  document.addEventListener('ml:consent-denied', () => { consentGranted = false })

  const send = (name: string, label: string) => {
    if (!consentGranted) return
    const w = window as unknown as { gtag?: (...args: unknown[]) => void }
    w.gtag?.('event', name, { event_category: 'corporate', event_label: label })
  }

  document.querySelectorAll<HTMLElement>('[data-ga]').forEach((el) => {
    el.addEventListener('click', () => send('corporate_click', el.dataset.ga ?? ''), { passive: true })
  })

  document.querySelectorAll<HTMLDetailsElement>('details[data-ga="corporate-faq"]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) send('corporate_faq_open', d.querySelector('summary')?.textContent?.trim() ?? '')
    })
  })

  const halls = document.getElementById('saly')
  if (halls && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          send('corporate_reach_halls', 'saly')
          io.disconnect()
        }
      },
      { threshold: 0.25 },
    )
    io.observe(halls)
  }
</script>
