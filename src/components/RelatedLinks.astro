---
/**
 * Blok „Mohlo by vás zajímat" — rozcestník na související podstránky.
 *
 * Používá se na pilířových stránkách pod obsahem z CMS, aby nové podstránky
 * (Římské lázně, ambulantní léčení) nebyly slepé uličky dostupné jen z detailu
 * hotelu. Odkazy se předávají zvenčí, komponenta řeší jen vzhled a nadpis.
 */
import type { Locale } from '@/i18n/config'

export interface RelatedItem {
  href: string
  title: string
  text: string
}

interface Props {
  locale: Locale
  items: RelatedItem[]
  /** Vlastní nadpis; jinak se použije lokalizovaný výchozí. */
  heading?: string
}

const { locale, items, heading } = Astro.props as Props

const defaultHeading: Record<Locale, string> = {
  cs: 'Mohlo by vás zajímat',
  de: 'Das könnte Sie interessieren',
  en: 'You might also like',
  ru: 'Возможно, вам будет интересно',
}
---

{items.length > 0 && (
  <aside class="mt-12 mb-4">
    <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-5">
      {heading ?? defaultHeading[locale]}
    </h2>
    <div class:list={['grid gap-4', items.length > 1 ? 'md:grid-cols-2' : '']}>
      {items.map((item) => (
        <a
          href={item.href}
          class="group block rounded-2xl border border-beige-300 bg-white p-5 md:p-6 transition-colors hover:border-turquoise-400 hover:bg-turquoise-50/40"
        >
          <span class="flex items-center gap-2 font-heading text-lg font-bold text-indigo-700 group-hover:text-indigo-800">
            {item.title}
            <svg
              class="w-4 h-4 text-turquoise-600 transition-transform group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
          <span class="mt-2 block text-sm text-beige-700 leading-relaxed">{item.text}</span>
        </a>
      ))}
    </div>
  </aside>
)}
