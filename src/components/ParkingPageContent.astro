---
import type { Locale } from '@/i18n/config'
import Pic from '@/components/Pic.astro'
import { ui, getHotels, getTableGroups, garages, publicLots, cityLinks } from '@/data/parking'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const t = ui[locale]
const hotels = getHotels(locale)
const tableGroups = getTableGroups(locale)
const garageList = garages[locale]
const publicLotList = publicLots[locale]
const links = cityLinks[locale]

const extLinkIcon =
  'M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25'
---

<!-- Hero -->
<section class="bg-indigo-800 text-white">
  <div class="container-wide py-12 md:py-16">
    <p class="text-turquoise-200 font-semibold tracking-wide uppercase text-sm mb-3">{t.eyebrow}</p>
    <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold leading-tight max-w-3xl">
      {t.h1}
    </h1>
    <p class="mt-5 text-white/85 leading-relaxed max-w-2xl" set:html={t.heroLeadHtml} />
  </div>
</section>

<!-- Přehledová tabulka (jen na tabletu a výše; na mobilu jsou přehlednější karty níže) -->
<section class="container-wide py-10 md:py-14 hidden md:block">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-6">{t.tableHeading}</h2>
  <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-card">
    <table class="w-full text-left text-sm md:text-base border-collapse">
      <thead>
        <tr class="bg-indigo-800 text-white">
          <th class="px-4 py-3 font-semibold">{t.colOption}</th>
          <th class="px-4 py-3 font-semibold whitespace-nowrap">{t.colPrice}</th>
          <th class="px-4 py-3 font-semibold">{t.colNote}</th>
        </tr>
      </thead>
      {tableGroups.map((g) => (
        <tbody class="border-t-4 border-turquoise-400">
          <tr class="bg-beige-100">
            <th colspan="3" class="px-4 py-2.5 text-left align-baseline">
              <span class="font-heading font-bold text-indigo-800 text-base md:text-lg">{g.hotel}</span>
              <span class="ml-3 font-normal text-sm text-gray-600">
                {t.reservationLabel}
                <a href={`mailto:${g.contact}`} class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">{g.contact}</a>
              </span>
            </th>
          </tr>
          {g.rows.map((r) => (
            <tr class="bg-white align-top border-t border-gray-100">
              <td class="px-4 py-3 text-gray-800 font-medium">
                {r.href ? (
                  <a href={r.href} target="_blank" rel="noopener" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2 inline-flex items-center gap-1">
                    {r.option}
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={extLinkIcon} /></svg>
                  </a>
                ) : r.option}
              </td>
              <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{r.price}</td>
              <td class="px-4 py-3 text-gray-600">{r.note}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
</section>

<!-- Parkování u jednotlivých hotelů -->
<section class="bg-beige-50 py-10 md:py-16">
  <div class="container-wide">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-2">{t.hotelsHeading}</h2>
    <p class="text-gray-600 mb-8 max-w-2xl">{t.hotelsSubtitle}</p>

    <div class="grid gap-6 md:grid-cols-2">
      {hotels.map((h) => (
        <article class="flex flex-col sm:flex-row bg-white rounded-2xl shadow-card overflow-hidden border border-gray-100">
          <div class="sm:w-44 lg:w-52 shrink-0">
            <Pic
              src={h.image}
              alt={`${h.name}`}
              class="w-full h-40 sm:h-full object-cover"
              sizes="(max-width: 640px) 100vw, 208px"
            />
          </div>
          <div class="flex-1 p-5 md:p-6">
            <h3 class="font-heading text-lg md:text-xl font-bold text-indigo-800">{h.name}</h3>
            {h.location && <p class="text-sm text-gray-500 mt-1">{h.location}</p>}
            <p class="text-sm text-gray-600 mt-2">
              {t.reservationLabel}
              <a href={`mailto:${h.contact}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2 break-all">{h.contact}</a>
            </p>
            <ul class="mt-4 space-y-3">
              {h.options.map((o) => (
                <li class="flex gap-3">
                  <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-turquoise-500"></span>
                  <div>
                    <p class="text-gray-800 font-medium">
                      {o.href ? (
                        <a href={o.href} target="_blank" rel="noopener" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2 inline-flex items-center gap-1">
                          {o.name}
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={extLinkIcon} /></svg>
                        </a>
                      ) : o.name}
                      {o.price && <span class="text-turquoise-700 font-semibold"> — {o.price}</span>}
                    </p>
                    {o.note && <p class="text-sm text-gray-500 mt-0.5">{o.note}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Další možnosti parkování ve městě -->
<section class="container-wide py-10 md:py-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">{t.cityHeading}</h2>
  <p class="text-gray-700 leading-relaxed max-w-3xl mb-8" set:html={t.cityIntroHtml} />

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-6 md:p-7">
      <h3 class="font-heading text-lg font-bold text-indigo-800 mb-4">{t.garagesHeading}</h3>
      <div class="space-y-5 text-gray-700 leading-relaxed">
        {garageList.map((p) => (
          <div>
            <p class="font-semibold text-gray-900">{p.name}</p>
            <p class="text-sm mt-1">{p.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-6 md:p-7">
      <h3 class="font-heading text-lg font-bold text-indigo-800 mb-4">{t.publicLotsHeading}</h3>
      <div class="space-y-5 text-gray-700 leading-relaxed">
        {publicLotList.map((p) => (
          <div>
            <p class="font-semibold text-gray-900">{p.name}</p>
            <p class="text-sm mt-1">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="mt-6 bg-indigo-50 rounded-2xl border border-indigo-100 p-6 md:p-7">
    <h3 class="font-heading text-lg font-bold text-indigo-800 mb-3">{t.centreZoneHeading}</h3>
    <div class="space-y-4 text-gray-700 leading-relaxed">
      <p set:html={t.centreZonePara1Html} />
      <p set:html={t.centreZonePara2Html} />
    </div>
  </div>

  <div class="mt-10">
    <h3 class="font-heading text-lg md:text-xl font-bold text-indigo-800 mb-2">{t.usefulLinksHeading}</h3>
    <p class="text-gray-600 mb-5 max-w-2xl">{t.usefulLinksSubtitle}</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="group flex items-start gap-4 bg-white border border-gray-200 hover:border-turquoise-400 rounded-2xl p-5 shadow-card card-hover"
        >
          <span class="shrink-0 w-10 h-10 rounded-xl bg-turquoise-50 text-turquoise-700 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={extLinkIcon} />
            </svg>
          </span>
          <span class="flex-1">
            <span class="block font-semibold text-indigo-800 group-hover:text-turquoise-700">{l.label}</span>
            <span class="block text-sm text-gray-500 mt-0.5">{l.desc}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
