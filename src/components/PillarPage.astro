---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'

interface Props {
  locale: Locale
  title: string
  description: string
}

const { locale, title, description } = Astro.props
---

<section class="bg-primary-950 text-white py-16 md:py-24">
  <div class="container-wide">
    <h1 class="font-heading text-3xl md:text-5xl font-bold mb-4">{title}</h1>
    <p class="text-stone-300 text-lg max-w-2xl">{description}</p>
  </div>
</section>

<section class="container-wide py-12 md:py-16">
  <div class="prose prose-stone prose-lg max-w-3xl mx-auto">
    <slot />
  </div>
</section>
