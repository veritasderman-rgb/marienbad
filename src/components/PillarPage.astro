---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import TableOfContents from '@/components/TableOfContents.astro'

interface BreadcrumbItem {
  label: string
  href?: string
}

interface Props {
  locale: Locale
  title: string
  description: string
  breadcrumbs?: BreadcrumbItem[]
}

const { locale, title, description, breadcrumbs } = Astro.props
const homeLabel = t(locale, 'nav.home')
const pathname = Astro.url.pathname.replace(/\/$/, '')
const canonicalUrl = `https://marienbad.vercel.app${pathname}`
const homeUrl = `/${locale}`

const defaultBreadcrumbs: BreadcrumbItem[] = [
  { label: homeLabel, href: homeUrl },
  { label: title },
]

const breadcrumbItems = breadcrumbs ?? defaultBreadcrumbs
---

<!-- Reading Progress Bar -->
<div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-turquoise-400 z-50 transition-[width] duration-150 ease-out" style="width: 0%"></div>

<!-- Pillar Hero -->
<section class="relative bg-indigo-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.12)_0%,_transparent_60%)]"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-turquoise-400/30 to-transparent"></div>
  <div class="relative container-wide py-20 md:py-28">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />
    <h1 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight" style="font-size: var(--text-h1);">{title}</h1>
    <p class="text-white/70 text-lg md:text-xl max-w-2xl leading-relaxed">{description}</p>
  </div>
</section>

<!-- Content with TOC sidebar -->
<section class="container-wide py-12 md:py-20">
  <div class="lg:grid lg:grid-cols-[minmax(0,680px)_240px] lg:gap-12 max-w-[1024px] mx-auto">
    <div id="pillar-content" class="prose-marienbad">
      <slot />
    </div>
    <aside class="hidden lg:block">
      <TableOfContents label={t(locale, 'common.tableOfContents')} />
    </aside>
  </div>
</section>

<script>
  function initToc() {
    const content = document.getElementById('pillar-content')
    const tocList = document.getElementById('toc-list')
    const tocNav = document.getElementById('toc-nav')
    if (!content || !tocList || !tocNav) return

    const headings = content.querySelectorAll('h2, h3')
    if (headings.length === 0) {
      tocNav.style.display = 'none'
      return
    }

    function toSlug(text: string): string {
      return text
        .toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .trim()
    }

    const tocItems: Array<{ el: HTMLElement; slug: string; depth: number; text: string }> = []
    const slugCounts = new Map<string, number>()

    headings.forEach((h) => {
      const heading = h as HTMLElement
      let slug = heading.id || toSlug(heading.textContent || '')
      const count = slugCounts.get(slug) || 0
      slugCounts.set(slug, count + 1)
      if (count > 0) slug = `${slug}-${count}`
      if (!heading.id) heading.id = slug

      const depth = heading.tagName === 'H3' ? 3 : 2
      tocItems.push({ el: heading, slug, depth, text: heading.textContent || '' })
    })

    // Populate TOC
    tocList.innerHTML = ''
    tocItems.forEach((item) => {
      const li = document.createElement('li')
      const a = document.createElement('a')
      a.href = `#${item.slug}`
      a.textContent = item.text
      a.dataset.slug = item.slug
      a.className =
        item.depth === 3
          ? 'toc-link toc-sub block py-1.5 transition-colors duration-200 hover:text-indigo-600 pl-6 text-xs text-gray-400'
          : 'toc-link toc-item block py-1.5 transition-colors duration-200 hover:text-indigo-600 border-l border-gray-200 pl-3 text-gray-500'
      a.addEventListener('click', (e) => {
        e.preventDefault()
        const target = document.getElementById(item.slug)
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' })
          history.replaceState(null, '', `#${item.slug}`)
        }
      })
      li.appendChild(a)
      tocList.appendChild(li)
    })

    // IntersectionObserver for active heading
    let activeSlug = ''
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)

        if (visible.length > 0) {
          const newSlug = (visible[0].target as HTMLElement).id
          if (newSlug !== activeSlug) {
            activeSlug = newSlug
            updateActive(newSlug)
          }
        }
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    )

    tocItems.forEach((item) => observer.observe(item.el))

    function updateActive(slug: string) {
      tocList.querySelectorAll('.toc-link').forEach((link) => {
        const el = link as HTMLElement
        const isActive = el.dataset.slug === slug
        const isSub = el.classList.contains('toc-sub')
        if (isActive) {
          el.classList.remove('text-gray-500', 'text-gray-400', 'border-gray-200')
          el.classList.add('font-medium')
          if (isSub) {
            el.classList.add('text-indigo-600')
          } else {
            el.classList.add('text-gray-900', 'border-turquoise-400', 'border-l-2')
          }
        } else {
          el.classList.remove('text-indigo-600', 'text-gray-900', 'font-medium', 'border-turquoise-400', 'border-l-2')
          if (isSub) {
            el.classList.add('text-gray-400')
          } else {
            el.classList.add('text-gray-500', 'border-gray-200')
          }
        }
      })
    }
  }

  initToc()
  document.addEventListener('astro:after-swap', initToc)

  function initReadingProgress() {
    const bar = document.getElementById('reading-progress')
    if (!bar) return

    // Respect prefers-reduced-motion: remove transition so width jumps instantly
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bar.classList.remove('transition-[width]', 'duration-150', 'ease-out')
    }

    let rafId: number | null = null

    function updateProgress() {
      rafId = null
      const content = document.getElementById('pillar-content')
      if (!content) {
        bar.style.width = '0%'
        return
      }

      const rect = content.getBoundingClientRect()
      const contentTop = rect.top + window.scrollY
      const contentHeight = content.offsetHeight
      const scrolled = window.scrollY - contentTop
      const progress = Math.min(Math.max(scrolled / (contentHeight - window.innerHeight || contentHeight), 0), 1)
      bar.style.width = `${progress * 100}%`
    }

    function onScroll() {
      if (rafId === null) {
        rafId = requestAnimationFrame(updateProgress)
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    updateProgress()

    // Return cleanup so we can re-run on view transitions
    return () => {
      window.removeEventListener('scroll', onScroll)
      if (rafId !== null) cancelAnimationFrame(rafId)
    }
  }

  let cleanupProgress = initReadingProgress()
  document.addEventListener('astro:after-swap', () => {
    if (cleanupProgress) cleanupProgress()
    cleanupProgress = initReadingProgress()
  })
</script>
