---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'

interface Props {
  locale: Locale
  title: string
  description: string
}

const { locale, title, description } = Astro.props
const homeLabel = t(locale, 'nav.home')
---

<!-- Pillar Hero -->
<section class="relative bg-indigo-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.12)_0%,_transparent_60%)]"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-turquoise-400/30 to-transparent"></div>
  <div class="relative container-wide py-20 md:py-28">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-sm text-white/60">
        <li><a href={`/${locale}`} class="hover:text-white transition-colors">{homeLabel}</a></li>
        <li class="before:content-['/'] before:mr-2">{title}</li>
      </ol>
    </nav>
    <h1 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight" style="font-size: var(--text-h1);">{title}</h1>
    <p class="text-white/70 text-lg md:text-xl max-w-2xl leading-relaxed">{description}</p>
  </div>
</section>

<!-- Content -->
<section class="container-wide py-12 md:py-20">
  <div class="prose-marienbad max-w-4xl mx-auto">
    <slot />
  </div>
</section>
