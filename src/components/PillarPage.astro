---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'

interface Props {
  locale: Locale
  title: string
  description: string
}

const { locale, title, description } = Astro.props
---

<!-- Pillar Hero -->
<section class="relative bg-primary-950 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--color-primary-800)_0%,_transparent_60%)] opacity-50"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent-500/20 to-transparent"></div>
  <div class="relative container-wide py-20 md:py-28">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-px w-12 bg-accent-400"></div>
      <span class="text-accent-400 text-sm font-medium tracking-widest uppercase">Marienbad.com</span>
    </div>
    <h1 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight">{title}</h1>
    <p class="text-sand-300 text-lg md:text-xl max-w-2xl leading-relaxed">{description}</p>
  </div>
</section>

<!-- Content -->
<section class="container-wide py-12 md:py-20">
  <div class="prose-marienbad prose prose-lg max-w-4xl mx-auto">
    <slot />
  </div>
</section>
