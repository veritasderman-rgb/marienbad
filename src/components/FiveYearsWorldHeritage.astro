      <div>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 leading-tight">{c.whatHeading}</h2>
        <div class="mt-6 space-y-5 text-lg text-beige-900 leading-relaxed">
          {c.whatParagraphs.map((p) => <p set:html={bold(p)} />)}
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl shadow-card">
        <Pic
          src="/images/library/colonnade/main-colonnade-16a4646.jpg"
          alt="Interiér litinové Hlavní kolonády se stropními freskami"
          class="w-full h-full object-cover"
          sizes="(min-width: 1024px) 45vw, 100vw"
        />
      </div>
    </div>
  </div>
</section>

<!-- ── Program ──────────────────────────────────────────────────────── -->
<section id="program" class="section bg-indigo-700 text-white relative overflow-hidden scroll-mt-24">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.18)_0%,_transparent_60%)]"></div>

  <div class="relative container-wide">
    <div class="max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl font-bold leading-tight">{c.programmeHeading}</h2>
      <p class="mt-4 text-lg text-white/80 leading-relaxed">{c.programmeLead}</p>
    </div>

    <div class="mt-10 grid md:grid-cols-3 gap-6">
      {c.days.map((d) => (
        <div class={`rounded-2xl p-6 border ${d.highlight ? 'bg-yellow-400 text-beige-950 border-yellow-300' : 'bg-white/8 border-white/15'}`}>
          <p class={`text-xs font-semibold uppercase tracking-wider ${d.highlight ? 'text-beige-950/70' : 'text-turquoise-300'}`}>{d.day}</p>
          <h3 class="mt-1.5 font-heading text-xl font-bold leading-snug">{d.town}</h3>
          <ul class="mt-4 space-y-2.5">
            {d.items.map((item) => (
              <li class="flex gap-2.5 text-sm leading-snug">
                <svg class={`w-4 h-4 mt-0.5 shrink-0 ${d.highlight ? 'text-beige-950' : 'text-turquoise-300'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                <span class={d.highlight ? '' : 'text-white/85'}>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-6 text-sm text-white/60">{c.programmeNote}</p>
    <a href={CAMPAIGN_URL} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4">
      {c.programmeCta}
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" /></svg>
    </a>
  </div>
</section>

<!-- ── Zářijový kontext + odkazy ────────────────────────────────────── -->
<section class="section bg-white">
  <div class="container-wide">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 leading-tight">{c.septemberHeading}</h2>
        <p class="mt-4 text-lg text-beige-800 leading-relaxed">{c.septemberText}</p>
        <ul class="mt-6 space-y-4">
          {c.septemberItems.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-turquoise-500 shrink-0"></span>
              <span class="text-beige-900 leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-beige-50 border border-beige-200 p-7 md:p-8">
        <h2 class="font-heading text-2xl font-bold text-indigo-700 leading-snug">{c.moreHeading}</h2>
        <p class="mt-3 text-beige-800 leading-relaxed">{c.moreText}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={c.unescoHref} class="btn-ghost">
            {c.moreUnesco}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
          <a href={c.articleHref} class="btn-ghost">
            {c.moreArticle}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Závěrečná výzva ──────────────────────────────────────────────── -->
<section class="relative overflow-hidden bg-aubergine-900 text-white">
  <div class="absolute inset-0">
    <Pic
      src="/images/library/colonnade/park-16a4999.jpg"
      alt=""
      class="w-full h-full object-cover"
      sizes="100vw"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-aubergine-950/95 via-aubergine-950/80 to-aubergine-950/35"></div>

  <div class="relative container-wide">
    <div class="max-w-2xl py-20 md:py-28">
      <h2 class="font-heading text-3xl md:text-5xl font-bold leading-tight">{c.closingHeading}</h2>
      <p class="mt-5 text-lg text-white/80 leading-relaxed">{c.closingText}</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href={c.bookingHref} class="btn-primary">
          {c.closingBook}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
