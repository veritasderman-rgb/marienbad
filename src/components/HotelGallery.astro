---
/**
 * Fotogalerie hotelu — mozaika v booking stylu (velká fotka + čtyři náhledy)
 * a celoobrazovkový lightbox s filtrem podle kategorií.
 *
 * Lightbox je čisté vanilla JS, žádný island: data se předají v <script type="application/json">
 * a modal se sestaví až při prvním otevření.
 */
import type { Locale } from '@/i18n/config'
import { hotelPhotos, categoriesOf, srcset, displaySize, type HotelPhoto } from '@/lib/hotelPhotos'
import { categoryLabels, ui } from '@/data/hotelUi'

interface Props {
  locale: Locale
  slug: string
  hotelName: string
}

const { locale, slug, hotelName } = Astro.props
const photos = hotelPhotos(slug)
const cats = categoriesOf(slug)
const labels = categoryLabels[locale]
const t = ui[locale]

/** Do mozaiky: první krajinná fotka jako hero, pak čtyři další z různých kategorií. */
const hero = photos.find((p) => p.orientation === 'landscape') ?? photos[0]
const rest = photos.filter((p) => p.id !== hero?.id)
const tiles: HotelPhoto[] = []
for (const cat of cats) {
  if (tiles.length >= 4) break
  const next = rest.find((p) => p.category === cat && !tiles.includes(p))
  if (next) tiles.push(next)
}
for (const p of rest) {
  if (tiles.length >= 4) break
  if (!tiles.includes(p)) tiles.push(p)
}

const payload = photos.map((p) => ({
  s: srcset(p),
  b: `${p.base}-1600.webp`,
  c: p.category,
  l: labels[p.category],
  ...displaySize(p),
}))

const heroSize = hero ? displaySize(hero) : { width: 1600, height: 1067 }
---

{photos.length > 0 && (
  <section id="gallery" class="scroll-mt-24">
    <div
      class="grid grid-cols-4 grid-rows-2 gap-1.5 md:gap-2 h-[280px] sm:h-[360px] md:h-[460px] lg:h-[520px] rounded-2xl overflow-hidden"
      data-gallery-grid
    >
      {hero && (
        <button
          type="button"
          class="col-span-4 row-span-2 sm:col-span-2 relative group overflow-hidden cursor-zoom-in"
          data-gallery-open="0"
          aria-label={t.gallery}
        >
          <img
            src={`${hero.base}-1600.webp`}
            srcset={srcset(hero)}
            sizes="(max-width: 640px) 100vw, 50vw"
            width={heroSize.width}
            height={heroSize.height}
            alt={`${hotelName} — ${labels[hero.category]}`}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </button>
      )}

      {tiles.map((photo, i) => {
        const size = displaySize(photo)
        const isLast = i === tiles.length - 1
        return (
          <button
            type="button"
            class="hidden sm:block relative group overflow-hidden cursor-zoom-in"
            data-gallery-open={photos.indexOf(photo)}
            aria-label={labels[photo.category]}
          >
            <img
              src={`${photo.base}-800.webp`}
              srcset={srcset(photo)}
              sizes="25vw"
              width={size.width}
              height={size.height}
              alt={`${hotelName} — ${labels[photo.category]}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            {isLast && photos.length > 5 && (
              <span class="absolute inset-0 bg-indigo-950/55 flex items-center justify-center text-white text-sm font-semibold text-center px-2">
                +{photos.length - 5}
              </span>
            )}
          </button>
        )
      })}
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button
        type="button"
        data-gallery-open="0"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-indigo-700 text-white text-sm font-semibold hover:bg-indigo-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="8.5" cy="9.5" r="1.5" />
          <path stroke-linecap="round" d="M21 16l-5-5-4 4-2-2-7 7" />
        </svg>
        {t.allPhotos(photos.length)}
      </button>
      <div class="hidden md:flex flex-wrap gap-1.5">
        {cats.map((c) => (
          <button
            type="button"
            data-gallery-cat={c}
            class="px-3 py-1.5 rounded-full bg-beige-100 text-beige-700 text-xs font-medium hover:bg-turquoise-50 hover:text-turquoise-800 transition-colors"
          >
            {labels[c]}
          </button>
        ))}
      </div>
    </div>

    <script type="application/json" data-gallery-photos set:html={JSON.stringify(payload)} />
    <script
      type="application/json"
      data-gallery-labels
      set:html={JSON.stringify({
        all: t.all,
        close: t.close,
        prev: t.prev,
        next: t.next,
        hotel: hotelName,
        cats: cats.map((c) => ({ key: c, label: labels[c] })),
      })}
    />
  </section>
)}

<script>
  interface GalleryPhoto { s: string; b: string; c: string; l: string; width: number; height: number }

  function initGallery() {
    const dataEl = document.querySelector('[data-gallery-photos]')
    const labelEl = document.querySelector('[data-gallery-labels]')
    if (!dataEl || !labelEl) return

    const photos: GalleryPhoto[] = JSON.parse(dataEl.textContent || '[]')
    const labels = JSON.parse(labelEl.textContent || '{}') as {
      all: string; close: string; prev: string; next: string; hotel: string
      cats: { key: string; label: string }[]
    }
    if (photos.length === 0) return

    let filter = 'all'
    let index = 0
    let visible = photos.map((_, i) => i)

    const overlay = document.createElement('div')
    overlay.className =
      'fixed inset-0 z-[100] bg-indigo-950/95 backdrop-blur-sm hidden flex-col text-white'
    overlay.setAttribute('role', 'dialog')
    overlay.setAttribute('aria-modal', 'true')
    overlay.innerHTML = `
      <div class="flex items-center justify-between gap-4 px-4 py-3 shrink-0">
        <span class="text-sm text-white/70" data-counter></span>
        <div class="flex-1 overflow-x-auto">
          <div class="flex gap-1.5 justify-center min-w-max" data-filters></div>
        </div>
        <button type="button" data-close aria-label="${labels.close}"
          class="shrink-0 w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 grid place-items-center transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="relative flex-1 min-h-0 flex items-center justify-center px-2 md:px-16">
        <button type="button" data-prev aria-label="${labels.prev}"
          class="absolute left-2 md:left-4 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 grid place-items-center transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <figure class="max-h-full flex flex-col items-center gap-3">
          <img data-main alt="" class="max-h-[70vh] md:max-h-[74vh] w-auto max-w-full object-contain rounded-lg shadow-2xl" />
          <figcaption class="text-sm text-white/70" data-caption></figcaption>
        </figure>
        <button type="button" data-next aria-label="${labels.next}"
          class="absolute right-2 md:right-4 z-10 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 grid place-items-center transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <div class="shrink-0 overflow-x-auto px-4 py-3">
        <div class="flex gap-2 min-w-max" data-thumbs></div>
      </div>`
    document.body.appendChild(overlay)

    const mainImg = overlay.querySelector('[data-main]') as HTMLImageElement
    const caption = overlay.querySelector('[data-caption]') as HTMLElement
    const counter = overlay.querySelector('[data-counter]') as HTMLElement
    const thumbs = overlay.querySelector('[data-thumbs]') as HTMLElement
    const filters = overlay.querySelector('[data-filters]') as HTMLElement

    const chipBase =
      'px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-colors'
    const chipOff = ' bg-white/10 text-white/70 hover:bg-white/20'
    const chipOn = ' bg-turquoise-400 text-indigo-900'

    function renderFilters() {
      filters.innerHTML = ''
      const entries = [{ key: 'all', label: labels.all }, ...labels.cats]
      for (const c of entries) {
        const b = document.createElement('button')
        b.type = 'button'
        b.className = chipBase + (filter === c.key ? chipOn : chipOff)
        b.textContent = c.label
        b.addEventListener('click', () => setFilter(c.key))
        filters.appendChild(b)
      }
    }

    function renderThumbs() {
      thumbs.innerHTML = ''
      visible.forEach((pIdx, i) => {
        const p = photos[pIdx]
        const b = document.createElement('button')
        b.type = 'button'
        b.className =
          'w-20 h-14 rounded-md overflow-hidden shrink-0 ring-2 transition-all ' +
          (visible[i] === index ? 'ring-turquoise-400 opacity-100' : 'ring-transparent opacity-60 hover:opacity-100')
        b.innerHTML = `<img src="${p.b.replace('-1600.webp', '-400.webp')}" alt="" loading="lazy" class="w-full h-full object-cover">`
        b.addEventListener('click', () => show(pIdx))
        thumbs.appendChild(b)
      })
    }

    function show(pIdx: number) {
      index = pIdx
      const p = photos[pIdx]
      mainImg.src = p.b
      mainImg.srcset = p.s
      mainImg.sizes = '90vw'
      mainImg.width = p.width
      mainImg.height = p.height
      mainImg.alt = `${labels.hotel} — ${p.l}`
      caption.textContent = p.l
      const pos = visible.indexOf(pIdx) + 1
      counter.textContent = `${pos} / ${visible.length}`
      renderThumbs()
      const active = thumbs.children[visible.indexOf(pIdx)] as HTMLElement | undefined
      active?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' })
    }

    function setFilter(key: string) {
      filter = key
      visible = photos.map((_, i) => i).filter((i) => key === 'all' || photos[i].c === key)
      if (visible.length === 0) visible = photos.map((_, i) => i)
      renderFilters()
      show(visible.includes(index) ? index : visible[0])
    }

    function step(delta: number) {
      const pos = visible.indexOf(index)
      const next = (pos + delta + visible.length) % visible.length
      show(visible[next])
    }

    function open(pIdx: number, cat?: string) {
      setFilter(cat ?? 'all')
      show(visible.includes(pIdx) ? pIdx : visible[0])
      overlay.classList.remove('hidden')
      overlay.classList.add('flex')
      document.body.style.overflow = 'hidden'
    }

    function close() {
      overlay.classList.add('hidden')
      overlay.classList.remove('flex')
      document.body.style.overflow = ''
    }

    overlay.querySelector('[data-close]')?.addEventListener('click', close)
    overlay.querySelector('[data-prev]')?.addEventListener('click', () => step(-1))
    overlay.querySelector('[data-next]')?.addEventListener('click', () => step(1))
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close()
    })
    document.addEventListener('keydown', (e) => {
      if (overlay.classList.contains('hidden')) return
      if (e.key === 'Escape') close()
      if (e.key === 'ArrowLeft') step(-1)
      if (e.key === 'ArrowRight') step(1)
    })

    document.querySelectorAll('[data-gallery-open]').forEach((el) => {
      el.addEventListener('click', () => open(Number((el as HTMLElement).dataset.galleryOpen ?? 0)))
    })
    document.querySelectorAll('[data-gallery-cat]').forEach((el) => {
      el.addEventListener('click', () => {
        const cat = (el as HTMLElement).dataset.galleryCat!
        const first = photos.findIndex((p) => p.c === cat)
        open(first >= 0 ? first : 0, cat)
      })
    })
  }

  initGallery()
  document.addEventListener('astro:page-load', initGallery)
</script>
