---
import type { Locale } from '@/i18n/config'
import { hotels } from '@/data/hotels'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const hotelOrder = [
  'nove-lazne',
  'centralni-lazne',
  'hvezda',
  'pacifik',
  'butterfly',
  'vltava',
  'svoboda',
]

const orderedHotels = hotelOrder
  .map((slug) => hotels.find((h) => h.slug === slug))
  .filter(Boolean)

const sectionTitle: Record<string, string> = {
  de: 'Unsere Hotels in Marienbad',
  en: 'Our Hotels in Marienbad',
  cs: 'Naše hotely v Mariánských Lázních',
  ru: 'Наши отели в Марианских Лазнях',
}

const ctaLabel: Record<string, string> = {
  de: 'Mehr erfahren',
  en: 'Learn more',
  cs: 'Zjistit více',
  ru: 'Узнать больше',
}
---

<section class="mb-12 md:mb-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8" style="font-size: var(--text-h2);">
    {sectionTitle[locale]}
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
    {orderedHotels.map((hotel) => {
      if (!hotel) return null
      const tagline = hotel.tagline[locale]
      const url = hotel.bookingUrls[locale]
      const stars = '★'.repeat(hotel.stars)
      return (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-xl bg-indigo-700 aspect-[3/4] transition-transform duration-300 hover:scale-[1.02] hover:shadow-lg"
        >
          {/* Gradient overlay for text readability */}
          <div class="absolute inset-0 bg-gradient-to-t from-indigo-900/90 via-indigo-900/40 to-indigo-700/20 z-10" />

          {/* Decorative accent line */}
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-turquoise-400 to-turquoise-500 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

          {/* Content */}
          <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5 z-20 text-white">
            <span class="text-yellow-400 text-xs tracking-wider mb-1 block">{stars}</span>
            <h3 class="font-heading text-sm md:text-base font-bold leading-tight mb-1.5">
              {hotel.name.replace(' Ensana Health Spa Hotel', '')}
            </h3>
            <p class="text-white/70 text-xs leading-snug line-clamp-2 mb-3">
              {tagline}
            </p>
            <span class="inline-flex items-center text-turquoise-300 text-xs font-medium group-hover:text-turquoise-200 transition-colors">
              {ctaLabel[locale]}
              <svg class="w-3 h-3 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      )
    })}
  </div>
</section>
