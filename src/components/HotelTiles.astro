---
import type { Locale } from '@/i18n/config'
import { hotels } from '@/data/hotels'
import { getHotelGallery } from '@/content/reader'
import { withUtm } from '@/utils/utm'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const hotelOrder = [
  'nove-lazne',
  'centralni-lazne',
  'hvezda',
  'pacifik',
  'butterfly',
  'vltava',
  'svoboda',
]

const orderedHotels = hotelOrder
  .map((slug) => {
    const hotel = hotels.find((h) => h.slug === slug)
    if (!hotel) return null
    const gallery = getHotelGallery(slug)
    return { ...hotel, gallery }
  })
  .filter(Boolean)

const sectionTitle: Record<string, string> = {
  de: 'Unsere Hotels in Marienbad',
  en: 'Our Hotels in Marienbad',
  cs: 'Naše hotely v Mariánských Lázních',
  ru: 'Наши отели в Марианских Лазнях',
}

const ctaLabel: Record<string, string> = {
  de: 'Hotel ansehen',
  en: 'View hotel',
  cs: 'Zobrazit hotel',
  ru: 'Смотреть отель',
}

const placeholder = '/images/hotels/placeholder.svg'
---

<section class="mb-12 md:mb-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8" style="font-size: var(--text-h2);">
    {sectionTitle[locale]}
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
    {orderedHotels.map((hotel) => {
      if (!hotel) return null
      const tagline = hotel.tagline[locale]
      const url = withUtm(hotel.bookingUrls[locale], 'marienbad', 'hotel-tile', 'hotel-booking')
      const stars = '★'.repeat(hotel.stars)
      const features = (hotel.features[locale] ?? hotel.features.de).slice(0, 3)
      const hotelName = hotel.name.replace(' Ensana Health Spa Hotel', '')
      const images = hotel.gallery.length > 0
        ? hotel.gallery.map((g) => ({ src: g.image!, alt: g.alt || hotelName }))
        : [{ src: placeholder, alt: hotelName }]
      const hasMultipleImages = images.length > 1

      return (
        <div class="group relative flex flex-col overflow-hidden rounded-xl bg-white border border-beige-200 transition-all duration-300 hover:shadow-lg hover:border-turquoise-300">
          {/* Accent line on hover */}
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-turquoise-400 to-turquoise-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10" />

          {/* Photo carousel area */}
          <div class="relative aspect-[3/2] overflow-hidden bg-beige-100" data-carousel={hasMultipleImages ? 'true' : undefined}>
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                class:list={[
                  'absolute inset-0 w-full h-full object-cover transition-opacity duration-500',
                  i === 0 ? 'opacity-100' : 'opacity-0',
                ]}
                data-slide={i}
              />
            ))}

            {/* Navigation arrows (only if multiple images) */}
            {hasMultipleImages && (
              <>
                <button
                  type="button"
                  data-prev
                  aria-label="Previous photo"
                  class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-white z-20"
                >
                  <svg class="w-4 h-4 text-indigo-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                <button
                  type="button"
                  data-next
                  aria-label="Next photo"
                  class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-white z-20"
                >
                  <svg class="w-4 h-4 text-indigo-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>

                {/* Dot indicators */}
                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-20">
                  {images.map((_, i) => (
                    <button
                      type="button"
                      data-dot={i}
                      aria-label={`Photo ${i + 1}`}
                      class:list={[
                        'w-2 h-2 rounded-full transition-all duration-200',
                        i === 0 ? 'bg-white scale-110' : 'bg-white/50',
                      ]}
                    />
                  ))}
                </div>
              </>
            )}

            {/* Star badge overlay */}
            <div class="absolute top-3 left-3 z-10">
              <span class="inline-block px-2 py-0.5 rounded-full bg-white/90 backdrop-blur-sm text-yellow-500 text-xs tracking-wider font-medium">
                {stars}
              </span>
            </div>
          </div>

          {/* Hotel info */}
          <div class="flex flex-col flex-1 p-4 md:p-5">
            <h3 class="font-heading text-lg font-bold text-indigo-700 leading-tight mb-1.5">
              {hotelName}
            </h3>
            <p class="text-beige-600 text-sm leading-relaxed mb-3 line-clamp-2">
              {tagline}
            </p>

            {/* Feature chips */}
            <ul class="flex flex-wrap gap-1.5 mb-4">
              {features.map((feature) => (
                <li class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-turquoise-50 text-turquoise-700 text-[10px] leading-snug">
                  <svg class="w-2.5 h-2.5 text-turquoise-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            {/* CTA */}
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto inline-flex items-center text-turquoise-600 text-sm font-medium hover:text-turquoise-500 transition-colors self-start"
            >
              {ctaLabel[locale]}
              <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      )
    })}
  </div>
</section>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = carousel.querySelectorAll<HTMLImageElement>('[data-slide]')
    const dots = carousel.querySelectorAll<HTMLButtonElement>('[data-dot]')
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]')
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]')
    if (slides.length < 2) return

    let current = 0
    const total = slides.length

    function show(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index)
        s.classList.toggle('opacity-0', i !== index)
      })
      dots.forEach((d, i) => {
        d.classList.toggle('bg-white', i === index)
        d.classList.toggle('scale-110', i === index)
        d.classList.toggle('bg-white/50', i !== index)
      })
      current = index
    }

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      show((current - 1 + total) % total)
    })

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      show((current + 1) % total)
    })

    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        show(i)
      })
    })
  })
</script>
