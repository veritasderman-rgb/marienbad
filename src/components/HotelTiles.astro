---
import type { Locale } from '@/i18n/config'
import { hotels } from '@/data/hotels'
import { getHotelGallery } from '@/content/reader'
import { exelyBookingUrl } from '@/utils/booking'
import Pic from '@/components/Pic.astro'
import { ui } from '@/data/hotelUi'
import { hotelPhotos, heroPhoto, srcset } from '@/lib/hotelPhotos'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const hotelOrder = [
  'nove-lazne',
  'centralni-lazne',
  'hvezda',
  'pacifik',
  'butterfly',
  'vltava',
  'svoboda',
]

const t = ui[locale]

const orderedHotels = hotelOrder
  .map((slug) => {
    const hotel = hotels.find((h) => h.slug === slug)
    if (!hotel) return null
    const gallery = getHotelGallery(slug)
    return { ...hotel, gallery }
  })
  .filter(Boolean)

const sectionTitle: Record<string, string> = {
  de: 'Unsere Hotels in Marienbad',
  en: 'Our Hotels in Marienbad',
  cs: 'Naše hotely v Mariánských Lázních',
  ru: 'Наши отели в Марианских Лазнях',
}

const ctaLabel: Record<string, string> = {
  de: 'Verfügbarkeit prüfen',
  en: 'Check availability',
  cs: 'Zjistit dostupnost',
  ru: 'Проверить наличие',
}

const photosLabel: Record<string, string> = {
  de: 'Alle Fotos',
  en: 'All photos',
  cs: 'Všechny fotky',
  ru: 'Все фото',
}

const placeholder = '/images/hotels/placeholder.svg'
---

<section class="mb-12 md:mb-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8" style="font-size: var(--text-h2);">
    {sectionTitle[locale]}
  </h2>

  <div class="flex flex-col gap-8 md:gap-10">
    {orderedHotels.map((hotel) => {
      if (!hotel) return null
      const tagline = hotel.tagline[locale]
      const url = exelyBookingUrl({ hotelId: hotel.exelyHotelId, locale, utmMedium: 'hotel-tile', utmCampaign: hotel.slug })
      const stars = '★'.repeat(hotel.stars)
      const features = (hotel.features[locale] ?? hotel.features.de).slice(0, 4)
      const hotelName = hotel.name

      const detailUrl = `/${locale}/hotel/${hotel.slug}`

      // Mozaika 5 fotek: nová fotobanka (hero + čtyři z různých kategorií),
      // jinak fallback na starou Keystatic galerii a placeholder.
      const bank = hotelPhotos(hotel.slug)
      const cover = heroPhoto(hotel.slug)
      const bankTiles = cover
        ? [cover, ...bank.filter((p) => p.id !== cover.id && p.category !== cover.category).slice(0, 4)]
        : []
      const imgs = Array.from({ length: 5 }, (_, i) => {
        const b = bankTiles[i]
        if (b) return { src: `${b.base}-800.webp`, srcset: srcset(b), alt: hotelName }
        const g = hotel.gallery[i]
        return g ? { src: g.image!, srcset: undefined, alt: g.alt || hotelName } : { src: placeholder, srcset: undefined, alt: hotelName }
      })

      const galleryCount = bank.length || hotel.gallery.length
      const hasGallery = galleryCount > 1

      return (
        <article class="group relative overflow-hidden rounded-2xl bg-white border border-beige-200 transition-all duration-300 hover:shadow-xl hover:border-turquoise-300">
          <a href={detailUrl} class="absolute inset-0 z-10" aria-label={`${hotelName} — ${t.detail}`}></a>
          {/* Masonry photo grid */}
          <div class="grid grid-cols-4 grid-rows-2 gap-1 md:gap-1.5 h-56 sm:h-64 md:h-80 lg:h-96" data-lightbox>
            {/* Hero image — spans 2 cols + 2 rows */}
            <div class="col-span-2 row-span-2 relative overflow-hidden cursor-pointer" data-img={0}>
              {imgs[0].srcset ? (
                <img
                  src={imgs[0].src}
                  srcset={imgs[0].srcset}
                  sizes="(max-width: 768px) 50vw, 33vw"
                  alt={imgs[0].alt}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Pic
                  src={imgs[0].src}
                  alt={imgs[0].alt}
                  sizes="(max-width: 768px) 50vw, 33vw"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
            </div>
            {/* 4 smaller images */}
            {imgs.slice(1).map((img, i) => (
              <div class="relative overflow-hidden cursor-pointer" data-img={i + 1}>
                {img.srcset ? (
                  <img
                    src={img.src}
                    srcset={img.srcset}
                    sizes="(max-width: 768px) 25vw, 15vw"
                    alt={img.alt}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Pic
                    src={img.src}
                    alt={img.alt}
                    sizes="(max-width: 768px) 25vw, 15vw"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                )}
                {/* "All photos" overlay on last thumbnail */}
                {hasGallery && i === 3 && galleryCount > 5 && (
                  <div class="absolute inset-0 bg-indigo-900/55 flex items-center justify-center">
                    <span class="text-white text-xs font-medium text-center px-1">
                      {photosLabel[locale]} ({galleryCount})
                    </span>
                  </div>
                )}
              </div>
            ))}

            {/* Star badge */}
            <div class="absolute top-3 left-3 z-10">
              <span class="inline-block px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-sm text-yellow-500 text-xs tracking-wider font-semibold shadow-sm">
                {stars}
              </span>
            </div>
          </div>

          {/* Hotel info bar */}
          <div class="p-4 md:p-5 lg:p-6 flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-6">
            {/* Left: name + tagline */}
            <div class="flex-1 min-w-0">
              <h3 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 leading-tight mb-1">
                {hotelName}
              </h3>
              <p class="text-beige-600 text-sm leading-relaxed line-clamp-2 mb-3">
                {tagline}
              </p>
              <ul class="flex flex-wrap gap-1.5">
                {features.map((feature) => (
                  <li class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-turquoise-50 text-turquoise-700 text-[10px] leading-snug">
                    <svg class="w-2.5 h-2.5 text-turquoise-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            {/* Right: detail (vizuál — odkaz je přes celou kartu) + rezervace (vlastní odkaz nad ním) */}
            <div class="shrink-0 flex flex-col gap-2 self-start sm:self-center">
              <span class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-indigo-700 text-white text-sm font-semibold group-hover:bg-indigo-800 transition-colors shadow-sm">
                {t.detail}
                <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-20 inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-yellow-400 text-indigo-900 text-sm font-semibold hover:bg-yellow-300 transition-colors shadow-sm"
              >
                {ctaLabel[locale]}
                <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      )
    })}
  </div>
</section>
