---
import type { Locale } from '@/i18n/config'
import { hotels } from '@/data/hotels'
import { withUtm } from '@/utils/utm'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const hotelOrder = [
  'nove-lazne',
  'centralni-lazne',
  'hvezda',
  'pacifik',
  'butterfly',
  'vltava',
  'svoboda',
]

const orderedHotels = hotelOrder
  .map((slug) => hotels.find((h) => h.slug === slug))
  .filter(Boolean)

const sectionTitle: Record<string, string> = {
  de: 'Unsere Hotels in Marienbad',
  en: 'Our Hotels in Marienbad',
  cs: 'Naše hotely v Mariánských Lázních',
  ru: 'Наши отели в Марианских Лазнях',
}

const ctaLabel: Record<string, string> = {
  de: 'Hotel ansehen',
  en: 'View hotel',
  cs: 'Zobrazit hotel',
  ru: 'Смотреть отель',
}
---

<section class="mb-12 md:mb-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8" style="font-size: var(--text-h2);">
    {sectionTitle[locale]}
  </h2>

  <div class="flex flex-col gap-4 md:gap-5">
    {orderedHotels.map((hotel) => {
      if (!hotel) return null
      const tagline = hotel.tagline[locale]
      const url = withUtm(hotel.bookingUrls[locale], 'marienbad', 'hotel-tile', 'hotel-booking')
      const stars = '★'.repeat(hotel.stars)
      const features = (hotel.features[locale] ?? hotel.features.de).slice(0, 4)
      const hotelName = hotel.name.replace(' Ensana Health Spa Hotel', '')
      return (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-xl bg-white border border-beige-200 transition-all duration-300 hover:shadow-lg hover:border-turquoise-300"
        >
          {/* Accent line on hover */}
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-turquoise-400 to-turquoise-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10" />

          <div class="p-5 md:p-6 flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
            {/* Left: Hotel name, stars, tagline */}
            <div class="md:w-1/3 shrink-0">
              <span class="text-yellow-500 text-xs tracking-wider block mb-1">{stars}</span>
              <h3 class="font-heading text-lg md:text-xl font-bold text-indigo-700 leading-tight mb-2">
                {hotelName}
              </h3>
              <p class="text-beige-600 text-sm leading-relaxed">
                {tagline}
              </p>
            </div>

            {/* Right: USP features + CTA */}
            <div class="flex-1 flex flex-col justify-between">
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 mb-4">
                {features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-beige-700">
                    <svg class="w-4 h-4 mt-0.5 text-turquoise-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <span class="inline-flex items-center text-turquoise-600 text-sm font-medium group-hover:text-turquoise-500 transition-colors self-start">
                {ctaLabel[locale]}
                <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      )
    })}
  </div>
</section>
