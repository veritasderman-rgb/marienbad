---
import type { Locale } from '@/i18n/config'
import { routes } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { getArticles } from '@/content/reader'

interface Props {
  locale: string
  category?: string
  limit?: number
}

const { locale, category, limit = 3 } = Astro.props
const typedLocale = locale as Locale

const allArticles = await getArticles(typedLocale)
const filtered = category
  ? allArticles.filter((a) => a.category === category).slice(0, limit)
  : allArticles.slice(0, limit)

const magazineSlug = routes.magazine[typedLocale]

const sectionTitles: Record<Locale, string> = {
  de: 'Weitere Artikel',
  en: 'Related Articles',
  cs: 'Související články',
  ru: 'Похожие статьи',
}

const allArticlesLabels: Record<Locale, string> = {
  de: 'Alle Artikel',
  en: 'All Articles',
  cs: 'Všechny články',
  ru: 'Все статьи',
}

const categoryLabels: Record<string, Record<Locale, string>> = {
  health: { de: 'Gesundheit', en: 'Health', cs: 'Zdravi', ru: 'Здоровье' },
  culture: { de: 'Kultur', en: 'Culture', cs: 'Kultura', ru: 'Культура' },
  tip: { de: 'Tipp', en: 'Tip', cs: 'Tip', ru: 'Совет' },
  nature: { de: 'Natur', en: 'Nature', cs: 'Příroda', ru: 'Природа' },
  history: { de: 'Geschichte', en: 'History', cs: 'Historie', ru: 'История' },
  food: { de: 'Genuss', en: 'Food', cs: 'Jídlo', ru: 'Еда' },
}

const sectionTitle = sectionTitles[typedLocale]
const allArticlesLabel = allArticlesLabels[typedLocale]
---

{filtered.length > 0 && (
  <section class="mt-16 pt-12 border-t border-beige-300">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">{sectionTitle}</h2>
      <a href={`/${typedLocale}/${magazineSlug}`} class="text-turquoise-600 font-medium hover:underline text-sm">
        {allArticlesLabel} &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filtered.map((article) => {
        const articleSlug = article.slug.replace(/^[a-z]{2}-/, '')
        const href = `/${typedLocale}/${magazineSlug}/${articleSlug}`
        const categoryLabel = categoryLabels[article.category]?.[typedLocale] ?? article.category
        return (
          <a href={href} class="group bg-white rounded-xl overflow-hidden shadow-card card-hover block">
            {article.coverImage && (
              <div class="h-44 relative overflow-hidden">
                <img src={article.coverImage} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="p-5">
              <h3 class="font-heading text-xl font-bold text-indigo-700 mb-2 group-hover:text-turquoise-600 transition-colors">{article.title}</h3>
              <span class="text-beige-500 text-[0.6875rem] font-medium uppercase tracking-wider">{categoryLabel}</span>
              <p class="text-beige-700 text-sm leading-relaxed line-clamp-2">{article.excerpt}</p>
              <div class="mt-3 flex items-center justify-between text-beige-600 text-xs">
                <span>{article.readingTime}</span>
                <span class="text-turquoise-600 font-medium group-hover:underline">{t(typedLocale, 'common.readMore')}</span>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </section>
)}
