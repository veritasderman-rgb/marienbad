---
/**
 * Obsah stránky o ambulantním léčení. Záměrně bez cen — jen seznam procedur
 * a odkaz na spa recepci, kde je aktuální ceník.
 */
import type { Locale } from '@/i18n/config'
import { routes } from '@/i18n/config'
import { ui, SPA_EMAIL } from '@/data/outpatient'
import { hotelPhotos } from '@/lib/hotelPhotos'
import { srcset } from '@/lib/hotelPhotos'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = ui[locale]

// Ilustrační fotka z lázeňského oddělení Nových Lázní.
const hero = hotelPhotos('nove-lazne').find((p) => p.category === 'spa' && p.orientation === 'landscape')
---

<!-- Hero -->
<section class="relative bg-indigo-900 text-white">
  {hero && (
    <img
      src={`${hero.base}-1600.webp`}
      srcset={srcset(hero)}
      sizes="100vw"
      alt={t.h1}
      class="absolute inset-0 w-full h-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  )}
  <div class="relative container-wide py-16 md:py-24">
    <p class="text-turquoise-200 font-semibold tracking-wide uppercase text-sm mb-3">{t.eyebrow}</p>
    <h1 class="font-heading text-3xl md:text-5xl font-bold leading-tight max-w-3xl">{t.h1}</h1>
    <p class="mt-5 text-white/90 leading-relaxed max-w-2xl text-lg">{t.heroLead}</p>
  </div>
</section>

<!-- Jak se objednat -->
<section class="container-wide py-12 md:py-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">{t.stepsHeading}</h2>
  <p class="text-beige-700 leading-relaxed max-w-3xl mb-10">{t.stepsLead}</p>

  <ol class="grid gap-6 md:grid-cols-3">
    {t.steps.map((step, i) => (
      <li class="rounded-2xl border border-beige-300 bg-white p-6 flex flex-col">
        <span
          class="w-10 h-10 shrink-0 rounded-full bg-indigo-600 text-white font-bold grid place-items-center mb-4"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <h3 class="font-heading text-lg font-bold text-indigo-800 mb-2">{step.title}</h3>
        <p class="text-beige-800 leading-relaxed text-sm">{step.text}</p>
      </li>
    ))}
  </ol>

  <div class="mt-8 rounded-2xl bg-turquoise-50 border border-turquoise-200 p-6">
    <p class="text-sm text-beige-600 mb-1">{t.stepsHeading}</p>
    <a
      href={`mailto:${SPA_EMAIL}`}
      class="text-turquoise-700 hover:text-turquoise-800 font-semibold text-lg underline underline-offset-2 break-all"
    >
      {SPA_EMAIL}
    </a>
    {t.receptionHours && (
      <p class="mt-3 text-beige-800">
        <span class="font-semibold">{t.receptionHoursLabel}:</span> {t.receptionHours}
      </p>
    )}
  </div>
</section>

<!-- Co s sebou -->
<section class="bg-beige-100">
  <div class="container-wide py-12 md:py-16">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">{t.bringHeading}</h2>
    <p class="text-beige-700 leading-relaxed max-w-3xl mb-6">{t.bringLead}</p>
    <ul class="grid gap-3 sm:grid-cols-2 max-w-4xl">
      {t.bringItems.map((item) => (
        <li class="flex items-start gap-3 text-beige-900">
          <svg
            class="w-5 h-5 text-turquoise-500 shrink-0 mt-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Přehled procedur -->
<section class="container-wide py-12 md:py-16">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">{t.proceduresHeading}</h2>
  <p class="text-beige-700 leading-relaxed max-w-3xl mb-8">{t.proceduresLead}</p>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {t.groups.map((group) => (
      <article class="rounded-2xl border border-beige-300 bg-white p-6">
        <h3 class="font-heading text-lg font-bold text-indigo-800 mb-4 pb-3 border-b border-beige-200">
          {group.title}
        </h3>
        <ul class="space-y-2">
          {group.items.map((item) => (
            <li class="flex items-start gap-2.5 text-beige-800 text-sm leading-relaxed">
              <span class="w-1.5 h-1.5 rounded-full bg-turquoise-500 shrink-0 mt-2" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <aside class="mt-8 rounded-2xl bg-yellow-50 border-l-4 border-yellow-400 p-6 md:p-8">
    <h3 class="font-heading text-lg font-bold text-indigo-800 mb-2">{t.doctorOnlyHeading}</h3>
    <p class="text-beige-800 leading-relaxed mb-4 max-w-4xl">{t.doctorOnlyText}</p>
    <a
      href={`mailto:${SPA_EMAIL}`}
      class="text-turquoise-700 hover:text-turquoise-800 font-semibold underline underline-offset-2 break-all"
    >
      {SPA_EMAIL}
    </a>
  </aside>
</section>

<!-- Ceník + kontraindikace -->
<section class="bg-beige-100">
  <div class="container-wide py-12 md:py-16 grid gap-6 md:grid-cols-2">
    <aside class="rounded-2xl bg-white p-6 md:p-8 border-l-4 border-yellow-400">
      <h2 class="font-heading text-xl font-bold text-indigo-800 mb-3">{t.priceHeading}</h2>
      <p class="text-beige-800 leading-relaxed mb-5">{t.priceText}</p>
      <a
        href={`mailto:${SPA_EMAIL}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-yellow-400 text-indigo-900 rounded-lg font-semibold hover:bg-yellow-300 transition-colors"
      >
        {t.priceCta}
      </a>
    </aside>

    <aside class="rounded-2xl bg-white p-6 md:p-8 border-l-4 border-indigo-400">
      <h2 class="font-heading text-xl font-bold text-indigo-800 mb-3">{t.cautionHeading}</h2>
      <p class="text-beige-800 leading-relaxed mb-5">{t.cautionText}</p>
      <a
        href={`/${locale}/${routes.indications[locale]}`}
        class="inline-flex items-center gap-2 text-indigo-700 font-semibold underline underline-offset-2 hover:text-indigo-800"
      >
        {t.cautionCta}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </aside>
  </div>
</section>

<!-- Odkaz na Římské lázně -->
<section class="container-wide py-12 md:py-16">
  <aside class="rounded-2xl bg-indigo-800 text-white p-6 md:p-8">
    <h2 class="font-heading text-xl font-bold mb-2">{t.romanHeading}</h2>
    <p class="text-white/85 leading-relaxed mb-5 max-w-3xl">{t.romanText}</p>
    <a
      href={`/${locale}/${routes['roman-baths'][locale]}`}
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-indigo-800 rounded-lg font-semibold hover:bg-beige-100 transition-colors"
    >
      {t.romanCta}
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </aside>
</section>
