      'Mariánské Lázně jsou historické lázeňské město zapsané v rámci Slavných lázeňských měst Evropy na seznamu UNESCO, proslulé více než 100 minerálními prameny, přírodními CO₂ terapiemi a 200 lety lázeňské tradice. Sedm hotelů Ensana nabízí léčebné lázeňství, wellness i MICE zázemí, dvě hodiny od Prahy.',
    contactHeading: 'Spojte se s naším týmem',
    contactLead: 'Ceny, alotmenty, FAM tripy a skupinové nabídky. Odpovídáme česky, anglicky i německy.',
    contacts: [
      { label: 'Rezervace a skupiny', email: 'reservation.cz@ensanahotels.com', phone: '+420 354 655 501–9', phoneHref: '+420354655501' },
      { label: 'MICE a konference', email: 'conference.cz@ensanahotels.com', phone: '+420 354 655 505', phoneHref: '+420354655505' },
      { label: 'Obecné dotazy', email: 'marienbad@ensanahotels.com', phone: '+420 354 655 501–9', phoneHref: '+420354655501' },
    ],
    vcard: 'Uložit kontakt (vCard)',
    socialHeading: 'Kde nás najdete',
    aboutHeading: 'O nás',
    aboutCaption: 'Mariánské Lázně z výšky — kolonáda, Zpívající fontána a lázeňské parky.',
    aboutParagraphsHtml: [
      'Jsme <strong>Léčebné lázně Mariánské Lázně a.s.</strong>, součást mezinárodní lázeňské skupiny <strong>Ensana</strong> — jména spojujícího <em>„en“</em> (enhanced, posílené) a <em>„sana“</em> (zdraví). Lázeňská medicína je naše řemeslo: naším posláním je zlepšit zdraví hostů během pobytu spojením postupů moderní medicíny s osvědčenými lázeňskými procedurami z přírodních léčivých zdrojů.',
      'Mariánské Lázně jsou skutečně jedinečné. Jsme jediná destinace, která spojuje <strong>všechny přírodní léčivé zdroje na jednom místě</strong> — přírodní CO₂ plyn (vzácný suchý „Mariin plyn“), studenou minerální vodu přirozeně bohatou na CO₂, přírodní rašelinu (peloidy), statut <strong>klimatických lázní</strong> (od 2023) a zápis na seznam <strong>Světového dědictví UNESCO</strong> (2021, Slavná lázeňská města Evropy). Nikde jinde to všechno nenajdete vedle sebe.',
      'Naši destinaci tvoří <strong>sedm lázeňských hotelů</strong> — Nové Lázně, Centrální Lázně, Hvězda, Pacifik, Butterfly, Vltava a Svoboda — s celkem <strong>více než 900 pokoji</strong> a největším historickým balneoprovozem v České republice. Pro tagungy, incentivy a kongresy nabízí naše vlastní <strong>konferenční centrum deset sálů a jednacích místností</strong> pro akce každé velikosti, doplněné gastronomií a kompletním lázeňským zázemím pod jednou střechou.',
    ],
    viewOnlineHeading: 'Prohlédněte si podklady online',
    viewOnlineText: 'Chcete se napřed podívat? Všechna PDF o destinaci i hotelech si prohlédnete rovnou v prohlížeči — bez stahování.',
    viewOnlineCta: 'Zobrazit online',
    materialsHeading: 'Podklady a materiály',
    downloadsHeading: 'Centrum ke stažení',
    downloadsLead:
      'Všechny prezentace jsou PDF a můžete je volně použít ve svých kanálech. U každé položky uvádíme jazyk dokumentu — vždy tedy víte, kterou verzi dát kterému klientovi.',
    downloadAll: 'Stáhnout vše (ZIP · 44 MB)',
    downloadsCta: 'Otevřít centrum ke stažení',
    downloadsCount: '11 PDF dokumentů · EN · DE · CS',
    mediaHeading: 'Video a foto mediatéka',
    mediaText: 'Všechna oficiální videa a fotogalerie destinace a hotelů Ensana ke stažení — přehledně seskupené.',
    mediaCta: 'Otevřít mediatéku',
    hotelsHeading: 'Detailní listy hotelů',
    hotelsText: 'Podrobné listy všech sedmi hotelů Ensana: kapacity, lázeňský a léčebný profil, gastronomie, jednací prostory a přímé rezervační kontakty. V angličtině.',
    hotelsCta: 'Otevřít listy hotelů',
    hotelsHref: '/introduce/hotels',
    newsletterHeading: 'Archiv Ensana News',
    newsletterText: 'Všechna vydání partnerského newsletteru se shrnutími, štítky témat a vyhledáváním — tento odkaz otevře českou verzi; angličtina a němčina jsou na jedno kliknutí.',
    newsletterCta: 'Prohlédnout archiv',
    newsletterHref: '/introduce/newsletter-ck',
    stepsHeading: 'Přidejte si nás jako partnera ve třech krocích',
    steps: [
      { t: 'Stáhněte si podklady', d: 'Vyberte si prezentace a média v centru ke stažení.' },
      { t: 'Zaveďte nás do CRM', d: 'Zkopírujte firemní pole nebo importujte vCard — název, identifikátory a kontakty během vteřin.' },
      { t: 'Ozvěte se nám', d: 'Domluvte s naším týmem ceny, alotmenty, FAM tripy a skupinové nabídky na míru.' },
    ],
    partnershipCta: 'Zahájit spolupráci',
    partnershipMailto: 'mailto:reservation.cz@ensanahotels.com?subject=Z%C3%A1jem%20o%20spolupr%C3%A1ci%20—%20Mari%C3%A1nsk%C3%A9%20L%C3%A1zn%C4%9B',
    photoCaptions: ['Hlavní kolonáda', 'Zpívající fontána', 'Kolonáda Ferdinandova pramene', 'Kolonáda Rudolfova a Karolinina pramene', 'Lázeňský les'],
  },
}

const c = content[lang]

const facts = c.factLabels.map((label, i) => ({ label, value: factValues[i] }))
const copyAllText = [...facts.map((f) => `${f.label}: ${f.value}`), '', c.shortDescription].join('\n')

/** Přepínač jazyků této stránky (výchozí je EN na /introduce). */
const langSwitch: { code: Lang; label: string; href: string }[] = [
  { code: 'en', label: 'English', href: '/introduce' },
  { code: 'de', label: 'Deutsch', href: '/introduce/de' },
  { code: 'cs', label: 'Česky', href: '/introduce/cs' },
]

/** Lokalizované vstupy do centra ke stažení. */
const downloadsHref = { en: '/introduce/downloads', de: '/introduce/downloads/de', cs: '/introduce/downloads/cs' }[lang]

/** Náhledy prvních stran PDF pro koláž karty centra ke stažení. */
const THUMB = '/images/partners/pdf-thumbs'
const collageThumbs = [
  `${THUMB}/introduction-of-destination.jpg`,
  `${THUMB}/hotels-and-destination.jpg`,
  `${THUMB}/butterfly-flyer-en.jpg`,
]
---

<!-- Hero -->
<section class="relative bg-indigo-950 text-white overflow-hidden">
  <Pic
    src="/images/partners/roman-baths-hero.jpg"
    alt="The Roman Baths pool at Hotel Nové Lázně, Mariánské Lázně"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
    sizes="100vw"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-950/90 via-indigo-950/78 to-indigo-900/60"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.14)_0%,_transparent_60%)]"></div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-turquoise-400/30 to-transparent"></div>
  <div class="relative container-wide pt-24 pb-16 md:pt-28 md:pb-24">
    <!-- Přepínač jazyků stránky -->
    <div class="flex justify-end mb-6">
      <div class="inline-flex items-center gap-2">
        <span class="text-xs text-white/50 uppercase tracking-wider hidden sm:inline">{c.langSwitchLabel}</span>
        <div class="inline-flex rounded-full bg-white/10 border border-white/20 p-1">
          {langSwitch.map((l) => (
            <a
              href={l.href}
              aria-current={l.code === lang ? 'page' : undefined}
              class={`px-3.5 py-1.5 rounded-full text-sm font-semibold transition-colors ${
                l.code === lang ? 'bg-yellow-400 text-beige-950' : 'text-white/80 hover:text-white hover:bg-white/10'
              }`}>
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mb-8 flex justify-center">
      <img src="/images/partners/ensana-white.png" alt="Ensana" width="120" height="109" class="h-24 md:h-32 w-auto" />
    </div>
    <span class="inline-block px-3 py-1 bg-white/15 text-white text-xs font-semibold uppercase tracking-widest rounded-full mb-5">
      {c.heroBadge}
    </span>
    <h1 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight max-w-3xl" style="font-size: var(--text-h1);">
      {c.heroTitle}
    </h1>
    <p class="text-white/85 text-lg md:text-xl max-w-2xl leading-relaxed mb-8">{c.heroLead}</p>
    <div class="flex flex-wrap gap-3">
      <a href={partnerKit} download class="inline-flex items-center gap-2 px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-beige-950 font-semibold rounded-full transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={downloadIcon} /></svg>
        {c.heroKit}
      </a>
      <a href={downloadsHref} class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/25 text-white font-semibold rounded-full transition-colors">
        {c.heroBrowse}
      </a>
      <a href="#company" class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/25 text-white font-semibold rounded-full transition-colors">
        {c.heroCompany}
      </a>
    </div>
  </div>
</section>

<!-- Statistiky -->
<section class="bg-beige-100 py-14 md:py-20">
  <div class="container-wide">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-10 text-center">{c.statsHeading}</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
      {c.stats.map((s) => (
        <div class="bg-white rounded-xl shadow-card p-5 text-center">
          <p class="font-heading text-2xl md:text-3xl font-bold text-turquoise-700 mb-1">{s.value}</p>
          <p class="text-xs md:text-sm text-gray-600 leading-snug">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Firma v kostce -->
<section id="company" class="container-wide py-14 md:py-20 scroll-mt-24">
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-12">
    <div>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-2">{c.companyHeading}</h2>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="text-gray-600 max-w-xl">{c.companyLead}</p>
        <button type="button" class="copy-btn shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-semibold transition-colors" data-copy={copyAllText} data-copied={c.copied}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d={copyIcon} /></svg>
          <span class="copy-label">{c.copyAll}</span>
        </button>
      </div>
      <dl class="divide-y divide-beige-200 border-y border-beige-200">
        {facts.map((f) => (
          <div class="flex items-start gap-4 py-3">
            <dt class="w-40 shrink-0 text-xs font-semibold uppercase tracking-wider text-gray-400 pt-1">{f.label}</dt>
            <dd class="flex-1 text-gray-800 font-medium break-words">{f.value}</dd>
            <button type="button" class="copy-btn shrink-0 mt-0.5 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-beige-300 text-xs font-medium text-indigo-700 hover:bg-indigo-50 transition-colors" data-copy={f.value} data-copied={c.copied} aria-label={`${c.copy} ${f.label}`}>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d={copyIcon} /></svg>
              <span class="copy-label">{c.copy}</span>
            </button>
          </div>
        ))}
      </dl>

      <div class="mt-8 bg-beige-50 border border-beige-200 rounded-xl p-5">
        <div class="flex items-center justify-between gap-3 mb-2">
          <h3 class="font-heading text-sm font-bold text-indigo-800 uppercase tracking-wider">{c.descriptionHeading}</h3>
          <button type="button" class="copy-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-beige-300 text-xs font-medium text-indigo-700 hover:bg-indigo-50 transition-colors" data-copy={c.shortDescription} data-copied={c.copied}>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d={copyIcon} /></svg>
            <span class="copy-label">{c.copy}</span>
          </button>
        </div>
        <p class="text-sm text-gray-700 leading-relaxed">{c.shortDescription}</p>
      </div>
    </div>

    <!-- Kontaktní karta -->
    <aside class="mt-10 lg:mt-0">
      <div class="bg-indigo-700 text-white rounded-2xl shadow-card p-6 md:p-7 lg:sticky lg:top-24">
        <img src="/images/partners/ensana-white.png" alt="Ensana" width="56" height="51" class="h-12 w-auto mb-4 mx-auto" />
        <h3 class="font-heading text-lg font-bold mb-1">{c.contactHeading}</h3>
        <p class="text-white/70 text-sm mb-5">{c.contactLead}</p>
        <div class="space-y-4">
          {c.contacts.map((ct) => (
            <div class="border-t border-white/15 pt-3 first:border-0 first:pt-0">
              <p class="text-turquoise-300 text-xs font-semibold uppercase tracking-wider mb-1">{ct.label}</p>
              <a href={`mailto:${ct.email}`} class="block text-white hover:text-turquoise-200 text-sm font-medium break-all transition-colors">{ct.email}</a>
              <a href={`tel:${ct.phoneHref}`} class="block text-white/80 hover:text-white text-sm transition-colors">{ct.phone}</a>
            </div>
          ))}
        </div>
        <a href={`${PDF}/marienbad-tourism.vcf`} download class="mt-6 inline-flex items-center gap-2 w-full justify-center px-4 py-2.5 bg-yellow-400 hover:bg-yellow-300 text-beige-950 font-semibold rounded-full transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={downloadIcon} /></svg>
          {c.vcard}
        </a>

        <div class="mt-6 border-t border-white/15 pt-5">
          <p class="text-turquoise-300 text-xs font-semibold uppercase tracking-wider mb-3">{c.socialHeading}</p>
          <ul class="flex flex-wrap gap-2.5">
            {socials.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={channel.name}
                  title={channel.name}
                  class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                >
                  <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={channel.icon} /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- O nás -->
<section class="container-wide pt-10 md:pt-16 pb-4 md:pb-8">
  <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-6">{c.aboutHeading}</h2>
  <div class="lg:grid lg:grid-cols-[minmax(0,480px)_minmax(0,1fr)] lg:gap-10 xl:gap-12 items-start">
    <figure class="mb-8 lg:mb-0">
      <Pic src="/images/partners/colonnade-aerial.jpg" alt={c.aboutCaption} class="w-full rounded-2xl shadow-card object-cover" sizes="(max-width: 1024px) 100vw, 480px" />
      <figcaption class="text-xs text-gray-400 mt-2">{c.aboutCaption}</figcaption>
    </figure>
    <div class="space-y-4 text-gray-700 leading-relaxed">
      {c.aboutParagraphsHtml.map((p) => <p set:html={p} />)}
    </div>
  </div>

  <a href={viewOnline} target="_blank" rel="noopener" class="group mt-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-6 bg-white border border-turquoise-200 hover:border-turquoise-400 rounded-2xl p-6 md:p-7 shadow-card card-hover">
    <div class="shrink-0 w-12 h-12 rounded-xl bg-turquoise-50 text-turquoise-700 flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1 1 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178a1 1 0 010 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
    </div>
    <div class="flex-1">
      <h3 class="font-heading text-xl font-bold text-indigo-800 mb-1">{c.viewOnlineHeading}</h3>
      <p class="text-gray-600 text-sm leading-relaxed">{c.viewOnlineText}</p>
    </div>
    <span class="shrink-0 inline-flex items-center gap-2 text-turquoise-800 group-hover:text-turquoise-900 font-semibold text-sm">
      {c.viewOnlineCta}
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </span>
  </a>
</section>

<!-- Materiály: karta centra ke stažení + mediatéka, hotely, newslettery -->
<section id="downloads" class="bg-beige-100 py-14 md:py-20 scroll-mt-20">
  <div class="container-wide">
    <div class="max-w-2xl mb-10">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">{c.materialsHeading}</h2>
      <p class="text-gray-600">{c.downloadsLead}</p>
    </div>

    <!-- Centrum ke stažení — koláž náhledů PDF + vstup na podstránku -->
    <div class="bg-white rounded-2xl shadow-card overflow-hidden md:grid md:grid-cols-[minmax(0,440px)_minmax(0,1fr)]">
      <a href={downloadsHref} class="relative block bg-indigo-800/[0.04] p-6 md:p-8" aria-hidden="true" tabindex="-1">
        <div class="relative h-56 md:h-full md:min-h-[16rem]">
          <div class="absolute left-0 top-2 w-[62%] -rotate-3 rounded-lg overflow-hidden shadow-lg border border-black/5">
            <Pic src={collageThumbs[0]} alt="" class="w-full h-auto" sizes="280px" />
          </div>
          <div class="absolute right-0 top-10 w-[52%] rotate-2 rounded-lg overflow-hidden shadow-lg border border-black/5">
            <Pic src={collageThumbs[1]} alt="" class="w-full h-auto" sizes="240px" />
          </div>
          <div class="absolute left-[28%] bottom-0 w-[34%] rotate-1 rounded-lg overflow-hidden shadow-xl border border-black/5">
            <Pic src={collageThumbs[2]} alt="" class="w-full h-auto" sizes="160px" />
          </div>
        </div>
      </a>
      <div class="p-6 md:p-8 flex flex-col justify-center">
        <h3 class="font-heading text-xl md:text-2xl font-bold text-indigo-900 mb-2">
          <a href={downloadsHref} class="hover:text-turquoise-800 transition-colors">{c.downloadsHeading}</a>
        </h3>
        <p class="text-sm font-semibold text-turquoise-700 uppercase tracking-wider mb-3">{c.downloadsCount}</p>
        <div class="flex flex-wrap gap-3 mt-2">
          <a href={downloadsHref} class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-700 hover:bg-indigo-800 text-white font-semibold rounded-full transition-colors">
            {c.downloadsCta}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href={partnerKit} download class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-indigo-200 hover:border-indigo-400 text-indigo-800 font-semibold rounded-full transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={downloadIcon} /></svg>
            {c.downloadAll}
          </a>
        </div>
      </div>
    </div>

    <!-- Mediatéka + listy hotelů + archiv newsletterů — karty s fotkou -->
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href={mediaHref} class="group bg-white rounded-2xl shadow-card overflow-hidden card-hover flex flex-col">
        <div class="relative aspect-[16/9] overflow-hidden">
          <Pic src="/images/library/colonnade/main-colonnade-16a4646.jpg" alt="" class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-300" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
          <span class="absolute bottom-2.5 left-2.5 inline-flex items-center justify-center w-9 h-9 rounded-full bg-indigo-950/70 text-white backdrop-blur-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <h3 class="font-heading text-lg font-bold text-indigo-900 group-hover:text-turquoise-800 transition-colors mb-1">{c.mediaHeading}</h3>
          <p class="text-gray-600 text-sm leading-relaxed flex-1">{c.mediaText}</p>
