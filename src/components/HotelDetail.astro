        </a>
      )}
    </div>
  </div>
</section>

<!-- ============ DALŠÍ HOTELY ============ -->
<section class="container-wide py-14 md:py-20">
  <div class="flex items-baseline justify-between gap-4 mb-8">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">{t.otherHotels}</h2>
    <a href={accommodationUrl} class="text-sm text-turquoise-700 hover:underline shrink-0">{t.backToAccommodation}</a>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {others.map((h) => {
      const cover = heroPhoto(h.slug)
      return (
        <a href={`/${locale}/hotel/${h.slug}`} class="group rounded-2xl overflow-hidden border border-beige-200 bg-white block">
          <div class="aspect-[16/10] overflow-hidden bg-beige-100">
            {cover && (
              <img
                src={`${cover.base}-800.webp`}
                srcset={srcset(cover)}
                sizes="(max-width: 640px) 100vw, 33vw"
                alt={h.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="p-4">
            <span class="text-yellow-500 text-xs tracking-widest">{'★'.repeat(h.stars)}</span>
            <h3 class="font-heading text-lg font-bold text-indigo-700 leading-snug mt-1 mb-1">{h.name}</h3>
            <p class="text-sm text-beige-600 line-clamp-2">{h.tagline[locale]}</p>
          </div>
        </a>
      )
    })}
  </div>
</section>
