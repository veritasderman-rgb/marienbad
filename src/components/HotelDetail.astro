---
/**
 * Hotelová podstránka — velká fotogalerie v booking stylu nahoře a pod ní
 * postupně odvyprávěný hotel (pokoje, wellness, léčba, gastronomie, praktické
 * info), zakončený rezervačním blokem. Rezervace vždy vede do oficiálního
 * systému Ensana (bookings.ensanahotels.com), nikam jinam.
 */
import type { Locale } from '@/i18n/config'
import { hotels, type Hotel } from '@/data/hotels'
import { detailsOf } from '@/data/hotelDetails'
import {
  ui,
  amenityLabels,
  facilityLabels,
  diningLabels,
  indicationLabels,
  springLabels,
  parkingLabels,
  categoryLabels,
  currency,
  perDay,
  perNight,
  fromFiveNights,
  inHotelNote,
} from '@/data/hotelUi'
import { hotelPhotos, photosOf, firstAvailable, heroPhoto, srcset, displaySize, type PhotoCategory } from '@/lib/hotelPhotos'
import { exelyBookingUrl } from '@/utils/booking'
import HotelGallery from '@/components/HotelGallery.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { t as tr } from '@/i18n/ui'
import { routes } from '@/i18n/config'

interface Props {
  locale: Locale
  hotel: Hotel
}

const { locale, hotel } = Astro.props
const t = ui[locale]
const d = detailsOf(hotel.slug)
const all = hotelPhotos(hotel.slug)
const hero = heroPhoto(hotel.slug)
const heroSize = hero ? displaySize(hero) : { width: 1600, height: 1067 }

const description = hotel.description[locale] ?? hotel.description.en
const features = hotel.features[locale] ?? hotel.features.en
const treatments = hotel.treatments[locale] ?? hotel.treatments.en
const tagline = hotel.tagline[locale]

const bookUrl = (medium: string) =>
  exelyBookingUrl({ hotelId: hotel.exelyHotelId, locale, utmMedium: medium, utmCampaign: hotel.slug })

const accommodationUrl = `/${locale}/${routes.accommodation[locale]}`
const others = hotels.filter((h) => h.slug !== hotel.slug)

const paragraphs = description.split('\n\n').filter(Boolean)

/** Pruh fotek jedné kategorie; index v `all` slouží lightboxu. */
const strip = (cats: PhotoCategory[], limit = 6) => firstAvailable(hotel.slug, cats, limit)
const roomShots = strip(['rooms'], 8)
const poolShots = strip(['pool'], 6)
const spaShots = strip(['spa'], 6)
const diningShots = strip(['dining'], 6)
const miceShots = strip(['mice', 'interior'], 4)

const sections = [
  { id: 'overview', label: t.overview },
  { id: 'gallery', label: t.gallery },
  ...(d && d.roomTypes.length ? [{ id: 'rooms', label: t.rooms }] : []),
  ...(d && d.wellness.length ? [{ id: 'wellness', label: t.wellness }] : []),
  { id: 'treatments', label: t.treatments },
  ...(d && d.dining.length ? [{ id: 'dining', label: t.dining }] : []),
  ...(d?.meetings?.length ? [{ id: 'mice', label: t.mice }] : []),
  { id: 'practical', label: t.practical },
]

const cur = currency[locale]
function priceLine(priceCzk?: number, priceLong?: number) {
  if (!priceCzk) return ''
  const base = `${priceCzk} ${cur} ${perDay[locale]}`
  return priceLong ? `${base} · ${fromFiveNights[locale]} ${priceLong} ${cur}` : base
}
---

<!-- ============ HERO ============ -->
<section class="relative h-[62vh] min-h-[420px] md:h-[76vh] flex items-end overflow-hidden">
  {hero ? (
    <img
      src={`${hero.base}-1600.webp`}
      srcset={srcset(hero)}
      sizes="100vw"
      width={heroSize.width}
      height={heroSize.height}
      alt={hotel.name}
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-700 to-indigo-900"></div>
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/85 via-indigo-950/25 to-indigo-950/45"></div>

  <div class="relative container-wide w-full pb-10 md:pb-14 pt-28 text-white">
    <Breadcrumbs
      items={[
        { label: tr(locale, 'nav.home'), href: `/${locale}` },
        { label: tr(locale, 'nav.accommodation'), href: accommodationUrl },
        { label: hotel.name },
      ]}
      locale={locale}
    />
    <div class="flex items-center gap-3 mb-3 mt-4">
      <span class="text-yellow-400 tracking-widest text-lg">{'★'.repeat(hotel.stars)}</span>
      <span class="text-white/80 text-sm">{t.stars(hotel.stars)}</span>
    </div>
    <h1 class="font-heading font-bold leading-tight mb-4" style="font-size: var(--text-h1);">{hotel.name}</h1>
    <p class="text-white/90 text-lg md:text-xl max-w-3xl leading-relaxed mb-7">{tagline}</p>
    <div class="flex flex-wrap gap-3">
      <a
        href={bookUrl('hotel-hero')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-yellow-400 text-indigo-900 font-semibold hover:bg-yellow-300 transition-colors shadow-lg"
      >
        {t.checkAvailability}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M21 12H3" />
        </svg>
      </a>
      {all.length > 0 && (
        <a
          href="#gallery"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-white/15 backdrop-blur-sm text-white font-semibold hover:bg-white/25 transition-colors"
        >
          {t.allPhotos(all.length)}
        </a>
      )}
    </div>
  </div>
</section>

<!-- ============ KOTVY SEKCÍ ============ -->
<nav class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-beige-200">
  <div class="container-wide overflow-x-auto">
    <ul class="flex gap-1 min-w-max py-2">
      {sections.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            class="inline-block px-4 py-2 rounded-full text-sm text-beige-700 hover:bg-turquoise-50 hover:text-turquoise-800 transition-colors whitespace-nowrap"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<!-- ============ PŘEHLED ============ -->
<section id="overview" class="container-wide py-12 md:py-16 scroll-mt-20">
  <div class="grid lg:grid-cols-[minmax(0,1fr)_360px] gap-10 lg:gap-14">
    <div>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{t.overview}</h2>
      <div class="prose-marienbad max-w-none">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="font-heading text-xl font-bold text-indigo-700 mt-10 mb-5">{t.highlights}</h3>
      <ul class="grid sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <li class="flex items-start gap-3 text-beige-800">
            <svg class="w-5 h-5 text-turquoise-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="lg:sticky lg:top-20 self-start bg-beige-100 rounded-2xl p-6 border border-beige-200">
      <dl class="space-y-3 text-sm">
        {d && (
          <div class="flex justify-between gap-4">
            <dt class="text-beige-600">{t.roomsCount}</dt>
            <dd class="font-semibold text-indigo-700">{d.rooms}</dd>
          </div>
        )}
        {d && (
          <div class="flex justify-between gap-4">
            <dt class="text-beige-600">{t.bedsCount}</dt>
            <dd class="font-semibold text-indigo-700">{d.beds}</dd>
          </div>
        )}
        <div class="flex justify-between gap-4">
          <dt class="text-beige-600">{t.built}</dt>
          <dd class="font-semibold text-indigo-700">{hotel.yearBuilt}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-beige-600">{t.style}</dt>
          <dd class="font-semibold text-indigo-700 text-right">{hotel.style[locale]}</dd>
        </div>
        {d && (
          <div class="flex justify-between gap-4">
            <dt class="text-beige-600">{t.checkIn} / {t.checkOut}</dt>
            <dd class="font-semibold text-indigo-700">{d.checkIn} / {d.checkOut}</dd>
          </div>
        )}
        <div class="pt-3 border-t border-beige-300">
          <dt class="text-beige-600 mb-1">{t.address}</dt>
          <dd class="text-indigo-800">{hotel.address.replace(', Czech Republic', '')}</dd>
        </div>
        {d?.email && (
          <div>
            <dd><a href={`mailto:${d.email}`} class="text-turquoise-700 hover:underline break-all">{d.email}</a></dd>
          </div>
        )}
        {d?.reservationPhone && (
          <div>
            <dd><a href={`tel:${d.reservationPhone.replace(/\s/g, '')}`} class="text-turquoise-700 hover:underline">{d.reservationPhone}</a></dd>
          </div>
        )}
      </dl>
      <a
        href={bookUrl('hotel-sidebar')}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-indigo-700 text-white font-semibold hover:bg-indigo-800 transition-colors"
      >
        {t.book}
      </a>
      {d?.buildings && (
        <ul class="mt-5 pt-4 border-t border-beige-300 space-y-1.5 text-xs text-beige-700">
          {d.buildings.map((b) => (
            <li class="flex justify-between gap-3">
              <span>{b.name}</span>
              <span class="text-beige-500">{b.rooms}×</span>
            </li>
          ))}
        </ul>
      )}
    </aside>
  </div>
</section>

<!-- ============ GALERIE ============ -->
<div class="container-wide pb-4 md:pb-8">
  <HotelGallery locale={locale} slug={hotel.slug} hotelName={hotel.name} />
</div>

<!-- ============ POKOJE ============ -->
{d && d.roomTypes.length > 0 && (
  <section id="rooms" class="bg-beige-50 py-14 md:py-20 scroll-mt-20">
    <div class="container-wide">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">{t.rooms}</h2>

      {roomShots.length > 0 && (
        <div class="flex gap-3 overflow-x-auto pb-4 mb-10 -mx-4 px-4 snap-x">
          {roomShots.map((p) => (
            <button
              type="button"
              data-gallery-open={all.indexOf(p)}
              class="shrink-0 w-64 md:w-80 aspect-[4/3] rounded-xl overflow-hidden snap-start cursor-zoom-in group"
            >
              <img
                src={`${p.base}-800.webp`}
                srcset={srcset(p)}
                sizes="320px"
                alt={`${hotel.name} — ${categoryLabels[locale].rooms}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {d.roomTypes.map((rt) => (
          <article class="bg-white rounded-xl border border-beige-200 p-5 flex flex-col">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="font-heading text-lg font-bold text-indigo-700 leading-snug">{rt.name}</h3>
              {rt.count && <span class="shrink-0 text-xs px-2 py-0.5 rounded-full bg-turquoise-50 text-turquoise-800">{rt.count}×</span>}
            </div>
            {rt.size && <p class="text-sm text-beige-600 mb-3">{rt.size}</p>}
            <ul class="flex flex-wrap gap-1.5 mt-auto">
              {rt.amenities.map((a) => (
                <li class="text-[11px] leading-snug px-2 py-0.5 rounded-full bg-beige-100 text-beige-700">
                  {amenityLabels[locale][a]}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="mt-8">
        <a
          href={bookUrl('hotel-rooms')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-yellow-400 text-indigo-900 font-semibold hover:bg-yellow-300 transition-colors"
        >
          {t.reserveRoom}
        </a>
      </div>
    </div>
  </section>
)}

<!-- ============ WELLNESS ============ -->
{d && d.wellness.length > 0 && (
  <section id="wellness" class="container-wide py-14 md:py-20 scroll-mt-20">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">{t.wellness}</h2>
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <ul class="space-y-3">
        {d.wellness.map((f) => (
          <li class="flex items-start gap-3 pb-3 border-b border-beige-200 last:border-0">
            <svg class="w-5 h-5 text-turquoise-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 10c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
            </svg>
            <div>
              <p class="font-semibold text-indigo-700">{facilityLabels[locale][f.kind]}</p>
              <p class="text-sm text-beige-600">
                {[f.detail, f.hours ? `${t.hours} ${f.hours}` : null, f.inHotel ? inHotelNote[locale](f.inHotel) : null]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>
      {poolShots.length > 0 && (
        <div class="grid grid-cols-2 gap-3">
          {poolShots.slice(0, 3).map((p, i) => (
            <button
              type="button"
              data-gallery-open={all.indexOf(p)}
              class={`rounded-xl overflow-hidden cursor-zoom-in group ${i === 0 ? 'col-span-2 aspect-[16/9]' : 'aspect-[4/3]'}`}
            >
              <img
                src={`${p.base}-800.webp`}
                srcset={srcset(p)}
                sizes="(max-width: 1024px) 50vw, 25vw"
                alt={`${hotel.name} — ${categoryLabels[locale].pool}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}
    </div>

    {/* Římské lázně má jen Nové Lázně — odkaz se ukáže podle dat, ne natvrdo podle slugu. */}
    {d.wellness.some((f) => f.kind === 'roman-bath') && (
      <a
        href={`/${locale}/${routes['roman-baths'][locale]}`}
        class="mt-8 inline-flex items-center gap-2 text-turquoise-700 hover:text-turquoise-800 font-semibold underline underline-offset-2"
      >
        {t.romanBathsLink}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    )}
  </section>
)}

<!-- ============ LÉČBA A PROCEDURY ============ -->
<section id="treatments" class="bg-indigo-700 text-white py-14 md:py-20 scroll-mt-20">
  <div class="container-wide">
    <h2 class="font-heading text-2xl md:text-3xl font-bold mb-8">{t.treatments}</h2>
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10">
      <div>
        {d?.spring && (
          <div class="mb-6">
            <p class="text-turquoise-300 text-xs uppercase tracking-wider mb-1">{t.spring}</p>
            <p class="font-heading text-xl font-bold">{springLabels[locale][d.spring]}</p>
          </div>
        )}
        {d?.mineralBaths && (
          <div class="mb-6">
            <p class="text-turquoise-300 text-xs uppercase tracking-wider mb-1">{t.mineralBaths}</p>
            <p class="font-heading text-xl font-bold">
              {d.mineralBaths} {t.cabins}{d.historicCabins ? ' · 1896' : ''}
            </p>
          </div>
        )}
        {d && (
          <div class="mb-6">
            <p class="text-turquoise-300 text-xs uppercase tracking-wider mb-2">{t.indications}</p>
            <ul class="flex flex-wrap gap-1.5">
              {d.indications.map((i) => (
                <li class="text-xs px-2.5 py-1 rounded-full bg-white/10">{indicationLabels[locale][i]}</li>
              ))}
            </ul>
          </div>
        )}
        <div>
          <p class="text-turquoise-300 text-xs uppercase tracking-wider mb-2">{t.treatmentList}</p>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm text-white/90">
            {treatments.map((tt) => (
              <li class="flex items-start gap-2">
                <span class="text-turquoise-300 mt-1.5 w-1 h-1 rounded-full bg-turquoise-300 shrink-0"></span>
                <span>{tt}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {spaShots.length > 0 && (
        <div class="grid grid-cols-2 gap-3 self-start">
          {spaShots.slice(0, 4).map((p) => (
            <button
              type="button"
              data-gallery-open={all.indexOf(p)}
              class="aspect-[4/3] rounded-xl overflow-hidden cursor-zoom-in group"
            >
              <img
                src={`${p.base}-800.webp`}
                srcset={srcset(p)}
                sizes="(max-width: 1024px) 50vw, 25vw"
                alt={`${hotel.name} — ${categoryLabels[locale].spa}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}
    </div>

    <aside class="mt-10 rounded-xl bg-white/10 border border-white/20 p-5 flex flex-wrap items-center justify-between gap-4">
      <p class="text-white/90">{t.outpatientLink}</p>
      <a
        href={`/${locale}/${routes.outpatient[locale]}`}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-indigo-700 rounded-lg font-semibold hover:bg-beige-100 transition-colors"
      >
        {t.outpatientCta}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </aside>
  </div>
</section>

<!-- ============ GASTRONOMIE ============ -->
{d && d.dining.length > 0 && (
  <section id="dining" class="container-wide py-14 md:py-20 scroll-mt-20">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">{t.dining}</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {d.dining.map((venue, i) => {
        const shot = diningShots[i]
        return (
          <article class="rounded-2xl overflow-hidden border border-beige-200 bg-white flex flex-col">
            {shot && (
              <button
                type="button"
                data-gallery-open={all.indexOf(shot)}
                class="aspect-[3/2] overflow-hidden cursor-zoom-in group"
              >
                <img
                  src={`${shot.base}-800.webp`}
                  srcset={srcset(shot)}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  alt={`${hotel.name} — ${categoryLabels[locale].dining}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            )}
            <div class="p-5">
              <p class="text-xs uppercase tracking-wider text-turquoise-700 mb-1">{diningLabels[locale][venue.kind]}</p>
              <h3 class="font-heading text-lg font-bold text-indigo-700 mb-2">{venue.name}</h3>
              {venue.hours && <p class="text-sm text-beige-600">{venue.hours}</p>}
              {venue.seats && <p class="text-sm text-beige-500 mt-1">{venue.seats} {t.seats}</p>}
            </div>
          </article>
        )
      })}
    </div>
  </section>
)}

<!-- ============ KONFERENCE ============ -->
{d?.meetings?.length && (
  <section id="mice" class="bg-beige-50 py-14 md:py-20 scroll-mt-20">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{t.mice}</h2>
        <ul class="space-y-4">
          {d.meetings.map((m) => (
            <li class="bg-white rounded-xl border border-beige-200 p-5">
              <h3 class="font-heading text-lg font-bold text-indigo-700 mb-1">{m.name}</h3>
              <p class="text-sm text-beige-600">
                {[m.area, m.capacity ? `max. ${m.capacity} ${t.persons}` : null].filter(Boolean).join(' · ')}
              </p>
            </li>
          ))}
        </ul>
      </div>
      {miceShots.length > 0 && (
        <div class="grid grid-cols-2 gap-3">
          {miceShots.slice(0, 4).map((p) => (
            <button
              type="button"
              data-gallery-open={all.indexOf(p)}
              class="aspect-[4/3] rounded-xl overflow-hidden cursor-zoom-in group"
            >
              <img
                src={`${p.base}-800.webp`}
                srcset={srcset(p)}
                sizes="(max-width: 1024px) 50vw, 25vw"
                alt={`${hotel.name} — ${categoryLabels[locale].mice}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<!-- ============ PRAKTICKÉ INFORMACE ============ -->
{d && (
  <section id="practical" class="container-wide py-14 md:py-20 scroll-mt-20">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">{t.practical}</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 text-sm">
      <div class="bg-beige-50 rounded-xl p-5 border border-beige-200">
        <h3 class="font-semibold text-indigo-700 mb-3">{t.parking}</h3>
        <ul class="space-y-2 text-beige-700">
          {d.parking.map((p) => (
            <li>
              {parkingLabels[locale][p.kind]}
              {p.spaces ? ` (${p.spaces}×)` : ''}
              {p.priceCzk ? ` — ${priceLine(p.priceCzk, p.priceCzkLongStay)}` : ''}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-beige-50 rounded-xl p-5 border border-beige-200">
        <h3 class="font-semibold text-indigo-700 mb-3">{t.checkIn} / {t.checkOut}</h3>
        <p class="text-beige-700">{d.checkIn} / {d.checkOut}</p>
        <p class="text-beige-700 mt-2">{t.wifi}</p>
        <p class="text-beige-700 mt-2">{t.spaTax}</p>
      </div>
      <div class="bg-beige-50 rounded-xl p-5 border border-beige-200">
        <h3 class="font-semibold text-indigo-700 mb-3">{t.pets}</h3>
        <p class="text-beige-700">
          {d.petsAllowed ? t.petsYes : t.petsNo}
          {d.petsAllowed && d.petFeeCzk ? ` — ${d.petFeeCzk} ${cur} ${perNight[locale]}` : ''}
        </p>
      </div>
    </div>
  </section>
)}

<!-- ============ REZERVACE ============ -->
<section class="relative py-16 md:py-24 overflow-hidden">
  {all[1] && (
    <img
      src={`${all[1].base}-1600.webp`}
      srcset={srcset(all[1])}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="absolute inset-0 bg-indigo-950/80"></div>
  <div class="relative container-wide text-center text-white max-w-2xl mx-auto">
    <h2 class="font-heading text-2xl md:text-4xl font-bold mb-4">{t.book}</h2>
    <p class="text-white/80 mb-8 leading-relaxed">{t.bookingNote}</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href={bookUrl('hotel-cta')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-yellow-400 text-indigo-900 font-semibold hover:bg-yellow-300 transition-colors shadow-lg"
      >
        {t.checkAvailability}
      </a>
      {d?.email && (
        <a
          href={`mailto:${d.email}`}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-white/15 backdrop-blur-sm text-white font-semibold hover:bg-white/25 transition-colors"
        >
