      {
        group: 'Prezentace destinace',
        items: [
          { title: 'Představení destinace', desc: 'Kompletní vizuální prezentace Mariánských Lázní pro partnery a CK.', file: 'introduction-of-destination.pdf', size: '9.6 MB', doc: 'EN' },
          { title: 'Proč Mariánské Lázně', desc: 'Hlavní prodejní argumenty — důvody, proč poslat klienty do Mariánek.', file: 'why-marianske-lazne.pdf', size: '3.7 MB', doc: 'EN' },
          { title: 'Dvoustránkový přehled destinace', desc: 'Stručný souhrn — ideální jako rychlý hand-out nebo příloha e-mailu.', file: 'marianske-lazne-2-page-info.pdf', size: '1.0 MB', doc: 'EN' },
        ],
