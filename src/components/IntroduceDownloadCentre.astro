---
/**
 * Centrum ke stažení pro CK — /introduce/downloads (EN výchozí),
 * /introduce/downloads/de a /introduce/downloads/cs.
 *
 * Vyčleněno z hlavní stránky /introduce, aby hub zůstal přehledný. Každá
 * položka nese náhled první strany PDF (public/images/partners/pdf-thumbs)
 * a štítek s jazykem dokumentu; partner v každé mutaci vidí všechny materiály.
 */
import Pic from '@/components/Pic.astro'

type Lang = 'en' | 'de' | 'cs'

// Meta + jazykové URL pro tenké stránky (exporty se hoistují do module scope,
// proto jen literály).
export const downloadCentreMeta = {
  en: {
    title: 'Download Centre — Marienbad Partner Materials',
    description:
      'All official Mariánské Lázně partner PDFs in one place: destination and hotel presentations, spa, springs and MICE materials and the Butterfly flyers — each labelled with its document language.',
  },
  de: {
    title: 'Download-Center — Marienbad-Partnerunterlagen',
    description:
      'Alle offiziellen Partner-PDFs zu Marienbad an einem Ort: Destinations- und Hotelpräsentationen, Kur-, Quellen- und MICE-Unterlagen und die Butterfly-Flyer — jeweils mit Sprachetikett des Dokuments.',
  },
  cs: {
    title: 'Centrum ke stažení — partnerské podklady Mariánské Lázně',
    description:
      'Všechna oficiální partnerská PDF o Mariánských Lázních na jednom místě: prezentace destinace a hotelů, podklady o lázních, pramenech a MICE a letáky Butterfly — u každého je vyznačen jazyk dokumentu.',
  },
}

export const downloadCentreAlternates = {
  en: '/introduce/downloads',
  de: '/introduce/downloads/de',
  cs: '/introduce/downloads/cs',
}

export const downloadCentreSwitcher = {
  ...downloadCentreAlternates,
  ru: '/introduce/downloads',
}

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const PDF = '/partners'
const THUMB = '/images/partners/pdf-thumbs'
const partnerKit = '/partners/marienbad-partner-kit.zip'
const viewOnline = 'https://vps113733.cloud-anywhere.eu/index.php/s/jDQABzYkcRBFKH7'

const downloadIcon = 'M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2'

/** Jazyk dokumentu (štítek u položek ke stažení). */
type DocLang = 'EN' | 'DE' | 'CS'

interface Material {
  title: string
  desc: string
  file: string
  size: string
  doc: DocLang
}

const flyerItems = (t: (l: DocLang) => string, d: string): Material[] => [
  { title: t('CS'), desc: d, file: 'butterfly-flyer-cs.pdf', size: '4.7 MB', doc: 'CS' },
  { title: t('EN'), desc: d, file: 'butterfly-flyer-en.pdf', size: '4.7 MB', doc: 'EN' },
  { title: t('DE'), desc: d, file: 'butterfly-flyer-de.pdf', size: '4.7 MB', doc: 'DE' },
]

interface Content {
  eyebrow: string
  title: string
  lead: string
  downloadAll: string
  backHub: string
  langSwitchLabel: string
  viewOnlineHeading: string
  viewOnlineText: string
  viewOnlineCta: string
  docLangBadge: Record<DocLang, string>
  groups: { group: string; note?: string; items: Material[] }[]
}

const content: Record<Lang, Content> = {
  en: {
    eyebrow: 'Partner materials',
    title: 'Download centre',
    lead: 'All presentations are PDFs, free to use in your own channels. Each item is labelled with the language of the document, so you always know which version to hand to which client.',
    downloadAll: 'Download all (ZIP · 44 MB)',
    backHub: '← Partner hub',
    langSwitchLabel: 'This page in your language',
    viewOnlineHeading: 'Browse everything online',
    viewOnlineText: 'Prefer to look before you save? View all PDFs directly in your browser — no download required.',
    viewOnlineCta: 'View online',
    docLangBadge: { EN: 'In English', DE: 'In German', CS: 'In Czech' },
    groups: [
      {
        group: 'Destination presentations',
        items: [
          { title: 'Introduction of the destination', desc: 'Full visual presentation of Mariánské Lázně for partners and agencies.', file: 'introduction-of-destination.pdf', size: '9.6 MB', doc: 'EN' },
          { title: 'Why Mariánské Lázně', desc: 'The key selling points — reasons to send your clients to Marienbad.', file: 'why-marianske-lazne.pdf', size: '3.7 MB', doc: 'EN' },
          { title: 'Two-page destination fact sheet', desc: 'A concise overview — ideal as a quick hand-out or e-mail attachment.', file: 'marianske-lazne-2-page-info.pdf', size: '1.0 MB', doc: 'EN' },
        ],
      },
      {
        group: 'Hotels, spa & product',
        items: [
          { title: 'Hotels & destination introduction', desc: 'The seven Ensana spa hotels and what each of them offers.', file: 'hotels-and-destination.pdf', size: '11.1 MB', doc: 'EN' },
          { title: 'Spa treatment', desc: 'Medical spa programmes, therapies and treatment overview.', file: 'spa-treatment.pdf', size: '1.2 MB', doc: 'EN' },
          { title: 'Mineral springs', desc: 'The famous springs of Marienbad and how they are used.', file: 'mineral-springs.pdf', size: '1.7 MB', doc: 'EN' },
          { title: 'MICE — meetings & events', desc: 'Conference capacity, halls and incentive ideas for groups.', file: 'mice-meetings-and-events.pdf', size: '4.1 MB', doc: 'EN' },
          { title: 'Medical indications', desc: 'Indications & contraindications — medical reference.', file: 'medical-indications-cz.pdf', size: '0.2 MB', doc: 'CS' },
        ],
      },
      {
        group: 'Hotel flyers — Ensana Butterfly',
        note: 'one flyer, three language versions',
        items: flyerItems(
          (l) => ({ CS: 'Butterfly flyer — Czech', EN: 'Butterfly flyer — English', DE: 'Butterfly flyer — German' })[l],
          'Client-ready flyer: the new Traditional and Intensive spa stays and the Ferdinand Spring.',
        ),
      },
    ],
  },

  de: {
    eyebrow: 'Partnerunterlagen',
    title: 'Download-Center',
    lead: 'Alle Präsentationen sind PDFs und frei in Ihren Kanälen nutzbar. Jede Unterlage trägt ein Sprachetikett — Sie wissen also immer, welche Version zu welchem Kunden passt.',
    downloadAll: 'Alles herunterladen (ZIP · 44 MB)',
    backHub: '← Partner-Hub',
    langSwitchLabel: 'Diese Seite in Ihrer Sprache',
    viewOnlineHeading: 'Alles online durchsehen',
    viewOnlineText: 'Erst schauen, dann speichern? Alle PDFs lassen sich direkt im Browser ansehen — ohne Download.',
    viewOnlineCta: 'Online ansehen',
    docLangBadge: { EN: 'Auf Englisch', DE: 'Auf Deutsch', CS: 'Auf Tschechisch' },
    groups: [
      {
        group: 'Destinationspräsentationen',
        items: [
          { title: 'Vorstellung der Destination', desc: 'Vollständige visuelle Präsentation Marienbads für Partner und Reisebüros.', file: 'introduction-of-destination.pdf', size: '9.6 MB', doc: 'EN' },
          { title: 'Warum Marienbad', desc: 'Die wichtigsten Verkaufsargumente — Gründe, Ihre Kunden nach Marienbad zu schicken.', file: 'why-marianske-lazne.pdf', size: '3.7 MB', doc: 'EN' },
          { title: 'Zweiseitiges Destinations-Factsheet', desc: 'Kompakter Überblick — ideal als Hand-out oder E-Mail-Anhang.', file: 'marianske-lazne-2-page-info.pdf', size: '1.0 MB', doc: 'EN' },
        ],
      },
      {
        group: 'Hotels, Kur & Produkt',
        items: [
          { title: 'Hotels & Destination', desc: 'Die sieben Ensana-Kurhotels und was jedes von ihnen bietet.', file: 'hotels-and-destination.pdf', size: '11.1 MB', doc: 'EN' },
          { title: 'Kurbehandlung', desc: 'Medizinische Kurprogramme, Therapien und Anwendungsüberblick.', file: 'spa-treatment.pdf', size: '1.2 MB', doc: 'EN' },
          { title: 'Mineralquellen', desc: 'Die berühmten Quellen Marienbads und ihre Nutzung.', file: 'mineral-springs.pdf', size: '1.7 MB', doc: 'EN' },
          { title: 'MICE — Tagungen & Events', desc: 'Konferenzkapazitäten, Säle und Incentive-Ideen für Gruppen.', file: 'mice-meetings-and-events.pdf', size: '4.1 MB', doc: 'EN' },
          { title: 'Medizinische Indikationen', desc: 'Indikationen & Kontraindikationen — medizinische Referenz.', file: 'medical-indications-cz.pdf', size: '0.2 MB', doc: 'CS' },
        ],
      },
      {
        group: 'Hotelflyer — Ensana Butterfly',
        note: 'ein Flyer, drei Sprachversionen',
        items: flyerItems(
          (l) => ({ CS: 'Butterfly-Flyer — Tschechisch', EN: 'Butterfly-Flyer — Englisch', DE: 'Butterfly-Flyer — Deutsch' })[l],
          'Kundenfertiger Flyer: die neuen Kuraufenthalte Traditionell und Intensiv und die Ferdinandquelle.',
        ),
      },
    ],
  },

  cs: {
    eyebrow: 'Partnerské podklady',
    title: 'Centrum ke stažení',
    lead: 'Všechny prezentace jsou PDF a můžete je volně použít ve svých kanálech. U každé položky uvádíme jazyk dokumentu — vždy tedy víte, kterou verzi dát kterému klientovi.',
    downloadAll: 'Stáhnout vše (ZIP · 44 MB)',
    backHub: '← Partnerský rozcestník',
    langSwitchLabel: 'Tato stránka ve vašem jazyce',
    viewOnlineHeading: 'Prohlédněte si vše online',
    viewOnlineText: 'Chcete se napřed podívat? Všechna PDF si prohlédnete rovnou v prohlížeči — bez stahování.',
    viewOnlineCta: 'Zobrazit online',
    docLangBadge: { EN: 'V angličtině', DE: 'V němčině', CS: 'V češtině' },
