          { title: 'Lázeňská léčba', desc: 'Léčebné programy, terapie a přehled procedur.', file: 'spa-treatment.pdf', size: '1.2 MB', doc: 'EN' },
          { title: 'Minerální prameny', desc: 'Slavné mariánskolázeňské prameny a jejich využití.', file: 'mineral-springs.pdf', size: '1.7 MB', doc: 'EN' },
          { title: 'MICE — setkání a akce', desc: 'Konferenční kapacity, sály a nápady na incentivy pro skupiny.', file: 'mice-meetings-and-events.pdf', size: '4.1 MB', doc: 'EN' },
          { title: 'Léčebné indikace', desc: 'Indikace a kontraindikace — odborná reference.', file: 'medical-indications-cz.pdf', size: '0.2 MB', doc: 'CS' },
        ],
      },
      {
        group: 'Hotelové letáky — Ensana Butterfly',
        note: 'jeden leták, tři jazykové verze',
        items: flyerItems(
          (l) => ({ CS: 'Leták Butterfly — česky', EN: 'Leták Butterfly — anglicky', DE: 'Leták Butterfly — německy' })[l],
          'Leták pro klienty: nové Tradiční a Intenzivní léčebné pobyty a Ferdinandův pramen.',
        ),
      },
    ],
  },
}

const c = content[lang]

const hubHref = { en: '/introduce', de: '/introduce/de', cs: '/introduce/cs' }[lang]

/** Přepínač jazyků této stránky (výchozí je EN na /introduce/downloads). */
const langSwitch: { code: Lang; label: string; href: string }[] = [
  { code: 'en', label: 'English', href: downloadCentreAlternates.en },
  { code: 'de', label: 'Deutsch', href: downloadCentreAlternates.de },
  { code: 'cs', label: 'Česky', href: downloadCentreAlternates.cs },
]

const badgeColor: Record<DocLang, string> = {
  EN: 'bg-indigo-50 text-indigo-700 border-indigo-200',
  DE: 'bg-yellow-50 text-yellow-800 border-yellow-300',
  CS: 'bg-turquoise-50 text-turquoise-800 border-turquoise-200',
}
---

<!-- Hlavička -->
<section class="bg-indigo-800 text-white">
  <div class="container-wide py-12 md:py-16">
    <div class="flex justify-end mb-4">
      <div class="inline-flex items-center gap-2">
        <span class="text-xs text-white/50 uppercase tracking-wider hidden sm:inline">{c.langSwitchLabel}</span>
        <div class="inline-flex rounded-full bg-white/10 border border-white/20 p-1">
          {langSwitch.map((l) => (
            <a
              href={l.href}
              aria-current={l.code === lang ? 'page' : undefined}
              class={`px-3.5 py-1.5 rounded-full text-sm font-semibold transition-colors ${
                l.code === lang ? 'bg-yellow-400 text-beige-950' : 'text-white/80 hover:text-white hover:bg-white/10'
              }`}>
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </div>
    <p class="text-turquoise-200 font-semibold tracking-wide uppercase text-sm mb-3">{c.eyebrow}</p>
    <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold leading-tight max-w-3xl">{c.title}</h1>
    <p class="mt-5 text-white/85 leading-relaxed max-w-3xl">{c.lead}</p>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a href={partnerKit} download class="inline-flex items-center gap-2 px-5 py-2.5 bg-yellow-400 hover:bg-yellow-300 text-beige-950 font-semibold rounded-full transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={downloadIcon} /></svg>
        {c.downloadAll}
      </a>
      <a href={hubHref} class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 transition-colors">
        {c.backHub}
      </a>
      <a href={viewOnline} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 transition-colors">
        {c.viewOnlineCta}
      </a>
    </div>
  </div>
</section>

<!-- Skupiny dokumentů s náhledy -->
<section class="bg-beige-100 py-12 md:py-16">
  <div class="container-wide">
    {c.groups.map((g) => (
      <div class="mb-12 last:mb-0">
        <div class="flex items-baseline gap-3 mb-5">
          <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700">{g.group}</h2>
          {g.note && <span class="text-sm text-gray-500">— {g.note}</span>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {g.items.map((m) => (
            <a href={`${PDF}/${m.file}`} target="_blank" rel="noopener" class="group bg-white rounded-2xl shadow-card overflow-hidden card-hover flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden bg-beige-50 border-b border-beige-200">
                <Pic
                  src={`${THUMB}/${m.file.replace('.pdf', '.jpg')}`}
                  alt={m.title}
                  class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                />
                <span class="absolute top-2.5 right-2.5 inline-flex items-center justify-center w-8 h-8 rounded-full bg-indigo-700/90 text-white shadow">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={downloadIcon} /></svg>
                </span>
              </div>
              <div class="p-4 flex-1 flex flex-col">
                <h3 class="font-semibold text-indigo-900 group-hover:text-turquoise-800 transition-colors leading-snug">{m.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed mt-1 mb-3 flex-1">{m.desc}</p>
                <span class="inline-flex flex-wrap items-center gap-2">
                  <span class={`px-2 py-0.5 rounded-full border text-[0.68rem] font-bold uppercase tracking-wide ${badgeColor[m.doc]}`}>{c.docLangBadge[m.doc]}</span>
                  <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">PDF · {m.size}</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Online prohlížení -->
    <a href={viewOnline} target="_blank" rel="noopener" class="group mt-10 flex flex-col md:flex-row md:items-center gap-4 md:gap-6 bg-white border border-turquoise-200 hover:border-turquoise-400 rounded-2xl p-6 md:p-7 shadow-card card-hover">
      <div class="shrink-0 w-12 h-12 rounded-xl bg-turquoise-50 text-turquoise-700 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1 1 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178a1 1 0 010 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
      <div class="flex-1">
        <h2 class="font-heading text-xl font-bold text-indigo-800 mb-1">{c.viewOnlineHeading}</h2>
        <p class="text-gray-600 text-sm leading-relaxed">{c.viewOnlineText}</p>
      </div>
      <span class="shrink-0 inline-flex items-center gap-2 text-turquoise-800 group-hover:text-turquoise-900 font-semibold text-sm">
        {c.viewOnlineCta}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </span>
    </a>
  </div>
</section>
