---
import type { Locale } from '@/i18n/config'
import { getEpisodes, getThumbnail } from '@/data/podcasts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const episodes = getEpisodes()
const latestEpisode = episodes[episodes.length - 1]

const labels = {
  cs: { title: 'Podcast z Mariánských Lázní', subtitle: 'Video podcasty z lázeňského města — rozhovory, tipy a příběhy', watch: 'Přehrát', allEpisodes: 'Všechny epizody', playlistLabel: 'Celý playlist na YouTube', episode: 'Epizoda' },
  de: { title: 'Podcast aus Marienbad', subtitle: 'Video-Podcasts aus der Kurstadt — Gespräche, Tipps und Geschichten', watch: 'Abspielen', allEpisodes: 'Alle Folgen', playlistLabel: 'Komplette Playlist auf YouTube', episode: 'Folge' },
  en: { title: 'Marienbad Podcast', subtitle: 'Video podcasts from the spa town — conversations, tips and stories', watch: 'Play', allEpisodes: 'All Episodes', playlistLabel: 'Full playlist on YouTube', episode: 'Episode' },
  ru: { title: 'Подкаст из Марианских Лазне', subtitle: 'Видеоподкасты из курортного города — разговоры, советы и истории', watch: 'Смотреть', allEpisodes: 'Все выпуски', playlistLabel: 'Полный плейлист на YouTube', episode: 'Выпуск' },
}

const t = labels[locale]
---

<!-- Hero -->
<section class="bg-gradient-to-br from-indigo-700 via-indigo-600 to-aubergine-800 text-white py-20 md:py-28">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 rounded-full mb-6">
        <svg class="w-5 h-5 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span class="text-sm font-semibold tracking-wider uppercase">Video Podcast</span>
      </div>
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4" style="font-size: var(--text-h1);">{t.title}</h1>
      <p class="text-white/70 text-lg md:text-xl mb-8">{t.subtitle}</p>
      <a
        href="https://www.youtube.com/playlist?list=PLMj3cJtcC8RvX7WPBj3h2lUnN8xOrlmmS"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-full text-sm font-medium transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        {t.playlistLabel}
      </a>
    </div>
  </div>
</section>

<!-- Featured episode (latest) -->
{episodes.length > 0 && (
  <section class="py-12 md:py-16 bg-white">
    <div class="container-wide">
      <div class="max-w-4xl mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-card bg-gradient-to-br from-indigo-50 to-beige-50 border border-indigo-100">
          <div class="relative w-full" style="padding-bottom: 56.25%;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${latestEpisode.videoId}?rel=0&modestbranding=1`}
              title={latestEpisode.title[locale] || latestEpisode.title.en}
              class="absolute inset-0 w-full h-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <div class="p-6 md:p-8">
            <span class="text-xs font-semibold uppercase tracking-widest text-indigo-500">{t.episode} {episodes.length}</span>
            <h2 class="font-heading text-2xl font-bold text-indigo-700 mt-1 mb-2">{latestEpisode.title[locale] || latestEpisode.title.en}</h2>
            <p class="text-beige-700">{latestEpisode.description[locale] || latestEpisode.description.en}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<!-- All episodes grid -->
<section class="py-12 md:py-20 bg-beige-100">
  <div class="container-wide">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-10 text-center">{t.allEpisodes}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {episodes.map((ep, i) => (
        <div class="group bg-white rounded-xl overflow-hidden shadow-card card-hover reveal" data-episode-id={ep.id}>
          <!-- Thumbnail with play overlay -->
          <div class="relative aspect-video overflow-hidden cursor-pointer" data-video-id={ep.videoId}>
            <img
              src={getThumbnail(ep.videoId)}
              alt={ep.title[locale] || ep.title.en}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
              <div class="w-14 h-14 bg-white/90 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-indigo-700 ml-1" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
            <span class="absolute top-3 left-3 px-2.5 py-1 bg-indigo-700/90 text-white text-xs font-bold rounded-lg">
              {t.episode} {i + 1}
            </span>
          </div>
          <!-- Info -->
          <div class="p-5">
            <h3 class="font-heading text-lg font-bold text-indigo-700 mb-1.5 line-clamp-2">{ep.title[locale] || ep.title.en}</h3>
            <p class="text-sm text-beige-600 line-clamp-2 mb-3">{ep.description[locale] || ep.description.en}</p>
            <div class="flex items-center justify-between">
              <span class="text-xs text-beige-500">{ep.date}</span>
              <a
                href={`https://www.youtube.com/watch?v=${ep.videoId}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                YouTube
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Click thumbnail to replace with iframe player
  document.querySelectorAll('[data-video-id]').forEach(el => {
    el.addEventListener('click', () => {
      const videoId = (el as HTMLElement).dataset.videoId
      if (!videoId) return
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
      iframe.allowFullscreen = true
      iframe.className = 'absolute inset-0 w-full h-full'
      el.innerHTML = ''
      el.classList.remove('cursor-pointer')
      el.appendChild(iframe)
    })
  })
</script>
