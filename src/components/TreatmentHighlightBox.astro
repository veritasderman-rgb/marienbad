---

<aside class="my-10 bg-indigo-700 text-white rounded-xl p-8 md:p-10 flex gap-5 items-start">
  <div class="shrink-0 w-12 h-12 rounded-xl bg-turquoise-400/20 flex items-center justify-center">
    <svg class="w-6 h-6 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
    </svg>
  </div>
  <div>
    <h3 class="font-heading text-lg font-bold mb-2">{title}</h3>
    <p class="text-white/70 text-sm leading-relaxed">{description}</p>
  </div>
</aside>
