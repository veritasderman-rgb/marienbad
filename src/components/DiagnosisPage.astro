---
/**
 * Stránka „léčba podle diagnózy“ — jedna šablona pro všechny jazyky.
 *
 * Pořadí sekcí je záměrné a nemění se: čtenář i AI potřebují nejdřív vědět,
 * co se léčí a co ne, pak jak léčba probíhá, a teprve nakonec co říká výzkum.
 * FAQ na konci drží doslovné znění dotazů, jaké lidé píší, protože právě z něj
 * se skládají odpovědi asistentů.
 */
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Pic from '@/components/Pic.astro'
import ArticleSources from '@/components/ArticleSources.astro'
import { indications } from '@/data/indications'
import { diagnoses, diagnosisHref, treatmentBase, type Diagnosis } from '@/data/treatmentFor'
import type { Locale } from '@/i18n/config'
import { localizedHref } from '@/i18n/utils'
import { t } from '@/i18n/ui'

interface Props {
  locale: Locale
  diagnosis: Diagnosis
}

const { locale, diagnosis } = Astro.props
const c = diagnosis.content[locale]
const group = indications[locale].groups.find((g) => g.id === diagnosis.groupId)
/**
 * Z indikační skupiny patří na stránku jen položky té konkrétní diagnózy.
 * Vypsat celou skupinu znamená tvrdit, že třeba u operace kyčle rozhoduje
 * i revmatoidní artritida nebo osteoporóza. Kódy nese jen česká verze
 * seznamu, takže jinde se blok nevykreslí — délku pobytu i položku seznamu
 * stejně pojmenovává sekce `stay` slovy.
 */
const listItems = (group?.items ?? []).filter((item) => item.code && diagnosis.codes.includes(item.code))
const others = diagnoses.filter((d) => d.id !== diagnosis.id)

const ui = {
  de: {
    hub: 'Kur nach Diagnose', treats: 'Was hier behandelt wird', notFor: 'Wann eine Kur nicht infrage kommt',
    course: 'So läuft die Kur ab', procedures: 'Angewandte Anwendungen', stay: 'Dauer und Zeitpunkt',
    list: 'Was die Indikationsliste nennt', faq: 'Häufige Fragen', others: 'Weitere Diagnosen',
    indicationsLink: 'Vollständige Indikationsliste',
  },
  en: {
    hub: 'Spa treatment by condition', treats: 'What is treated here', notFor: 'When a spa cure is not an option',
    course: 'How the cure works', procedures: 'Treatments used', stay: 'Length and timing',
    list: 'What the indication list says', faq: 'Frequently asked questions', others: 'Other conditions',
    indicationsLink: 'Full indication list',
  },
  cs: {
    hub: 'Lázeňská léčba podle diagnózy', treats: 'Co se tady léčí', notFor: 'Kdy lázeňská léčba nepřipadá v úvahu',
    course: 'Jak léčba probíhá', procedures: 'Používané procedury', stay: 'Délka a načasování',
    list: 'Co uvádí indikační seznam', faq: 'Časté dotazy', others: 'Další diagnózy',
    indicationsLink: 'Úplný indikační seznam',
  },
  ru: {
    hub: 'Курортное лечение по диагнозу', treats: 'Что здесь лечат', notFor: 'Когда курортное лечение невозможно',
    course: 'Как проходит лечение', procedures: 'Применяемые процедуры', stay: 'Длительность и сроки',
    list: 'Что указано в индикационном списке', faq: 'Частые вопросы', others: 'Другие диагнозы',
    indicationsLink: 'Полный индикационный список',
  },
}[locale]

const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: ui.hub, href: treatmentBase(locale) },
  { label: c.navLabel },
]
---

<section class="relative bg-indigo-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.12)_0%,_transparent_60%)]"></div>
  <div class="relative container-wide pt-28 pb-14 md:pt-36 md:pb-16">
    <Breadcrumbs items={breadcrumbs} locale={locale} />
    <p class="text-turquoise-300 text-sm font-semibold uppercase tracking-wider mb-3">{ui.hub}</p>
    <h1 class="font-heading text-3xl md:text-5xl font-bold mb-5 leading-tight" style="font-size: var(--text-h1);">{c.h1}</h1>
    <p class="text-white/85 text-lg md:text-xl leading-relaxed max-w-3xl">{c.lead}</p>
  </div>
</section>

<div class="container-wide py-14 md:py-20 flex flex-col gap-14 md:gap-20">

  <figure class="not-prose m-0 grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-center bg-beige-100 border border-beige-200 p-5 md:p-6" style="border-radius: var(--radius-card);">
    <div class="overflow-hidden rounded-xl">
      <Pic src={diagnosis.image} alt={diagnosis.imageAlt[locale]} class="w-full h-auto block" sizes="(max-width: 768px) 100vw, 420px" loading="eager" />
    </div>
    <figcaption class="m-0 text-beige-900 text-base leading-relaxed">{diagnosis.imageAlt[locale]}</figcaption>
  </figure>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.treats}</h2>
    <ul class="flex flex-col gap-3 list-none p-0 m-0">
      {c.treats.map((item) => (
        <li class="flex gap-3 bg-beige-100 border border-beige-200 px-5 py-4 rounded-xl text-beige-900 text-base leading-relaxed">
          <svg class="w-5 h-5 text-turquoise-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.course}</h2>
    <div class="flex flex-col gap-5">
      {c.course.map((step, i) => (
        <div class="flex gap-5">
          <span class="shrink-0 w-9 h-9 rounded-lg bg-indigo-700 text-white text-sm font-bold flex items-center justify-center tabular-nums">{i + 1}</span>
          <div>
            <h3 class="font-heading font-bold text-indigo-700 mb-1.5">{step.heading}</h3>
            <p class="text-beige-800 text-base leading-relaxed m-0">{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.procedures}</h2>
    <dl class="grid gap-4 sm:grid-cols-2 m-0">
      {c.procedures.map((proc) => (
        <div class="bg-white border border-beige-200 p-5" style="border-radius: var(--radius-card);">
          <dt class="font-heading font-bold text-indigo-700 mb-2">{proc.name}</dt>
          <dd class="text-beige-800 text-sm leading-relaxed m-0">{proc.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-turquoise-50 border-l-4 border-turquoise-400 px-6 py-6 md:px-8 md:py-7 rounded-r-xl">
    <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-3">{c.stay.heading}</h2>
    <p class="text-beige-900 text-base leading-relaxed m-0">{c.stay.body}</p>
  </section>

  {c.evidence && (
    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{c.evidence.heading}</h2>
      <p class="text-beige-800 text-base md:text-lg leading-relaxed">{c.evidence.body}</p>
    </section>
  )}

  {c.ongoing && (
    <section class="bg-beige-100 border border-beige-200 px-6 py-6 md:px-8 md:py-7" style="border-radius: var(--radius-card);">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{c.ongoing.heading}</h2>
      <p class="text-beige-900 text-base md:text-lg leading-relaxed m-0">{c.ongoing.body}</p>
    </section>
  )}

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.notFor}</h2>
    <ul class="flex flex-col gap-3 list-none p-0 m-0">
      {c.notFor.map((item) => (
        <li class="flex gap-3 text-beige-800 text-base leading-relaxed">
          <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-beige-400 mt-2.5" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <p class="text-beige-900 text-base leading-relaxed mt-5 bg-beige-100 border border-beige-200 px-5 py-4 rounded-xl">{c.physicianNote}</p>
  </section>

  {group && listItems.length > 0 && (
    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-1">{ui.list}</h2>
      <p class="text-turquoise-700 text-sm font-semibold uppercase tracking-wider mb-4">{group.title}</p>
      <ul class="flex flex-col gap-4 list-none p-0 m-0">
        {listItems.map((item) => (
          <li class="bg-white border border-beige-200 p-5 md:p-6" style="border-radius: var(--radius-card);">
            <div class="flex flex-wrap items-start gap-3">
              {item.code && (
                <span class="shrink-0 inline-flex items-center rounded-lg bg-indigo-700 text-white text-xs font-bold px-2.5 py-1 tabular-nums">{item.code}</span>
              )}
              <p class="flex-1 min-w-[16rem] text-beige-900 text-base leading-relaxed m-0">{item.text}</p>
            </div>
            {item.coverage && (
              <p class="text-turquoise-800 text-sm font-medium bg-turquoise-50 inline-block px-3 py-1.5 rounded-lg m-0 mt-3">{item.coverage}</p>
            )}
          </li>
        ))}
      </ul>
      <p class="text-beige-700 text-sm leading-relaxed mt-5">
        {indications[locale].sourceNote}{' '}
        <a href={localizedHref(locale, 'indications')} class="text-turquoise-700 underline underline-offset-2 hover:text-indigo-700">{ui.indicationsLink}</a>
      </p>
    </section>
  )}

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.faq}</h2>
    <div class="flex flex-col gap-3">
      {c.faqs.map((faq) => (
        <details class="group bg-white border border-beige-200 rounded-xl overflow-hidden">
          <summary class="cursor-pointer list-none px-5 py-4 font-heading font-semibold text-indigo-700 flex items-center justify-between gap-4">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="px-5 pb-5 pt-0 text-beige-800 text-base leading-relaxed m-0">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  {c.related.length > 0 && (
    <nav aria-label={ui.others}>
      <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
        {c.related.map((r) => (
          <li class="m-0">
            <a href={r.href} class="inline-flex items-center gap-2 border border-indigo-200 text-indigo-700 font-semibold px-5 py-2.5 rounded-full hover:bg-indigo-50 transition-colors text-sm">{r.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <ArticleSources locale={locale} sources={c.sources} medicalReviewDate={diagnosis.medicalReviewDate} />

  <nav aria-label={ui.others}>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{ui.others}</h2>
    <ul class="grid gap-3 sm:grid-cols-2 list-none p-0 m-0">
      {others.map((other) => (
        <li class="m-0">
          <a href={diagnosisHref(locale, other)} class="group flex flex-col gap-1 bg-white border border-beige-200 p-4 hover:border-turquoise-400 hover:shadow-card transition-all duration-300 h-full" style="border-radius: var(--radius-card);">
            <span class="font-semibold text-indigo-700 group-hover:text-turquoise-600 transition-colors">{other.content[locale].navLabel}</span>
            <span class="text-beige-700 text-sm leading-relaxed">{other.content[locale].teaser}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

</div>
