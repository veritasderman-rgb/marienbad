---
interface Props {
  title: string
  subtitle: string
  ctaText: string
  ctaHref: string
  badges?: string[]
  image?: string | null
}

const { title, subtitle, ctaText, ctaHref, badges = [], image } = Astro.props
const hasImage = image && image.trim().length > 0
---

<section class="relative min-h-[85vh] md:min-h-screen flex items-center overflow-hidden">
  <!-- Background: real image or gradient placeholder with Ken Burns animation -->
  <div class="absolute inset-0 animate-ken-burns">
    {hasImage ? (
      <img
        src={image}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-700 via-indigo-500 to-indigo-900"></div>
    )}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.15)_0%,_transparent_60%)]"></div>
  </div>

  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-rgba(0,79,113,0.5) via-transparent to-rgba(26,25,22,0.6)"
    style="background: linear-gradient(to bottom, rgba(0,79,113,0.7), rgba(0,79,113,0.3) 40%, rgba(26,25,22,0.8))">
  </div>

  <!-- Decorative turquoise line at bottom -->
  <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-turquoise-400/40 to-transparent"></div>

  <div class="relative container-wide py-24 md:py-32 lg:py-40">
    <div class="max-w-3xl animate-fade-in-up">
      <!-- Badges -->
      {badges.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 mb-8">
          {badges.map((badge) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-yellow-400/90 text-beige-950 text-xs font-semibold uppercase tracking-wider rounded-full">
              {badge}
            </span>
          ))}
        </div>
      )}

      <h1 class="font-heading text-hero font-bold leading-[1.1] mb-6 text-white break-words" style="font-size: var(--text-hero);">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-white/80 mb-10 max-w-2xl leading-relaxed" style="line-height: 1.6;">
        {subtitle}
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={ctaHref}
          class="btn-primary text-base"
        >
          {ctaText}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#discover"
          aria-label="Scroll down"
          class="inline-flex items-center gap-2 px-6 py-3.5 text-white/70 hover:text-white border border-white/20 hover:border-white/40 rounded-full transition-all duration-300"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
