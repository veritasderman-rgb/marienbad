---
import type { Locale } from '@/i18n/config'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const ensanaLocale = locale === 'de' ? 'de' : locale === 'cs' ? 'cs' : locale === 'ru' ? 'ru' : 'en'
const destinationPaths: Record<string, string> = {
  cs: 'destinace/ceska-republika/marianske-lazne',
  de: 'destinationen/tschechische-republik/marienbad',
  en: 'destinations/czech-republic/marianske-lazne',
  ru: 'napravleniya/cheshskaya-respublika/marienbad',
}
const bookingUrl = `https://ensanahotels.com/${ensanaLocale}/${destinationPaths[ensanaLocale]}?utm_source=marienbad&utm_medium=popup&utm_campaign=best-offer`

const messages: Record<Locale, { text: string; cta: string }> = {
  de: { text: 'Für das beste Angebot besuchen Sie', cta: 'ensanahotels.com' },
  en: { text: 'For the best offer visit', cta: 'ensanahotels.com' },
  cs: { text: 'Pro nejlepší nabídku navštivte', cta: 'ensanahotels.com' },
  ru: { text: 'Лучшие предложения на', cta: 'ensanahotels.com' },
}

const msg = messages[locale]
---

<div
  id="booking-popup"
  class="fixed left-4 right-4 bottom-[4.5rem] sm:left-auto sm:right-6 sm:max-w-xs md:bottom-8 z-50 opacity-0 translate-y-3 sm:translate-y-0 sm:translate-x-4 pointer-events-none transition-all duration-500 ease-out"
  role="dialog"
  aria-label={msg.text}
>
  <div class="relative bg-white rounded-2xl shadow-2xl shadow-black/15 border border-beige-200 overflow-hidden">
    <!-- Accent bar -->
    <div class="h-1 bg-gradient-to-r from-turquoise-400 via-indigo-500 to-aubergine-700"></div>

    <div class="px-5 py-4 pr-10">
      <p class="text-sm text-beige-700 leading-relaxed">
        {msg.text}
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener"
          class="font-semibold text-indigo-700 hover:text-turquoise-600 transition-colors underline underline-offset-2 decoration-turquoise-300"
        >
          {msg.cta}
        </a>
      </p>
    </div>

    <!-- Close button -->
    <button
      id="booking-popup-close"
      class="absolute top-2.5 right-2.5 w-6 h-6 flex items-center justify-center rounded-full text-beige-400 hover:text-beige-700 hover:bg-beige-100 transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Progress bar (auto-close countdown) -->
    <div class="h-0.5 bg-beige-100">
      <div id="booking-popup-timer" class="h-full bg-turquoise-400/60 w-full origin-left"></div>
    </div>
  </div>
</div>

<style>
  #booking-popup-timer {
    animation: popup-countdown 10s linear forwards;
    animation-play-state: paused;
  }
  @keyframes popup-countdown {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }
</style>

<script>
  (() => {
    const popup = document.getElementById('booking-popup')
    const closeBtn = document.getElementById('booking-popup-close')
    if (!popup || !closeBtn) return

    // Don't show if already dismissed this session
    if (sessionStorage.getItem('booking-popup-dismissed')) return

    let autoCloseTimer: ReturnType<typeof setTimeout>

    const timerBar = document.getElementById('booking-popup-timer')

    function show() {
      popup.classList.remove('opacity-0', 'translate-y-3', 'sm:translate-x-4', 'pointer-events-none')
      popup.classList.add('opacity-100', 'translate-y-0', 'sm:translate-x-0', 'pointer-events-auto')
      if (timerBar) timerBar.style.animationPlayState = 'running'
      autoCloseTimer = setTimeout(hide, 10000)
    }

    function hide() {
      popup.classList.add('opacity-0', 'translate-y-3', 'sm:translate-x-4', 'pointer-events-none')
      popup.classList.remove('opacity-100', 'translate-y-0', 'sm:translate-x-0', 'pointer-events-auto')
      clearTimeout(autoCloseTimer)
      sessionStorage.setItem('booking-popup-dismissed', '1')
    }

    closeBtn.addEventListener('click', hide)

    // Show after 5s of page load
    setTimeout(show, 5000)
  })()
</script>
