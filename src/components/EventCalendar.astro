---
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { events, type MarienbadEvent } from '@/data/events'

interface Props {
  locale: string
}

const { locale } = Astro.props as { locale: Locale }

const currentMonth = new Date().getMonth() + 1 // 1-12

type Season = 'spring' | 'summer' | 'autumn' | 'winter'

interface SeasonConfig {
  id: Season
  label: string
  months: number[]
  borderColor: string
  bgColor: string
  badgeColor: string
  textColor: string
}

const seasons: SeasonConfig[] = [
  {
    id: 'spring',
    label: t(locale, 'eventCalendar.spring'),
    months: [3, 4, 5],
    borderColor: 'border-l-green-500',
    bgColor: 'bg-green-50',
    badgeColor: 'bg-green-100 text-green-800',
    textColor: 'text-green-700',
  },
  {
    id: 'summer',
    label: t(locale, 'eventCalendar.summer'),
    months: [6, 7, 8],
    borderColor: 'border-l-yellow-500',
    bgColor: 'bg-yellow-50',
    badgeColor: 'bg-yellow-100 text-yellow-800',
    textColor: 'text-yellow-700',
  },
  {
    id: 'autumn',
    label: t(locale, 'eventCalendar.autumn'),
    months: [9, 10, 11],
    borderColor: 'border-l-orange-500',
    bgColor: 'bg-orange-50',
    badgeColor: 'bg-orange-100 text-orange-800',
    textColor: 'text-orange-700',
  },
  {
    id: 'winter',
    label: t(locale, 'eventCalendar.winter'),
    months: [12, 1, 2],
    borderColor: 'border-l-blue-500',
    bgColor: 'bg-blue-50',
    badgeColor: 'bg-blue-100 text-blue-800',
    textColor: 'text-blue-700',
  },
]

function getSeasonForEvent(event: MarienbadEvent): Season {
  // Use the first month to determine primary season
  const firstMonth = event.months[0]
  for (const season of seasons) {
    if (season.months.includes(firstMonth)) {
      return season.id
    }
  }
  return 'spring'
}

function getCurrentSeason(): Season {
  for (const season of seasons) {
    if (season.months.includes(currentMonth)) {
      return season.id
    }
  }
  return 'spring'
}

const currentSeason = getCurrentSeason()

// Group events by season
const eventsBySeason = new Map<Season, MarienbadEvent[]>()
for (const season of seasons) {
  eventsBySeason.set(season.id, [])
}
for (const event of events) {
  const season = getSeasonForEvent(event)
  eventsBySeason.get(season)!.push(event)
}

const sectionTitle = t(locale, 'eventCalendar.title')
const currentLabel = t(locale, 'eventCalendar.currentSeason')

function loc(obj: { de: string; en: string }): string {
  return (obj as Record<string, string>)[locale] ?? obj.en
}

// The events are recurring/seasonal — the data holds no concrete calendar
// dates, so recurrence is expressed via eventSchedule (byMonth) rather than
// fabricated startDate/endDate values.
const eventListSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: events.map((event, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Event',
      name: loc(event.name),
      description: loc(event.description),
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventSchedule: {
        '@type': 'Schedule',
        repeatFrequency: 'P1Y',
        byMonth: event.months,
      },
      location: {
        '@type': 'Place',
        name: 'Mariánské Lázně',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Mariánské Lázně',
          addressCountry: 'CZ',
        },
      },
    },
  })),
})
---

<div class="my-12">
  <h2 id="event-calendar">{sectionTitle}</h2>

  <div class="space-y-10 not-prose">
    {seasons.map((season) => {
      const seasonEvents = eventsBySeason.get(season.id) || []
      if (seasonEvents.length === 0) return null
      const isCurrent = season.id === currentSeason
      return (
        <div>
          <div class="flex items-center gap-3 mb-4">
            <h3 class={`text-xl font-semibold ${season.textColor} m-0`}>
              {season.label}
            </h3>
            {isCurrent && (
              <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${season.badgeColor}`}>
                {currentLabel}
              </span>
            )}
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {seasonEvents.map((event) => (
              <div class={`border-l-4 ${season.borderColor} ${isCurrent ? season.bgColor : 'bg-white'} rounded-lg shadow-sm p-5 transition-shadow hover:shadow-md`}>
                <div class="flex items-start gap-3">
                  <span class="text-2xl leading-none mt-0.5" role="img">{event.icon}</span>
                  <div class="min-w-0">
                    <h4 class="font-semibold text-gray-900 text-base m-0">
                      {loc(event.name)}
                    </h4>
                    <p class={`text-sm font-medium ${season.textColor} mt-0.5 mb-2`}>
                      {loc(event.period)}
                    </p>
                    <p class="text-sm text-gray-600 m-0 leading-relaxed">
                      {loc(event.description)}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    })}
  </div>
</div>

<script type="application/ld+json" set:html={eventListSchema} />
