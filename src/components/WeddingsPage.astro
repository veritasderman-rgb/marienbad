          <p class="mt-2 text-sm text-beige-700 leading-relaxed">{r.note}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // GoogleAnalytics.astro instaluje window.gtag okamžitě, ještě před souhlasem —
  // jeho přítomnost tedy souhlas neznamená. Bez téhle brány by se události
  // nakupily v dataLayer a po pozdějším přijetí cookies se přehrály do gtag.js.
  // Stejnou podmínku má i posluchač kliknutí v GoogleAnalytics.astro.
  let consentGranted = false
  try {
    consentGranted = localStorage.getItem('ml-consent') === 'granted'
  } catch {
    /* localStorage může být nedostupné (private mode, blokované cookies) */
  }
  document.addEventListener('ml:consent-granted', () => { consentGranted = true })
  document.addEventListener('ml:consent-denied', () => { consentGranted = false })

  const send = (name: string, label: string) => {
    if (!consentGranted) return
    const w = window as unknown as { gtag?: (...args: unknown[]) => void }
    w.gtag?.('event', name, { event_category: 'weddings', event_label: label })
  }

  document.querySelectorAll<HTMLElement>('[data-ga]').forEach((el) => {
    el.addEventListener('click', () => send('wedding_click', el.dataset.ga ?? ''), { passive: true })
  })

  document.querySelectorAll<HTMLDetailsElement>('details[data-ga="wedding-faq"]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) send('wedding_faq_open', d.querySelector('summary')?.textContent?.trim() ?? '')
    })
  })

  const venues = document.getElementById('mista')
  if (venues && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          send('wedding_reach_venues', 'mista')
          io.disconnect()
        }
      },
      { threshold: 0.25 },
    )
    io.observe(venues)
  }
</script>
