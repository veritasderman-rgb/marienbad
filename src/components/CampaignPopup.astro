          </div>
          <div class="px-6 py-6 text-center">
            <p class="text-beige-700 text-base leading-relaxed mb-6">{campaign.summerSale.teaserText}</p>
            <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-4 px-6 mb-5">
              <p class="text-turquoise-600 text-xs font-semibold tracking-[0.2em] uppercase mb-1">{labels.countdown}</p>
              <p data-countdown="summer" class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">...</p>
            </div>
            <a
              href={campaign.summerSale.ctaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {campaign.summerSale.ctaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{campaign.summerSale.footnote}</p>
          </div>
        </Fragment>
      )}
    </div>

    {/* ============== SUMMER — ACTIVE ============== */}
    <div data-card="summer-active" class="campaign-card hidden relative bg-white rounded-2xl shadow-2xl overflow-hidden max-w-md w-full transition-transform duration-300 scale-95">
      {summerPopupImage ? (
        <Fragment>
          <button class="campaign-close absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-black/35 hover:bg-black/55 text-white transition-colors cursor-pointer" aria-label={labels.close}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <img src={summerPopupImage} alt={summerPopupAlt} class="block w-full h-auto" width="1080" height="1080" />
          <div class="sr-only">
            <p>{campaign.summerSale.eyebrow}</p>
            <p>{summerHeadlineParts.join(' ')} — {campaign.summerSale.discountLabel}</p>
            <p>{campaign.summerSale.saleText}</p>
            {summerStayLine && <p>{summerStayLine}</p>}
            {summerConditions.length > 0 && (
              <ul>{summerConditions.map((c) => <li>{c}</li>)}</ul>
            )}
            <p>{campaign.summerSale.footnote}</p>
          </div>
          <div class="px-6 py-5 text-center">
            <a
              href={campaign.summerSale.ctaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {campaign.summerSale.ctaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{campaign.summerSale.footnote}</p>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="px-6 pt-8 pb-10 text-center text-white relative flex flex-col justify-end" style={summerHeaderStyle} role={campaign.summerSale.image ? 'img' : undefined} aria-label={campaign.summerSale.image ? summerImgAlt : undefined}>
            <button class="campaign-close absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/15 hover:bg-white/25 transition-colors cursor-pointer" aria-label={labels.close}>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <p class="text-turquoise-200 text-xs font-semibold tracking-[0.2em] uppercase mb-3">{campaign.summerSale.eyebrow}</p>
            <h2 class="font-heading text-2xl md:text-3xl font-bold leading-tight">
              {summerHeadlineParts[0]}{summerHeadlineParts[1] && (<><br/>{summerHeadlineParts[1]}</>)}
            </h2>
          </div>
          <div class="px-6 py-6 text-center">
            <p class="text-beige-700 text-base leading-relaxed mb-5">{campaign.summerSale.saleText}</p>
            <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-5 px-6 mb-5">
              <p class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 tracking-wider">{campaign.summerSale.discountLabel}</p>
            </div>
            <a
              href={campaign.summerSale.ctaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {campaign.summerSale.ctaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{campaign.summerSale.footnote}</p>
          </div>
        </Fragment>
      )}
    </div>
    {/* ============== MEDICAL PROMO — TEASER ============== */}
    <div data-card="medical-teaser" class="campaign-card hidden relative bg-white rounded-2xl shadow-2xl overflow-hidden max-w-md w-full transition-transform duration-300 scale-95">
      {medicalPopupImage ? (
        <Fragment>
          <button class="campaign-close absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-black/35 hover:bg-black/55 text-white transition-colors cursor-pointer" aria-label={labels.close}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <img src={medicalPopupImage} alt={medicalPopupAlt} class="block w-full h-auto" width="1080" height="1080" />
          <div class="sr-only">
            <p>{medical.eyebrow}</p>
            <p>{medicalHeadlineParts.join(' ')} — {medical.discountLabel}</p>
            <p>{medical.teaserText}</p>
            {medicalStayLine && <p>{medicalStayLine}</p>}
            {medicalConditions.length > 0 && (
              <ul>{medicalConditions.map((c) => <li>{c}</li>)}</ul>
            )}
            <p>{medical.footnote}</p>
          </div>
          <div class="px-6 py-5 text-center">
            <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-4 px-6 mb-5">
              <p class="text-turquoise-600 text-xs font-semibold tracking-[0.2em] uppercase mb-1">{labels.countdown}</p>
              <p data-countdown="medical" class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">...</p>
            </div>
            <a
              href={medicalTeaserCta}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {medical.teaserCtaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{medical.footnote}</p>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="px-6 pt-8 pb-10 text-center text-white relative flex flex-col justify-end" style={medicalHeaderStyle} role={medical.image ? 'img' : undefined} aria-label={medical.image ? medicalImgAlt : undefined}>
            <button class="campaign-close absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/15 hover:bg-white/25 transition-colors cursor-pointer" aria-label={labels.close}>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <p class="text-turquoise-200 text-xs font-semibold tracking-[0.2em] uppercase mb-3">{medical.eyebrow}</p>
            <h2 class="font-heading text-2xl md:text-3xl font-bold leading-tight">
              {medicalHeadlineParts[0]}{medicalHeadlineParts[1] && (<><br/>{medicalHeadlineParts[1]}</>)}
            </h2>
          </div>
          <div class="px-6 py-6 text-center">
            <p class="text-beige-700 text-base leading-relaxed mb-6">{medical.teaserText}</p>
            <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-4 px-6 mb-5">
              <p class="text-turquoise-600 text-xs font-semibold tracking-[0.2em] uppercase mb-1">{labels.countdown}</p>
              <p data-countdown="medical" class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">...</p>
            </div>
            <a
              href={medicalTeaserCta}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {medical.teaserCtaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{medical.footnote}</p>
          </div>
        </Fragment>
      )}
    </div>

    {/* ============== MEDICAL PROMO — ACTIVE ============== */}
    <div data-card="medical-active" class="campaign-card hidden relative bg-white rounded-2xl shadow-2xl overflow-hidden max-w-md w-full transition-transform duration-300 scale-95">
      {medicalPopupImage ? (
        <Fragment>
          <button class="campaign-close absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-black/35 hover:bg-black/55 text-white transition-colors cursor-pointer" aria-label={labels.close}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <img src={medicalPopupImage} alt={medicalPopupAlt} class="block w-full h-auto" width="1080" height="1080" />
          <div class="sr-only">
            <p>{medical.eyebrow}</p>
            <p>{medicalHeadlineParts.join(' ')} — {medical.discountLabel}</p>
            <p>{medical.saleText}</p>
            {medicalStayLine && <p>{medicalStayLine}</p>}
            {medicalConditions.length > 0 && (
              <ul>{medicalConditions.map((c) => <li>{c}</li>)}</ul>
            )}
            <p>{medical.footnote}</p>
          </div>
          <div class="px-6 py-5 text-center">
            <a
              href={medicalCta}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {medical.ctaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{medical.footnote}</p>
          </div>
        </Fragment>
      ) : (
        <Fragment>
          <div class="px-6 pt-8 pb-10 text-center text-white relative flex flex-col justify-end" style={medicalHeaderStyle} role={medical.image ? 'img' : undefined} aria-label={medical.image ? medicalImgAlt : undefined}>
            <button class="campaign-close absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/15 hover:bg-white/25 transition-colors cursor-pointer" aria-label={labels.close}>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <p class="text-turquoise-200 text-xs font-semibold tracking-[0.2em] uppercase mb-3">{medical.eyebrow}</p>
            <h2 class="font-heading text-2xl md:text-3xl font-bold leading-tight">
              {medicalHeadlineParts[0]}{medicalHeadlineParts[1] && (<><br/>{medicalHeadlineParts[1]}</>)}
            </h2>
          </div>
          <div class="px-6 py-6 text-center">
            <p class="text-beige-700 text-base leading-relaxed mb-5">{medical.saleText}</p>
            <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-5 px-6 mb-5">
              <p class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 tracking-wider">{medical.discountLabel}</p>
            </div>
            <a
              href={medicalCta}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
            >
              {medical.ctaLabel}
            </a>
            <p class="text-beige-500 text-xs mt-4">{medical.footnote}</p>
          </div>
        </Fragment>
      )}
    </div>
  </div>

  <script>
    (function () {
      var overlay = document.getElementById('campaign-popup-overlay');
      if (!overlay) return;

      // Phase boundaries as epoch milliseconds, resolved server-side in the
      // campaign time zone — never re-derived from the visitor's clock, so the
      // popup and the landing page change phase at the same moment.
      var jubileeTeaserStart = Number(overlay.dataset.jubileeTeaserStart);
      var jubileeSaleStart = Number(overlay.dataset.jubileeSaleStart);
      var jubileeSaleEnd = Number(overlay.dataset.jubileeSaleEnd);
      var summerTeaserStart = Number(overlay.dataset.summerTeaserStart);
      var summerSaleStart = Number(overlay.dataset.summerSaleStart);
      var summerSaleEnd = Number(overlay.dataset.summerSaleEnd);

      var medicalEnabled = overlay.dataset.medicalEnabled === '1';
      var medicalTeaserStart = Number(overlay.dataset.medicalTeaserStart);
      var medicalSaleStart = Number(overlay.dataset.medicalSaleStart);
      var medicalSaleEnd = Number(overlay.dataset.medicalSaleEnd);

      var now = Date.now();
      var phase = null;
      var countdownTarget = null;

      // ?campaignPreview=<phase> renders any card on demand for review, ignoring the
      // date windows, the per-campaign enabled flag and the dismissal/session locks.
      var preview = null;
      try { preview = new URLSearchParams(window.location.search).get('campaignPreview'); } catch (e) {}

      if (preview) {
        phase = preview;
      } else if (now >= jubileeSaleStart && now <= jubileeSaleEnd) {
        phase = 'jubilee-active';
      } else if (now >= summerSaleStart && now <= summerSaleEnd) {
        phase = 'summer-active';
      } else if (medicalEnabled && now >= medicalSaleStart && now <= medicalSaleEnd) {
        phase = 'medical-active';
      } else if (now >= jubileeTeaserStart && now < jubileeSaleStart) {
        phase = 'jubilee-teaser';
      } else if (now >= summerTeaserStart && now < summerSaleStart) {
        phase = 'summer-teaser';
      } else if (medicalEnabled && now >= medicalTeaserStart && now < medicalSaleStart) {
        phase = 'medical-teaser';
      }

      if (!phase) return;

      var campaignKey = phase.split('-')[0];
      if (phase.indexOf('-teaser') > 0) {
        countdownTarget = campaignKey === 'jubilee' ? jubileeSaleStart
          : campaignKey === 'summer' ? summerSaleStart
          : medicalSaleStart;
      }

      var storageKey = 'campaign-' + phase + '-dismissed';
      if (!preview) {
        try { if (localStorage.getItem(storageKey)) return; } catch (e) {}
      }

      var card = overlay.querySelector('[data-card="' + phase + '"]');
      if (!card) return;
      card.classList.remove('hidden');

      if (countdownTarget) {
        var countdownEl = card.querySelector('[data-countdown="' + campaignKey + '"]');
        var doneText = overlay.dataset.countdownDone || 'Ready!';
        if (countdownEl) {
          var update = function () {
            var diff = countdownTarget - Date.now();
            if (diff <= 0) { countdownEl.textContent = doneText; return; }
            var days = Math.floor(diff / 86400000);
            var hours = Math.floor((diff % 86400000) / 3600000);
            var mins = Math.floor((diff % 3600000) / 60000);
            var secs = Math.floor((diff % 60000) / 1000);
            var parts = [];
            if (days > 0) parts.push(days + 'd');
            parts.push(hours + 'h');
            parts.push(mins + 'm');
            parts.push(secs + 's');
            countdownEl.textContent = parts.join(' ');
          };
          update();
          setInterval(update, 1000);
        }
      }

      function show() {
        // Shared one-modal-per-session lock, claimed only when actually showing
        // (an eager claim would suppress the popup for the whole session if the
        // visitor navigated away during the delay). Campaign wins over
        // PromoPopup/BookingPopup via its shorter show delay. A preview claims
        // no lock, so reviewers can reload the same page repeatedly.
        if (!preview) {
          try {
            if (sessionStorage.getItem('ml-modal-shown')) return;
            sessionStorage.setItem('ml-modal-shown', '1');
            sessionStorage.setItem('booking-popup-dismissed', '1');
          } catch (e) {}
        }
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      }

      function hide() {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        if (!preview) {
          try { localStorage.setItem(storageKey, '1'); } catch (e) {}
        }
      }

      var closeButtons = card.querySelectorAll('.campaign-close');
      for (var i = 0; i < closeButtons.length; i++) {
        closeButtons[i].addEventListener('click', hide);
      }

      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) hide();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') hide();
      });

      setTimeout(show, preview ? 300 : 8000);
    })();
  </script>
)}
