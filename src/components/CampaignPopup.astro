        <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-5 px-6 mb-5">
          <p class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 tracking-wider">{campaign.jubilee.discountLabel}</p>
        </div>
        <a
