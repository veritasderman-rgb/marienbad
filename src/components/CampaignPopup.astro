---
/**
 * CampaignPopup — site-wide promo popup for Jubilee Sale (1.–6. 6. 2026, −25 %),
 * Summer Sale (9.–17. 6. 2026, −25 %) and Medical Promo (22.–30. 9. 2026, −25 %).
 *
 * Phases (priority when windows overlap: jubilee > summer > medical):
 *  - jubilee-teaser:   teaserStart .. dayBefore(saleStart)
 *  - jubilee-active:   saleStart   .. saleEnd
 *  - summer-teaser:    teaserStart .. dayBefore(saleStart)   (skipped if jubilee-active)
 *  - summer-active:    saleStart   .. saleEnd
 *  - medical-teaser:   teaserStart .. dayBefore(saleStart)   (only while medicalPromo.enabled)
 *  - medical-active:   saleStart   .. saleEnd                (only while medicalPromo.enabled)
 *  - none:             outside all windows → component renders empty
 *
 * All dates/copy come from src/content/campaigns/{locale}.json (Keystatic-managed).
 * Per-phase dismissal in localStorage so closing one phase doesn't hide the next.
 *
 * Reviewing an off-season or not-yet-live phase: append ?campaignPreview=<phase>
 * (e.g. ?campaignPreview=medical-teaser) to any page. That bypasses the date
 * windows, the per-campaign enabled flag and the dismissal/session locks, and
 * shows the card immediately.
 */
import type { Locale } from '@/i18n/config'
import { t } from '@/i18n/ui'
import { campaignDayEnd, campaignDayStart, getCampaign, withUtmMedium } from '@/lib/campaign'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const campaign = getCampaign(locale)

const labels = {
  close: t(locale, 'campaign.popup.close'),
  countdown: t(locale, 'campaign.popup.countdown'),
  countdownDone: t(locale, 'campaign.popup.countdownDone'),
}

const jubileeHeadlineParts = campaign.jubilee.headline.split('\n')
const summerHeadlineParts = campaign.summerSale.headline.split('\n')

const gradientFallback = 'background: linear-gradient(135deg, #004F71 0%, #3199b3 100%);'
const jubileeHeaderStyle = campaign.jubilee.image
  ? `background: linear-gradient(180deg, rgba(0,79,113,0.25) 0%, rgba(0,79,113,0.85) 100%), url('${campaign.jubilee.image}') center / cover no-repeat; min-height: 220px;`
  : gradientFallback
const summerHeaderStyle = campaign.summerSale.image
  ? `background: linear-gradient(180deg, rgba(0,79,113,0.25) 0%, rgba(0,79,113,0.85) 100%), url('${campaign.summerSale.image}') center / cover no-repeat; min-height: 220px;`
  : gradientFallback
const jubileeImgAlt = campaign.jubilee.imageAlt ?? campaign.jubilee.eyebrow
const summerImgAlt = campaign.summerSale.imageAlt ?? campaign.summerSale.eyebrow

// Summer Sale popup creative — per-locale square social banner with all the
// headline/discount copy baked into the image. When present, the summer cards
// render image-forward (full banner + CTA) instead of the gradient + text card.
const summerPopupImage = campaign.summerSale.popupImage
const summerPopupAlt = campaign.summerSale.popupImageAlt ?? summerImgAlt
// Accessible text equivalent for the image-forward popup: the creative bakes
// the headline/discount into the image, so expose the offer specifics (stay
// period, sale window, booking conditions) as sr-only copy for screen readers
// and image-load-failure fallback.
const summerStayLine = campaign.summerSale.landingStayPeriodLabel && campaign.summerSale.stayPeriod
  ? `${campaign.summerSale.landingStayPeriodLabel}: ${campaign.summerSale.stayPeriod}`
  : (campaign.summerSale.stayPeriod ?? '')
const summerConditions = campaign.summerSale.conditions ?? []

// Medical Promo — same two-phase shape as Summer Sale. Cards are always rendered
// so ?campaignPreview= can show them before the campaign goes live; the enabled
// flag only gates the date-driven path in the script below.
const medical = campaign.medicalPromo
const medicalHeadlineParts = medical.headline.split('\n')
const medicalHeaderStyle = medical.image
  ? `background: linear-gradient(180deg, rgba(0,79,113,0.25) 0%, rgba(0,79,113,0.85) 100%), url('${medical.image}') center / cover no-repeat; min-height: 220px;`
  : gradientFallback
const medicalImgAlt = medical.imageAlt || medical.eyebrow
const medicalPopupImage = medical.popupImage
const medicalPopupAlt = medical.popupImageAlt || medicalImgAlt
const medicalStayLine = medical.landingStayPeriodLabel && medical.stayPeriod
  ? `${medical.landingStayPeriodLabel}: ${medical.stayPeriod}`
  : (medical.stayPeriod ?? '')
const medicalConditions = medical.conditions ?? []

// Every click here is a popup click, whatever the stored URL says.
const medicalTeaserCta = withUtmMedium(medical.teaserCtaUrl, 'popup')
const medicalCta = withUtmMedium(medical.ctaUrl, 'popup')

// Phase boundaries are resolved server-side in the campaign time zone and handed
// to the script as epoch milliseconds, so every visitor switches phase at the
// same moment and in step with the landing page.
const windows = {
  jubileeTeaserStart: campaignDayStart(campaign.jubilee.teaserStart).getTime(),
  jubileeSaleStart: campaignDayStart(campaign.jubilee.saleStart).getTime(),
  jubileeSaleEnd: campaignDayEnd(campaign.jubilee.saleEnd).getTime(),
  summerTeaserStart: campaignDayStart(campaign.summerSale.teaserStart).getTime(),
  summerSaleStart: campaignDayStart(campaign.summerSale.saleStart).getTime(),
  summerSaleEnd: campaignDayEnd(campaign.summerSale.saleEnd).getTime(),
  medicalTeaserStart: campaignDayStart(medical.teaserStart).getTime(),
  medicalSaleStart: campaignDayStart(medical.saleStart).getTime(),
  medicalSaleEnd: campaignDayEnd(medical.saleEnd).getTime(),
}
---

{campaign.popupEnabled && (
  <div
    id="campaign-popup-overlay"
    class="fixed inset-0 z-[60] bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    data-jubilee-teaser-start={windows.jubileeTeaserStart}
    data-jubilee-sale-start={windows.jubileeSaleStart}
    data-jubilee-sale-end={windows.jubileeSaleEnd}
    data-summer-teaser-start={windows.summerTeaserStart}
    data-summer-sale-start={windows.summerSaleStart}
    data-summer-sale-end={windows.summerSaleEnd}
    data-medical-enabled={medical.enabled ? '1' : '0'}
    data-medical-teaser-start={windows.medicalTeaserStart}
    data-medical-sale-start={windows.medicalSaleStart}
    data-medical-sale-end={windows.medicalSaleEnd}
    data-countdown-done={labels.countdownDone}
  >
    {/* ============== JUBILEE — TEASER ============== */}
    <div data-card="jubilee-teaser" class="campaign-card hidden relative bg-white rounded-2xl shadow-2xl overflow-hidden max-w-md w-full transition-transform duration-300 scale-95">
      <div class="px-6 pt-8 pb-10 text-center text-white relative flex flex-col justify-end" style={jubileeHeaderStyle} role={campaign.jubilee.image ? 'img' : undefined} aria-label={campaign.jubilee.image ? jubileeImgAlt : undefined}>
        <button class="campaign-close absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/15 hover:bg-white/25 transition-colors cursor-pointer" aria-label={labels.close}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <p class="text-turquoise-200 text-xs font-semibold tracking-[0.2em] uppercase mb-3">{campaign.jubilee.eyebrow}</p>
        <h2 class="font-heading text-2xl md:text-3xl font-bold leading-tight">
          {jubileeHeadlineParts[0]}{jubileeHeadlineParts[1] && (<><br/>{jubileeHeadlineParts[1]}</>)}
        </h2>
      </div>
      <div class="px-6 py-6 text-center">
        <p class="text-beige-700 text-base leading-relaxed mb-6">{campaign.jubilee.teaserText}</p>
        <div class="border-2 border-dashed border-turquoise-300 bg-beige-50 rounded-xl py-4 px-6 mb-5">
          <p class="text-turquoise-600 text-xs font-semibold tracking-[0.2em] uppercase mb-1">{labels.countdown}</p>
          <p data-countdown="jubilee" class="font-heading text-2xl md:text-3xl font-bold text-indigo-700">...</p>
        </div>
        <a
          href={campaign.jubilee.ctaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block w-full bg-yellow-400 hover:bg-yellow-500 text-indigo-900 font-bold py-3.5 px-6 rounded-full text-center transition-colors"
        >
          {campaign.jubilee.ctaLabel}
        </a>
        <p class="text-beige-500 text-xs mt-4">{campaign.jubilee.footnote}</p>
      </div>
    </div>

    {/* ============== JUBILEE — ACTIVE ============== */}
    <div data-card="jubilee-active" class="campaign-card hidden relative bg-white rounded-2xl shadow-2xl overflow-hidden max-w-md w-full transition-transform duration-300 scale-95">
