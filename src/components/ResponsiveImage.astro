---
import { lookup } from '@/lib/imageOptim'

interface Props {
  src: string
  alt: string
  width?: number
  height?: number
  class?: string
  loading?: 'lazy' | 'eager'
  sizes?: string
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  sizes = '100vw',
} = Astro.props

const optim = lookup(src)
// Fall back to intrinsic dimensions from the WebP manifest to prevent CLS
const imgWidth = width ?? optim.width
const imgHeight = height ?? optim.height
---

{optim.webpSrcset ? (
  <picture>
    <source type="image/webp" srcset={optim.webpSrcset} sizes={sizes} />
    <img
      src={src}
      alt={alt}
      width={imgWidth}
      height={imgHeight}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class:list={['transition-opacity duration-300', className]}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={imgWidth}
    height={imgHeight}
    loading={loading}
    decoding="async"
    sizes={sizes}
    class:list={['transition-opacity duration-300', className]}
  />
)}
