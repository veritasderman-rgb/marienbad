---
/**
 * Stránka o úhradě lázeňské léčby ze zahraničí.
 *
 * Struktura je záměrně jiná než u diagnóz: hned pod nadpisem stojí krátká přímá
 * odpověď, protože právě tu asistenti citují. Teprve pod ní jsou jednotlivé
 * cesty k úhradě s právní oporou.
 */
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ArticleSources from '@/components/ArticleSources.astro'
import type { FundingContent, FundingLocale } from '@/data/funding'
import { t } from '@/i18n/ui'

interface Props {
  locale: FundingLocale
  content: FundingContent
}

const { locale, content: c } = Astro.props

const ui = {
  de: { answer: 'Kurz gesagt', who: 'Für wen', covers: 'Was übernommen wird', steps: 'Was Sie tun müssen', basis: 'Rechtsgrundlage', faq: 'Häufige Fragen', more: 'Weiterlesen' },
  en: { answer: 'In short', who: 'Who it applies to', covers: 'What is covered', steps: 'What you need to do', basis: 'Legal basis', faq: 'Frequently asked questions', more: 'Read more' },
  ru: { answer: 'Коротко', who: 'Кому подходит', covers: 'Что покрывается', steps: 'Что нужно сделать', basis: 'Правовое основание', faq: 'Частые вопросы', more: 'Читать дальше' },
}[locale]
---

<section class="relative bg-indigo-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.12)_0%,_transparent_60%)]"></div>
  <div class="relative container-wide pt-28 pb-14 md:pt-36 md:pb-16">
    <Breadcrumbs items={[{ label: t(locale, 'nav.home'), href: `/${locale}` }, { label: c.navLabel }]} locale={locale} />
    <h1 class="font-heading text-3xl md:text-5xl font-bold mb-5 leading-tight" style="font-size: var(--text-h1);">{c.h1}</h1>
    <p class="text-white/85 text-lg md:text-xl leading-relaxed max-w-3xl">{c.lead}</p>
  </div>
</section>

<div class="container-wide py-14 md:py-20 flex flex-col gap-14 md:gap-20">

  <section class="bg-turquoise-50 border-l-4 border-turquoise-400 px-6 py-6 md:px-8 md:py-7 rounded-r-xl">
    <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-3">{ui.answer}</h2>
    <p class="text-beige-900 text-base md:text-lg leading-relaxed m-0">{c.shortAnswer}</p>
  </section>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{c.routesHeading}</h2>
    <div class="flex flex-col gap-6">
      {c.routes.map((route) => (
        <article class="bg-white border border-beige-200 p-6 md:p-8" style="border-radius: var(--radius-card);">
          <h3 class="font-heading text-xl font-bold text-indigo-700 mb-5">{route.name}</h3>
          <dl class="grid gap-4 sm:grid-cols-2 m-0 mb-5">
            <div>
              <dt class="text-turquoise-700 text-xs font-bold uppercase tracking-wider mb-1.5">{ui.who}</dt>
              <dd class="text-beige-800 text-base leading-relaxed m-0">{route.who}</dd>
            </div>
            <div>
              <dt class="text-turquoise-700 text-xs font-bold uppercase tracking-wider mb-1.5">{ui.covers}</dt>
              <dd class="text-beige-800 text-base leading-relaxed m-0">{route.covers}</dd>
            </div>
          </dl>
          <p class="text-turquoise-700 text-xs font-bold uppercase tracking-wider mb-2">{ui.steps}</p>
          <ol class="flex flex-col gap-2 pl-5 m-0 mb-5 text-beige-800 text-base leading-relaxed">
            {route.steps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="text-beige-700 text-sm leading-relaxed m-0 bg-beige-100 border border-beige-200 px-4 py-3 rounded-lg">
            <span class="font-semibold">{ui.basis}:</span> {route.basis}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{c.selfPayHeading}</h2>
    <p class="text-beige-800 text-base md:text-lg leading-relaxed">{c.selfPayBody}</p>
    <p class="text-beige-900 text-base leading-relaxed mt-5 bg-beige-100 border border-beige-200 px-5 py-4 rounded-xl">{c.disclaimer}</p>
  </section>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{ui.faq}</h2>
    <div class="flex flex-col gap-3">
      {c.faqs.map((faq) => (
        <details class="group bg-white border border-beige-200 rounded-xl overflow-hidden">
          <summary class="cursor-pointer list-none px-5 py-4 font-heading font-semibold text-indigo-700 flex items-center justify-between gap-4">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="px-5 pb-5 pt-0 text-beige-800 text-base leading-relaxed m-0">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  {c.related.length > 0 && (
    <nav aria-label={ui.more}>
      <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
        {c.related.map((r) => (
          <li class="m-0">
            <a href={r.href} class="inline-flex items-center gap-2 border border-indigo-200 text-indigo-700 font-semibold px-5 py-2.5 rounded-full hover:bg-indigo-50 transition-colors text-sm">{r.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <ArticleSources locale={locale} sources={c.sources} medicalReviewDate={c.reviewDate} />

</div>
