---
/**
 * Detail page body for a single day-trip destination: photo hero, key facts,
 * map, nearby destinations and related magazine articles. Rendered by the
 * prerendered /{locale}/{day-trips}/{id} routes.
 */
import type { Locale } from '@/i18n/config'
import { routes } from '@/i18n/config'
import { t } from '@/i18n/ui'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { dayTrips, TRIP_ORIGIN, tripDifficultyOrder, type DayTrip, type TripCategory, type TripDifficulty, type TripTag } from '@/data/dayTrips'
import { articlesForTrip } from '@/data/tripArticles'
import { tripLongDescriptions, tripGalleries } from '@/data/tripDetails'

interface Props {
  locale: Locale
  trip: DayTrip
}

const { locale, trip } = Astro.props

const catalogHref = `/${locale}/${routes['day-trips'][locale]}`
const magazineBase = `/${locale}/${routes.magazine[locale]}`
const detailHref = (id: string) => `${catalogHref}/${id}`

const ui: Record<Locale, Record<string, string>> = {
  de: {
    catalog: 'Ausflüge',
    facts: 'Auf einen Blick',
    drive: 'Fahrzeit',
