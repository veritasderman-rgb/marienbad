    mapLink: 'Auf Mapy.com öffnen',
    website: 'Offizielle Webseite',
    mapTitle: 'Karte',
    about: 'Über den Ort',
    gallery: 'Galerie',
    nearby: 'In der Nähe',
    nearbyAway: 'entfernt',
    reading: 'Zum Weiterlesen',
