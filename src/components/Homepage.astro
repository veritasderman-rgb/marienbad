---
import { routes, type Locale } from '@/i18n/config'
import BookingPopup from '@/components/BookingPopup.astro'
import PromoPopup from '@/components/PromoPopup.astro'
import HeroSection from '@/components/HeroSection.astro'
import Pic from '@/components/Pic.astro'
import SectionCard from '@/components/SectionCard.astro'
import WaveDivider from '@/components/WaveDivider.astro'
import PartnerStrip from '@/components/PartnerStrip.astro'
import { t } from '@/i18n/ui'
import { localizedHref } from '@/i18n/utils'
import { getHomepage, getArticles, getItineraries } from '@/content/reader'
import { getCampaign } from '@/lib/campaign'
import GoogleReviews from '@/components/GoogleReviews.tsx'
import ItineraryFilter from '@/components/ItineraryFilter.tsx'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const cms = await getHomepage(locale)

// Dynamically fetch the 3 most recent articles (sorted by date descending in reader)
const allArticles = await getArticles(locale)
const latestArticles = allArticles.slice(0, 3)

// Popup coordination: CampaignPopup (rendered site-wide from Base.astro) takes
// priority over the homepage-only PromoPopup/BookingPopup. Mirror its phase
// windows (teaserStart..saleEnd per campaign) so we don't stack two modals.
const campaign = getCampaign(locale)
const campaignFrom = (s: string) => new Date(`${s}T00:00:00`)
const campaignUntil = (s: string) => new Date(`${s}T23:59:59.999`)
const now = new Date()
const campaignPopupActive = campaign.popupEnabled && (
  (now >= campaignFrom(campaign.jubilee.teaserStart) && now <= campaignUntil(campaign.jubilee.saleEnd)) ||
  (now >= campaignFrom(campaign.summerSale.teaserStart) && now <= campaignUntil(campaign.summerSale.saleEnd))
)

const itineraries = getItineraries()
const ensanaHotelPath: Record<Locale, string> = { de: 'hotels', en: 'hotels', cs: 'hotely', ru: 'oteli' }

const categoryLabels: Record<string, Record<Locale, string>> = {
  health: { de: 'Gesundheit', en: 'Health', cs: 'Zdraví', ru: 'Здоровье' },
  wellness: { de: 'Wellness', en: 'Wellness', cs: 'Wellness', ru: 'Велнес' },
  planning: { de: 'Planung', en: 'Planning', cs: 'Plánování', ru: 'Планирование' },
  culture: { de: 'Kultur', en: 'Culture', cs: 'Kultura', ru: 'Культура' },
  tip: { de: 'Tipp', en: 'Tip', cs: 'Tip', ru: 'Совет' },
  nature: { de: 'Natur', en: 'Nature', cs: 'Příroda', ru: 'Природа' },
  history: { de: 'Geschichte', en: 'History', cs: 'Historie', ru: 'История' },
  food: { de: 'Genuss', en: 'Food', cs: 'Jídlo', ru: 'Еда' },
}

const gradients = [
  'linear-gradient(135deg, #3D1F3D 0%, #266782 100%)',
  'linear-gradient(135deg, #3D1F3D 0%, #004F71 100%)',
  'linear-gradient(135deg, #3D1F3D 0%, #3A8BA8 100%)',
]
---

<!-- 1. HERO -->
<HeroSection
  title={cms.hero.title}
  subtitle={cms.hero.subtitle}
  ctaText={cms.hero.ctaText}
  ctaHref={cms.hero.ctaHref}
  ctaText2={(cms.hero as any).ctaText2}
  ctaHref2={(cms.hero as any).ctaHref2}
  badges={cms.hero.badges}
  image={(cms.hero as any).image}
/>

<!-- 1b. EMOTIONAL BLOCK -->
{(cms as any).emotionalBlock && (
  <section class="py-10 md:py-14 bg-beige-100 text-center">
    <div class="container-wide max-w-3xl mx-auto reveal">
      <p class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-3 leading-snug" style="font-size: var(--text-h3);">
        {(cms as any).emotionalBlock.headline}
      </p>
      <p class="text-beige-700 text-lg leading-relaxed">
        {(cms as any).emotionalBlock.text}
      </p>
    </div>
  </section>
)}

<!-- 2. QUICK FACTS STRIP -->
<section class="relative z-10 reveal">
  <div class="container-wide">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {cms.quickFacts.map((fact, i) => {
        const factIcons = [
          /* Mineral Spring — stylized fountain with water drops */
          `<path d="M12 2v6" stroke-linecap="round"/>
           <path d="M12 8c0 0-3 2-3 5a3 3 0 006 0c0-3-3-5-3-5z"/>
           <path d="M8 20c0-2.2 1.8-4 4-4s4 1.8 4 4" stroke-linecap="round"/>
           <path d="M6 22h12" stroke-linecap="round"/>
           <circle cx="8" cy="5" r="0.8" fill="currentColor" stroke="none"/>
           <circle cx="16" cy="4" r="0.8" fill="currentColor" stroke="none"/>
           <circle cx="15" cy="7" r="0.6" fill="currentColor" stroke="none"/>`,
          /* UNESCO — heritage temple/monument */
          `<path d="M3 21h18" stroke-linecap="round"/>
           <path d="M5 21V11" stroke-linecap="round"/>
           <path d="M19 21V11" stroke-linecap="round"/>
           <path d="M9 21V11" stroke-linecap="round"/>
           <path d="M15 21V11" stroke-linecap="round"/>
           <path d="M12 3l9 8H3l9-8z"/>
           <circle cx="12" cy="7" r="1.5"/>`,
          /* 1812 Spa tradition — historic bath/thermal vessel */
          `<path d="M4 12h16" stroke-linecap="round"/>
           <path d="M6 12v5a6 6 0 0012 0v-5" stroke-linecap="round"/>
           <path d="M8 8c0-1 .5-2 1.5-2s1.5 1 1.5 2" stroke-linecap="round"/>
           <path d="M11 6c0-1 .5-2 1.5-2s1.5 1 1.5 2" stroke-linecap="round"/>
           <path d="M14 8c0-1 .5-2 1.5-2s1.5 1 1.5 2" stroke-linecap="round"/>
           <circle cx="12" cy="17" r="1.5"/>`,
          /* Golf — flag on green with ball */
          `<path d="M12 2v16" stroke-linecap="round"/>
           <path d="M12 2l7 4-7 4z" fill="currentColor" stroke="none"/>
           <circle cx="12" cy="20" r="2"/>
           <circle cx="7" cy="19" r="1.2" fill="currentColor" stroke="none"/>
           <path d="M4 22c2-2 6-3 8-3s6 1 8 3" stroke-linecap="round"/>`,
        ]
        const Tag = fact.href ? 'a' : 'div'
        return (
          <Tag href={fact.href} class="bg-white rounded-xl shadow-card p-5 md:p-6 text-center card-hover reveal block group transition-shadow hover:shadow-lg">
            <div class="w-10 h-10 mx-auto mb-2 text-turquoise-600 transition-transform group-hover:scale-110">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10" set:html={factIcons[i % 4]} />
            </div>
            <div class="font-heading text-lg md:text-xl font-bold text-indigo-500">{fact.value}</div>
            <div class="text-sm text-beige-600">{fact.label}</div>
          </Tag>
        )
      })}
    </div>
  </div>
</section>

<!-- 3. FOUR HEALING ELEMENTS -->
<section class="bg-indigo-700 text-white py-20 md:py-28 mt-12 md:mt-16">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-14 reveal">
      <span class="text-turquoise-300 text-sm font-medium tracking-widest uppercase">{cms.healingElements.sectionLabel}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold mt-4 mb-4" style="font-size: var(--text-h2);">{cms.healingElements.title}</h2>
      <p class="text-white/70 text-lg">{cms.healingElements.description}</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6">
      {cms.healingElements.items.map((item, i) => {
        const icons = [
          /* Water/Drop */ 'M12 21.5c-3.04 0-5.5-2.46-5.5-5.5 0-3.91 5.5-11.5 5.5-11.5s5.5 7.59 5.5 11.5c0 3.04-2.46 5.5-5.5 5.5z',
          /* Earth/Leaf */ 'M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66L7 18.5C9 14 13 12 17 12V8zM3.82 21.34C5.9 16.17 8 10 17 8v4c-4 0-8 2-10 6.5l-1.29 3.5',
          /* Gas/Bubbles */ 'M12 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm-3.5 9.5c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm8 1c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zm-3 4c.83 0 1.5.67 1.5 1.5S14.33 20.5 13.5 20.5 12 19.83 12 19s.67-1.5 1.5-1.5z',
          /* Climate/Sun */ 'M12 7a5 5 0 100 10 5 5 0 000-10zM12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42',
        ]
        const ElTag = item.href ? 'a' : 'div'
        return (
          <ElTag href={item.href} class="bg-white/10 backdrop-blur-sm rounded-xl p-4 md:p-6 text-center card-hover reveal block group transition-all hover:bg-white/15">
            <div class="w-12 h-12 md:w-16 md:h-16 mx-auto mb-2 md:mb-4 rounded-xl md:rounded-2xl bg-turquoise-400/20 flex items-center justify-center transition-transform group-hover:scale-110">
              <svg class="w-6 h-6 md:w-8 md:h-8 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[i % 4]} />
              </svg>
            </div>
            <h3 class="font-heading text-base md:text-xl font-bold mb-1 md:mb-2">{item.name}</h3>
            <p class="text-white/70 text-xs md:text-sm leading-relaxed hidden md:block">{item.description}</p>
          </ElTag>
        )
      })}
    </div>
  </div>
</section>

<WaveDivider variant="white-on-indigo" />

<!-- 4. DISCOVER THE TOWN -->
<section id="discover" class="py-16 md:py-24 bg-white">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-14 reveal">
      <div class="divider-ornament mb-6">
        <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">{cms.discover.sectionLabel}</span>
      </div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mb-4" style="font-size: var(--text-h2);">{cms.discover.title}</h2>
      <p class="text-beige-700 text-lg leading-relaxed">{cms.discover.description}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 reveal">
      <SectionCard title={t(locale, 'home.springs')} description={t(locale, 'home.springsDesc')} href={localizedHref(locale, 'mineral-springs')} icon="springs" variant="indigo" />
      <SectionCard title={t(locale, 'home.thingsToDo')} description={t(locale, 'home.thingsToDoDesc')} href={localizedHref(locale, 'things-to-do')} icon="activities" variant="turquoise" />
      <SectionCard title={t(locale, 'home.history')} description={t(locale, 'home.historyDesc')} href={localizedHref(locale, 'history')} icon="history" variant="dark" />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mt-6 lg:mt-8 reveal">
      {locale === 'cs' && <SectionCard title={t(locale, 'home.podcast')} description={t(locale, 'home.podcastDesc')} href={localizedHref(locale, 'podcast')} icon="podcast" variant="beige" />}
      <SectionCard title={t(locale, 'home.magazine')} description={t(locale, 'home.magazineDesc')} href={localizedHref(locale, 'magazine')} icon="magazine" variant="turquoise" />
      <SectionCard title={t(locale, 'home.events')} description={t(locale, 'home.eventsDesc')} href={locale === 'cs' ? 'https://news.lazneml.cz/' : `https://news.lazneml.cz/index.php?lang=${locale === 'de' ? 'DE' : locale === 'ru' ? 'RU' : 'EN'}&days=7&daysOffset=0`} icon="events" variant="dark" />
    </div>
  </div>
</section>

<!-- 5. WHERE TO STAY -->
<section class="bg-beige-200 py-16 md:py-24">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-14 reveal">
      <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">{cms.hotels.sectionLabel}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h2);">{cms.hotels.title}</h2>
      <p class="text-beige-700 text-lg">{cms.hotels.description}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto reveal">
      {cms.hotels.items.map((hotel) => (
        <div class="bg-white rounded-xl overflow-hidden shadow-card card-hover reveal">
          <div class="h-48 relative overflow-hidden" class:list={[(hotel as any).image ? '' : 'placeholder-image']}>
            {(hotel as any).image ? (
              <Pic src={(hotel as any).image} alt={hotel.name} class="w-full h-full object-cover" sizes="(max-width: 768px) 100vw, 50vw" />
            ) : (
              <span class="text-white/80 text-sm absolute inset-0 flex items-center justify-center">{hotel.name} — Foto</span>
            )}
            <div class="absolute top-3 left-3 flex gap-2">
              <span class="px-2.5 py-1 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full">{'★'.repeat(hotel.stars)}</span>
              {hotel.badge && <span class="px-2.5 py-1 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full">{hotel.badge}</span>}
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-heading text-xl font-bold text-indigo-700 mb-2">{hotel.name}</h3>
            <p class="text-beige-700 text-sm mb-3">{hotel.description}</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {hotel.tags.map((tag) => (
                <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">{tag}</span>
              ))}
            </div>
            <a href={hotel.bookingUrl} class="inline-flex items-center gap-1.5 text-indigo-500 hover:text-indigo-700 text-sm font-semibold transition-colors" target="_blank" rel="noopener noreferrer">
              {hotel.bookingLabel}
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            {(hotel as any).anniversaryUrl && (
              <a href={(hotel as any).anniversaryUrl} class="inline-flex items-center gap-1.5 text-yellow-600 hover:text-yellow-800 text-sm font-semibold transition-colors ml-4">
                {(hotel as any).anniversaryLabel}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={localizedHref(locale, 'accommodation')} class="btn-ghost">{cms.hotels.allHotelsLabel}</a>
    </div>
  </div>
</section>

<!-- 5b. PERSONALIZED ITINERARIES -->
<section class="py-16 md:py-24 bg-beige-100">
  <div class="container-wide reveal">
    <div class="divider-ornament mb-6">
      <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">{t(locale, 'itinerary.title')}</span>
    </div>
    <ItineraryFilter
      client:visible
      locale={locale}
      translations={{
        title: t(locale, 'itinerary.title'),
        subtitle: t(locale, 'itinerary.subtitle'),
        families: t(locale, 'itinerary.families'),
        couples: t(locale, 'itinerary.couples'),
        solo: t(locale, 'itinerary.solo'),
        wellness: t(locale, 'itinerary.wellness'),
        hotelLabel: t(locale, 'itinerary.hotelLabel'),
        activitiesLabel: t(locale, 'itinerary.activitiesLabel'),
        treatmentLabel: t(locale, 'itinerary.treatmentLabel'),
        detailsLink: t(locale, 'itinerary.detailsLink'),
      }}
      cmsData={itineraries}
    />
  </div>
</section>

<!-- 6. PEOPLE OF COLONNADE — hidden until content is ready
<section class="bg-aubergine-900 text-white py-20 md:py-28">
  ...
</section>
-->

<!-- GOOGLE REVIEWS -->
<GoogleReviews
  client:visible
  locale={locale}
  translations={{
    title: t(locale, 'reviews.title'),
    moreOnGoogle: t(locale, 'reviews.moreOnGoogle'),
  }}
/>

<!-- 7. SEASONAL HIGHLIGHT -->
<section class="py-16 md:py-24 bg-white">
  <div class="container-wide">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center reveal">
      <div class="rounded-xl h-72 lg:h-96 relative overflow-hidden" class:list={[(cms.seasonal as any).image ? '' : 'placeholder-image']}>
        {(cms.seasonal as any).image ? (
          <Pic src={(cms.seasonal as any).image} alt={cms.seasonal.title} class="w-full h-full object-cover" sizes="(max-width: 768px) 100vw, 50vw" />
        ) : (
          <span class="text-white/80 text-sm absolute inset-0 flex items-center justify-center">Seasonal — Foto</span>
        )}
        <div class="absolute top-4 left-4">
          <span class="px-3 py-1 bg-turquoise-400 text-indigo-900 text-xs font-semibold uppercase tracking-wider rounded-full">{cms.seasonal.badge}</span>
        </div>
      </div>
      <div>
        <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">{cms.seasonal.season}</span>
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h3);">{cms.seasonal.title}</h2>
        <p class="text-beige-700 text-lg leading-relaxed mb-6">{cms.seasonal.description}</p>
        <a href={localizedHref(locale, 'things-to-do')} class="btn-secondary">
          {cms.seasonal.ctaText}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<WaveDivider variant="beige-on-white" />

<!-- 8. MAGAZINE PREVIEW -->
<section class="bg-beige-200 py-16 md:py-24">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-14 reveal">
      <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">{cms.magazine.sectionLabel}</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h2);">{cms.magazine.title}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestArticles.map((article) => (
        <a href={`/${locale}/${routes['magazine'][locale]}/${article.slug.replace(/^[a-z]{2}-/, '')}`} class="group bg-white rounded-xl overflow-hidden shadow-card card-hover reveal block">
          {article.coverImage && (
            <div class="h-44 relative overflow-hidden">
              <Pic src={article.coverImage} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
            </div>
          )}
          <div class="p-5">
            <h3 class="font-heading text-xl font-bold text-indigo-700 group-hover:text-turquoise-600 transition-colors mb-2">{article.title}</h3>
            <span class="text-beige-500 text-[0.6875rem] font-medium uppercase tracking-wider">{categoryLabels[article.category]?.[locale] ?? article.category}</span>
            <p class="text-beige-700 text-sm leading-relaxed line-clamp-2">{article.excerpt}</p>
            <div class="mt-3 text-beige-600 text-xs">{article.readingTime}</div>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href={localizedHref(locale, 'magazine')} class="btn-ghost">{cms.magazine.sectionLabel}</a>
    </div>
  </div>
</section>

<!-- 8b. PARTNER STRIP (CS only) -->
{locale === 'cs' && <PartnerStrip locale={locale} />}

<!-- 9. EMAIL CAPTURE -->
<section class="py-16 md:py-24 reveal" style="background: linear-gradient(135deg, #004F71 0%, #1A1916 100%);">
  <div class="container-wide">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4" style="font-size: var(--text-h2);">{cms.newsletter.title}</h2>
      <p class="text-white/70 text-lg mb-8">{cms.newsletter.description}</p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" action="#" method="POST" data-locale={locale} data-ga-form="newsletter">
        <!-- Honeypot field (hidden from real users, bots will fill it) -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;height:0;width:0;overflow:hidden;">
          <label for="newsletter-website">Website</label>
          <input id="newsletter-website" type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <!-- Timestamp for timing-based bot detection -->
        <input type="hidden" id="newsletter-ts" name="_ts" value="" />
        <label for="newsletter-email" class="sr-only">{cms.newsletter.placeholder}</label>
        <input id="newsletter-email" type="email" placeholder={cms.newsletter.placeholder} required class="flex-1 px-5 py-3 rounded-full bg-white/10 border border-white/20 text-white placeholder:text-white/40 focus:outline-none focus:border-turquoise-400 focus:ring-1 focus:ring-turquoise-400 transition-colors" />
        <button type="submit" class="btn-primary whitespace-nowrap">
          <span class="btn-label">{cms.newsletter.buttonText}</span>
          <svg class="btn-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          <svg class="btn-spinner hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3" /><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
        </button>
      </form>
      <p id="newsletter-success" class="hidden text-turquoise-300 text-sm font-medium mt-4">{cms.newsletter.successMessage}</p>
      <p id="newsletter-error" class="hidden text-red-400 text-sm font-medium mt-4"></p>
      <p id="newsletter-disclaimer" class="text-white/40 text-xs mt-4">{cms.newsletter.disclaimer}</p>
    </div>
  </div>
</section>

<script is:inline>
  // Set timestamp on page load for bot timing detection
  var tsInput = document.getElementById('newsletter-ts');
  if (tsInput) tsInput.value = String(Date.now());

  var form = document.getElementById('newsletter-form');
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      var btn = form.querySelector('button[type="submit"]');
      var btnLabel = btn.querySelector('.btn-label');
      var btnIcon = btn.querySelector('.btn-icon');
      var btnSpinner = btn.querySelector('.btn-spinner');
      var emailInput = form.querySelector('#newsletter-email');
      var honeypotInput = form.querySelector('#newsletter-website');
      var timestampInput = form.querySelector('#newsletter-ts');
      var errorEl = document.getElementById('newsletter-error');
      var successEl = document.getElementById('newsletter-success');
      var disclaimerEl = document.getElementById('newsletter-disclaimer');

      // Store original label text
      var originalLabel = btnLabel.textContent;

      // Reset error state
      errorEl.classList.add('hidden');
      errorEl.textContent = '';

      // Loading state
      btn.disabled = true;
      btn.style.opacity = '0.6';
      btnLabel.textContent = '...';
      btnIcon.classList.add('hidden');
      btnSpinner.classList.remove('hidden');

      try {
        var res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: emailInput.value,
            locale: form.dataset.locale || 'de',
            website: honeypotInput ? honeypotInput.value : '',
            _ts: timestampInput && timestampInput.value ? Number(timestampInput.value) : undefined,
          }),
        });

        var data = await res.json();

        if (data.success) {
          form.style.display = 'none';
          successEl.classList.remove('hidden');
          disclaimerEl.classList.add('hidden');
        } else {
          throw new Error(data.error || 'Subscription failed.');
        }
      } catch (err) {
        // Restore button
        btn.disabled = false;
        btn.style.opacity = '1';
        btnLabel.textContent = originalLabel;
        btnIcon.classList.remove('hidden');
        btnSpinner.classList.add('hidden');

        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again.';
        errorEl.classList.remove('hidden');
      }
    });
  }
</script>

