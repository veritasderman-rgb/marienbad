---
/**
 * Rozcestník podstránek sekce. Aktuální stránku vynechává, takže ho lze
 * vložit i doprostřed podstránky jako „kam dál“.
 */
import { INSURANCE_BASE, subPages, type SubPage } from '@/data/insuranceSpa'

interface Props {
  /** Slug aktuální podstránky — vypadne z výpisu. */
  current?: string
  heading?: string
  /** Zúžený výběr slugů; výchozí je celá sekce. */
  only?: string[]
}

const { current, heading, only } = Astro.props

const items: SubPage[] = subPages
  .filter((p) => (only ? only.includes(p.slug) : true))
  .filter((p) => p.slug !== current)

const icons: Record<SubPage['icon'], string> = {
  document: '<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25M9 16.5v.75m3-3v3M15 12v5.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />',
  compare: '<path stroke-linecap="round" stroke-linejoin="round" d="M8 3v18M16 3v18M3 8h5M16 8h5M3 16h5M16 16h5" />',
  price: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
  stethoscope: '<path stroke-linecap="round" stroke-linejoin="round" d="M6 3v6a5 5 0 0010 0V3M4 3h4M14 3h4M11 14v2a5 5 0 0010 0v-1" /><circle cx="19" cy="10" r="2" />',
  suitcase: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 6V4.5A1.5 1.5 0 0110.5 3h3A1.5 1.5 0 0115 4.5V6M3.75 6h16.5a1.5 1.5 0 011.5 1.5v11.25a1.5 1.5 0 01-1.5 1.5H3.75a1.5 1.5 0 01-1.5-1.5V7.5a1.5 1.5 0 011.5-1.5zM9 10v7M15 10v7" />',
  hotel: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M4.5 21V6.75A1.5 1.5 0 016 5.25h12a1.5 1.5 0 011.5 1.5V21M9 9h1.5M13.5 9H15M9 12.75h1.5M13.5 12.75H15M10.5 21v-3.75h3V21" />',
  question: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 17.25h.007v.008H12v-.008zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" />',
}
---

{items.length > 0 && (
  <nav class="not-prose" aria-label={heading ?? 'Další stránky sekce'}>
    {heading && <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{heading}</h2>}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
      {items.map((page) => (
        <li class="m-0">
          <a
            href={`${INSURANCE_BASE}/${page.slug}`}
            class="group flex h-full flex-col gap-3 bg-white border border-beige-200 p-6 hover:border-turquoise-400 hover:shadow-card transition-all duration-300"
            style="border-radius: var(--radius-card);"
          >
            <span class="w-11 h-11 rounded-xl bg-turquoise-400/15 text-indigo-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={icons[page.icon]} />
            </span>
            <span class="font-heading text-lg font-bold text-indigo-700 group-hover:text-turquoise-600 transition-colors">
              {page.title}
            </span>
            <span class="text-beige-700 text-sm leading-relaxed">{page.metaDescription}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
