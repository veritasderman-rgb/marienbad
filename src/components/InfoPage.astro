---
/**
 * Šablona pro informační stránky postavené na sekcích (rady pro hosty,
 * lékařský tým). Sekce je buď odstavec, nebo seznam; číslovaný seznam se
 * používá tam, kde na pořadí záleží nebo kde jde o očíslované pokyny.
 */
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ArticleSources from '@/components/ArticleSources.astro'
import Pic from '@/components/Pic.astro'
import type { Locale } from '@/i18n/config'
import type { InfoContent } from '@/data/spaInfoPages'
import { t } from '@/i18n/ui'

interface Props {
  locale: Locale
  content: InfoContent
}

const { locale, content: c } = Astro.props

const faqHeading = { de: 'Häufige Fragen', en: 'Frequently asked questions', cs: 'Časté dotazy', ru: 'Частые вопросы' }[locale]
---

<section class="relative bg-indigo-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.12)_0%,_transparent_60%)]"></div>
  <div class="relative container-wide pt-28 pb-14 md:pt-36 md:pb-16">
    <Breadcrumbs items={[{ label: t(locale, 'nav.home'), href: `/${locale}` }, { label: c.navLabel }]} locale={locale} />
    <h1 class="font-heading text-3xl md:text-5xl font-bold mb-5 leading-tight" style="font-size: var(--text-h1);">{c.h1}</h1>
    <p class="text-white/85 text-lg md:text-xl leading-relaxed max-w-3xl">{c.lead}</p>
  </div>
</section>

<div class="container-wide py-14 md:py-20 flex flex-col gap-11 max-w-4xl">

  {c.sections.map((s) => (
    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{s.heading}</h2>
      {s.body && <p class="text-beige-800 text-base md:text-lg leading-relaxed">{s.body}</p>}
      {s.items && s.numbered && (
        <ol class="flex flex-col gap-3 list-none p-0 m-0 counter-reset">
          {s.items.map((item, i) => (
            <li class="flex gap-4 bg-white border border-beige-200 px-5 py-4 rounded-xl text-beige-900 text-base leading-relaxed">
              <span class="shrink-0 w-7 h-7 rounded-lg bg-indigo-700 text-white text-sm font-bold flex items-center justify-center tabular-nums">{i + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      )}
      {s.items && !s.numbered && (
        <ul class="flex flex-col gap-3 list-none p-0 m-0">
          {s.items.map((item) => (
            <li class="flex gap-3 text-beige-800 text-base leading-relaxed">
              <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-turquoise-500 mt-2.5" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}
      {s.image && (
      <figure class="m-0 mt-6 overflow-hidden" style="border-radius: var(--radius-card);">
        <Pic
          src={s.image.src}
          alt={s.image.alt}
          class="w-full h-auto block"
          sizes="(max-width: 768px) 100vw, 800px"
        />
      </figure>
      )}
    </section>
  ))}

  {c.people && c.people.length > 0 && (
    <section>
      {c.peopleHeading && <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{c.peopleHeading}</h2>}
      <ul class="grid gap-4 sm:grid-cols-2 list-none p-0 m-0">
        {c.people.map((p) => (
          <li class="bg-indigo-50 border border-indigo-100 p-5 m-0" style="border-radius: var(--radius-card);">
            <p class="font-heading font-bold text-indigo-700 m-0 mb-1">{p.name}</p>
            <p class="text-beige-800 text-sm leading-relaxed m-0">{p.role}</p>
          </li>
        ))}
      </ul>
      {c.peopleNote && <p class="text-beige-700 text-sm leading-relaxed mt-4">{c.peopleNote}</p>}
    </section>
  )}

  <p class="text-beige-900 text-base leading-relaxed bg-beige-100 border border-beige-200 px-5 py-4 rounded-xl m-0">{c.note}</p>

  <section>
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-5">{faqHeading}</h2>
    <div class="flex flex-col gap-3">
      {c.faqs.map((faq) => (
        <details class="group bg-white border border-beige-200 rounded-xl overflow-hidden">
          <summary class="cursor-pointer list-none px-5 py-4 font-heading font-semibold text-indigo-700 flex items-center justify-between gap-4">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="px-5 pb-5 text-beige-800 text-base leading-relaxed m-0">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <ArticleSources sources={c.sources} locale={locale} medicalReviewDate={c.reviewDate} />

  <nav aria-label={c.navLabel}>
    <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
      {c.related.map((r) => (
        <li class="m-0">
          <a href={r.href} class="inline-flex items-center gap-2 bg-white border border-beige-200 px-5 py-2.5 rounded-full text-indigo-700 font-semibold hover:border-turquoise-400 transition-colors">
            {r.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

</div>
