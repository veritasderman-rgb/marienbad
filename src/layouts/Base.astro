---
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BookingCtaBar from '@/components/BookingCtaBar.astro'
import ChatWidget from '@/components/ChatWidget.tsx'
import { type Locale, locales, routes, type SectionKey } from '@/i18n/config'
import { t } from '@/i18n/ui'
import Analytics from '@vercel/analytics/astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogType?: string
  locale: Locale
  section?: SectionKey | 'home'
  /** Explicit locale→URL map for hreflang tags. Overrides automatic generation. Locales not present are skipped. */
  alternateUrls?: Partial<Record<Locale, string>>
}

const { locale, section, alternateUrls } = Astro.props

/** OG locale mapping */
const ogLocaleMap: Record<Locale, string> = {
  de: 'de_DE',
  en: 'en_US',
  cs: 'cs_CZ',
  ru: 'ru_RU',
}
const title = Astro.props.title ?? `${t(locale, 'meta.siteName')} — ${t(locale, 'meta.tagline')}`
const description = Astro.props.description ?? t(locale, 'meta.description')
const pathname = Astro.url.pathname.replace(/\/$/, '') || `/${locale}`
const siteUrl = (import.meta.env.SITE ?? 'https://marienbad.vercel.app').replace(/\/$/, '')
const canonicalUrl = `${siteUrl}${pathname}`

/** Dynamic OG image — use static prop if provided, otherwise generate via API */
const ogImageUrl = Astro.props.ogImage
  ?? `${siteUrl}/api/og?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description.slice(0, 100))}&locale=${locale}`

/** Build hreflang URL for a given locale from current pathname.
 *  Returns null if alternateUrls is provided but has no entry for the target locale. */
function hreflangUrl(targetLocale: Locale): string | null {
  // If explicit alternate URLs are provided, use them exclusively
  if (alternateUrls) {
    const url = alternateUrls[targetLocale]
    if (!url) return null
    return `${siteUrl}${url}`
  }
  // Homepage
  if (!section || section === 'home') {
    return `${siteUrl}/${targetLocale}`
  }
  // Pillar pages — use route mapping for correct localized slugs
  if (section in routes) {
    const slug = routes[section as SectionKey][targetLocale]
    return `${siteUrl}/${targetLocale}/${slug}`
  }
  // Fallback: simple locale prefix swap
  const path = pathname.replace(/^\/[a-z]{2}/, `/${targetLocale}`)
  return `${siteUrl}${path}`
}

/** Language switcher URLs — same page in each locale */
const langSwitcherUrls = Object.fromEntries(
  locales.map(l => [l, hreflangUrl(l)?.replace(siteUrl, '') ?? `/${l}`])
) as Record<Locale, string>
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="dns-prefetch" href="https://plausible.io" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2d2a6e" />

    <meta name="robots" content="index, follow" />

    <!-- Hreflang -->
    {hreflangUrl('de') && <link rel="alternate" hreflang="de" href={hreflangUrl('de')} />}
    {hreflangUrl('en') && <link rel="alternate" hreflang="en" href={hreflangUrl('en')} />}
    {hreflangUrl('cs') && <link rel="alternate" hreflang="cs" href={hreflangUrl('cs')} />}
    {hreflangUrl('ru') && <link rel="alternate" hreflang="ru" href={hreflangUrl('ru')} />}
    {hreflangUrl('de') && <link rel="alternate" hreflang="x-default" href={hreflangUrl('de')} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.props.ogType ?? "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Marienbad.com" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {locales.filter(l => l !== locale).map(l => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l]} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured data: Organization + TouristDestination -->
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Marienbad.com",
        "url": "https://marienbad.com",
        "logo": `${siteUrl}/favicon.svg`,
        "description": t(locale, 'meta.description'),
        "sameAs": [
          "https://www.instagram.com/marienbad.com_official/",
          "https://www.facebook.com/marienbad.com.official",
          "https://www.youtube.com/@marienbad-com"
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "TouristDestination",
        "name": "Mariánské Lázně (Marienbad)",
        "url": "https://marienbad.com",
        "description": "Historic Czech spa town, part of the UNESCO Great Spa Towns of Europe. Famous for 100+ mineral springs, CO₂ therapies, and 200 years of spa culture.",
        "touristType": ["Spa Tourism", "Wellness", "Cultural Heritage"],
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 49.9644,
          "longitude": 12.7012
        },
        "containedInPlace": {
          "@type": "Country",
          "name": "Czech Republic"
        },
        "award": "UNESCO World Heritage Site — Great Spa Towns of Europe (2021)"
      }
    ])} />

    <!-- Branding font preload (critical weights) -->
    <link rel="preload" href="/fonts/Branding-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Branding-Bold.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Branding-Semilight.otf" as="font" type="font/otf" crossorigin />

    <!-- Cookie-free analytics (Plausible) -->
    {import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
      <script defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-black">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:bg-yellow-400 focus:text-black focus:rounded-lg focus:font-semibold">
      Skip to content
    </a>
    <Header locale={locale} langUrls={langSwitcherUrls} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <BookingCtaBar locale={locale} />
    <ChatWidget
      client:idle
      locale={locale}
      translations={{
        title: t(locale, 'chat.title'),
        placeholder: t(locale, 'chat.placeholder'),
        greeting: t(locale, 'chat.greeting'),
        disclaimer: t(locale, 'chat.disclaimer'),
      }}
    />
    <Analytics />

    <!-- Scroll-to-top button -->
    <button
      id="scroll-to-top"
      class="fixed bottom-20 right-6 z-50 w-11 h-11 rounded-full bg-indigo-700/90 text-white shadow-lg backdrop-blur-sm cursor-pointer flex items-center justify-center opacity-0 translate-y-4 pointer-events-none transition-all duration-300 ease-out hover:bg-indigo-600 hover:scale-110 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 md:bottom-8 md:right-8 md:w-12 md:h-12"
      aria-label="Scroll to top"
    >
      <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
      </svg>
    </button>

    <!-- Scroll reveal observer -->
    <script>
      (() => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal');

        if (prefersReducedMotion) {
          // Skip animation entirely — show all elements immediately
          revealElements.forEach((el) => el.classList.add('visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        revealElements.forEach((el) => observer.observe(el));
      })();
    </script>

    <!-- Scroll-to-top behavior -->
    <script>
      (() => {
        const btn = document.getElementById('scroll-to-top');
        if (!btn) return;

        let ticking = false;
        const show = () => {
          btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          btn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        };
        const hide = () => {
          btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          btn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        };

        const update = () => {
          const scrolled = window.scrollY > 400;
          scrolled ? show() : hide();
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        update();
      })();
    </script>
  </body>
</html>
