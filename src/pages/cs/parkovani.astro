---
/**
 * Parkování u hotelů Ensana v Mariánských Lázních — /cs/parkovani
 *
 * Zatím nelinkovaná informační podstránka (není v navigaci ani v sitemap,
 * viz astro.config NOINDEXED_PATHS, a je označena noindex). Dostupná jen
 * přes přímý odkaz, dokud ji nezveřejníme.
 */
import Base from '@/layouts/Base.astro'
import Pic from '@/components/Pic.astro'

export const prerender = true

const locale = 'cs' as const

interface ParkingOption {
  name: string
  price?: string
  note?: string
  /** Odkaz na oficiální stránku městského parkoviště (proklik pro klienta). */
  href?: string
}
interface Hotel {
  name: string
  image: string
  location?: string
  /** Rezervační e-mail hotelu. */
  contact: string
  options: ParkingOption[]
}

const IMG = '/images/content/hotels/hotels/items'

// Oficiální stránka města pro „Parkovací dům u Městského divadla" (Parking Centrum, Pramenská).
const CITY_GARAGE = 'https://www.muml.cz/mesto/doprava-a-parkovani/parkoviste/hlidane-parkoviste/'

const hotels: Hotel[] = [
  {
    name: 'Ensana Nové Lázně',
    image: `${IMG}/0/image.jpg`,
    contact: 'res.nl@ensanahotels.com',
    options: [
      { name: 'Nehlídané parkoviště před hotelem', price: 'Zdarma', note: 'Omezený počet míst' },
      { name: 'Hlídané parkoviště ve dvoře', price: '380 Kč/den · od 5 nocí 250 Kč/den', note: 'Nutná rezervace předem' },
      {
        name: 'Podzemní garáže v resortu',
        price: '380 Kč/den · od 5 nocí 250 Kč/den',
        note: '38 míst, nutná rezervace předem. Zákaz vjezdu elektromobilů, hybridních vozidel a vozidel na LPG.',
      },
    ],
  },
  {
    name: 'Ensana Centrální Lázně',
    image: `${IMG}/1/image.jpg`,
    contact: 'res.cl@ensanahotels.com',
    options: [
      { name: 'Nehlídané parkoviště před hotelem', price: 'Zdarma', note: 'Omezený počet míst (4 místa + 1 pro osoby se zdravotním postižením)' },
      { name: 'Hlídané parkoviště za hotelem', price: '380 Kč/den', note: '30 míst, nutná rezervace předem' },
    ],
  },
  {
    name: 'Ensana Hvězda',
    image: `${IMG}/2/image.jpg`,
    contact: 'res.hv@ensanahotels.com',
    options: [
      {
        name: 'Podzemní garáže v resortu',
        price: '380 Kč/den · od 5 nocí 250 Kč/den',
        note: '38 míst, nutná rezervace předem. Zákaz vjezdu elektromobilů, hybridních vozidel a vozidel na LPG.',
      },
    ],
  },
  {
    name: 'Ensana Pacifik',
    image: `${IMG}/3/image.jpg`,
    location: 'Poloha u parku a kolonády.',
    contact: 'res.pa@ensanahotels.com',
    options: [
      { name: '4 místa před hotelem', note: 'Pouze pro check-in a check-out' },
      { name: 'Parkovací dům u Městského divadla', note: 'cca 5 minut chůze od hotelu', href: CITY_GARAGE },
    ],
  },
  {
    name: 'Ensana Butterfly',
    image: `${IMG}/4/image.jpg`,
    location: 'Poloha v centru města přímo u lázeňského parku.',
    contact: 'res.bu@ensanahotels.com',
    options: [
      {
        name: 'Podzemní garáž',
        price: '380 Kč/den · od 5 nocí 250 Kč/den',
        note: 'Nutná rezervace předem. Vjezd pro elektromobily, hybridní vozidla a vozidla na LPG je zakázán.',
      },
      { name: '4 místa před hotelem', note: 'Pouze pro check-in a check-out' },
      { name: 'Parkovací dům u Městského divadla', note: 'Alternativně', href: CITY_GARAGE },
    ],
  },
  {
    name: 'Ensana Vltava',
    image: `${IMG}/5/image.jpg`,
    location: 'Poloha u lesoparku.',
    contact: 'res.vl@ensanahotels.com',
    options: [
      { name: 'Parkoviště před hotelem', price: '250 Kč/den', note: '5 míst, platba na recepci, nutná rezervace předem' },
      { name: 'Místa pro osoby se zdravotním postižením', note: '3 parkovací místa' },
    ],
  },
  {
    name: 'Ensana Svoboda',
    image: `${IMG}/6/image.jpg`,
    location: 'Poloha v klidné části lesoparku nedaleko kolonády.',
    contact: 'res.sv@ensanahotels.com',
    options: [
      { name: 'Parkoviště ve dvoře hotelu', price: '250 Kč/den · od 5 nocí 200 Kč/den', note: '12 míst, platba na recepci, nutná rezervace předem' },
      { name: 'Před hotelem v Chopinově ulici', note: 'Veřejné placené stání s parkovacím automatem' },
      { name: 'Parkovací dům u Městského divadla', note: 'ul. Pramenská, cca 200 m od hotelu', href: CITY_GARAGE },
    ],
  },
]

// Přehledová tabulka — seskupeno po hotelech (každý hotel jako samostatný blok).
interface TableRow {
  option: string
  price: string
  note: string
  /** Proklik na oficiální stránku městského parkoviště. */
  href?: string
}
interface TableGroup {
  hotel: string
  contact: string
  rows: TableRow[]
}
const tableGroups: TableGroup[] = [
  {
    hotel: 'Ensana Nové Lázně',
    contact: 'res.nl@ensanahotels.com',
    rows: [
      { option: 'Nehlídané parkoviště před hotelem', price: 'Zdarma', note: 'Omezený počet míst' },
      { option: 'Hlídané parkoviště ve dvoře', price: '380 Kč/den, od 5 nocí 250 Kč/den', note: 'Nutná rezervace' },
      { option: 'Podzemní garáže v resortu', price: '380 Kč/den, od 5 nocí 250 Kč/den', note: '38 míst, nutná rezervace; zákaz vjezdu elektro, hybridů a LPG' },
    ],
  },
  {
    hotel: 'Ensana Centrální Lázně',
    contact: 'res.cl@ensanahotels.com',
    rows: [
      { option: 'Nehlídané parkoviště před hotelem', price: 'Zdarma', note: 'Omezený počet míst (4 + 1 pro invalidy)' },
      { option: 'Hlídané parkoviště za hotelem', price: '380 Kč/den', note: '30 míst, nutná rezervace' },
    ],
  },
  {
    hotel: 'Ensana Hvězda',
    contact: 'res.hv@ensanahotels.com',
    rows: [
      { option: 'Podzemní garáže v resortu', price: '380 Kč/den, od 5 nocí 250 Kč/den', note: '38 míst, nutná rezervace; zákaz vjezdu elektro, hybridů a LPG' },
    ],
  },
  {
    hotel: 'Ensana Pacifik',
    contact: 'res.pa@ensanahotels.com',
    rows: [
      { option: '4 místa před hotelem', price: '–', note: 'Pouze pro check-in a check-out' },
      { option: 'Parkovací dům u Městského divadla', price: 'dle ceníku města', note: 'cca 5 min chůze od hotelu', href: CITY_GARAGE },
    ],
  },
  {
    hotel: 'Ensana Butterfly',
    contact: 'res.bu@ensanahotels.com',
    rows: [
      { option: 'Podzemní garáž', price: '380 Kč/den, od 5 nocí 250 Kč/den', note: 'Nutná rezervace; zákaz vjezdu elektro, hybridů a LPG' },
      { option: '4 místa před hotelem', price: '–', note: 'Pouze pro check-in a check-out' },
      { option: 'Parkovací dům u Městského divadla', price: 'dle ceníku města', note: 'Alternativně', href: CITY_GARAGE },
    ],
  },
  {
    hotel: 'Ensana Vltava',
    contact: 'res.vl@ensanahotels.com',
    rows: [
      { option: 'Parkoviště před hotelem', price: '250 Kč/den', note: '5 míst, platba na recepci, nutná rezervace' },
      { option: 'Místa pro osoby se zdravotním postižením', price: '–', note: '3 místa' },
    ],
  },
  {
    hotel: 'Ensana Svoboda',
    contact: 'res.sv@ensanahotels.com',
    rows: [
      { option: 'Parkoviště ve dvoře hotelu', price: '250 Kč/den, od 5 nocí 200 Kč/den', note: '12 míst, platba na recepci, nutná rezervace' },
      { option: 'Před hotelem v Chopinově ulici', price: 'dle parkovacího automatu', note: 'Veřejné, parkovací automat' },
      { option: 'Parkovací dům u Městského divadla', price: 'dle ceníku města', note: 'ul. Pramenská, cca 200 m od hotelu', href: CITY_GARAGE },
    ],
  },
]

// Ověřené odkazy na oficiální informace o parkování ve městě.
const cityLinks: { label: string; desc: string; href: string }[] = [
  {
    label: 'Doprava a parkování — přehled parkovišť',
    desc: 'Oficiální stránky města: hlídaná, nehlídaná a autobusová parkoviště.',
    href: 'https://www.muml.cz/mesto/doprava-a-parkovani/parkoviste/',
  },
  {
    label: 'Parkování v centru',
    desc: 'Ceník, doba zpoplatnění a parkovací automaty v centru města.',
    href: 'https://www.muml.cz/mesto/doprava-a-parkovani/parkovani-v-centru/',
  },
  {
    label: 'Vjezd do lázeňské zóny',
    desc: 'Podmínky vjezdu a jednodenní / týdenní povolení do lázeňské zóny.',
    href: 'https://www.muml.cz/mesto/doprava-a-parkovani/vjezd-do-lazenske-zony/',
  },
  {
    label: 'Parkování — turistický portál Mariánské Lázně',
    desc: 'Souhrn možností parkování pro návštěvníky města.',
    href: 'https://www.marianskelazne.cz/kudy-k-nam/parkovani/',
  },
]
---

<Base
  locale={locale}
  section="practical-info"
  title="Parkování u hotelů Ensana v Mariánských Lázních"
  description="Přehled možností parkování u jednotlivých hotelů Ensana v Mariánských Lázních — ceny, kapacity a rezervace — a doplňující informace o parkování ve městě."
  noindex={true}
>
  <!-- Hero -->
  <section class="bg-indigo-800 text-white">
    <div class="container-wide py-12 md:py-16">
      <p class="text-turquoise-200 font-semibold tracking-wide uppercase text-sm mb-3">Praktické informace</p>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold leading-tight max-w-3xl">
        Parkování u hotelů Ensana v Mariánských Lázních
      </h1>
      <p class="mt-5 text-white/85 leading-relaxed max-w-2xl">
        Přehled možností parkování u jednotlivých hotelů Ensana a doplňující informace o parkování ve
        městě. U všech hotelových parkovišť a garáží platí, že je <strong class="text-white">nutná
        rezervace předem</strong> — doporučujeme si místo zajistit již při rezervaci pobytu.
      </p>
    </div>
  </section>

  <!-- Přehledová tabulka (jen na tabletu a výše; na mobilu jsou přehlednější karty níže) -->
  <section class="container-wide py-10 md:py-14 hidden md:block">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-6">Přehledová tabulka</h2>
    <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-card">
      <table class="w-full text-left text-sm md:text-base border-collapse">
        <thead>
          <tr class="bg-indigo-800 text-white">
            <th class="px-4 py-3 font-semibold">Možnost parkování</th>
            <th class="px-4 py-3 font-semibold whitespace-nowrap">Cena</th>
            <th class="px-4 py-3 font-semibold">Kapacita / poznámka</th>
          </tr>
        </thead>
        {tableGroups.map((g) => (
          <tbody class="border-t-4 border-turquoise-400">
            <tr class="bg-beige-100">
              <th colspan="3" class="px-4 py-2.5 text-left align-baseline">
                <span class="font-heading font-bold text-indigo-800 text-base md:text-lg">{g.hotel}</span>
                <span class="ml-3 font-normal text-sm text-gray-600">
                  Rezervace:
                  <a href={`mailto:${g.contact}`} class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">{g.contact}</a>
                </span>
              </th>
            </tr>
            {g.rows.map((r) => (
              <tr class="bg-white align-top border-t border-gray-100">
                <td class="px-4 py-3 text-gray-800 font-medium">
                  {r.href ? (
                    <a href={r.href} target="_blank" rel="noopener" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2 inline-flex items-center gap-1">
                      {r.option}
                      <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                    </a>
                  ) : r.option}
                </td>
                <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{r.price}</td>
                <td class="px-4 py-3 text-gray-600">{r.note}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  <!-- Parkování u jednotlivých hotelů -->
  <section class="bg-beige-50 py-10 md:py-16">
    <div class="container-wide">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-2">Parkování u jednotlivých hotelů</h2>
      <p class="text-gray-600 mb-8 max-w-2xl">Fotografie hotelů, ke kterým se informace vztahují.</p>

      <div class="grid gap-6 md:grid-cols-2">
        {hotels.map((h) => (
          <article class="flex flex-col sm:flex-row bg-white rounded-2xl shadow-card overflow-hidden border border-gray-100">
            <div class="sm:w-44 lg:w-52 shrink-0">
              <Pic
                src={h.image}
                alt={`Hotel ${h.name} v Mariánských Lázních`}
                class="w-full h-40 sm:h-full object-cover"
                sizes="(max-width: 640px) 100vw, 208px"
              />
            </div>
            <div class="flex-1 p-5 md:p-6">
              <h3 class="font-heading text-lg md:text-xl font-bold text-indigo-800">{h.name}</h3>
              {h.location && <p class="text-sm text-gray-500 mt-1">{h.location}</p>}
              <p class="text-sm text-gray-600 mt-2">
                Rezervace:
                <a href={`mailto:${h.contact}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2 break-all">{h.contact}</a>
              </p>
              <ul class="mt-4 space-y-3">
                {h.options.map((o) => (
                  <li class="flex gap-3">
                    <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-turquoise-500"></span>
                    <div>
                      <p class="text-gray-800 font-medium">
                        {o.href ? (
                          <a href={o.href} target="_blank" rel="noopener" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2 inline-flex items-center gap-1">
                            {o.name}
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                          </a>
                        ) : o.name}
                        {o.price && <span class="text-turquoise-700 font-semibold"> — {o.price}</span>}
                      </p>
                      {o.note && <p class="text-sm text-gray-500 mt-0.5">{o.note}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Další možnosti parkování ve městě -->
  <section class="container-wide py-10 md:py-16">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-3">
      Další možnosti parkování v Mariánských Lázních
    </h2>
    <p class="text-gray-700 leading-relaxed max-w-3xl mb-8">
      Pokud jsou hotelová místa obsazená nebo hosté přijíždějí elektromobilem či hybridem (kam u
      některých hotelů platí zákaz vjezdu do garáží), lze využít městská a komerční parkoviště.
    </p>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Parkovací domy a hlídaná parkoviště -->
      <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-6 md:p-7">
        <h3 class="font-heading text-lg font-bold text-indigo-800 mb-4">Parkovací domy a hlídaná parkoviště</h3>
        <div class="space-y-5 text-gray-700 leading-relaxed">
          <div>
            <p class="font-semibold text-gray-900">Parking Centrum — parkovací dům</p>
            <p class="text-sm mt-1">
              Pramenská 653/2 (severní část města za Městským divadlem). Kryté hlídané parkoviště
              s kamerovým dohledem, non-stop provoz (obsluha 7–16 h), kapacita 290 míst. Cena: prvních
              20 minut zdarma, 20 Kč/hod, 240 Kč/den. Jízdní kolo 20 Kč/den. Toto je „Parkovací dům
              u Městského divadla" zmiňovaný u hotelů Pacifik, Butterfly a Svoboda.
            </p>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Parking Centrum — Centrální parkoviště</p>
            <p class="text-sm mt-1">
              Kollárova 94/26. Hlídané, nekryté, s parkovacím automatem, non-stop, kapacita 400 míst.
              Cena: 10 Kč/hod (0,50 €), 50 Kč/den (2 €).
            </p>
          </div>
        </div>
      </div>

      <!-- Veřejná parkoviště s automatem -->
      <div class="bg-white rounded-2xl shadow-card border border-gray-100 p-6 md:p-7">
        <h3 class="font-heading text-lg font-bold text-indigo-800 mb-4">Veřejná parkoviště s automatem</h3>
        <div class="space-y-5 text-gray-700 leading-relaxed">
          <div>
            <p class="font-semibold text-gray-900">Parkoviště u hotelu Koliba</p>
            <p class="text-sm mt-1">Dusíkova ulice, 30 míst, nehlídané, 9:00–22:00. Cena cca 10 Kč/hod, 40 Kč/celý den.</p>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Parkoviště u hotelu Krakonoš</p>
            <p class="text-sm mt-1">Mariánské Lázně 660, 50 míst, nehlídané, 9:00–22:00. Cena od 10 Kč/hod, 50 Kč za delší stání.</p>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Parkoviště u Oděvy</p>
            <p class="text-sm mt-1">ul. Boženy Němcové, nehlídané, non-stop. Cena 10 Kč/30 min, 30 Kč/hod.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Parkování v centru a lázeňské zóně -->
    <div class="mt-6 bg-indigo-50 rounded-2xl border border-indigo-100 p-6 md:p-7">
      <h3 class="font-heading text-lg font-bold text-indigo-800 mb-3">Parkování v centru a lázeňské zóně</h3>
      <div class="space-y-4 text-gray-700 leading-relaxed">
        <p>
          Ve městě je rozmístěno přes 30 parkovacích automatů. Hodinové sazby se v centru pohybují
          zhruba od 30 do 50 Kč podle zóny (nejvyšší tarif v lázeňském centru). Pro vjezd do
          <strong> Lázeňské zóny</strong> je potřeba povolení — hosté ubytovaní v zóně mají výjimku
          v den příjezdu a odjezdu; jednodenní povolení do lázeňské zóny lze zakoupit z automatu za 20 Kč.
        </p>
        <p>
          <strong>Způsoby platby:</strong> automaty přijímají platební karty a mobilní aplikaci
          <strong>ClickPark</strong>, která hlídá konec doby parkování. Platba hotovostí (Kč i €) je
          možná pouze u některých automatů nového typu, které jsou ve městě postupně rozmisťovány. Ve
          městě jsou také interaktivní tabule zobrazující počet volných míst v jednotlivých lokalitách.
        </p>
      </div>
    </div>

    <!-- Užitečné odkazy -->
    <div class="mt-10">
      <h3 class="font-heading text-lg md:text-xl font-bold text-indigo-800 mb-2">Užitečné odkazy — parkování ve městě</h3>
      <p class="text-gray-600 mb-5 max-w-2xl">Podrobné a vždy aktuální informace najdete na oficiálních stránkách města a turistickém portálu.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {cityLinks.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="group flex items-start gap-4 bg-white border border-gray-200 hover:border-turquoise-400 rounded-2xl p-5 shadow-card card-hover"
          >
            <span class="shrink-0 w-10 h-10 rounded-xl bg-turquoise-50 text-turquoise-700 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </span>
            <span class="flex-1">
              <span class="block font-semibold text-indigo-800 group-hover:text-turquoise-700">{l.label}</span>
              <span class="block text-sm text-gray-500 mt-0.5">{l.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
