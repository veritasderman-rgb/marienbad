---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import StoryFilter from '@/components/StoryFilter'
import StorySubmissionForm from '@/components/StorySubmissionForm'
import { getPage, getAllStories } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'cs' as const
const page = await getPage('cs-lide')
const allStories = await getAllStories()
const storyData = allStories.map(({ body, ...rest }) => rest)
const translations = {
  all: t(locale, 'filter.all'),
  byLanguage: t(locale, 'filter.byLanguage'),
  byLocation: t(locale, 'filter.byLocation'),
  noResults: t(locale, 'filter.noResults'),
}
const formTranslations = {
  formTitle: t(locale, 'storyForm.title'),
  formSubtitle: t(locale, 'storyForm.subtitle'),
  nameLabel: t(locale, 'storyForm.nameLabel'),
  namePlaceholder: t(locale, 'storyForm.namePlaceholder'),
  emailLabel: t(locale, 'storyForm.emailLabel'),
  emailPlaceholder: t(locale, 'storyForm.emailPlaceholder'),
  emailHint: t(locale, 'storyForm.emailHint'),
  locationLabel: t(locale, 'storyForm.locationLabel'),
  locationPlaceholder: t(locale, 'storyForm.locationPlaceholder'),
  visitLabel: t(locale, 'storyForm.visitLabel'),
  visitRecently: t(locale, 'storyForm.visitRecently'),
  visit1to5: t(locale, 'storyForm.visit1to5'),
  visit5to10: t(locale, 'storyForm.visit5to10'),
  visit10plus: t(locale, 'storyForm.visit10plus'),
  storyLabel: t(locale, 'storyForm.storyLabel'),
  storyPlaceholder: t(locale, 'storyForm.storyPlaceholder'),
  storyHint: t(locale, 'storyForm.storyHint'),
  photoConsent: t(locale, 'storyForm.photoConsent'),
  privacyConsent: t(locale, 'storyForm.privacyConsent'),
  submitButton: t(locale, 'storyForm.submitButton'),
  submitting: t(locale, 'storyForm.submitting'),
  successTitle: t(locale, 'storyForm.successTitle'),
  successMessage: t(locale, 'storyForm.successMessage'),
  errorMessage: t(locale, 'storyForm.errorMessage'),
  required: t(locale, 'storyForm.required'),
  minChars: t(locale, 'storyForm.minChars'),
}
---

<Base locale={locale} section="people" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }

    { storyData.length > 0 && (
      <section class="mt-16 pt-16 border-t border-beige-300">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">Objevte jejich příběhy</h2>
        <StoryFilter
          client:load
          stories={storyData}
          translations={translations}
          currentLocale={locale}
        />
      </section>
    )}

    <section class="mt-16 pt-16 border-t border-beige-300">
      <StorySubmissionForm
        client:visible
        locale={locale}
        translations={formTranslations}
      />
    </section>
  </PillarPage>
</Base>
