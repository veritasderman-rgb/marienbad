---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import StoryCard from '@/components/StoryCard.astro'
import { getPage, getStories } from '@/content/reader'

const locale = 'cs' as const
const page = await getPage('cs-lide')
const stories = await getStories(locale)
---

<Base locale={locale} section="people" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }

    { stories.length > 0 && (
      <section class="mt-16 pt-16 border-t border-beige-300">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-8">Objevte jejich příběhy</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {stories.map((story, i) => (
            <StoryCard
              locale={locale}
              slug={story.slug}
              name={story.name}
              location={story.location}
              visitLabel={story.visitLabel}
              quote={story.quote}
              lang={story.lang}
              index={i}
            />
          ))}
        </div>
      </section>
    )}
  </PillarPage>
</Base>
