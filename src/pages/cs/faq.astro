---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import { getPage, extractFaqs } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'cs' as const
const page = await getPage('cs-faq')
const faqs = page?.rawBody ? extractFaqs(page.rawBody) : []
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: t(locale, 'nav.practicalInfo'), href: `/${locale}/prakticke-informace` },
  { label: 'FAQ' },
]
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
})
---

<Base locale={locale} section="practical-info" title={page?.metaTitle ?? "FAQ"} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/faq', en: '/en/faq', cs: '/cs/faq', ru: '/ru/faq' }}>
  <script type="application/ld+json" set:html={faqSchema} />
  <PillarPage locale={locale} title={page?.title ?? "FAQ"} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    <div class="space-y-6">
      {faqs.map((faq, i) => (
        <details class="group bg-beige-200 rounded-xl overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 md:p-6 text-indigo-700 font-semibold hover:text-indigo-500 transition-colors list-none">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 md:px-6 pb-5 md:pb-6 text-beige-700 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </PillarPage>
</Base>
