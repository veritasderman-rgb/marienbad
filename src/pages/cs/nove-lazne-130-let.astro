---
import Base from '@/layouts/Base.astro'
import YouTubeEmbed from '@/components/YouTubeEmbed.astro'
import { hotels } from '@/data/hotels'
import { exelyBookingUrl } from '@/utils/booking'

const locale = 'cs' as const
const hotel = hotels.find((h) => h.slug === 'nove-lazne')!

const pageTitle = '130 let Nových Lázní — Oslavy výročí 1896–2026 — Marienbad.com'
const pageDescription = 'Nové Lázně slaví 130 let od velkolepé přestavby architektem Josefem Schafferem. Objevte historii, Římské lázně a Královskou kabinu krále Edwarda VII.'

const milestones = [
  { year: '1808', title: 'První lázeňská sezóna', description: 'Do nehostinné krajiny dorazilo osmdesát hostů. Chyběly upravené cesty i základní služby — hosté si přiváželi vlastní postele a zásoby jídla. Přesto minerální prameny rychle získávaly věhlas.' },
  { year: '1820', title: 'Éra inovací', description: 'Zavedeny parní a sprchové koupele, krátce poté slatinné zábaly a plynové koupele využívající oxid uhličitý z Mariina pramene — procedura, která je dodnes považována za místní unikát.' },
  { year: '1828', title: 'Vznik „Neubadu"', description: 'Opat Karl Kašpar Reitenberger zakládá novou lázeňskou budovu — Neubad. Šestnáct koupelových kabin a deset pokojů pro hosty přijíždějící na kúry v železnatých vodách Ambrožova a Karolinina pramene.' },
  { year: '1841', title: 'První rozšíření', description: 'Počet koupelových kabin roste na 14, u budovy vzniká samostatná kotelna. Přibývá kursální sál — Nové Lázně se stávají společenským centrem města.' },
  { year: '1872', title: 'Příjezd prvního vlaku', description: 'Díky železnici se město otevřelo Evropě a návštěvnost prudce vzrostla. Původní kapacity přestaly stačit a bylo nutné přistoupit k velkorysé přestavbě.' },
  { year: '1890', title: '„Ocelové koupele"', description: 'Staré Nové Lázně disponovaly 42 kabinami pro tzv. ocelové koupele (Stahlbäder) — koupel v Ambrožově prameni. Voda byla tak železitá, že zbarvila vanu do rezava a slibovala pacientům „ocelové zdraví".' },
  { year: '1892–1896', title: 'Schafferova přestavba', description: 'Opat Alfred Clemens rozhodl o přestavbě, zajistil financování a vtiskl projektu jasnou vizi. Jeho iniciály A.C. a A.T. (Abbas Teplensis) jsou dodnes vytesány ve štítu budovy. Architekt Josef Schaffer, mariánskolázeňský rodák inspirovaný cestami po Benátkách, Boloni a Florencii, přeměnil Neubad v monumentální novorenesanční palác. Výstavba trvala čtyři roky a probíhala vždy v zimě, aby nebyl narušen lázeňský provoz. Slavnostní otevření proběhlo 1. června 1896.' },
  { year: '1897', title: 'Král Edward VII. poprvé', description: 'Budoucí britský monarcha přijíždí a okamžitě si město zamiluje. V Nových Lázních pro něj vzniká soukromá Královská kabina — dveře do lodžie zdobí původní malby na skle od slavné tyrolské dílny Geyling, kachličky jsou luxusní majolika a na stěnách visí obrazy s ptáky. Pobyt měl evokovat atmosféru zahradního pavilonu uprostřed přírody.' },
  { year: '1904', title: 'Setkání dvou mocnářů', description: '16. srpna 1904 se v hotelu setkávají císař František Josef I. a král Edward VII. při oficiálním diplomatickém jednání. Mariánské Lázně se na jeden den stávají centrem evropské politiky.' },
  { year: '1905', title: 'Založení Royal Golf Clubu', description: 'Edward VII. zakládá nejstarší golfový klub v Čechách — Royal Golf Club Mariánské Lázně. Klub funguje nepřetržitě dodnes.' },
  { year: '1912–1913', title: 'Rozšíření za opata Helmera', description: 'Pod vedením opata Gilberta Helmera se kapacita koupelových kabin téměř zdvojnásobuje. Nové Lázně reagují na rostoucí poptávku mezinárodní aristokracie.' },
  { year: '2005', title: 'Královská tradice pokračuje', description: 'Princ Edward, hrabě z Wessexu, se ubytovává v hotelu a navazuje na tradici britské královské rodiny v Mariánských Lázních.' },
  { year: '2021', title: 'Zápis na seznam UNESCO', description: 'Mariánské Lázně se stávají součástí transnacionálního zápisu „Slavná lázeňská města Evropy". Nové Lázně patří mezi klíčové stavby chráněné zóny.' },
  { year: '2023', title: 'Statut klimatických lázní', description: 'Mariánské Lázně získávají statut klimatických lázní — potvrzení, že zdejší mikroklima je samo o sobě léčivým zdrojem.' },
  { year: '2026', title: '130 let od slavnostního otevření', description: '1. června 2026 slaví Nové Lázně 130. výročí. Budova stále slouží jako pětihvězdičkový lázeňský hotel — největší historický balneoprovoz v České republice, s původními Římskými lázněmi, Královskou kabinou i Císařskou kabinou v plném provozu.' },
]

const highlights = [
  {
    title: 'Římské lázně z roku 1896',
    description: 'Prosklený strop zaplavuje interiér měkkým denním světlem. Klenbu nese jednadvacet vznosných sloupů z tmavě červeného salcburského mramoru s hlavicemi z bílého carrarského kamene. Dva původní bazény s minerální vodou, pozlacené chrliče ve tvaru lvích hlav a barevné kachličky evokují noblesu antických lázní. Třetí bazén s protiproudem byl přidán při moderní rekonstrukci.',
    icon: 'M12 21.5c-3.04 0-5.5-2.09-5.5-6 0-3.91 5.5-11 5.5-11s5.5 7.09 5.5 11c0 3.91-2.46 6-5.5 6z',
  },
  {
    title: 'Královská kabina Edwarda VII.',
    description: 'Soukromá koupelna vybudovaná pro britského krále. Dveře do lodžie zdobí původní malby na skle od slavné tyrolské dílny Geyling, které ve slunečním svitu hrají všemi barvami. Kachličky jsou luxusní majolika, na stěnách visí obrazy s ptáky — pobyt měl evokovat atmosféru zahradního pavilonu. V kabině dodnes stojí dřevěná židle se zabudovanou mechanickou váhou.',
    icon: 'M5 3a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2H5zm7 2a5 5 0 110 10 5 5 0 010-10z',
  },
  {
    title: 'Císařská kabina Františka Josefa I.',
    description: 'Koupelna s původní historickou výzdobou, určená rakouskému císaři. Obě kabiny — Královská i Císařská — dnes slouží pro speciální balneoterapeutické procedury, minerální koupele a bahenní zábaly.',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    title: '5 900 m² propojený komplex',
    description: 'Nové Lázně, Centrální Lázně, Maria Spa, Hvězda, Neapol a Imperial jsou spojené krytými promenádami a koridory v jeden celek. Hosté přecházejí mezi budovami, aniž by vyšli ven — největší historicky původní lázeňský komplex v Čechách.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
]

const funFacts = [
  'Ve štítu budovy jsou dodnes vytesány iniciály A.C. a A.T. (Abbas Teplensis) — připomínka opata Alfreda Clemence, který přestavbu inicioval a financoval.',
  'Klenbu Římských lázní nese 21 vznosných sloupů z tmavě červeného salcburského mramoru s hlavicemi z bílého carrarského kamene. Pozlacené chrliče ve tvaru lvích hlav dotváří atmosféru antických lázní.',
  'Dveře do lodžie v Královské kabině zdobí původní malby na skle od slavné tyrolské dílny Geyling. Ve slunečním svitu hrají všemi barvami — kabina měla evokovat zahradní pavilon uprostřed přírody.',
  'V Královské kabině stojí dřevěná židle s vyřezávanými nožkami, uvnitř které se skrývá mechanická váha. Edward VII. si na ní diskrétně kontroloval váhu — stát na obyčejné váze by nebylo královské.',
  'V první lázeňské sezóně roku 1808 dorazilo do nehostinné krajiny přibližně 80 hostů. Chyběly cesty i služby — hosté si přiváželi vlastní postele a zásoby jídla.',
  'Před Schafferovou přestavbou nabízely staré Nové Lázně 42 kabin pro „ocelové koupele" (Stahlbäder). Voda z Ambrožova pramene byla tak železitá, že zbarvila vanu do rezava.',
  'Ferdinandův pramen byl přiveden do Nových lázní potrubím o délce 1 700 metrů z Úšovic. Parní stroj tlačil vodu po trase stoupající o 43 metrů výškového rozdílu.',
  'Edward VII. přijížděl do Mariánských Lázní devětkrát za 12 let. Evropský tisk nazýval město „letním hlavním městem evropské diplomacie".',
  'Již v roce 1820 zde byly zavedeny parní a sprchové koupele, krátce poté slatinné zábaly a plynové koupele využívající CO₂ z Mariina pramene — procedura unikátní dodnes.',
]
---

<Base locale={locale} section="accommodation" title={pageTitle} description={pageDescription} alternateUrls={{ cs: '/cs/nove-lazne-130-let', de: '/de/neue-baeder-130-jahre', en: '/en/neue-baeder-130-years', ru: '/ru/novye-lazni-130-let' }}>

  <!-- Anniversary Hero -->
  <section class="relative bg-indigo-700 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.15)_0%,_transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(201,163,105,0.1)_0%,_transparent_50%)]"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>

    <div class="relative container-wide py-20 md:py-32 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-yellow-400/20 rounded-full text-yellow-300 text-sm font-semibold mb-6">
        <span>★</span>
        <span>1896 — 2026</span>
        <span>★</span>
      </div>

      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight" style="font-size: clamp(2.25rem, 5vw, 4.5rem);">
        130 let Nových Lázní
      </h1>

      <p class="text-white/70 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed mb-8">
        Slavnostně otevřen <strong class="text-white">1. června 1896</strong> — perla lázeňské architektury navržená mariánskolázeňským rodákem <strong class="text-white">Josefem Schafferem</strong> podle italských renesančních vzorů. Dnes <strong class="text-white">největší historický balneoprovoz v České republice</strong> s <strong class="text-white">Římskými lázněmi</strong>, <strong class="text-white">Královskou kabinou Edwarda VII.</strong> a minerálním pramenem přímo v chodbách.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href={exelyBookingUrl({ hotelId: hotel.exelyHotelId, locale: 'cs', utmMedium: 'anniversary', utmCampaign: 'nove-lazne-130' })}
          class="inline-flex items-center gap-2 px-8 py-4 bg-yellow-400 text-indigo-900 rounded-lg font-bold hover:bg-yellow-300 transition-colors text-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Rezervovat pobyt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#milniky" class="inline-flex items-center gap-2 px-8 py-4 border border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors text-lg">
          Objevte historii
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-6 md:gap-10 mt-12 text-sm">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">1896</div>
          <div class="text-white/50 mt-1">Rok přestavby</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">★★★★★</div>
          <div class="text-white/50 mt-1">5 hvězdiček</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">5 900 m²</div>
          <div class="text-white/50 mt-1">Lázeňský komplex</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">UNESCO</div>
          <div class="text-white/50 mt-1">Světové dědictví</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Anniversary Packages -->
  <section class="bg-beige-100 py-16 md:py-24">
    <div class="container-wide">
      <div class="text-center mb-12">
        <span class="text-yellow-600 text-xs font-semibold uppercase tracking-wider">★ Výroční nabídka ★</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Připravili jsme pro vás to nejlepší</h2>
        <p class="text-beige-700 mt-3 max-w-2xl mx-auto">Oslavte 130 let Nových Lázní speciálními balíčky, které spojují historii, léčbu a nezapomenutelný zážitek.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto items-center">
        <div class="rounded-2xl overflow-hidden shadow-lg">
          <img src="/images/content/anniversary/illustration.jpg" alt="Nové Lázně — kresba z roku 2026" class="w-full h-auto" loading="lazy" decoding="async" />
        </div>

        <div class="flex flex-col gap-6">
          <a
            href="https://ensanahotels.com/cs/nabidky/nove-lazne/akce/anniversarystay-2nights?utm_source=marienbad&utm_medium=anniversary&utm_campaign=package-2nights"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-xl p-6 shadow-card hover:shadow-lg transition-shadow border border-beige-200"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="px-3 py-1 bg-yellow-400 text-indigo-900 text-xs font-bold rounded-full">2 noci</span>
              <span class="text-beige-500 text-sm">Výroční pobyt</span>
            </div>
            <h3 class="font-heading text-xl font-bold text-indigo-700 group-hover:text-turquoise-600 transition-colors mb-2">Anniversary Stay — víkendový zážitek</h3>
            <p class="text-beige-700 text-sm leading-relaxed mb-3">Krátký pobyt s přístupem do Římských lázní, uhličitou koupelí a pitnou kúrou. Ideální na prodloužený víkend.</p>
            <span class="text-turquoise-600 text-sm font-semibold group-hover:underline">Zobrazit nabídku →</span>
          </a>

          <a
            href="https://ensanahotels.com/cs/nabidky/nove-lazne/akce/anniversarystay-6nights?utm_source=marienbad&utm_medium=anniversary&utm_campaign=package-6nights"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-xl p-6 shadow-card hover:shadow-lg transition-shadow border border-beige-200"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="px-3 py-1 bg-yellow-400 text-indigo-900 text-xs font-bold rounded-full">6 nocí</span>
              <span class="text-beige-500 text-sm">Výroční kúra</span>
            </div>
            <h3 class="font-heading text-xl font-bold text-indigo-700 group-hover:text-turquoise-600 transition-colors mb-2">Anniversary Stay — kompletní lázeňský týden</h3>
            <p class="text-beige-700 text-sm leading-relaxed mb-3">Týdenní program s plnou lázeňskou péčí, Královskou kabinou, procedurami a lékařskou konzultací.</p>
            <span class="text-turquoise-600 text-sm font-semibold group-hover:underline">Zobrazit nabídku →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights Grid -->
  <section class="container-wide py-16 md:py-24">
    <div class="text-center mb-12">
      <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Co dělá Nové Lázně výjimečnými</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Unikáty, které nikde jinde nenajdete</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {highlights.map((item) => (
        <div class="bg-beige-200 rounded-xl p-6 md:p-8 flex gap-5 items-start">
          <div class="shrink-0 w-12 h-12 rounded-xl bg-indigo-700 flex items-center justify-center">
            <svg class="w-6 h-6 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-lg font-bold text-indigo-700 mb-2">{item.title}</h3>
            <p class="text-beige-700 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architect Section -->
  <section class="bg-indigo-700 text-white py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-turquoise-400 text-xs font-semibold uppercase tracking-wider">Architekt</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mt-3 mb-6">Josef Schaffer — mariánskolázeňský rodák</h2>
        <p class="text-white/70 text-lg leading-relaxed mb-6">
          Impuls ke vzniku Nových Lázní dal <strong class="text-white">opat Alfred Clemens</strong>, který rozhodl o jejich výstavbě, zajistil financování a vtiskl projektu jasnou vizi. Jeho iniciály A.C. a A.T. (Abbas Teplensis) jsou dodnes vytesány ve štítu budovy.
        </p>
        <p class="text-white/70 text-lg leading-relaxed mb-6">
          Architektonickou podobu navrhl <strong class="text-white">mariánskolázeňský rodák Josef Schaffer</strong>. Inspiraci čerpal během svých cest po Itálii — zejména v <strong class="text-white">Benátkách, Boloni a Florencii</strong>. Prvky italské renesance vtiskly stavbě její velkolepý a nadčasový charakter. Výstavba trvala čtyři roky a probíhala vždy v zimě mimo hlavní sezonu, aby nebyl narušen lázeňský provoz. Slavnostní otevření proběhlo <strong class="text-white">1. června 1896</strong>.
        </p>
        <p class="text-white/70 text-lg leading-relaxed">
          Nové Lázně jsou dnes <strong class="text-white">největším historickým balneoprovozem v České republice</strong>. Minerální prameny Lesní a Ambrožův jsou přivedeny přímo do budovy a tvoří základ komplexní lázeňské péče, rehabilitace i moderní diagnostiky včetně oxygenoterapie. Mariánské Lázně jsou od roku 2021 součástí <strong class="text-white">světového dědictví UNESCO</strong> a od roku 2023 nesou <strong class="text-white">statut klimatických lázní</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section id="milniky" class="container-wide py-16 md:py-24">
    <div class="text-center mb-12">
      <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Cesta staletími</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Milníky Nových Lázní</h2>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-[27px] top-0 bottom-0 w-px bg-beige-300 hidden md:block"></div>

        <div class="space-y-8">
          {milestones.map((milestone) => (
            <div class="flex gap-5 items-start">
              <div class="shrink-0 w-14 h-14 rounded-full bg-indigo-700 text-white flex items-center justify-center text-xs font-bold z-10 shadow-lg">
                {milestone.year.includes('–') ? milestone.year.split('–')[0] : milestone.year}
              </div>
              <div class="pt-2">
                <div class="text-turquoise-600 text-sm font-semibold">{milestone.year}</div>
                <h3 class="font-heading text-lg font-bold text-indigo-700 mt-1">{milestone.title}</h3>
                <p class="text-beige-700 text-sm leading-relaxed mt-1">{milestone.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Fun Facts -->
  <section class="bg-beige-200 py-16 md:py-24">
    <div class="container-wide">
      <div class="text-center mb-12">
        <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Věděli jste?</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Zajímavosti z historie</h2>
        <p class="text-beige-700 mt-3 max-w-2xl mx-auto">Příběhy a fakta z 130 let existence Nových Lázní — z archivů Hameliky, Městského muzea Mariánské Lázně a dobového tisku.</p>
