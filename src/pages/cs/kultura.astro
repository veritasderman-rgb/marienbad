---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import EventCalendar from '@/components/EventCalendar.astro'
import { getPage } from '@/content/reader'

const locale = 'cs' as const
const page = await getPage('cs-kultura')
---

<Base locale={locale} section="things-to-do" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/kultur', en: '/en/culture', cs: '/cs/kultura', ru: '/ru/kultura' }}>
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <EventCalendar locale={locale} />
  </PillarPage>
</Base>
