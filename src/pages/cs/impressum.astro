---
import Base from '@/layouts/Base.astro'

const locale = 'cs' as const
---

<Base locale={locale} title="Impressum — Marienbad.com" description="Právní informace a údaje o provozovateli webu marienbad.com." alternateUrls={{ de: '/de/impressum', en: '/en/imprint', cs: '/cs/impressum', ru: '/ru/impressum' }}>
  <main class="container-wide py-16 md:py-24">
    <div class="max-w-3xl mx-auto prose-marienbad">
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mb-8">Impressum</h1>

      <h2>Provozovatel</h2>
      <p>Marienbad Tourism<br/>ve spolupráci s Ensana Health Spa Hotels<br/>Hlavní třída 47<br/>353 01 Mariánské Lázně, Česká republika</p>

      <h2>Kontakt</h2>
      <p>E-mail: <a href="mailto:info@marienbad.com">info@marienbad.com</a><br/>Telefon: +420 354 622 474</p>

      <h2>Vyloučení odpovědnosti</h2>
      <p>Navzdory pečlivé kontrole obsahu nepřebíráme odpovědnost za obsah externích odkazů.</p>
    </div>
  </main>
</Base>
