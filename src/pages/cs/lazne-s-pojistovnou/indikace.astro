---
import Base from '@/layouts/Base.astro'
import InsuranceSubpage from '@/components/InsuranceSubpage.astro'
import { INSURANCE_BASE, getSubPage, indicationPages } from '@/data/insuranceSpa'
import { indications } from '@/data/indications'

export const prerender = true

const locale = 'cs' as const
const page = getSubPage('indikace')
const cs = indications.cs

/** Počet statutárních položek v každé skupině — orientační měřítko rozsahu. */
const itemCount = (groupId: string) => cs.groups.find((g) => g.id === groupId)?.items.length ?? 0
---

<Base
  locale={locale}
  section="insurance-spa"
  title={page.metaTitle}
  description={page.metaDescription}
  alternateUrls={{ cs: `${INSURANCE_BASE}/${page.slug}` }}
>
  <InsuranceSubpage title={page.title} lead={page.lead} current={page.slug} image={page.image} imageAlt={page.imageAlt} eyebrow="Lázně s pojišťovnou" extraCrumbs={[{ label: page.navLabel }]}>

    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-4">Devět indikačních skupin</h2>
      <p class="text-beige-800 text-base md:text-lg leading-relaxed mb-8">
        Každá skupina má v indikačním seznamu vlastní římské číslo a v něm očíslované diagnózy — právě ten kód
        uvádí lékař do návrhu. U každé skupiny najdete, co konkrétně se léčí, jakými procedurami a jak dlouhý
        pobyt pojišťovna hradí.
      </p>

      <ul class="grid gap-4 sm:grid-cols-2 list-none p-0 m-0">
        {indicationPages.map((ind) => (
          <li class="m-0">
            <a
              href={`${INSURANCE_BASE}/indikace/${ind.slug}`}
              class="group flex flex-col h-full gap-3 bg-white border border-beige-200 p-6 hover:border-turquoise-400 hover:shadow-card transition-all duration-300"
              style="border-radius: var(--radius-card);"
            >
              <div class="flex items-center gap-3">
                <span class="shrink-0 w-10 h-10 rounded-lg bg-indigo-700 text-white text-sm font-bold flex items-center justify-center">{ind.roman}</span>
                <span class="text-beige-700 text-xs uppercase tracking-wider font-semibold">
                  {itemCount(ind.groupId)} {itemCount(ind.groupId) === 1 ? 'diagnóza' : itemCount(ind.groupId) < 5 ? 'diagnózy' : 'diagnóz'} v seznamu
                </span>
              </div>
              <h3 class="font-heading text-lg font-bold text-indigo-700 group-hover:text-turquoise-600 transition-colors">{ind.title}</h3>
              <p class="text-beige-800 text-sm leading-relaxed">{ind.teaser}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-indigo-600 text-sm font-semibold pt-2">
                Zobrazit detail
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-beige-100 border border-beige-200 p-6 md:p-8" style="border-radius: var(--radius-card);">
      <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-4">Jak číst zápis „základní pobyt K 21, P 21“</h2>
      <div class="grid gap-4 sm:grid-cols-2 mb-5">
        <div class="bg-white border border-beige-200 rounded-xl px-5 py-4">
          <p class="font-heading font-bold text-indigo-700 mb-1">K — komplexní péče</p>
          <p class="text-beige-800 text-sm leading-relaxed">Číslo za písmenem je délka pobytu ve dnech: K 21 znamená 21 dnů, K 28 dvacet osm.</p>
        </div>
        <div class="bg-white border border-beige-200 rounded-xl px-5 py-4">
          <p class="font-heading font-bold text-indigo-700 mb-1">P — příspěvková péče</p>
          <p class="text-beige-800 text-sm leading-relaxed">P 21 znamená 21 dnů; údaj v závorce, například (P 14), je zkrácená varianta u opakovaného pobytu.</p>
        </div>
      </div>
      <p class="text-beige-900 text-base leading-relaxed">
        <strong>Základní pobyt</strong> je první lázeňská péče pro danou diagnózu, <strong>opakovaný pobyt</strong> je
        každý další. U řady diagnóz je základní pobyt hrazen jako komplexní péče, opakovaný už jen jako příspěvkový —
        proto se rozsah úhrady u druhého pobytu často liší.
      </p>
    </section>

    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-4">{cs.contraindicationsTitle}</h2>
      <p class="text-beige-800 text-base md:text-lg leading-relaxed mb-6">{cs.contraindicationsIntro}</p>
      <ul class="flex flex-col gap-3 list-none p-0 m-0">
        {cs.contraindications.map((item) => (
          <li class="flex gap-3 text-beige-800 text-base leading-relaxed">
            <svg class="w-5 h-5 text-aubergine-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-indigo-50 border border-indigo-100 p-6 md:p-8" style="border-radius: var(--radius-card);">
      <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-3">{cs.disclaimerTitle}</h2>
      <p class="text-beige-900 text-base leading-relaxed mb-4">{cs.disclaimer}</p>
      <p class="text-beige-700 text-sm leading-relaxed mb-4">{cs.sourceNote}</p>
      <a href="/cs/indikace-a-kontraindikace" class="inline-flex items-center gap-2 text-indigo-600 font-semibold hover:text-turquoise-600 transition-colors">
        Úplný indikační seznam se všemi kódy
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </section>

  </InsuranceSubpage>
</Base>
