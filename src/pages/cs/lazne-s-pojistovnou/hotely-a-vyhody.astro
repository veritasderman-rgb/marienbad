---
import Base from '@/layouts/Base.astro'
import InsuranceSubpage from '@/components/InsuranceSubpage.astro'
import Pic from '@/components/Pic.astro'
import { INSURANCE_BASE, benefits, getSubPage, hotelsFreeNote, hotelsIntro, insuranceHotels } from '@/data/insuranceSpa'

export const prerender = true

const locale = 'cs' as const
const page = getSubPage('hotely-a-vyhody')
---

<Base
  locale={locale}
  section="insurance-spa"
  title={page.metaTitle}
  description={page.metaDescription}
  alternateUrls={{ cs: `${INSURANCE_BASE}/${page.slug}` }}
>
  <InsuranceSubpage title={page.title} lead={page.lead} current={page.slug} image={page.image} imageAlt={page.imageAlt} eyebrow="Lázně s pojišťovnou" extraCrumbs={[{ label: page.navLabel }]}>

    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-4">Hotely, ve kterých lze péči čerpat</h2>
      <p class="text-beige-800 text-base md:text-lg leading-relaxed mb-4">{hotelsIntro}</p>
      <p class="bg-turquoise-50 border-l-4 border-turquoise-400 text-indigo-800 text-base leading-relaxed px-5 py-4 rounded-r-lg mb-8">
        {hotelsFreeNote}
      </p>

      <div class="flex flex-col gap-5">
        {insuranceHotels.map((hotel) => (
          <article class="bg-white border border-beige-200 overflow-hidden md:grid md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] md:items-start" style="border-radius: var(--radius-card);">
            {/* Fotka vedle údajů a v přirozeném poměru — ořez do nízkého pásu
                usekával budovám střechy. Pic musí být obalený vlastním divem:
                renderuje <picture class="contents">, takže by se <source>
                i <img> staly samostatnými buňkami mřížky a rozhodily ji. */}
            <div class="md:h-full">
              <Pic
                src={hotel.image}
                alt={hotel.imageAlt}
                class="w-full h-auto block md:h-full md:object-cover"
                sizes="(max-width: 768px) 100vw, 352px"
              />
            </div>
            <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-baseline gap-3 mb-3">
              <h3 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 m-0">{hotel.name}</h3>
              <span class="text-yellow-500 text-sm" aria-label={`${hotel.stars} hvězdičky`}>
                {'★'.repeat(hotel.stars)}
              </span>
            </div>
            <p class="text-beige-800 text-base leading-relaxed mb-4">{hotel.note}</p>

            <dl class="grid gap-4 sm:grid-cols-2 m-0 mb-4">
              <div>
                <dt class="text-beige-700 text-xs uppercase tracking-wider font-semibold mb-1">Kapacita</dt>
                <dd class="text-beige-900 text-sm leading-relaxed m-0">{hotel.rooms}</dd>
              </div>
              <div>
                <dt class="text-beige-700 text-xs uppercase tracking-wider font-semibold mb-1">Kategorie pokojů v ceníku</dt>
                <dd class="text-beige-900 text-sm leading-relaxed m-0">{hotel.roomCategories.join(' · ')}</dd>
              </div>
            </dl>

            {hotel.dependance && (
              <ul class="flex flex-col gap-2 list-none p-0 m-0 mb-4">
                {hotel.dependance.map((dep) => (
                  <li class="bg-beige-100 border border-beige-200 rounded-lg px-4 py-3 text-sm text-beige-900 leading-relaxed">
                    <strong class="text-indigo-800">{dep.name}</strong> — {dep.rooms}. {dep.note}
                  </li>
                ))}
              </ul>
            )}

            {hotel.hotelSlug && (
              <a href={`/cs/hotel/${hotel.hotelSlug}`} class="inline-flex items-center gap-2 text-indigo-600 font-semibold text-sm hover:text-turquoise-600 transition-colors">
                Detail hotelu, fotogalerie a vybavení
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            )}
            </div>
          </article>
        ))}
      </div>

      <p class="text-beige-700 text-sm leading-relaxed mt-6">
        Umístění vašeho návrhu se řeší podle aktuální volné kapacity — kapacita pokojů je omezená a konkrétní hotel
        nelze garantovat bez předchozí rezervace. Ta je zdarma.
      </p>
    </section>

    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-4">Co k pobytu dostanete navíc</h2>
      <p class="text-beige-800 text-base md:text-lg leading-relaxed mb-8">
        Tři až čtyři týdny jsou dost dlouhá doba na to, aby záleželo i na tom, co je k dispozici mimo procedury.
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        {benefits.map((benefit) => (
          <article class="bg-beige-100 border border-beige-200 p-6 flex flex-col h-full" style="border-radius: var(--radius-card);">
            <h3 class="font-heading text-lg font-bold text-indigo-700 mb-3">{benefit.title}</h3>
            <p class="text-beige-900 text-sm leading-relaxed mb-4">{benefit.body}</p>
            {benefit.href && (
              <a href={benefit.href} class="mt-auto inline-flex items-center gap-2 text-indigo-600 text-sm font-semibold hover:text-turquoise-600 transition-colors">
                {benefit.linkLabel}
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

  </InsuranceSubpage>
</Base>
