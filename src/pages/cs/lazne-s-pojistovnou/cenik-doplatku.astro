---
import Base from '@/layouts/Base.astro'
import InsuranceSubpage from '@/components/InsuranceSubpage.astro'
import InsurancePriceTable from '@/components/InsurancePriceTable.astro'
import { INSURANCE_BASE, getSubPage, priceDisclaimer, priceLists, spaTax } from '@/data/insuranceSpa'

export const prerender = true

const locale = 'cs' as const
const page = getSubPage('cenik-doplatku')
const [klp, plp] = priceLists
---

<Base
  locale={locale}
  section="insurance-spa"
  title={page.metaTitle}
  description={page.metaDescription}
  alternateUrls={{ cs: `${INSURANCE_BASE}/${page.slug}` }}
>
  <InsuranceSubpage title={page.title} lead={page.lead} current={page.slug} image={page.image} imageAlt={page.imageAlt} eyebrow="Lázně s pojišťovnou" extraCrumbs={[{ label: page.navLabel }]}>

    <section>
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-4">Jak ceník číst</h2>
      <div class="grid gap-4 sm:grid-cols-3 mb-6">
        <div class="bg-beige-100 border border-beige-200 p-5 rounded-xl">
          <p class="font-semibold text-indigo-800 mb-2">1/2 a 1/1</p>
          <p class="text-beige-800 text-sm leading-relaxed">
            1/2 je jedno lůžko ve dvoulůžkovém pokoji — druhé lůžko obsadí další host. 1/1 je jednolůžkový pokoj.
          </p>
        </div>
        <div class="bg-beige-100 border border-beige-200 p-5 rounded-xl">
          <p class="font-semibold text-indigo-800 mb-2">Tři sezóny</p>
          <p class="text-beige-800 text-sm leading-relaxed">
            Nejlevnější je leden až duben, nejdražší hlavní sezóna od května do října. Listopad a prosinec jsou mezi tím.
          </p>
        </div>
        <div class="bg-beige-100 border border-beige-200 p-5 rounded-xl">
          <p class="font-semibold text-indigo-800 mb-2">Ceny za osobu</p>
          <p class="text-beige-800 text-sm leading-relaxed">
            Všechny částky jsou v Kč včetně DPH a platí za jednu osobu na uvedené období.
          </p>
        </div>
      </div>
      <nav aria-label="Rychlý přechod na ceník" class="flex flex-wrap gap-3">
        <a href="#cenik-klp" class="inline-flex items-center gap-2 border border-indigo-200 text-indigo-700 font-semibold px-5 py-2.5 rounded-full hover:bg-indigo-50 transition-colors">
          Komplexní péče
        </a>
        <a href="#cenik-plp" class="inline-flex items-center gap-2 border border-indigo-200 text-indigo-700 font-semibold px-5 py-2.5 rounded-full hover:bg-indigo-50 transition-colors">
          Příspěvková péče
        </a>
      </nav>
    </section>

    <InsurancePriceTable list={klp} />

    <InsurancePriceTable list={plp} />

    <section class="bg-beige-100 border border-beige-200 p-6 md:p-8" style="border-radius: var(--radius-card);">
      <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-3">Lázeňský poplatek města</h2>
      <p class="text-indigo-800 text-2xl font-bold mb-3">{spaTax.amount}</p>
      <p class="text-beige-900 text-base leading-relaxed mb-3">{spaTax.text}</p>
      <p class="text-beige-800 text-sm leading-relaxed">{spaTax.exemptions}</p>
    </section>

    <section>
      <h2 class="font-heading text-xl md:text-2xl font-bold text-indigo-700 mb-4">Důležité poznámky k ceníku</h2>
      <ul class="flex flex-col gap-3 list-none p-0 m-0">
        {priceDisclaimer.map((item) => (
          <li class="flex gap-3 text-beige-800 text-base leading-relaxed">
            <svg class="w-5 h-5 text-beige-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="text-beige-700 text-sm leading-relaxed mt-6">
        Zdroj: oficiální ceníky Léčebných lázní Mariánské Lázně a.s. pro rok 2026 — Ceník komplexní lázeňské péče
        (změny platné od 15. 6. 2026) a Ceník příspěvkové lázeňské péče. Tato stránka má informativní charakter;
        závazné jsou vždy aktuální ceníky poskytovatele.
      </p>
    </section>

  </InsuranceSubpage>
</Base>
