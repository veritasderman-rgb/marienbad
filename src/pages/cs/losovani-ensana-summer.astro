    <div class="card">
      <div class="card-head">
        <h3>Postup, na kterém to stojí</h3>
      </div>
      <p class="prose">
        Seznam se seřadí podle e-mailu (porovnání po znacích, ne podle české abecedy — jinak by výsledek závisel
        na nastavení počítače) a očísluje od 1. Kanonický zápis je <em>číslo, tabulátor, e-mail, konec řádku</em>
        pro každý los, v kódování UTF-8. Z něj vzniká otisk:
      </p>
      <div class="formula">otisk = SHA-256( "1\te-mail\n2\te-mail\n…" )</div>
      <p class="prose">Výherce je pak jednoznačně dán otiskem, taženými čísly a počtem losů:</p>
      <div class="formula">index = ( SHA-256( čísla + "|" + otisk ) mod N ) + 1</div>
      <p class="prose">
        Náhradníci se odvozují stejně, jen se do vstupu přidá pořadí a už vylosovaná čísla se přeskakují:
      </p>
      <div class="formula">index_k = ( SHA-256( čísla + "|" + otisk + "|" + k ) mod N ) + 1</div>
      <p class="callout">
        Otisk se zveřejňuje <strong>před</strong> tahem Sportky, čísla vzniknou <strong>po</strong> něm.
        Ani jedna strana tak nemůže ovlivnit druhou — a v tom je celý důkaz.
      </p>
    </div>

  </section>

</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const $ = (id) => document.getElementById(id);

/* ══════════════════ stav ══════════════════ */

const state = {
  sources: { ml: [], ocr: [] },   // syrové řádky ze souborů
  entries: [],                    // sloučené, po deduplikaci
  flags: [],                      // řádky ke kontrole
  fixes: new Map(),               // ruční zásahy podle id řádku, přežijí přepočet
  dupes: 0,
  frozen: null,                   // { list, hash, n }
  showMails: false,
  lastDraw: null,
};

/* ══════════════════ CSV ══════════════════ */

/** Oddělovač se hádá podle prvního řádku — MailerLite dává čárky, české Excely středníky. */
function sniffDelimiter(text) {
  const line = text.split(/\r?\n/).find((l) => l.trim().length) || '';
  const counts = [[',', 0], [';', 0], ['\t', 0]];
  let inQuotes = false;
  for (const ch of line) {
    if (ch === '"') inQuotes = !inQuotes;
    else if (!inQuotes) for (const c of counts) if (ch === c[0]) c[1]++;
  }
  counts.sort((a, b) => b[1] - a[1]);
  return counts[0][1] > 0 ? counts[0][0] : ',';
}

function parseCsv(text) {
  const clean = text.replace(/^﻿/, '');
  const delim = sniffDelimiter(clean);
  const rows = [];
  let row = [], field = '', inQuotes = false;

  for (let i = 0; i < clean.length; i++) {
    const ch = clean[i];
    if (inQuotes) {
      if (ch === '"') {
        if (clean[i + 1] === '"') { field += '"'; i++; }
        else inQuotes = false;
      } else field += ch;
    } else if (ch === '"') {
      inQuotes = true;
    } else if (ch === delim) {
      row.push(field); field = '';
    } else if (ch === '\n') {
      row.push(field); rows.push(row); row = []; field = '';
    } else if (ch !== '\r') {
      field += ch;
    }
  }
  if (field.length || row.length) { row.push(field); rows.push(row); }
  return rows.filter((r) => r.some((c) => c.trim().length));
}

/** Najde sloupec s e-mailem podle hlavičky; když hlavička nesedí, vezme sloupec s nejvíc zavináči. */
function pickColumns(rows) {
  if (!rows.length) return null;
  const header = rows[0].map((h) => h.trim().toLowerCase());
  let emailIdx = header.findIndex((h) => /^(e[-\s]?mail|email_?address|mail)$/.test(h));
  if (emailIdx === -1) emailIdx = header.findIndex((h) => h.includes('mail'));

  // buňka s adresou obsahuje „mail" i v datovém řádku — když to, co jsme
  // vzali za hlavičku, samo vypadá jako e-mail, hlavička tam prostě není
  if (emailIdx !== -1 && EMAIL_RE.test(normalize(rows[0][emailIdx]))) emailIdx = -1;

  let body = rows.slice(1);
  if (emailIdx === -1) {
    // žádná použitelná hlavička — hledáme sloupec s nejvíc zavináči a bereme i první řádek
    const width = Math.max(...rows.map((r) => r.length));
    let best = -1, bestScore = 0;
    for (let c = 0; c < width; c++) {
      const score = rows.filter((r) => (r[c] || '').includes('@')).length;
      if (score > bestScore) { bestScore = score; best = c; }
    }
    if (best === -1) return null;
    emailIdx = best;
    body = rows;
  }

  const nameIdx = header.findIndex((h) => /^(name|jm[eé]no|first_?name|kř?estn[ií].*)/.test(h));
  const surIdx = header.findIndex((h) => /^(last_?name|p[řr][ií]jmen[ií])/.test(h));
  return { emailIdx, nameIdx, surIdx, body };
}

/* ══════════════════ kontrola adres ══════════════════ */

const KNOWN_DOMAINS = [
  'seznam.cz', 'email.cz', 'centrum.cz', 'volny.cz', 'post.cz', 'atlas.cz', 'tiscali.cz',
  'gmail.com', 'googlemail.com', 'hotmail.com', 'outlook.com', 'outlook.cz', 'live.com',
  'icloud.com', 'me.com', 'yahoo.com', 'yahoo.de', 'gmx.de', 'gmx.net', 'web.de',
  't-online.de', 'freenet.de', 'azet.sk', 'zoznam.sk', 'pobox.sk', 'chello.cz', 'quick.cz',
];

function editDistance(a, b) {
  const m = a.length, n = b.length;
  if (Math.abs(m - n) > 2) return 9;
  let prev = Array.from({ length: n + 1 }, (_, j) => j);
  for (let i = 1; i <= m; i++) {
    const cur = [i];
    for (let j = 1; j <= n; j++) {
      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
    }
    prev = cur;
  }
  return prev[n];
}

const EMAIL_RE = /^[^\s@,;:<>()[\]\\]+@[^\s@,;:<>()[\]\\]+\.[a-z]{2,}$/i;

/** Vrací null, když je adresa v pořádku, jinak důvod k ruční kontrole. */
function suspect(raw, normalized, fromOcr) {
  if (!normalized) return 'prázdná adresa';
  if (/\s/.test(raw.trim())) return 'mezera uvnitř adresy';
  const ats = (normalized.match(/@/g) || []).length;
  if (ats === 0) return 'chybí zavináč';
  if (ats > 1) return 'víc zavináčů než jeden';
  if (!EMAIL_RE.test(normalized)) return 'neplatný tvar adresy';

  const domain = normalized.split('@')[1];
  if (!domain.includes('.')) return 'doména bez tečky';
  if (KNOWN_DOMAINS.includes(domain)) return null;

  // typická OCR záměna v doméně — nabídneme nejbližší běžnou
  let best = null, bestD = 3;
  for (const d of KNOWN_DOMAINS) {
    const dist = editDistance(domain, d);
    if (dist < bestD) { bestD = dist; best = d; }
  }
  if (best && bestD <= 2) return `možná překlep v doméně — nemá tam být ${best}?`;
  if (fromOcr && /[0О1lI]/.test(domain)) return 'v doméně je znak, který OCR často plete';
  return null;
}

const normalize = (s) => (s || '').trim().replace(/^["'<]+|["'>]+$/g, '').replace(/\s+/g, '').toLowerCase();

/** Označený řádek je vyřízený, jen když je vyřazený nebo opravený na platnou adresu. */
function isResolved(f) {
  if (f.dropped) return true;
  const fixed = normalize(f.fixed);
  return !!fixed && !suspect(f.fixed, fixed, false);
}

/* ══════════════════ načtení souborů ══════════════════ */

async function readFiles(fileList, bucket) {
  const rows = [];
  for (const file of fileList) {
    const text = await file.text();
    const cols = pickColumns(parseCsv(text));
    if (!cols) { toast(`V souboru ${file.name} jsem nenašel sloupec s e-mailem.`); continue; }
    for (const r of cols.body) {
      const raw = r[cols.emailIdx] || '';
      if (!raw.trim()) continue;
      const name = [cols.nameIdx >= 0 ? r[cols.nameIdx] : '', cols.surIdx >= 0 ? r[cols.surIdx] : '']
        .filter((x) => x && x.trim()).join(' ').trim();
      // Klíč podle obsahu, ne podle pořadí: po opětovném nahrání opraveného
      // exportu by pozice ukázala na jiného člověka a oprava by se tiše
      // přenesla na cizí přihlášku.
      rows.push({ id: `${bucket}::${raw.trim().toLowerCase()}`, raw, name, file: file.name });
    }
  }
  state.sources[bucket] = rows;
  rebuild();
  return rows.length;
}

/** Sloučí oba zdroje, odstraní duplicity a vytřídí adresy ke kontrole. */
function rebuild() {
  const seen = new Map();
  state.flags = [];
  state.dupes = 0;

  for (const bucket of ['ml', 'ocr']) {
    const fromOcr = bucket === 'ocr';
    for (const row of state.sources[bucket]) {
      const email = normalize(row.raw);
      const why = suspect(row.raw, email, fromOcr);
      if (why) {
        const edit = state.fixes.get(row.id) || { fixed: '', dropped: false };
        state.flags.push({ ...row, email, why, source: fromOcr ? 'papír' : 'MailerLite', ...edit });
        continue;
      }
      if (seen.has(email)) { state.dupes++; continue; }
      seen.set(email, { email, name: row.name, source: fromOcr ? 'papír' : 'MailerLite' });
    }
  }

  // ručně opravené řádky se přidají zpátky
  for (const f of state.flags) {
    if (f.dropped) continue;
    const fixed = normalize(f.fixed);
    if (!fixed || suspect(f.fixed, fixed, false)) continue;
    if (seen.has(fixed)) { state.dupes++; continue; }
    seen.set(fixed, { email: fixed, name: f.name, source: f.source });
  }

  state.entries = [...seen.values()];
  state.frozen = null;

  // Se seznamem padá i tah, který z něj vzešel. Jinak by šlo zkopírovat
  // výsledek patřící k jiným datům — a přepnutí maskování by spadlo.
  if (state.lastDraw) {
    state.lastDraw = null;
    resetStage();
    $('result-card').hidden = true;
  }
  render();
}

/* ══════════════════ vykreslení fáze 1 ══════════════════ */

function render() {
  const has = state.sources.ml.length + state.sources.ocr.length > 0;
  $('stats').hidden = !has;
  $('stat-total').textContent = state.entries.length;
  $('stat-paper').textContent = state.entries.filter((e) => e.source === 'papír').length;
  $('stat-dupes').textContent = state.dupes;
  const open = state.flags.filter((f) => !isResolved(f)).length;
  $('stat-flags').textContent = open;

  $('review-card').hidden = state.flags.length === 0;
  renderReview();

  // Zmrazit nelze, dokud visí nevyřízený řádek — jinak by se do losování šlo
  // s pool­em, ze kterého někdo tiše vypadl.
  $('freeze').disabled = state.entries.length === 0 || open > 0;
  $('freeze-block').hidden = open === 0;
  $('freeze-block').textContent = open === 1
    ? 'Zbývá vyřídit 1 označenou adresu — opravte ji, nebo ji vyřaďte. Do losování nesmí jít seznam, ze kterého někdo tiše vypadl.'
    : `Zbývá vyřídit ${open} označených adres — opravte je, nebo je vyřaďte. Do losování nesmí jít seznam, ze kterého někdo tiše vypadl.`;
  $('commit-out').hidden = !state.frozen;
  $('copy-list').hidden = !state.frozen;
  $('draw').disabled = !state.frozen || !currentSeed();
  renderDrawSource();
}

function renderReview() {
  const host = $('review');
  host.textContent = '';
  state.flags.forEach((f) => {
    const row = document.createElement('div');
    row.className = 'row' + (f.dropped ? ' is-dropped' : '');

    const why = document.createElement('div');
    why.className = 'why';
    const reason = document.createElement('span');
    reason.textContent = `${f.why} · ${f.source}`;
    const raw = document.createElement('span');
    raw.className = 'raw';
    raw.textContent = f.raw.trim();
    why.append(reason, raw);

    const input = document.createElement('input');
    input.type = 'text';
    input.value = f.fixed;
    input.placeholder = 'správná adresa podle papíru';
    input.setAttribute('aria-label', `Oprava adresy ${f.raw.trim()}`);
    input.disabled = f.dropped;
    input.addEventListener('change', () => {
      const edit = state.fixes.get(f.id) || { fixed: '', dropped: false };
      state.fixes.set(f.id, { ...edit, fixed: input.value });
      rebuild();
    });

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-ghost btn-small';
    btn.textContent = f.dropped ? 'Vrátit' : 'Vyřadit';
    btn.addEventListener('click', () => {
      const edit = state.fixes.get(f.id) || { fixed: '', dropped: false };
      state.fixes.set(f.id, { ...edit, dropped: !f.dropped });
      rebuild();
    });

    row.append(why, input, btn);
    host.append(row);
  });
}

/* ══════════════════ zmrazení ══════════════════ */

const enc = new TextEncoder();

async function sha256Hex(str) {
  const buf = await crypto.subtle.digest('SHA-256', enc.encode(str));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
}

/** Řadí se po znacích (ne podle locale), aby výsledek nezávisel na nastavení počítače. */
function canonicalList(entries) {
  const sorted = [...entries].sort((a, b) => (a.email < b.email ? -1 : a.email > b.email ? 1 : 0));
  return sorted.map((e, i) => ({ ...e, index: i + 1 }));
}

async function freeze() {
  const list = canonicalList(state.entries);
  const canonical = list.map((e) => `${e.index}\t${e.email}\n`).join('');
  const hash = await sha256Hex(canonical);
  state.frozen = { list, hash, n: list.length };

  const today = new Date().toISOString().slice(0, 10);
  $('commit-text').textContent =
`LOSOVÁNÍ ENSANA SUMMER — ZÁVAZEK K SEZNAMU
Zveřejněno: ${today}

Počet losů (N):  ${list.length}
Otisk seznamu:   ${hash}

Postup zveřejněný předem:
  otisk  = SHA-256( "1<TAB>e-mail\\n2<TAB>e-mail\\n…" ), seznam seřazený vzestupně po znacích
  index  = ( SHA-256( tažená čísla + "|" + otisk ) mod N ) + 1
  náhr.  = ( SHA-256( tažená čísla + "|" + otisk + "|" + pořadí ) mod N ) + 1

Zdroj náhody: první tah Sportky ze dne …………, čísla seřazená vzestupně
              a spojená pomlčkou.

Seznam se nezveřejňuje — obsahuje osobní údaje. Zveřejněný otisk stačí
k tomu, aby šlo po tahu ověřit, že se s ním nehýbalo.`;
  render();
  toast('Seznam zmrazen. Otisk zveřejněte před tahem.');
}

/* ══════════════════ losování ══════════════════ */

/**
 * Z libovolného zápisu udělá jednoznačný tvar: čísla vzestupně, spojená pomlčkou.
 *
 * Kontrola je schválně přísná — musí to být přesně šest různých čísel 1–49.
 * Volnější pravidlo by spolklo i překlep nebo datum omylem zkopírované
 * k výsledku, seed by vyšel jiný a stránka by přesto tvářila, že losuje
 * podle vyhlášeného tahu.
 */
function parseSeed(input) {
  const nums = (String(input).match(/\d+/g) || []).map((n) => parseInt(n, 10));
  if (!nums.length) return { seed: '', error: '' };
  if (nums.length !== 6) return { seed: '', error: `Sportka má šest čísel, tady jich je ${nums.length}. Opište jen tažená čísla, bez data a pořadí tahu.` };
  if (nums.some((n) => n < 1 || n > 49)) return { seed: '', error: 'Tažená čísla Sportky jsou v rozsahu 1 až 49.' };
  if (new Set(nums).size !== 6) return { seed: '', error: 'Dvě čísla se opakují — v jednom tahu se každé číslo objeví nejvýš jednou.' };
  return { seed: [...nums].sort((a, b) => a - b).join('-'), error: '' };
}

const normalizeSeed = (input) => parseSeed(input).seed;

const currentSeed = () => normalizeSeed($('seed').value);

async function indexFrom(seed, hash, n, k) {
  const input = k == null ? `${seed}|${hash}` : `${seed}|${hash}|${k}`;
  const hex = await sha256Hex(input);
  return Number(BigInt('0x' + hex) % BigInt(n)) + 1;
}

async function pickWinners(seed, hash, n, count) {
  const picked = [];
  const first = await indexFrom(seed, hash, n);
  picked.push(first);
  let k = 1;
  while (picked.length < Math.min(count, n) && k < n * 4 + 50) {
    const idx = await indexFrom(seed, hash, n, k);
    if (!picked.includes(idx)) picked.push(idx);
    k++;
  }
  return picked;
}

const maskMail = (mail) => {
  const [user, domain] = mail.split('@');
  if (!domain) return mail;
  const head = user.slice(0, 1);
  return `${head}${'*'.repeat(Math.max(2, user.length - 1))}@${domain}`;
};

const showMail = (mail) => (state.showMails ? mail : maskMail(mail));

function renderChips(seed) {
  const host = $('chips');
  host.textContent = '';
  if (!seed) return;
  for (const n of seed.split('-')) {
    const chip = document.createElement('span');
    chip.className = 'chip';
    chip.textContent = n;
    host.append(chip);
  }
}

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function spinTo(target, n) {
  const dial = $('dial');
  dial.classList.remove('is-locked', 'is-idle');
  if (reduceMotion) { dial.textContent = target; dial.classList.add('is-locked'); return Promise.resolve(); }

  return new Promise((resolve) => {
    const total = 2200;
    const start = performance.now();
    let last = 0;
    const tick = (now) => {
      const t = Math.min(1, (now - start) / total);
      const eased = 1 - Math.pow(1 - t, 3);
      const gap = 28 + eased * 190;           // losování se ke konci zpomaluje
      if (now - last > gap) {
        dial.textContent = 1 + Math.floor(Math.random() * n);
        last = now;
      }
      if (t < 1) requestAnimationFrame(tick);
      else { dial.textContent = target; dial.classList.add('is-locked'); resolve(); }
    };
    requestAnimationFrame(tick);
  });
}

async function draw() {
  if (!state.frozen) { toast('Nejdřív zmrazte seznam v první fázi.'); return; }
  const { seed, error } = parseSeed($('seed').value);
  if (!seed) { toast(error || 'Zadejte šest tažených čísel.'); return; }

  const { hash, n, list } = state.frozen;
  const picks = await pickWinners(seed, hash, n, 3);
  state.lastDraw = { seed, picks };

  $('draw').disabled = true;
  $('stage-cta').classList.remove('is-ready');
  $('winner').classList.remove('is-shown');
  $('subs').textContent = '';
  renderChips(seed);

  await spinTo(picks[0], n);

  const win = list[picks[0] - 1];
  $('w-name').textContent = win.name || `Los číslo ${picks[0]}`;
  $('w-mail').textContent = showMail(win.email);
  $('w-meta').textContent = `Los ${picks[0]} z ${n} · přihláška: ${win.source}`;
  $('winner').classList.add('is-shown');

  const subs = $('subs');
  picks.slice(1).forEach((p, i) => {
    const e = list[p - 1];
    const el = document.createElement('div');
    el.className = 'sub';
    const rank = document.createElement('span');
    rank.className = 'rank';
    rank.textContent = `${i + 1}. náhradník · los ${p}`;
    const mail = document.createElement('span');
    mail.className = 'mail';
    mail.textContent = showMail(e.email);
    el.append(rank, mail);
    subs.append(el);
  });

  const today = new Date().toISOString().slice(0, 10);
  const subLines = picks.slice(1)
    .map((p, i) => `${i + 1}. náhradník:   los č. ${p} — ${maskMail(list[p - 1].email)}`)
    .join('\n');
  $('result-text').textContent =
`LOSOVÁNÍ ENSANA SUMMER — VÝSLEDEK
Losováno: ${today}

Tažená čísla:   ${seed}
Otisk seznamu:  ${hash}
Počet losů (N): ${n}

Výherce:        los č. ${picks[0]} — ${maskMail(win.email)}
${subLines}

Přepočítat si to může kdokoli — stačí tažená čísla, otisk a N.`;
  $('result-card').hidden = false;
  $('draw').disabled = false;
}

/** Přepíše jen adresy — po přepnutí maskování nemá smysl točit dialem znovu. */
function redrawMails() {
  if (!state.lastDraw || !state.frozen) return;
  const { picks } = state.lastDraw;
  const { list } = state.frozen;
  $('w-mail').textContent = showMail(list[picks[0] - 1].email);
  [...$('subs').querySelectorAll('.mail')].forEach((el, i) => {
    el.textContent = showMail(list[picks[i + 1] - 1].email);
  });
}

function renderDrawSource() {
  const host = $('draw-src');
  host.textContent = '';
  const p = document.createElement('p');
  p.className = state.frozen ? 'callout' : 'callout warn';
  if (state.frozen) {
    p.innerHTML = `Zmrazený seznam: <strong>${state.frozen.n} losů</strong>, otisk <span class="hash">${state.frozen.hash.slice(0, 16)}…</span>`;
  } else {
    p.innerHTML = '<strong>Seznam ještě není zmrazený.</strong> Vraťte se do první fáze — bez otisku by losování nebylo čím doložit.';
  }
  host.append(p);
}

/* ══════════════════ ověření ══════════════════ */

async function verify() {
  const hash = $('v-hash').value.trim().toLowerCase();
  const n = parseInt($('v-n').value.replace(/\D/g, ''), 10);
  const { seed, error } = parseSeed($('v-seed').value);

  if (!/^[0-9a-f]{64}$/.test(hash)) { toast('Otisk musí mít 64 znaků 0–9 a a–f.'); return; }
  if (!n || n < 1) { toast('Zadejte počet losů N.'); return; }
  if (!seed) { toast(error || 'Zadejte šest tažených čísel.'); return; }

  const picks = await pickWinners(seed, hash, n, 3);
  const subLines = picks.slice(1).map((p, i) => `${i + 1}. náhradník: los č. ${p}`).join('\n');
  $('verify-text').textContent =
`Tažená čísla (normalizovaná): ${seed}
Otisk seznamu:                ${hash}
Počet losů (N):               ${n}

Výherce:      los č. ${picks[0]}
${subLines}

Sedí-li tahle čísla s vyhlášeným výsledkem, losování proběhlo podle
zveřejněného postupu.`;
  $('verify-out').hidden = false;
}

/* ══════════════════ drobná obsluha ══════════════════ */

let toastTimer;
function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.add('is-shown');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('is-shown'), 3200);
}

async function copy(text, label) {
  try {
    await navigator.clipboard.writeText(text);
    toast(`${label} zkopírováno do schránky.`);
  } catch {
    toast('Schránka není dostupná — text označte a zkopírujte ručně.');
  }
}

function selectPhase(which) {
  for (const key of ['prep', 'draw', 'check']) {
    const on = key === which;
    $(`tab-${key}`).setAttribute('aria-selected', String(on));
    $(`panel-${key}`).classList.toggle('is-active', on);
  }
}

/* ══════════════════ události ══════════════════ */

for (const [id, bucket] of [['drop-ml', 'ml'], ['drop-ocr', 'ocr']]) {
  const zone = $(id);
  const input = zone.querySelector('input[type="file"]');
  const label = zone.querySelector('[data-loaded]');

  const ingest = async (files) => {
    if (!files || !files.length) return;
    const count = await readFiles([...files], bucket);
    zone.classList.add('has-file');
    label.hidden = false;
    label.textContent = `${[...files].map((f) => f.name).join(', ')} · ${count} řádků`;
    // Bez vynulování by výběr téhož souboru podruhé nevyvolal change a stránka
    // by po opravě CSV na disku tvrdila, že se načetlo, aniž by se cokoli změnilo.
    input.value = '';
  };

  input.addEventListener('change', () => ingest(input.files));
  zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('is-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('is-over');
    ingest(e.dataTransfer.files);
  });
}

for (const key of ['prep', 'draw', 'check']) {
  $(`tab-${key}`).addEventListener('click', () => selectPhase(key));
}

$('freeze').addEventListener('click', freeze);
$('go-draw').addEventListener('click', () => selectPhase('draw'));
$('draw').addEventListener('click', draw);
$('verify').addEventListener('click', verify);

$('copy-commit').addEventListener('click', () => copy($('commit-text').textContent, 'Text k závazku'));
$('copy-result').addEventListener('click', () => copy($('result-text').textContent, 'Výsledek'));
$('copy-list').addEventListener('click', () => {
  if (!state.frozen) return;
  const csv = 'index,email,zdroj\n' + state.frozen.list.map((e) => `${e.index},${e.email},${e.source}`).join('\n');
  copy(csv, 'Očíslovaný seznam');
});

$('seed').addEventListener('input', () => {
  const { seed, error } = parseSeed($('seed').value);
  $('seed-norm').textContent = seed
    ? `Do výpočtu vstoupí: ${seed}`
    : error || 'Opište šest tažených čísel.';
  $('seed-norm').classList.toggle('is-error', !!error);
  $('draw').disabled = !state.frozen || !seed;
  if (!state.lastDraw) renderChips(seed);
});

$('reveal-mails').addEventListener('click', (e) => {
  state.showMails = !state.showMails;
  e.currentTarget.setAttribute('aria-pressed', String(state.showMails));
  e.currentTarget.textContent = state.showMails ? 'Skrýt e-maily' : 'Zobrazit celé e-maily';
  if (state.lastDraw) redrawMails();
});

/** Před nahráváním se scéna vyčistí, aby šel natočit i samotný tah. */
function resetStage() {
  $('dial').textContent = '...';
  $('dial').classList.remove('is-locked');
  $('dial').classList.add('is-idle');
  $('winner').classList.remove('is-shown');
  $('subs').textContent = '';
  renderChips(currentSeed());   // čísla ať jsou v záběru dřív, než tah začne
  $('stage-cta').classList.add('is-ready');
}

$('stage-draw').addEventListener('click', async () => {
  $('stage-cta').classList.remove('is-ready');
  await draw();
});

$('rec-mode').addEventListener('click', () => {
  if (!state.frozen) { toast('Nejdřív zmrazte seznam v první fázi.'); return; }
  if (!currentSeed()) { toast('Zadejte šest tažených čísel, ať je co losovat.'); return; }
  resetStage();
  document.body.classList.add('recording');
});
$('rec-exit').addEventListener('click', () => document.body.classList.remove('recording'));
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') document.body.classList.remove('recording');
});

renderDrawSource();
</script>
</body>
</html>
