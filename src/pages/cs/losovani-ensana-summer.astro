---
/**
 * Losovací nástroj pro spotřebitelské soutěže (Ensana Summer).
 *
 * Stránka záměrně NEPOUŽÍVÁ Base.astro: je to celoobrazovkový nástroj, který
 * má režim nahrávání 9:16 pro reels, a lepící se hlavička, patička, cookie
 * lišta ani rezervační pruh do záběru nepatří. Proto si nese vlastní <html>.
 *
 * Není v navigaci a je noindex — cesta je zároveň v NOINDEXED_PATHS
 * v astro.config.mjs, takže nejde ani do sitemapy.
 *
 * Veškerý výpočet běží v prohlížeči. Nahrané kontakty se nikam neodesílají
 * a nikam neukládají; stránka nemá žádný serverový protějšek.
 */
export const prerender = true


---

<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Losování Ensana Summer</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="description" content="Interní nástroj pro transparentní losování výherce soutěže Ensana Summer." />
  <link rel="preload" href="/fonts/Branding-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Branding-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <style is:global>
/* Branding se hostuje u nás — stránka nedělá jediný požadavek ven.
   Rodina má váhy 500/600/700, proto je základ 500 a ne 400. */
@font-face { font-family: "Branding"; src: url("/fonts/Branding-Medium.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
@font-face { font-family: "Branding"; src: url("/fonts/Branding-Semibold.woff2") format("woff2"); font-weight: 600; font-style: normal; font-display: swap; }
@font-face { font-family: "Branding"; src: url("/fonts/Branding-Bold.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }

/* Ensana paleta (src/styles/global.css). Stránka je záměrně jednotématická —
   tmavá — protože se natáčí na video: výsledek nesmí záviset na tom, jestli
   má člověk u prohlížeče zapnutý světlý nebo tmavý režim. Všechny barvy jsou
   proto malované explicitně, žádná se nedědí od hostitele. */
:root {
  --ground:   #001A28;
  --surface:  #002D42;
  --raised:   #004F71;
  --line:     #0d5c7d;
  --ink:      #FAF7F2;
  --muted:    #8FB4C4;
  --accent:   #8BD3E6;
  --prize:    #F6BA00;
  --flag:     #E98CBE;
  --ok:       #7BD8B0;

  --display: 'Branding', 'Segoe UI', system-ui, sans-serif;
  --prose:   Georgia, 'Times New Roman', serif;

  --step-0: 0.9375rem;
  --step-1: 1.0625rem;
  --step-2: 1.375rem;
  --step-3: 1.875rem;
  --step-4: clamp(2rem, 1.4rem + 2.6vw, 3rem);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--ground);
  color: var(--ink);
  font-family: var(--display);
  font-weight: 500;
  font-size: var(--step-1);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* jemná vodní textura na pozadí — lázeňský motiv, ne dekorace pro dekoraci */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(60rem 40rem at 15% -10%, rgba(139, 211, 230, 0.10), transparent 70%),
    radial-gradient(45rem 32rem at 95% 8%, rgba(0, 79, 113, 0.55), transparent 72%);
  z-index: 0;
}

.wrap {
  position: relative;
  z-index: 1;
  max-width: 62rem;
  margin: 0 auto;
  padding: 2rem 1.25rem 5rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

h1, h2, h3 { margin: 0; text-wrap: balance; font-weight: 700; letter-spacing: -0.015em; }
h1 { font-size: var(--step-4); line-height: 1.05; }
h2 { font-size: var(--step-3); line-height: 1.15; }
h3 { font-size: var(--step-2); line-height: 1.25; }
p  { margin: 0; }

.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
}

.prose {
  font-family: var(--prose);
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--muted);
  max-width: 62ch;
}
.prose em { color: var(--ink); font-style: italic; }
.prose strong { color: var(--ink); font-weight: 500; }

/* ---------- hlavička ---------- */

.masthead { display: flex; flex-direction: column; gap: 0.85rem; }
.masthead .lede { max-width: 56ch; }

/* ---------- fázová navigace ---------- */

.phases {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding: 0.4rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  align-self: flex-start;
}
.phase {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-family: inherit;
  font-size: 0.9375rem;
  font-weight: 600;
  padding: 0.5rem 1.1rem;
  border-radius: 999px;
  cursor: pointer;
  display: inline-flex;
  align-items: baseline;
  gap: 0.5rem;
  transition: background 160ms ease, color 160ms ease;
}
.phase:hover { color: var(--ink); }
.phase[aria-selected="true"] { background: var(--accent); color: #00212f; }
.phase .n { font-variant-numeric: tabular-nums; opacity: 0.65; font-size: 0.8125rem; }
.phase[aria-selected="true"] .n { opacity: 0.75; }
.phase:focus-visible { outline: 2px solid var(--prize); outline-offset: 3px; }

/* ---------- panely a karty ---------- */

.panel { display: none; flex-direction: column; gap: 1.75rem; }
.panel.is-active { display: flex; }

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 1rem;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
@media (min-width: 40rem) { .card { padding: 1.85rem; } }

.card-head { display: flex; flex-direction: column; gap: 0.4rem; }

/* ---------- nahrání souborů ---------- */

.drops { display: grid; gap: 1rem; }
@media (min-width: 46rem) { .drops { grid-template-columns: 1fr 1fr; } }

.drop {
  position: relative;
  border: 1.5px dashed var(--line);
  border-radius: 0.85rem;
  padding: 1.35rem;
  background: rgba(0, 79, 113, 0.22);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: border-color 160ms ease, background 160ms ease;
}
.drop.is-over { border-color: var(--accent); background: rgba(139, 211, 230, 0.12); }
.drop.has-file { border-style: solid; border-color: var(--accent); }
.drop h3 { font-size: 1.0625rem; }
.drop .hint { font-size: 0.875rem; color: var(--muted); }
.drop input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.drop .loaded { font-size: 0.875rem; color: var(--accent); font-weight: 600; }

/* ---------- statistiky ---------- */

.stats { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); }
@media (min-width: 46rem) { .stats { grid-template-columns: repeat(4, 1fr); } }
.stat {
  background: rgba(0, 79, 113, 0.35);
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  padding: 0.9rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.stat .v { font-size: 1.75rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
.stat .k { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.stat.flagged .v { color: var(--flag); }
.stat.frozen .v { color: var(--accent); }

/* ---------- kontrolní řádky (OCR) ---------- */

.review { display: flex; flex-direction: column; gap: 0.6rem; max-height: 30rem; overflow-y: auto; padding-right: 0.35rem; }
.row {
  display: grid;
  gap: 0.6rem;
  grid-template-columns: 1fr;
  align-items: center;
  padding: 0.85rem;
  background: rgba(0, 79, 113, 0.3);
  border: 1px solid var(--line);
  border-radius: 0.7rem;
}
@media (min-width: 46rem) { .row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; } }
.row.is-dropped { opacity: 0.45; }
.row .why { font-size: 0.8125rem; color: var(--flag); display: flex; flex-direction: column; gap: 0.15rem; }
.row .why .raw { color: var(--muted); font-family: var(--prose); font-style: italic; word-break: break-all; }
.row input[type="text"] {
  width: 100%;
  background: var(--ground);
  border: 1px solid var(--line);
  border-radius: 0.5rem;
  color: var(--ink);
  font-family: inherit;
  font-size: 0.9375rem;
  padding: 0.55rem 0.7rem;
}
.row input[type="text"]:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

/* ---------- tlačítka ---------- */

.btn {
  appearance: none;
  font-family: inherit;
  font-size: 0.9375rem;
  font-weight: 600;
  border-radius: 999px;
  padding: 0.7rem 1.4rem;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform 120ms ease, background 160ms ease, color 160ms ease;
  white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn:focus-visible { outline: 2px solid var(--prize); outline-offset: 3px; }
.btn-primary { background: var(--accent); color: #00212f; }
.btn-primary:hover { background: #a9e0ee; }
.btn-prize { background: var(--prize); color: #2b2100; font-size: 1.0625rem; padding: 0.85rem 2rem; }
.btn-prize:hover { background: #ffcd2e; }
.btn-ghost { background: transparent; border-color: var(--line); color: var(--ink); }
.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
.btn-small { font-size: 0.8125rem; padding: 0.45rem 0.9rem; }
.btn[disabled] { opacity: 0.4; cursor: not-allowed; }
.btn[disabled]:active { transform: none; }

.actions { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; }

/* ---------- pole ---------- */

.field { display: flex; flex-direction: column; gap: 0.4rem; }
.field label { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
.field input, .field textarea {
  background: var(--ground);
  border: 1px solid var(--line);
  border-radius: 0.6rem;
  color: var(--ink);
  font-family: inherit;
  font-size: 1.0625rem;
  padding: 0.7rem 0.85rem;
  width: 100%;
}
.field textarea { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.875rem; resize: vertical; }
.field input:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.field .note { font-size: 0.8125rem; color: var(--muted); font-family: var(--prose); }
.field .note.is-error { color: var(--flag); }
.grid-2 { display: grid; gap: 1rem; }
@media (min-width: 46rem) { .grid-2 { grid-template-columns: 1fr 1fr; } }

/* ---------- commit blok ---------- */

pre.commit {
  margin: 0;
  background: var(--ground);
  border: 1px solid var(--line);
  border-radius: 0.7rem;
  padding: 1rem;
  overflow-x: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.8125rem;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre;
}
.hash { color: var(--accent); word-break: break-all; }

/* ---------- losovací scéna ---------- */

.stage {
  position: relative;
  background: linear-gradient(178deg, #00263a 0%, #001A28 58%, #002236 100%);
  border: 1px solid var(--line);
  border-radius: 1.25rem;
  padding: 2.5rem 1.5rem 3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  overflow: hidden;
  text-align: center;
}
.stage::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -14rem;
  width: 34rem;
  height: 34rem;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(139, 211, 230, 0.16), transparent 62%);
  pointer-events: none;
}
.stage > * { position: relative; z-index: 1; }

.seed-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
.chip {
  min-width: 2.75rem;
  padding: 0.4rem 0.7rem;
  border-radius: 0.6rem;
  background: rgba(139, 211, 230, 0.14);
  border: 1px solid rgba(139, 211, 230, 0.4);
  color: var(--accent);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.dial {
  font-size: clamp(4.5rem, 3rem + 14vw, 9rem);
  font-weight: 700;
  line-height: 0.95;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.03em;
  color: var(--ink);
  min-height: 1em;
}
.dial.is-locked { color: var(--prize); }
.dial.is-idle { color: var(--muted); opacity: 0.35; }
.dial-label { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

.winner {
  width: min(100%, 28rem);
  background: rgba(246, 186, 0, 0.08);
  border: 1px solid rgba(246, 186, 0, 0.45);
  border-radius: 1rem;
  padding: 1.4rem;
  display: none;
  flex-direction: column;
  gap: 0.35rem;
}
.winner.is-shown { display: flex; animation: rise 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
@keyframes rise { from { opacity: 0; transform: translateY(1.25rem); } to { opacity: 1; transform: none; } }
.winner .who { font-size: 1.5rem; font-weight: 700; word-break: break-word; }
.winner .mail { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9375rem; color: var(--accent); word-break: break-all; }
.winner .meta { font-size: 0.8125rem; color: var(--muted); }

.subs { display: flex; flex-direction: column; gap: 0.5rem; width: min(100%, 28rem); }
.sub {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.6rem 0.9rem;
  background: rgba(0, 79, 113, 0.4);
  border: 1px solid var(--line);
  border-radius: 0.6rem;
  font-size: 0.9375rem;
  text-align: left;
}
.sub .rank { color: var(--muted); font-size: 0.8125rem; font-weight: 600; white-space: nowrap; }
.sub .mail { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8125rem; color: var(--accent); word-break: break-all; }

/* ---------- režim nahrávání ---------- */

body.recording .masthead,
body.recording .phases,
body.recording #panel-prep,
body.recording #panel-check,
body.recording #panel-draw > .card { display: none; }
body.recording .wrap { padding: 0; max-width: none; gap: 0; }
body.recording {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-host { display: contents; }
body.recording .stage {
  width: min(100vw, calc((100vh - 2rem) * 9 / 16));
  aspect-ratio: 9 / 16;
  justify-content: center;
  border-radius: 0;
  border: 0;
  margin: 0 auto;
}
body.recording .stage .subs { display: none; }
body.recording .rec-exit { display: inline-flex; }
body.recording .toast { display: none; }
body.recording .stage-cta.is-ready { display: flex; }

.stage-cta { display: none; flex-direction: column; align-items: center; gap: 0.6rem; }
.stage-cta .why { font-size: 0.8125rem; color: var(--muted); font-family: var(--prose); max-width: 22rem; }
.rec-exit {
  display: none;
  position: fixed;
  top: 0.75rem;
  right: 0.75rem;
  z-index: 20;
  opacity: 0.35;
}
.rec-exit:hover { opacity: 1; }

/* ---------- drobnosti ---------- */

.callout {
  border-left: 3px solid var(--accent);
  padding: 0.15rem 0 0.15rem 1rem;
  font-family: var(--prose);
  color: var(--muted);
  line-height: 1.6;
}
.callout.warn { border-left-color: var(--flag); }
.callout strong { color: var(--ink); font-weight: 500; }

.formula {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.875rem;
  background: var(--ground);
  border: 1px solid var(--line);
  border-radius: 0.6rem;
  padding: 0.85rem 1rem;
  overflow-x: auto;
  color: var(--accent);
  white-space: pre;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 1.5rem;
  transform: translate(-50%, 1.5rem);
  background: var(--accent);
  color: #00212f;
  font-weight: 600;
  font-size: 0.9375rem;
  padding: 0.65rem 1.25rem;
  border-radius: 999px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 200ms ease, transform 200ms ease;
  z-index: 40;
}
.toast.is-shown { opacity: 1; transform: translate(-50%, 0); }

.empty { color: var(--muted); font-family: var(--prose); font-style: italic; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}
  </style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <p class="eyebrow">Ensana Summer</p>
    <h1>Losování, které si každý přepočítá</h1>
    <p class="prose lede">
      Výherce neurčuje tahle stránka, ale <strong>čísla Sportky</strong>, která v době zmrazení seznamu
      nikdo neznal. Stránka jen provede výpočet, který je zveřejněný dopředu. Kontakty
      zůstávají ve vašem prohlížeči — nikam se neodesílají.
    </p>
  </header>

  <div class="phases" role="tablist" aria-label="Fáze losování">
    <button class="phase" role="tab" id="tab-prep" aria-controls="panel-prep" aria-selected="true" type="button"><span class="n">1</span> Zmrazit seznam</button>
    <button class="phase" role="tab" id="tab-draw" aria-controls="panel-draw" aria-selected="false" type="button"><span class="n">2</span> Losovat</button>
    <button class="phase" role="tab" id="tab-check" aria-controls="panel-check" aria-selected="false" type="button"><span class="n">3</span> Ověřit</button>
  </div>

  <!-- ══════════ FÁZE 1 ══════════ -->
  <section class="panel is-active" id="panel-prep" role="tabpanel" aria-labelledby="tab-prep">

    <div class="card">
      <div class="card-head">
        <h2>Načtěte oba zdroje přihlášek</h2>
        <p class="prose">
          Soubory se zpracují přímo tady v prohlížeči. E-maily se nikam neodesílají a stránka si je nikam neukládá —
          po zavření záložky jsou pryč.
        </p>
      </div>

      <div class="drops">
        <label class="drop" id="drop-ml">
          <h3>MailerLite</h3>
          <p class="hint">CSV export ze seznamu soutěže. Sloupec s e-mailem se najde sám.</p>
          <p class="loaded" data-loaded hidden></p>
          <input type="file" accept=".csv,.txt,text/csv" multiple aria-label="CSV export z MailerLite">
        </label>

        <label class="drop" id="drop-ocr">
          <h3>Papírové přihlášky (OCR)</h3>
          <p class="hint">CSV z naskenovaných formulářů. Řádky se navíc projedou kontrolou překlepů.</p>
          <p class="loaded" data-loaded hidden></p>
          <input type="file" accept=".csv,.txt,text/csv" multiple aria-label="CSV z OCR papírových přihlášek">
        </label>
      </div>

      <div class="stats" id="stats" hidden>
        <div class="stat frozen"><span class="v" id="stat-total">0</span><span class="k">Platných losů</span></div>
        <div class="stat"><span class="v" id="stat-paper">0</span><span class="k">Z papíru</span></div>
        <div class="stat"><span class="v" id="stat-dupes">0</span><span class="k">Duplicit</span></div>
        <div class="stat flagged"><span class="v" id="stat-flags">0</span><span class="k">Ke kontrole</span></div>
      </div>
    </div>

    <div class="card" id="review-card" hidden>
      <div class="card-head">
        <h2>Zkontrolujte, co OCR nepřečetlo</h2>
        <p class="prose">
          Tyhle adresy stroj vyhodnotil jako podezřelé. <strong>Opravte je podle papíru</strong>, nebo řádek vyřaďte.
          Nic se neopravuje automaticky — jinak by o složení seznamu rozhodovala heuristika, kterou nikdo neviděl.
        </p>
      </div>
      <div class="review" id="review"></div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>Zmrazení seznamu</h2>
        <p class="prose">
          Seznam se seřadí podle e-mailu, očísluje od 1 do N a spočítá se jeho otisk SHA-256.
          <strong>Ten otisk zveřejněte dřív, než padnou čísla Sportky.</strong> Když by kdokoli potom do seznamu sáhl,
          otisk už nebude sedět.
        </p>
      </div>
      <div class="actions">
        <button class="btn btn-primary" id="freeze" type="button" disabled>Zmrazit seznam a spočítat otisk</button>
        <button class="btn btn-ghost btn-small" id="copy-list" type="button" hidden>Kopírovat očíslovaný seznam</button>
      </div>
      <p class="callout warn" id="freeze-block" hidden></p>
      <div id="commit-out" hidden>
        <pre class="commit" id="commit-text"></pre>
        <div class="actions" style="margin-top: 0.85rem;">
          <button class="btn btn-ghost btn-small" id="copy-commit" type="button">Kopírovat text ke zveřejnění</button>
