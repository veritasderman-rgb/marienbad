---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import SpringsExplorerSection from '@/components/SpringsExplorerSection.astro'
import { getPage } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'cs' as const
const page = await getPage('cs-prehled-pramenu')
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Mineralni prameny', href: `/${locale}/mineralni-prameny` },
  { label: 'Prehled pramenu' },
]
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/quellen-uebersicht', en: '/en/springs-overview', cs: '/cs/prehled-pramenu', ru: '/ru/obzor-istochnikov' }}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
  <SpringsExplorerSection locale={locale} />
</Base>
