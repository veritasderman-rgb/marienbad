---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'cs' as const
const page = await getPage('cs-klimatoterapie')
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Minerální prameny', href: `/${locale}/mineralni-prameny` },
  { label: 'Klimatoterapie' },
]
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/klimatherapie', en: '/en/climate-therapy', cs: '/cs/klimatoterapie', ru: '/ru/klimatoterapiya' }}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
</Base>
