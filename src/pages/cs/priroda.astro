---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'

const locale = 'cs' as const
---

<Base locale={locale} section="things-to-do" title="Příroda a parky — Marienbad.com" description="Lázeňské parky, Slavkovský les, Kladská — zelená stránka Mariánských Lázní. Pěší trasy, geologie a přírodní zážitky." alternateUrls={{ de: '/de/natur', en: '/en/nature', cs: '/cs/priroda', ru: '/ru/priroda' }}>
  <PillarPage locale={locale} title="Příroda a parky" description="Téměř polovina území obce je pokryta lesem. Parky a zahrady Mariánských Lázní patří k nejkrásnějším ve střední Evropě.">
    <h2>Zelený ráj</h2>
    <p>Mariánské Lázně jsou především <strong>zelené město</strong>. Téměř polovina území obce je pokryta lesem a uměle založené lázeňské parky plynule přecházejí do přirozené lesní krajiny Slavkovského lesa (Kaiserwaldu). Toto jedinečné propojení kultivované a divoké přírody činí z Mariánských Lázní ráj pro pěší turisty, výletníky a milovníky přírody.</p>

    <h2>Skalníkovy sady (Lázeňský park)</h2>
    <p>Centrální lázeňský park byl založen od roku 1817 <strong>Václavem Skalníkem</strong> — vizionářským krajinným architektem, který proměnil bažinaté údolí v jeden z nejobdivovanějších parků Evropy. Skalníkův naturalistický styl — křivolaké cesty, malebné průhledy, umělecké výsadby — je zachován dodnes.</p>
    <p>Zajímavosti parku:</p>
    <ul>
      <li><strong>Zpívající fontána</strong> — Voda, světlo a hudba před Kolonádou</li>
      <li><strong>Křížový pramen</strong> — Nejslavnější minerální pramen, přístupný v Kolonádě</li>
      <li><strong>Rododendronový háj</strong> — Moře barev v květnu</li>
      <li><strong>Goethův pomník</strong> — Na místě jeho slavných setkání</li>
    </ul>

    <h2>Geologický park</h2>
    <p>Jedinečné <strong>muzeum pod širým nebem</strong> nad městem, které představuje geologickou rozmanitost Čech. Velkoformátové vzorky hornin z celého regionu jsou rozmístěny podél lesní cesty — s informačními panely vysvětlujícími vulkanické a tektonické síly, které vytvořily mariánskolázeňské prameny.</p>

    <h2>Přírodní rezervace Kladská</h2>
    <p>Pouhých 15 minut od Mariánských Lázní leží <strong>přírodní rezervace Kladská</strong> — nedotčené rašeliniště s půvabným loveckým zámečkem ve švýcarském stylu. <strong>Naučná stezka po povalovém chodníku</strong> vede přes rašeliniště a nabízí fascinující pohled do tohoto unikátního ekosystému: masožravé rostliny, rašelinné břízy, vzácné vážky.</p>
    <p>Kladská je jedním z nejlépe střežených tajemství regionu — výlet, který podnikne jen málo turistů, ale který je nezapomenutelný.</p>

    <h2>Pěší trasy</h2>
    <p>Hustá síť značených tras se rozprostírá všemi směry:</p>
    <ul>
      <li><strong>Lesní pramen</strong> — Nachází se v budově Centrálních Lázní, volně přístupný návštěvníkům</li>
      <li><strong>Rozhledna Hamelika</strong> — 1,5hodinový okružní výlet s panoramatickými výhledy na město</li>
      <li><strong>Údolí Úšovic</strong> — Klidná procházka podél potoka, ideální pro rodiny</li>
      <li><strong>Dálkové trasy</strong> — Mariánské Lázně leží na několika regionálních turistických trasách přes Slavkovský les</li>
    </ul>

    <h2>Cykloturistika</h2>
    <p>Slavkovský les nabízí cyklotrasy pro každou úroveň — od snadných rodinných tras po zpevněných cestách až po náročné terénní tratě pro horská kola. Půjčovny v centru města nabízejí standardní i elektrokola. Několik hotelů nabízí <strong>cyklistické balíčky</strong> s mapami, svačinami a přepravou zavazadel.</p>

    <h2>Flóra a fauna</h2>
    <p>Slavkovský les je <strong>chráněná přírodní rezervace</strong> s pozoruhodnou biodiverzitou:</p>
    <ul>
      <li>Přes 900 druhů rostlin, včetně vzácných orchidejí a kapradin</li>
      <li>Jeleni, divočáci, lišky a příležitostně rysové</li>
      <li>Bohatý ptačí svět — datel černý, ledňáček říční, jestřáb lesní</li>
      <li>Na podzim: vynikající houbařský revír (hřiby, lišky, podubáky)</li>
    </ul>

    <blockquote>
      <p>„Příroda kolem Mariánských Lázní není jen kulisa — je součástí léčby. Čistý vzduch, ticho lesa, rytmus procházky jsou stejně léčivé jako prameny a lázně."</p>
    </blockquote>
  </PillarPage>
</Base>
