---
import Base from '@/layouts/Base.astro'
import DiagnosisHub from '@/components/DiagnosisHub.astro'
import { getAlternateLinks } from '@/i18n/utils'

export const prerender = true

const locale = 'cs' as const
const alternateUrls = Object.fromEntries(getAlternateLinks('treatment-for').map((a) => [a.locale, a.href]))
---

<Base
  locale={locale}
  section="treatment-for"
  title={'Lázeňská léčba podle diagnózy v Mariánských Lázních | Marienbad.com'}
  description={'Artróza, páteř, lupénka, ledvinové kameny, pobyt po operaci kyčle nebo kolene: co se v Mariánských Lázních léčí, jak léčba probíhá a jak dlouho trvá.'}
  alternateUrls={alternateUrls}
>
  <DiagnosisHub locale={locale} />
</Base>
