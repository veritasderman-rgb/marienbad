---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage, extractFaqs } from '@/content/reader'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { getHotelBySlug } from '@/data/hotels'
import { withUtm } from '@/utils/utm'

const locale = 'cs' as const
const page = await getPage('cs-mineralni-prameny')
const hotel = getHotelBySlug('nove-lazne')!

const faqs = page?.rawBody ? extractFaqs(page.rawBody) : []
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name={hotel.name}
      stars={hotel.stars}
      badge="Minerální lázně"
      description="Pětihvězdičkový hotel Nové Lázně nabízí vlastní minerální koupele a jediné Římské lázně ve střední Evropě — ideální místo pro zážitek z mariánskolázeňských léčivých pramenů."
      bookingUrl={withUtm(hotel.bookingUrls.cs, 'marienbad', 'editorial', 'mineral-springs')}
      bookingLabel="Rezervovat hotel"
    />
  </PillarPage>
</Base>
