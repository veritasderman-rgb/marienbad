---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import HotelTiles from '@/components/HotelTiles.astro'
import { getPage } from '@/content/reader'

const locale = 'ru' as const
const page = await getPage('ru-prozhivanie')
---

<Base locale={locale} section="accommodation" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    <img
      slot="hero-badge"
      src="/images/partners/ensana/ensana-logo-white-640.png"
      srcset="/images/partners/ensana/ensana-logo-white-320.png 320w, /images/partners/ensana/ensana-logo-white-640.png 640w"
      sizes="(min-width: 768px) 170px, 136px"
      alt="Ensana Health Spa Hotels"
      width="640"
      height="605"
      class="block mx-auto h-32 md:h-40 w-auto mb-8 md:mb-10"
      loading="eager"
      decoding="async"
    />
    <HotelTiles locale={locale} />
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
</Base>
