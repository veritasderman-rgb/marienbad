---
import Base from '@/layouts/Base.astro'
import PodcastPage from '@/components/PodcastPage.astro'

const locale = 'ru' as const
---

<Base locale={locale} section="magazine" title="Подкаст из Марианских Лазне — Видеоподкасты" description="Видеоподкасты из Марианских Лазне — разговоры, советы и истории из курортного города." alternateUrls={{ cs: '/cs/podcast', de: '/de/podcast', en: '/en/podcast', ru: '/ru/podcast' }}>
  <PodcastPage locale={locale} />
</Base>
