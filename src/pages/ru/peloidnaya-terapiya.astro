---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const page = await getPage('ru-peloidnaya-terapiya')
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Минеральные источники', href: `/${locale}/mineralnye-istochniki` },
  { label: 'Пелоидотерапия' },
]
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/peloidtherapie', en: '/en/peloid-therapy', cs: '/cs/peloidni-terapie', ru: '/ru/peloidnaya-terapiya' }}>
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
</Base>
