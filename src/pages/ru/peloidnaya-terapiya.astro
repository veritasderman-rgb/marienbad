---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import ArticleSources from '@/components/ArticleSources.astro'
import { getPage } from '@/content/reader'
import { t } from '@/i18n/ui'
import { medicalTherapyPage } from '@/lib/medicalSchema'

const locale = 'ru' as const
const page = await getPage('ru-peloidnaya-terapiya')
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Минеральные источники', href: `/${locale}/mineralnye-istochniki` },
  { label: 'Пелоидотерапия' },
]

const schema = medicalTherapyPage({
  locale,
  path: '/ru/peloidnaya-terapiya',
  name: page?.title ?? '',
  description: page?.metaDescription ?? '',
  indications: [
    'Osteoarthritis',
    'Chronic back pain',
    'Rheumatoid arthritis',
    'Ankylosing spondylitis',
    'Atopic dermatitis',
    'Psoriasis',
  ],
  lastReviewed: page?.medicalReviewDate,
})
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/peloidtherapie', en: '/en/peloid-therapy', cs: '/cs/peloidni-terapie', ru: '/ru/peloidnaya-terapiya' }} schema={schema}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <ArticleSources locale={locale} sources={page?.sources} medicalReviewDate={page?.medicalReviewDate} />
  </PillarPage>
</Base>
