---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: t(locale, 'nav.thingsToDo'), href: `/${locale}/chem-zanyatsya` },
  { label: 'Колоннада' },
]
---

<Base locale={locale} section="mineral-springs" title="Колоннада и Поющий фонтан — Marienbad.com" description="Знаменитая колоннада и Поющий фонтан в Марианских Лазнях: архитектура, история и расписание представлений." alternateUrls={{ de: '/de/kolonnade', en: '/en/colonnade', cs: '/cs/kolonada', ru: '/ru/kolonnada' }}>
  <PillarPage locale={locale} title="Колоннада и Поющий фонтан" description="Колоннада Марианских Лазней и знаменитый Поющий фонтан — одни из самых значительных достопримечательностей чешского курортного треугольника." breadcrumbs={breadcrumbs}>
    <h2>Архитектурный шедевр</h2>
    <p><strong>Главная колоннада</strong> Марианских Лазней — это гораздо больше, чем просто здание: это пульсирующее сердце курортного города и один из самых впечатляющих примеров необарочной курортной архитектуры в Европе. Элегантная чугунная конструкция протянулась на <strong>119 метров</strong> и с её изящной потолочной конструкцией и декоративными колоннами образует крытую прогулочную галерею, защищающую курортных гостей от солнца и дождя уже более столетия во время питья целебных вод минеральных источников.</p>

    <p>Нынешняя колоннада была построена в <strong>1888–1889 годах</strong> по проектам венских архитекторов <strong>Микша и Нидзельского</strong>, заменив более раннюю деревянную конструкцию. Строительство из чугуна было революционным для своего времени и отражало технический оптимизм конца XIX века. Колоннада неоднократно реставрировалась, последний раз капитально в 1970-х и 2000-х годах, и сегодня сияет в своём первоначальном великолепии.</p>

    <h2>Источники колоннады</h2>
    <p>Под крышей колоннады расположены несколько важнейших минеральных источников Марианских Лазней, воду которых гости могут пить прямо из художественно оформленных фонтанчиков:</p>

    <ul>
      <li><strong>Крестовый источник (Křížový pramen):</strong> Самый знаменитый источник Марианских Лазней, известный с 1679 года. Его вода богата железом и рекомендуется при заболеваниях желудочно-кишечного тракта и почек.</li>
      <li><strong>Фердинандов источник (Ferdinandův pramen):</strong> Назван в честь императора Фердинанда I, особенно богат минералами и применяется при нарушениях обмена веществ.</li>
      <li><strong>Каролинин источник (Karolinin pramen):</strong> Мягкий источник, особенно подходящий для начала питьевого курса.</li>
      <li><strong>Рудольфов источник (Rudolfův pramen):</strong> Назван в честь кронпринца Рудольфа, особенно эффективен при заболеваниях мочевыводящих путей.</li>
    </ul>

    <p>Каждый источник имеет уникальный минеральный состав и различные терапевтические свойства. Курортные врачи составляют для каждого пациента индивидуальный питьевой план, определяющий источник, количество, температуру и время приёма воды.</p>

    <h2>Поющий фонтан</h2>
    <p>Непосредственно перед колоннадой находится одна из самых любимых достопримечательностей Марианских Лазней: <strong>Поющий фонтан</strong> (Zpívající fontána). Это уникальное сочетание воды, музыки и света было торжественно открыто в <strong>1986 году</strong> по проекту инженера <strong>Павла Микулы</strong> и с тех пор является кульминацией каждого посещения Марианских Лазней.</p>

    <h3>Как работает Поющий фонтан?</h3>
    <p>Фонтан представляет собой круглый бассейн диаметром около 18 метров, оснащённый сотнями форсунок, которые с помощью компьютерной системы управления создают точно хореографированные водные фигуры. Они точно синхронизированы с подборкой музыки — от классических композиций (Дворжак, Сметана, Шопен) до киномузыки и современных произведений. Водяные струи буквально «танцуют» под музыку, создавая завораживающее аудиовизуальное зрелище.</p>

    <h3>Расписание представлений</h3>
    <p>Поющий фонтан работает с <strong>мая по октябрь каждый нечётный час</strong> (7:00, 9:00, 11:00, 13:00, 15:00, 17:00, 19:00, 21:00). Вечерние представления после наступления темноты особенно атмосферны, так как фонтан дополнительно подсвечивается цветными огнями. Каждое представление длится примерно <strong>10–15 минут</strong> и является бесплатным.</p>

    <h2>Колоннада Фердинанда Гавелки</h2>
    <p>Помимо Главной колоннады, заслуживает внимания <strong>Колоннада Фердинанда Гавелки</strong> — меньшее, но архитектурно столь же очаровательное сооружение в верхней части курортного парка. В ней находится Фердинандов источник, и она предлагает более спокойную, интимную обстановку для питьевого курса. Колоннада названа в честь заслуженного курортного врача Фердинанда Гавелки, внёсшего значительный вклад в научное изучение целебных источников Марианских Лазней в XIX веке.</p>

    <h2>История и культурное значение</h2>
    <p>Колоннада всегда была гораздо больше, чем просто функциональная прогулочная галерея. В XIX и начале XX века она была общественным центром курортной жизни — местом встреч, где прогуливались коронованные особы, поэты, музыканты и европейская аристократия. <strong>Иоганн Вольфганг фон Гёте</strong>, <strong>Фредерик Шопен</strong>, <strong>Рихард Вагнер</strong> и <strong>король Эдуард VII</strong> были в числе самых именитых посетителей, принимавших питьевой курс под крышей колоннады.</p>

    <p>И сегодня колоннада остаётся центром курортной жизни. Каждое утро и вечер курортные гости стекаются к источникам со своими характерными <strong>питьевыми чашками</strong> (Lázeňský pohárek), чтобы пить назначенную врачом минеральную воду — традиция, которая практически не изменилась за более чем 200 лет.</p>

    <h2>Вокруг колоннады</h2>
    <p>Колоннада расположена в сердце прекрасно спланированного <strong>курортного парка</strong> (Skalníkovy sady), созданного знаменитым ландшафтным архитектором Вацлавом Скальником в XIX веке. Парк предлагает обширные зелёные зоны, исторические павильоны, чугунный музыкальный павильон и ухоженные цветочные клумбы. Он является идеальной отправной точкой для терренкурных пешеходных маршрутов, ведущих в окрестные леса.</p>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="В шаге от колоннады"
      description="Исторические Нове Лазне находятся в нескольких шагах от колоннады и предоставляют прямой доступ к минеральным источникам. Наслаждайтесь питьевым курсом и Поющим фонтаном прямо у вашего порога."
      bookingUrl="https://ensanahotels.com/ru/oteli/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=colonnade"
      bookingLabel="Забронировать отель у колоннады"
    />

    <h2>Практическая информация</h2>
    <p>Колоннада свободно доступна круглый год. Минеральные источники текут непрерывно, и пить из них можно бесплатно в любое время — принесите свою чашку или приобретите традиционный lázeňský pohárek в одном из многочисленных сувенирных магазинов. Поющий фонтан работает сезонно с мая по октябрь. Вход свободный.</p>

    <p>Колоннада легко доступна пешком из центра города — она расположена в южной части Главной улицы (Hlavní třída), всего в нескольких минутах ходьбы от всех крупных курортных отелей.</p>
  </PillarPage>
</Base>
