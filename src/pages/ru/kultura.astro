---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import EventCalendar from '@/components/EventCalendar.astro'

const locale = 'ru' as const
---

<Base locale={locale} section="things-to-do" title="Культура и события — Marienbad.com" description="Фестиваль Шопена, Городской театр, Казино, концерты — культурная жизнь Марианских Лазней." alternateUrls={{ de: '/de/kultur', en: '/en/culture', cs: '/cs/kultura', ru: '/ru/kultura' }}>
  <PillarPage locale={locale} title="Культура и события" description="От концертов мирового класса до камерных театральных постановок — Марианские Лазне предлагают богатую культурную программу.">
    <h2>Международный фестиваль Шопена</h2>
    <p><strong>Фестиваль Шопена</strong> — главное культурное событие года. С 1960 года каждый август в Марианские Лазне приезжают всемирно известные пианисты, чтобы выступить в самых атмосферных залах города: в Казино, в Нове Лазне и у Главной колоннады. Фестиваль посвящён пребыванию Шопена летом 1836 года и превратился в один из <strong>самых престижных фортепианных фестивалей Европы</strong>.</p>
    <p>Концерты, мастер-классы, конкурсы и кинопоказы составляют недельную программу, привлекающую любителей музыки со всего мира. Билеты пользуются большим спросом — рекомендуется ранняя покупка.</p>

    <h2>Городской театр (Městské divadlo)</h2>
    <p>Неоклассический Городской театр, построенный в 1868 году, предлагает круглогодичную программу <strong>оперы, балета, драмы и концертов</strong>. Камерный формат — зал вмещает около 400 гостей — делает каждое посещение театра особенным событием. Гастроли отечественных и зарубежных ансамблей дополняют местную программу.</p>

    <h2>Казино (Společenský dům)</h2>
    <p><strong>Казино</strong> — одно из красивейших зданий города, шедевр неоренессансной архитектуры, служащий культурным и общественным центром. Великолепный бальный зал принимает концерты, балы и выставки. Одна только атмосфера стоит визита.</p>

    <h2>Поющий фонтан</h2>
    <p><strong>Поющий фонтан</strong> (Zpívající fontána) перед Главной колоннадой — самая узнаваемая достопримечательность Марианских Лазней. Каждый нечётный час (с 7:00 до 19:00 в сезон) вода танцует в такт музыке — от Дворжака и Шопена до популярных мелодий. Особенно впечатляют вечерние представления со световыми эффектами после наступления темноты.</p>

    <h2>Музеи</h2>
    <ul>
      <li><strong>Городской музей (Městské muzeum)</strong> — История Марианских Лазней от болотистой долины до курорта мирового класса. Историческое курортное оборудование, фотографии, гостевые книги знаменитых посетителей.</li>
      <li><strong>Дом Гёте</strong> — Воспоминания о пребывании поэта и его любви к Ульрике фон Леветцов.</li>
      <li><strong>Геологический музей</strong> — Наука за источниками и вулканическая история региона.</li>
    </ul>

    <h2>Сезонные мероприятия</h2>
    <ul>
      <li><strong>Весна:</strong> Открытие курортного сезона, первые концерты на открытом воздухе</li>
      <li><strong>Лето:</strong> Фестиваль Шопена, Поющий фонтан, концерты на открытом воздухе</li>
      <li><strong>Осень:</strong> Дни Гёте, праздник урожая, осенние концерты</li>
      <li><strong>Зима:</strong> Рождественские ярмарки, рождественские концерты, новогодний гала-вечер</li>
    </ul>

    <h2>Архитектура</h2>
    <p>Марианские Лазне сами по себе — это музей архитектуры под открытым небом: <strong>неоренессанс, необарокко, модерн и классицизм</strong> существуют в гармоничном соседстве. Экскурсии по архитектуре предлагает Туристический информационный центр. Основные достопримечательности: Главная колоннада (1889), Костёл Вознесения Девы Марии, отель Нове Лазне и виллы в стиле модерн вдоль улицы Тржебизского.</p>

    <EventCalendar locale={locale} />
  </PillarPage>
</Base>
