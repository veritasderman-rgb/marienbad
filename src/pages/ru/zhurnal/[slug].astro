---
import Base from '@/layouts/Base.astro'
import Pic from '@/components/Pic.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import SocialShare from '@/components/SocialShare.astro'
import WhyTrustUs from '@/components/WhyTrustUs.astro'
import YouTubeEmbed from '@/components/YouTubeEmbed.astro'
import { getArticle, getArticles } from '@/content/reader'
import TreatmentQuiz from '@/components/TreatmentQuiz.tsx'
import { hotels } from '@/data/hotels'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const { slug } = Astro.params
const article = slug ? await getArticle(`${locale}-${slug}`) : null
if (!article || (article.status === 'draft' && import.meta.env.PROD)) return new Response(null, { status: 404 })

const magazineLabel = 'Журнал'
const magazineHref = `/${locale}/zhurnal`
const backLabel = 'Назад в журнал'
const moreArticlesLabel = 'Ещё статьи'

const siteUrl = (import.meta.env.SITE ?? 'https://marienbad.com').replace(/\/$/, '')
const pageUrl = `${siteUrl}/${locale}/zhurnal/${slug}`
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.date,
  dateModified: article.date,
  author: { '@type': 'Organization', name: 'Marienbad.com' },
  publisher: { '@type': 'Organization', name: 'Marienbad.com', url: 'https://marienbad.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: locale,
  articleSection: article.category,
}
if (article.coverImage) articleSchema.image = article.coverImage.startsWith('/') ? `${siteUrl}${article.coverImage}` : article.coverImage

const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: magazineLabel, href: magazineHref },
  { label: article.title },
]

const quizHotels = hotels.map((h) => ({
  slug: h.slug,
  name: h.name,
  stars: h.stars,
  style: h.style,
  bookingUrl: h.bookingUrls[locale] ?? h.bookingUrl,
  exelyHotelId: h.exelyHotelId,
  tagline: h.tagline[locale] ?? h.tagline.de,
  treatments: h.treatments[locale] ?? h.treatments.de,
  features: h.features[locale] ?? h.features.de,
}))

const quizTranslations = {
  step1Title: t(locale, 'quiz.step1Title'),
  step2Title: t(locale, 'quiz.step2Title'),
  resultsTitle: t(locale, 'quiz.resultsTitle'),
  next: t(locale, 'quiz.next'),
  back: t(locale, 'quiz.back'),
  restart: t(locale, 'quiz.restart'),
  yourTreatments: t(locale, 'quiz.yourTreatments'),
  bookNow: t(locale, 'quiz.bookNow'),
  disclaimer: t(locale, 'quiz.disclaimer'),
  matchingTreatments: t(locale, 'quiz.matchingTreatments'),
  budgetComfort: t(locale, 'quiz.budgetComfort'),
  budgetPremium: t(locale, 'quiz.budgetPremium'),
  budgetLuxury: t(locale, 'quiz.budgetLuxury'),
  condMusculoskeletal: t(locale, 'quiz.condMusculoskeletal'),
  condRespiratory: t(locale, 'quiz.condRespiratory'),
  condDigestive: t(locale, 'quiz.condDigestive'),
  condCardiovascular: t(locale, 'quiz.condCardiovascular'),
  condKidney: t(locale, 'quiz.condKidney'),
  condStress: t(locale, 'quiz.condStress'),
  condSkin: t(locale, 'quiz.condSkin'),
  condRehab: t(locale, 'quiz.condRehab'),
  styleClassic: t(locale, 'quiz.styleClassic'),
  styleModern: t(locale, 'quiz.styleModern'),
  styleMedical: t(locale, 'quiz.styleMedical'),
  budgetLabel: t(locale, 'quiz.budgetLabel'),
  styleLabel: t(locale, 'quiz.styleLabel'),
  noResults: t(locale, 'quiz.noResults'),
  starsLabel: t(locale, 'quiz.starsLabel'),
}

const allArticles = await getArticles(locale)
const relatedArticles = allArticles
  .filter(a => a.slug !== `${locale}-${slug}`)
  .slice(0, 3)
---

<Base locale={locale} section="magazine" ogType="article" title={`${article.title} — Журнал Marienbad`} description={article.excerpt} alternateUrls={{ [locale]: Astro.url.pathname }} switcherUrls={{ de: '/de/magazin', en: '/en/magazine', cs: '/cs/magazin', ru: '/ru/zhurnal' }} ogImage={article.coverImage || undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <FaqSchema rawBody={article.rawBody} />
  <PillarPage locale={locale} title={article.title} description={article.excerpt} pullQuote={article.pullQuote} breadcrumbs={breadcrumbs}>
    <div class="flex items-center gap-3 text-sm text-beige-600 mb-8">
      <span class="px-2.5 py-0.5 bg-turquoise-50 text-turquoise-800 rounded-full font-medium">{article.category}</span>
      <span>{article.readingTime}</span>
    </div>
    {article.coverImage && (
      <div class="rounded-xl overflow-hidden mb-10 -mx-4 md:mx-0">
        <Pic src={article.coverImage} alt={article.title} class="w-full aspect-[16/9] object-cover" loading="eager" fetchpriority="high" sizes="(max-width: 768px) 100vw, 768px" />
      </div>
    )}
    <MarkdocRenderer content={article.body} />
    <WhyTrustUs locale={locale} />
    {article.youtubeVideoId && (
      <YouTubeEmbed
        videoId={article.youtubeVideoId}
        title={article.youtubeTitle}
        description={article.youtubeDescription}
        locale={locale}
      />
    )}
    <SocialShare url={Astro.url.href} title={article.title} locale={locale} />

    <TreatmentQuiz client:visible locale={locale} hotels={quizHotels} translations={quizTranslations} />

    <!-- Back to magazine + related articles -->
    <div class="mt-12 pt-10 border-t border-beige-200">
      <a href={magazineHref} class="inline-flex items-center gap-2 text-turquoise-700 hover:text-turquoise-900 font-medium transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        {backLabel}
      </a>
      {relatedArticles.length > 0 && (
        <div>
          <h2 class="font-heading text-xl font-semibold mb-6">{moreArticlesLabel}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedArticles.map(a => (
              <a href={`${magazineHref}/${a.slug.replace(`${locale}-`, '')}`} class="group block rounded-xl border border-beige-200 hover:border-turquoise-300 hover:shadow-md transition-all overflow-hidden">
                {a.coverImage && (
                  <div class="aspect-[16/9] overflow-hidden">
                    <Pic src={a.coverImage} alt={a.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" sizes="(max-width: 640px) 100vw, 33vw" />
                  </div>
                )}
                <div class="p-4">
                  <span class="text-xs text-turquoise-600 font-medium">{a.category}</span>
                  <h3 class="font-heading text-base font-semibold mt-1 group-hover:text-turquoise-700 transition-colors leading-snug">{a.title}</h3>
                  <p class="text-sm text-beige-600 mt-2 line-clamp-2">{a.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </PillarPage>
</Base>
