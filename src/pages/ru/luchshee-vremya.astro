---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const page = await getPage('ru-luchshee-vremya')
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: t(locale, 'nav.practicalInfo'), href: `/${locale}/prakticheskaya-informaciya` },
  { label: 'Лучшее время для посещения' },
]
---

<Base locale={locale} section="practical-info" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/beste-reisezeit', en: '/en/best-time-to-visit', cs: '/cs/nejlepsi-cas-navstevy', ru: '/ru/luchshee-vremya' }}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
</Base>
