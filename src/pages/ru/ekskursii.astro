---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'

const locale = 'ru' as const
---

<Base locale={locale} section="things-to-do" title="Экскурсии из Марианских Лазней — Marienbad.com" description="Лучшие однодневные экскурсии из Марианских Лазней: Карловы Вары, Пльзень, замок Локет, Кладска и монастырь Тепла." alternateUrls={{ de: '/de/ausfluege', en: '/en/day-trips', cs: '/cs/vylety', ru: '/ru/ekskursii' }}>
  <PillarPage locale={locale} title="Экскурсии из Марианских Лазней" description="Марианские Лазне — идеальная база для однодневных поездок к лучшим достопримечательностям западной Богемии — от горячих источников до средневековых замков.">
    <h2>Откройте для себя западную Богемию</h2>
    <p>Марианские Лазне расположены в самом сердце западной Богемии — региона удивительного разнообразия. В пределах 90 минут езды вы найдёте средневековые замки, всемирно известные пивоварни, архитектуру из списка ЮНЕСКО и нетронутые природные заповедники. На автомобиле, автобусе или организованной экскурсии — каждая из этих поездок комфортно укладывается в один день и добавляет незабываемые впечатления к вашему курортному отдыху.</p>

    <h2>Карловы Вары (Карлсбад)</h2>
    <h3>45 минут езды</h3>
    <p>Самый знаменитый курортный город Богемии — также самое популярное направление для однодневной поездки из Марианских Лазней. <strong>Карловы Вары</strong> поражают монументальными колоннадами, красочными фасадами в стиле ар-нуво и 13 горячими источниками с температурой до 73 °C.</p>
    <ul>
      <li><strong>Горячие источники</strong> — Прогуляйтесь вдоль пяти колоннад и попробуйте целебную воду из традиционных питьевых чашек (lázeňský pohárek)</li>
      <li><strong>Стеклозавод Мозер</strong> — Посетите всемирно известный стеклозавод, основанный в 1857 году, с музеем и экскурсией по мастерским</li>
      <li><strong>Смотровая башня Диана</strong> — Доступна на фуникулёре, открывает великолепный панорамный вид на долину реки Теплы</li>
      <li><strong>Кинофестиваль</strong> — В июле город превращается в площадку международного кинофестиваля</li>
    </ul>
    <p>Совет: дополните визит дегустацией знаменитых карловарских вафель и бокалом Бехеровки — травяного ликёра, который производится в Карловых Варах с 1807 года.</p>

    <h2>Пльзень (Пилзен)</h2>
    <h3>90 минут езды</h3>
    <p><strong>Пльзень</strong> — четвёртый по величине город Чешской Республики и прежде всего известен как родина пилзнерского пива. Однако город предлагает гораздо больше, чем пивную культуру.</p>
    <ul>
      <li><strong>Пивоварня Pilsner Urquell</strong> — Легендарная экскурсия по пивоварне ведёт через исторические подвалы и завершается дегустацией нефильтрованного пива прямо из дубовой бочки</li>
      <li><strong>Кафедральный собор Святого Варфоломея</strong> — Самый высокий церковный шпиль в Чехии (102,6 метра) награждает подъём по 301 ступени захватывающей панорамой</li>
      <li><strong>Историческое подземелье</strong> — Увлекательный лабиринт средневековых туннелей и подвалов под старым городом</li>
      <li><strong>Большая синагога</strong> — Третья по величине синагога в мире, впечатляющий образец мавритано-романской архитектуры</li>
    </ul>
    <p>Пльзень была Европейской столицей культуры в 2015 году и с тех пор развила яркую художественную и гастрономическую сцену. Центральная площадь (Náměstí Republiky) — одна из крупнейших рыночных площадей Европы.</p>

    <h2>Замок Локет</h2>
    <h3>30 минут езды</h3>
    <p><strong>Замок Локет</strong> (Hrad Loket) величественно возвышается на скале над излучиной реки Огрже и является одним из наиболее хорошо сохранившихся средневековых замков Богемии. Гёте был очарован этим местом и посещал его неоднократно.</p>
    <ul>
      <li><strong>Замковый музей</strong> — Романские и готические залы с экспозициями по истории замка, коллекция фарфора и знаменитая камера пыток</li>
      <li><strong>Музей Бехеровки</strong> — В городке у подножия замка расположен музей, рассказывающий историю знаменитого травяного ликёра, который был первоначально разработан в Локете</li>
      <li><strong>Старый город</strong> — Живописные улочки с фахверковыми домами, кафе и ремесленными магазинчиками</li>
      <li><strong>Берег Огрже</strong> — Идиллические прогулочные тропы вдоль реки с видом на замок</li>
    </ul>
    <p>Локет достаточно компактен для половины дня и прекрасно сочетается с посещением Карловых Вар, которые находятся всего в 15 минутах.</p>

    <h2>Кладска</h2>
    <h3>15 минут езды</h3>
    <p><strong>Природный заповедник Кладска</strong> — жемчужина у самых ворот Марианских Лазней. Нетронутое верховое болото с уникальной флорой и фауной — одна из наиболее ценных охраняемых территорий западной Богемии.</p>
    <ul>
      <li><strong>Болотная тропа</strong> — Деревянный настил ведёт через торфяное болото с информационными стендами, раскрывающими эту удивительную экосистему</li>
      <li><strong>Смотровая башня</strong> — Открывает панорамный вид на болотный ландшафт и Славковский лес</li>
      <li><strong>Охотничий домик</strong> — Живописное здание в швейцарском стиле на берегу болотного озера</li>
      <li><strong>Редкие виды</strong> — Хищные растения (росянка), болотные берёзы, редкие виды стрекоз и гадюки</li>
    </ul>
    <p>Кладска особенно привлекательна в начале лета (июнь) и осенью (сентябрь–октябрь). Вход свободный, обход занимает около 45 минут. Идеально для семей с детьми.</p>

    <h2>Монастырь Тепла</h2>
    <h3>20 минут езды</h3>
    <p><strong>Премонстрантский монастырь в Тепле</strong>, основанный в 1193 году блаженным Грозна́той, — один из важнейших монастырей Богемии, неразрывно связанный с историей Марианских Лазней. Именно монастырский врач Йозеф Нер по поручению монастыря исследовал целебные источники и тем самым сделал возможным основание курорта.</p>
    <ul>
      <li><strong>Монастырская библиотека</strong> — Великолепная барочная библиотека с более чем 100 000 томов, включая средневековые рукописи</li>
      <li><strong>Церковь Благовещения Пресвятой Богородицы</strong> — Романско-готическая базилика с барочным убранством</li>
      <li><strong>Монастырский сад</strong> — Исторический сад с аптекарскими грядками и старыми деревьями</li>
      <li><strong>Пивоварня</strong> — Монастырь снова варит собственное пиво по историческим рецептам</li>
    </ul>

    <h2>Практические советы</h2>
    <h3>Как добраться</h3>
    <ul>
      <li><strong>Аренда автомобиля</strong> — Самый гибкий вариант; парковка есть у всех достопримечательностей и обычно недорогая</li>
      <li><strong>Автобус</strong> — Регулярное сообщение с Карловыми Варами (каждый час) и Пльзенью (несколько раз в день). Замок Локет также доступен на автобусе</li>
      <li><strong>Организованные экскурсии</strong> — Несколько отелей и местных агентств предлагают групповые однодневные экскурсии с трансфером от отеля</li>
    </ul>

    <h3>Часы работы</h3>
    <p>Большинство достопримечательностей открыты ежедневно с <strong>апреля по октябрь</strong> (примерно с 9:00 до 17:00). В зимний сезон (ноябрь–март) часы работы сокращены — замок Локет и монастырь Тепла часто открыты только по выходным. Уточняйте актуальное расписание перед посещением.</p>

    <h3>Рекомендуемые комбинации</h3>
    <ul>
      <li><strong>Полдня:</strong> Кладска + монастырь Тепла</li>
      <li><strong>Целый день:</strong> Карловы Вары + замок Локет</li>
      <li><strong>Целый день:</strong> Пльзень (пивоварня, собор, старый город)</li>
    </ul>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="Идеальная база"
      description="Центральное расположение Nové Lázně делает его идеальной отправной точкой для экскурсий. Служба консьержа с удовольствием организует трансферы, аренду автомобиля и экскурсии ко всем достопримечательностям."
      bookingUrl="https://ensanahotels.com/ru/oteli/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=day-trips"
      bookingLabel="Посмотреть отель"
    />

    <blockquote>
      <p>«Из Марианских Лазней вся западная Богемия — у ваших ног: средневековые замки, знаменитые пивоварни и природа, от которой захватывает дух. Каждый день приносит новое открытие.»</p>
    </blockquote>
  </PillarPage>
</Base>
