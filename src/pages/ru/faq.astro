---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'

const locale = 'ru' as const

const faqs = [
  {
    q: 'Какие минеральные источники есть в Марианских Лазнях?',
    a: 'В Марианских Лазнях более 40 природных минеральных источников, каждый с уникальным химическим составом. Самые известные — Крестовый источник (пищеварение), Каролинин источник (обмен веществ), Рудольфов источник (мочевыводящие пути) и Лесной источник (дыхательные пути). Источники используются как для питьевых курсов, так и для лечебных ванн.',
  },
  {
    q: 'Как добраться до Марианских Лазней?',
    a: 'Из Праги — примерно 2 часа на машине по автомагистрали D5 или около 3 часов на поезде (пересадка в Пльзени). Из Мюнхена — около 300 км по автомагистралям A9/A93. Ближайший крупный аэропорт — Прага (PRG); аэропорт Карловых Вар (KLV) предлагает ограниченные сезонные рейсы.',
  },
  {
    q: 'Когда лучше всего приезжать в Марианские Лазне?',
    a: 'Каждый сезон по-своему хорош: весна (апрель-май) — для цветения парков, лето (июнь-август) — для Поющего фонтана и фестиваля Шопена, осень (сентябрь-октябрь) — для золотых лесов и меньшего числа туристов, зима (ноябрь-март) — для рождественских ярмарок и атмосферного покоя. Курортные процедуры доступны круглый год.',
  },
  {
    q: 'Нужен ли рецепт для лечения на курорте?',
    a: 'Для лечебных курортных программ рецепт рекомендуется, но не является строго обязательным. В курортных отелях есть собственные врачи, которые при заезде проводят первичный осмотр и составляют индивидуальный план лечения. Для велнес-программ рецепт не нужен.',
  },
  {
    q: 'Сколько стоит курортный отдых в Марианских Лазнях?',
    a: 'Цены варьируются в зависимости от отеля и программы. 7-дневное пребывание с полупансионом и ежедневными процедурами в 4-звёздочном отеле начинается примерно от 700-900 € на человека. 5-звёздочные отели, такие как Nové Lázně, стоят 1200-1800 € за неделю.',
  },
  {
    q: 'На каких языках говорят в Марианских Лазнях?',
    a: 'Официальный язык — чешский. В отелях, ресторанах и туристическом информационном центре широко говорят по-английски и по-немецки. Русский язык также хорошо понимается. У города давняя традиция приёма международных гостей.',
  },
  {
    q: 'Можно ли платить евро в Марианских Лазнях?',
    a: 'Официальная валюта — чешская крона (CZK). Многие отели и рестораны принимают евро, но обменный курс может быть невыгодным. Рекомендуем снимать кроны в банковском банкомате или расплачиваться картой.',
  },
  {
    q: 'Что такое Поющий фонтан?',
    a: 'Поющий фонтан (Zpívající fontána) перед Главной колоннадой — самая знаменитая достопримечательность Марианских Лазней. Каждый нечётный час фонтан показывает хореографическое шоу воды, света и музыки. В репертуаре — произведения Дворжака, Шопена и Моцарта. Вечерние шоу после наступления темноты особенно зрелищны.',
  },
  {
    q: 'Являются ли Марианские Лазне объектом ЮНЕСКО?',
    a: 'Да! В 2021 году Марианске-Лазне были включены в список Всемирного наследия ЮНЕСКО в составе «Великих курортных городов Европы». Это признание уникального сочетания целебных источников, исторической архитектуры и курортной культуры.',
  },
  {
    q: 'Какие экскурсии можно совершить из Марианских Лазней?',
    a: 'Популярные однодневные экскурсии: Карловы Вары (1 час), крепость Локет (40 минут), монастырь Тепла (20 минут), природный заповедник Кладска (15 минут), Пльзень с пивоварней Pilsner Urquell (80 минут) и замок Кинжварт (7 км).',
  },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
})
---

<Base locale={locale} section="practical-info" title="Часто задаваемые вопросы — Marienbad.com" description="Ответы на самые частые вопросы о Марианских Лазнях: как добраться, стоимость, лечение, языки и многое другое." alternateUrls={{ de: '/de/faq', en: '/en/faq', cs: '/cs/faq', ru: '/ru/faq' }}>
  <script type="application/ld+json" set:html={faqSchema} />
  <PillarPage locale={locale} title="Часто задаваемые вопросы" description="Ответы на самые распространённые вопросы о посещении Марианских Лазней.">
    <div class="space-y-6">
      {faqs.map((faq, i) => (
        <details class="group bg-beige-200 rounded-xl overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 md:p-6 text-indigo-700 font-semibold hover:text-indigo-500 transition-colors list-none">
            <span>{faq.q}</span>
            <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 md:px-6 pb-5 md:pb-6 text-beige-700 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </PillarPage>
</Base>
