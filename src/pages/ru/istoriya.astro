---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { getHotelBySlug } from '@/data/hotels'
import { exelyBookingUrl } from '@/utils/booking'
import RelatedLinks from '@/components/RelatedLinks.astro'

const locale = 'ru' as const
const page = await getPage('ru-istoriya')
const hotel = getHotelBySlug('nove-lazne')!
---

<Base locale={locale} section="history" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <HotelRecommendationBox
      locale={locale}
      name={hotel.name}
      stars={hotel.stars}
      badge="С 1828 года"
      description="Прикоснитесь к истории Марианских Лазней в отеле Ensana Nové Lázně — одном из самых легендарных курортных отелей Европы. Римские бани, сохранившиеся в первозданном виде с 1896 года, являются живым памятником чешской курортной культуры."
      bookingUrl={exelyBookingUrl({ hotelId: hotel.exelyHotelId, locale: 'ru', utmMedium: 'editorial', utmCampaign: 'history' })}
      bookingLabel="Забронировать исторический отель"
    />
    <RelatedLinks
      locale={locale}
      items={[
        { href: '/ru/rimskie-bani', title: 'Римские бани', text: 'История зала 1896 года, королевские кабины и правила посещения.' },
      ]}
    />
  </PillarPage>
</Base>
