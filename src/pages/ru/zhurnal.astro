---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import ArticleGrid from '@/components/ArticleGrid.astro'
import { getPage, getArticles } from '@/content/reader'

const locale = 'ru' as const
const page = await getPage('ru-zhurnal')
const articles = await getArticles(locale)
---

<Base locale={locale} section="magazine" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <ArticleGrid articles={articles} locale={locale} />
  </PillarPage>
</Base>
