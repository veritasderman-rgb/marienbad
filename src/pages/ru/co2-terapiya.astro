---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import TreatmentHighlightBox from '@/components/TreatmentHighlightBox.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Минеральные источники', href: `/${locale}/mineralnye-istochniki` },
  { label: 'CO₂-терапия' },
]
---

<Base locale={locale} section="mineral-springs" title="CO₂-терапия — Газ Марии — Marienbad.com" description="Уникальная CO₂-терапия в Марианских Лазнях: как природный углекислый газ улучшает кровообращение, артериальное давление и общее самочувствие." alternateUrls={{ de: '/de/co2-therapie', en: '/en/co2-therapy', cs: '/cs/co2-terapie', ru: '/ru/co2-terapiya' }}>
  <PillarPage locale={locale} title="CO₂-терапия: Газ Марии" description="Уникальная CO₂-терапия использует 99,7% чистый природный углекислый газ для улучшения кровообращения и общего самочувствия." breadcrumbs={breadcrumbs}>
    <h2>Что такое Газ Марии?</h2>
    <p>Марианские Лазни обладают уникальным в мировом масштабе природным ресурсом: <strong>99,7% чистым углекислым газом (CO₂)</strong>, который естественным образом поднимается из вулканического грунта Славковского леса. Этот газ, ласково называемый <em>«Газ Марии»</em>, является одним из четырёх природных лечебных ресурсов Марианских Лазней и составляет основу ряда высокоэффективных терапевтических процедур.</p>

    <p>CO₂-терапия относится к наиболее изученным формам бальнеотерапии (науки о лечебных ваннах) и систематически применяется в Марианских Лазнях уже более 150 лет.</p>

    <TreatmentHighlightBox
      title="Сухая газовая ванна CO₂"
      description="Пациент помещается в специальный мешок, наполненный природным CO₂. Газ впитывается через кожу, расширяя кровеносные сосуды и увеличивая периферическое кровообращение до 300%. Продолжительность: 20–30 минут."
      icon="gas"
    />

    <h2>Как действует CO₂-терапия?</h2>
    <p>Когда углекислый газ впитывается через кожу, он запускает каскад физиологических реакций:</p>

    <ul>
      <li><strong>Расширение сосудов:</strong> CO₂ расслабляет гладкую мускулатуру кровеносных сосудов, что приводит к их значительному расширению. Кровоток в обрабатываемых областях может увеличиться втрое.</li>
      <li><strong>Регуляция артериального давления:</strong> Вазодилатация снижает периферическое сопротивление, тем самым понижая артериальное давление.</li>
      <li><strong>Улучшение оксигенации:</strong> Благодаря эффекту Бора облегчается высвобождение кислорода из гемоглобина в ткани — клетки получают лучшее снабжение кислородом.</li>
      <li><strong>Обезболивающий эффект:</strong> Улучшенное кровообращение и прямое воздействие CO₂ на нервные волокна оказывают анальгетическое действие.</li>
      <li><strong>Заживление ран:</strong> Усиленная микроциркуляция способствует регенерации тканей и ускоряет заживление.</li>
    </ul>

    <h2>Формы CO₂-терапии в Марианских Лазнях</h2>

    <h3>1. Сухая газовая ванна CO₂ (Марианскоязненское газовое обёртывание)</h3>
    <p>Наиболее известная процедура: пациент лежит в специальном пластиковом мешке, доходящем до шеи, наполненном природным CO₂. Процедура длится 20–30 минут и совершенно безболезненна — многие пациенты ощущают приятное тепло и покалывание.</p>

    <h3>2. Углекислая ванна (ванна с CO₂)</h3>
    <p>Минеральные ванны, обогащённые природным CO₂. Газ впитывается через кожу и частично через дыхательные пути. Температура ванны составляет 33–34°C, что значительно ниже обычной тёплой ванны — тем не менее пациент ощущает приятное тепло благодаря сосудорасширяющему эффекту CO₂.</p>

    <h3>3. Инсуффляция CO₂ (газовые инъекции)</h3>
    <p>Подкожные инъекции небольшого количества CO₂ в болезненные суставы или мышечные области. Этот метод применяется прицельно при локальных проблемах, сочетая эффект улучшения кровообращения с прямым обезболивающим действием.</p>

    <h2>Показания</h2>
    <p>CO₂-терапия успешно применяется при:</p>
    <ul>
      <li>Сердечно-сосудистых заболеваниях (артериальная гипертензия, нарушения периферического кровообращения)</li>
      <li>Заболеваниях опорно-двигательного аппарата (артроз, ревматические жалобы)</li>
      <li>Нарушениях заживления ран и трофических язвах</li>
      <li>Диабетической полинейропатии</li>
      <li>Послеоперационной реабилитации</li>
      <li>Стрессовых расстройствах и синдромах усталости</li>
    </ul>

    <h2>Что говорит наука?</h2>
    <p>CO₂-терапия является одной из наиболее изученных форм бальнеотерапии. Клинический опыт и исследования показывают:</p>
    <ul>
      <li>Снижение систолического артериального давления до 10–15 мм рт. ст. после двухнедельного курса</li>
      <li>Значительное улучшение периферического кровообращения</li>
      <li>Большинство пациентов отмечают существенное снижение боли при суставных проблемах</li>
      <li>Измеримое улучшение заживления ран при хронических язвах</li>
    </ul>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="Эксперт по CO₂"
      description="Отель Nové Lázně предлагает комплексную программу CO₂-терапии с использованием природного марианскоязненского газа — включая сухие газовые ванны, углекислые минеральные ванны и газовые инъекции под медицинским наблюдением."
      bookingUrl="https://ensanahotels.com/ru/hotels/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=co2-therapy"
      bookingLabel="Забронировать CO₂-терапию"
    />

    <h2>Практическая информация</h2>
    <p>CO₂-терапия доступна во всех отелях Ensana Spa Hotels в Марианских Лазнях. Одна процедура длится 20–30 минут и обычно проводится один раз в день в течение 7–21 дня. Оптимальный результат достигается при минимальном курсе продолжительностью 14 дней.</p>

    <p>Перед началом лечения проводится врачебный осмотр, по результатам которого составляется ваш индивидуальный план терапии. Противопоказания включают острые воспаления, некомпенсированную сердечную недостаточность и некоторые кожные заболевания.</p>
  </PillarPage>
</Base>
