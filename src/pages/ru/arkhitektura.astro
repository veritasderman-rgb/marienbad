---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'

const locale = 'ru' as const
---

<Base locale={locale} section="things-to-do" title="Архитектура Марианских Лазней — Marienbad.com" description="Неоренессанс, необарокко, модерн — архитектурные сокровища Марианских Лазней. Колоннады, курортные здания и связь с ЮНЕСКО." alternateUrls={{ de: '/de/architektur', en: '/en/architecture', cs: '/cs/architektura', ru: '/ru/arkhitektura' }}>
  <PillarPage locale={locale} title="Архитектура Марианских Лазней" description="Марианске-Лазне — это музей европейской архитектуры под открытым небом: от неоренессанса через необарокко до модерна, возведённый всего за несколько десятилетий.">
    <h2>Город, построенный как единое целое</h2>
    <p>То, что делает Марианске-Лазне архитектурно уникальным, — это <strong>целостность его городского облика</strong>. В отличие от городов, развивавшихся на протяжении столетий, Марианске-Лазне был построен почти полностью в XIX веке — за поразительно короткий период между 1820 и 1900 годами. Результатом стал впечатляющий ансамбль курортных домов, отелей, вилл и общественных зданий, гармонично согласованных по стилю и масштабу.</p>
    <p>Архитекторы, формировавшие Марианске-Лазне, не просто проектировали отдельные здания — они создали <strong>сцену для курортной жизни</strong>: променады для прогулок, колоннады для питья целебных вод, парки как зелёные салоны и отели как дворцы для гостей со всей Европы.</p>

    <h2>Архитектурные стили</h2>

    <h3>Неоренессанс</h3>
    <p>Преобладающий стиль многих общественных зданий Марианских Лазней. Вдохновлённые итальянским Ренессансом, эти сооружения отличаются <strong>симметричными фасадами, полукруглыми окнами, пилястрами и богатым орнаментальным декором</strong>. Нове-Лазне является выдающимся примером этого стиля в Марианских Лазнях.</p>

    <h3>Необарокко</h3>
    <p><strong>Необарокко</strong> предпочитали для престижных отелей и Казино — стиль, излучающий великолепие и элегантность. Изогнутые фронтоны, пышная лепнина, балконы с коваными решётками и монументальные вестибюли характеризуют эти здания. Необарокко придало Марианским Лазням атмосферу грандеццы, которую ожидали их аристократические гости.</p>

    <h3>Модерн (Ар-нуво)</h3>
    <p>К концу XIX века пришёл <strong>модерн</strong> — с плавными линиями, цветочными орнаментами и единением искусства и ремесла. Отдельные виллы и коммерческие здания демонстрируют этот стиль, часто составляя очаровательный контраст с более старыми постройками по соседству. Особенно красивые элементы модерна можно найти на фасадах вдоль Главной улицы (Hlavní třída).</p>

    <h2>Ключевые здания</h2>

    <h3>Нове-Лазне (Новый курортный дом)</h3>
    <p><strong>Нове-Лазне</strong>, построенные в 1893–1896 годах по проекту Йозефа Шаффера, являются архитектурной жемчужиной Марианских Лазней. Монументальное неоренессансное здание сегодня вмещает пятизвёздочный отель группы Ensana и одновременно функционирует как действующий курортный дом. Его центральный элемент — <strong>Римские бани</strong> — великолепное помещение с мраморными бассейнами, мозаичным полом и кессонным потолком, напоминающим термы древнего Рима. Король Эдуард VII регулярно купался здесь; его личный купальный кабинет сохранился.</p>

    <h3>Казино (Городской театр)</h3>
    <p><strong>Казино</strong>, спроектированное Фридрихом Цикклером и открытое в 1868 году, никогда не служило игорным домом, а являлось общественным центром — с бальным залом, концертным залом и театром. Необарочное здание с элегантным фасадом было местом, где курортное общество собиралось для вечерней программы. Сегодня здание является Городским театром и служит площадкой для ежегодного Фестиваля Шопена.</p>

    <h3>Главная колоннада</h3>
    <p><strong>Главная колоннада</strong>, элегантная чугунная конструкция, является самой узнаваемой достопримечательностью Марианских Лазней. Возведённая в 1888–1889 годах, её изящная металлическая отделка и расписные потолочные панели укрывают Крестовый источник и образуют декорацию для <strong>Поющего фонтана</strong>. Чугунная конструкция была передовой для своего времени — пример союза инженерного искусства и эстетики.</p>

    <h2>Архитекторы</h2>

    <h3>Фридрих Цикклер (1829–1906)</h3>
    <p>Цикклер был наиболее значимым архитектором раннего Марианске-Лазне. Будучи городским архитектором, он спроектировал многочисленные общественные здания и виллы и определил архитектурный характер города. Его главное произведение — <strong>Казино</strong>, но его почерк виден на многих фасадах в центре города. Цикклер обладал мастерским умением гармонизировать представительную архитектуру с особенной топографией долины.</p>

    <h3>Йозеф Шаффер (1862–1938)</h3>
    <p>Шаффер перенял архитектурное формирование Марианских Лазней в следующем поколении, привнеся больший масштаб и более богатый декоративный язык. Его шедевр, <strong>Нове-Лазне</strong>, установил новые стандарты курортной архитектуры по всей Европе. Шаффер также отвечал за расширение и перестройку нескольких отелей и курортных зданий, неизменно сохраняя стилистическое единство городского облика.</p>

    <h2>Курортный треугольник</h2>
    <p>Архитектурное сердце Марианских Лазней можно описать как <strong>треугольник</strong> между тремя ключевыми точками:</p>
    <ul>
      <li><strong>Площадь Гёте (Goethovo náměstí)</strong> — Центральная площадь с памятником Гёте, окружённая величественными фасадами отелей. Отсюда расходятся все променады.</li>
      <li><strong>Крестовый источник (Křížový pramen)</strong> — Самый знаменитый минеральный источник, укрытый неоклассическим павильоном в Главной колоннаде. Уже более 200 лет — духовный центр курортной жизни.</li>
      <li><strong>Главная колоннада</strong> — Архитектурная связь между источниками и парком, а также место утренней прогулки для питья целебных вод.</li>
    </ul>
    <p>Этот треугольник образует естественный прогулочный маршрут курортного гостя — утром к источнику, вдоль колоннады, через парк — и является лучшей отправной точкой для знакомства с архитектурой Марианских Лазней.</p>

    <h2>Связь с ЮНЕСКО</h2>
    <p>С 2021 года Марианске-Лазне входят в состав <strong>объекта Всемирного наследия ЮНЕСКО «Великие курортные города Европы»</strong> — транснационального объекта, включающего одиннадцать европейских курортных городов, в том числе Баден-бай-Вин, Бат и Карловы Вары. Это признание отмечает уникальный городской ландшафт, в котором архитектура, парки, источники и нематериальное наследие курортной культуры образуют неразделимое целое.</p>
    <p>Включение в список ЮНЕСКО особо подчёркивает <strong>архитектурное качество</strong> Марианских Лазней: целостность ансамбля, вписанность в ландшафт и функциональную связь между курортными домами, колоннадами, парками и источниками как выражение европейской культурной идеи.</p>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="Архитектурная жемчужина"
      description="Остановитесь в одном из красивейших курортных зданий Европы: Нове-Лазне сочетает неоренессансную архитектуру с современным пятизвёздочным комфортом — включая знаменитые Римские бани."
      bookingUrl="https://ensanahotels.com/ru/hotels/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=architecture"
      bookingLabel="Посмотреть отель"
    />

    <blockquote>
      <p>«Марианске-Лазне — это не город, который вырос, — он был сочинён. Как музыкальное произведение, он имеет ритм, гармонию и кульминацию: вид с колоннады через парк к лесистому горизонту.»</p>
    </blockquote>
  </PillarPage>
</Base>
