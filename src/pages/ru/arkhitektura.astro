---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'

const locale = 'ru' as const
---

<Base locale={locale} section="things-to-do" title="Архитектура Марианских Лазней — Marienbad.com" description="Неоренессанс, необарокко, модерн — архитектурные сокровища Марианских Лазней. Колоннады, курортные здания и связь с ЮНЕСКО." alternateUrls={{ de: '/de/architektur', en: '/en/architecture', cs: '/cs/architektura', ru: '/ru/arkhitektura' }}>
  <PillarPage locale={locale} title="Архитектура Марианских Лазней" description="Марианские Лазне — это музей европейской архитектуры под открытым небом: от неоренессанса через необарокко к модерну, построенный всего за несколько десятилетий.">
    <h2>Город, построенный как единое целое</h2>
    <p>Что делает Марианские Лазне архитектурно уникальными — это <strong>цельность городского ансамбля</strong>. В отличие от городов, развивавшихся на протяжении столетий, Марианские Лазне были возведены почти полностью в XIX веке — за поразительно короткий период между 1820 и 1900 годами. Результатом стал впечатляющий ансамбль курортных зданий, отелей, вилл и общественных сооружений, гармонично сочетающихся по стилю и масштабу.</p>
    <p>Архитекторы, формировавшие Марианские Лазне, проектировали не просто отдельные здания — они создавали <strong>сцену для курортной жизни</strong>: променады для прогулок, колоннады для питья целебных вод, парки как зелёные салоны и отели как дворцы для гостей со всей Европы.</p>

    <h2>Архитектурные стили</h2>

    <h3>Неоренессанс</h3>
    <p>Преобладающий стиль многих общественных зданий Марианских Лазней. Вдохновлённые итальянским Ренессансом, эти сооружения отличаются <strong>симметричными фасадами, арочными окнами, пилястрами и богатым декоративным убранством</strong>. Нове Лазне (Новый курортный дом) является выдающимся примером этого стиля в Марианских Лазнях.</p>

    <h3>Необарокко</h3>
    <p><strong>Необарокко</strong> предпочитали для представительных отелей и Казино — стиль, излучающий великолепие и элегантность. Изогнутые фронтоны, пышная лепнина, балконы с коваными решётками и монументальные вестибюли определяют эти здания. Необарокко придало Марианским Лазням атмосферу грандёзности, которую ожидали их аристократические гости.</p>

    <h3>Модерн (Ар-нуво)</h3>
    <p>К концу XIX века пришёл <strong>модерн</strong> — с плавными линиями, цветочными орнаментами и единством искусства и ремесла. Отдельные виллы и торговые здания демонстрируют этот стиль, нередко в очаровательном контрасте со старшими постройками по соседству. Особенно красивые детали в стиле модерн можно обнаружить на фасадах вдоль Главной улицы (Hlavní třída).</p>

    <h2>Ключевые здания</h2>

    <h3>Нове Лазне (Новый курортный дом)</h3>
    <p><strong>Нове Лазне</strong>, построенные в 1893–1896 годах по проекту Йозефа Шаффера, являются архитектурной жемчужиной Марианских Лазней. Монументальное неоренессансное здание сегодня вмещает пятизвёздочный отель группы Ensana и одновременно функционирует как действующий курортный дом. Его сердце — <strong>Римские бани</strong> — великолепный зал с мраморными бассейнами, мозаичными полами и кессонным потолком, напоминающим термы Древнего Рима. Король Эдуард VII регулярно купался здесь; его личный купальный кабинет сохранился до наших дней.</p>

    <h3>Казино (Городской театр / Městské divadlo)</h3>
    <p><strong>Казино</strong>, спроектированное Фридрихом Цикклером и открытое в 1868 году, никогда не служило игорным домом, а было общественным центром — с бальным залом, концертным залом и театром. Необарочное здание с элегантным фасадом было местом, где курортное общество собиралось на вечерние мероприятия. Сегодня здание служит Городским театром и является площадкой ежегодного Фестиваля Шопена.</p>

    <h3>Главная колоннада (Hlavní kolonáda)</h3>
    <p><strong>Главная колоннада</strong>, элегантная чугунная конструкция, является самой узнаваемой достопримечательностью Марианских Лазней. Возведённая в 1888–1889 годах, её изящная металлическая отделка и расписные потолочные панели укрывают Крестовый источник и служат декорацией для <strong>Поющего фонтана</strong>. Чугунная конструкция была передовой для своего времени — пример сочетания инженерного искусства и эстетики.</p>

    <h2>Архитекторы</h2>

    <h3>Фридрих Цикклер (1829–1906)</h3>
    <p>Цикклер был наиболее значимым архитектором ранних Марианских Лазней. Будучи городским архитектором, он спроектировал множество общественных зданий и вилл и определил архитектурный характер города. Его главная работа — <strong>Казино</strong>, но его почерк виден на многих фасадах в центре города. Цикклер мастерски умел согласовать представительную архитектуру с особенностями рельефа долины.</p>

    <h3>Йозеф Шаффер (1862–1938)</h3>
    <p>Шаффер продолжил архитектурное формирование Марианских Лазней в следующем поколении, привнеся больший масштаб и более богатый декоративный язык. Его шедевр, <strong>Нове Лазне</strong>, установил новые стандарты курортной архитектуры по всей Европе. Шаффер также отвечал за расширение и перестройку нескольких отелей и курортных зданий, неизменно сохраняя стилистическое единство городского ансамбля.</p>

    <h2>Курортный треугольник</h2>
    <p>Архитектурное сердце Марианских Лазней можно описать как <strong>треугольник</strong> между тремя ключевыми точками:</p>
    <ul>
      <li><strong>Площадь Гёте (Goethovo náměstí)</strong> — Центральная площадь с памятником Гёте, окружённая величественными фасадами отелей. Отсюда расходятся все променады.</li>
      <li><strong>Крестовый источник (Křížový pramen)</strong> — Самый знаменитый минеральный источник, укрытый неоклассическим павильоном в Главной колоннаде. Уже более 200 лет — духовный центр курортной жизни.</li>
      <li><strong>Главная колоннада</strong> — Архитектурное связующее звено между источниками и парком, а также место общественных встреч во время утренней прогулки к водам.</li>
    </ul>
    <p>Этот треугольник образует естественный прогулочный маршрут курортного гостя — утром к источнику, вдоль колоннады, через парк — и является лучшей отправной точкой для знакомства с архитектурой Марианских Лазней.</p>

    <h2>Связь с ЮНЕСКО</h2>
    <p>С 2021 года Марианские Лазне входят в состав <strong>объекта Всемирного наследия ЮНЕСКО «Великие курортные города Европы»</strong> — транснационального объекта, объединяющего одиннадцать европейских курортных городов, включая Баден-бай-Вин, Бат и Карловы Вары. Это признание отмечает уникальный городской ландшафт, в котором архитектура, парки, источники и нематериальное наследие курортной культуры образуют неразрывное целое.</p>
    <p>Включение в список ЮНЕСКО особо подчёркивает <strong>архитектурное качество</strong> Марианских Лазней: цельность ансамбля, вписанность в ландшафт и функциональную связь между курортными зданиями, колоннадами, парками и источниками как выражение европейской культурной идеи.</p>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="Архитектурная жемчужина"
      description="Остановитесь в одном из красивейших курортных зданий Европы: Нове Лазне сочетает неоренессансную архитектуру с современным пятизвёздочным комфортом — включая знаменитые Римские бани."
      bookingUrl="https://ensanahotels.com/ru/oteli/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=architecture"
      bookingLabel="Посмотреть отель"
    />

    <blockquote>
      <p>«Марианские Лазне — это не город, который вырос, — он был сочинён. Как музыкальное произведение, он обладает ритмом, гармонией и кульминацией: видом с колоннады через парк к лесистому горизонту.»</p>
    </blockquote>
  </PillarPage>
</Base>
