---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import TreatmentHighlightBox from '@/components/TreatmentHighlightBox.astro'
import { t } from '@/i18n/ui'

const locale = 'ru' as const
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Минеральные источники', href: `/${locale}/mineralnye-istochniki` },
  { label: 'Обзор источников' },
]
---

<Base locale={locale} section="mineral-springs" title="Obzor istochnikov — 40+ mineral'nyh istochnikov Marianskih Laznej — Marienbad.com" description="Podrobnyj putevoditel' po vsem mineral'nym istochnikam Marianskih Laznej: Krestovyj istochnik, Ferdinandov istochnik, Lesnoj istochnik, Rudol'fov istochnik i drugie. Mineral'nyj sostav, temperatura i rekomendacii." alternateUrls={{ de: '/de/quellen-uebersicht', en: '/en/springs-overview', cs: '/cs/prehled-pramenu', ru: '/ru/obzor-istochnikov' }}>
  <PillarPage locale={locale} title="Обзор источников: Минеральные источники Марианске-Лазне" description="Марианске-Лазне располагают более чем 40 минеральными источниками — каждый с уникальным составом и терапевтическим действием. Полное руководство по важнейшим лечебным источникам." breadcrumbs={breadcrumbs}>
    <h2>Уникальный минеральный регион</h2>
    <p>Марианске-Лазне (Мариенбад) расположены в одном из <strong>самых богатых источниками районов Европы</strong>. Более 40 минеральных источников выходят на поверхность на относительно небольшой территории — каждый со своим химическим составом, температурой и терапевтическим эффектом. Уникальность этого региона в том, что большинство курортов располагают одним типом источника, тогда как Марианске-Лазне предлагают поразительное разнообразие минеральных вод, охватывающих широкий спектр заболеваний.</p>

    <p>Источники берут начало в <strong>вулканическом основании Славковского леса</strong>. Дождевая вода просачивается на большие глубины, обогащается минералами и поднимается обратно на поверхность по тектоническим разломам. Этот процесс длится тысячи лет — вода, которая сегодня вытекает из источников, начала своё подземное путешествие примерно 14 000 лет назад.</p>

    <p>Все источники объединяет высокое содержание <strong>природного углекислого газа (CO₂)</strong>, придающего минеральным водам их характерный игристый вкус. Однако источники существенно различаются по минеральному составу — одни богаты железом, другие натрием, третьи содержат особенно много кальция или магния.</p>

    <TreatmentHighlightBox
      title="Питьевой курс (Pitna kura)"
      description="Питьевой курс — краеугольный камень лечебных методов Марианске-Лазне. Пациенты пьют предписанное количество минеральной воды непосредственно у источника — как правило, утром натощак. Курортные врачи рекомендуют определённые источники в зависимости от диагноза каждого пациента. Типичный питьевой курс длится 14–21 день."
      icon="water"
    />

    <h2>Источники колоннады — Сердце курортного квартала</h2>
    <p>Источники у Главной колоннады и Крестовой колоннады образуют историческое ядро курортной жизни. Здесь курортные гости прогуливаются со своими питьевыми чашечками, наслаждаясь уникальной атмосферой неоклассической архитектуры.</p>

    <h3>Крестовый источник (Krizovy pramen)</h3>
    <p><strong>Крестовый источник</strong> — самый знаменитый и посещаемый источник Марианске-Лазне. Он расположен в великолепной <strong>Крестовой колоннаде</strong>, необарочном сооружении 1912 года. Вода отличается исключительно высоким содержанием CO₂ и сбалансированным минеральным профилем.</p>
    <ul>
      <li><strong>Температура:</strong> 7–10 °C</li>
      <li><strong>Минерализация:</strong> ок. 5 500 мг/л (натриево-сульфатно-гидрокарбонатный тип)</li>
      <li><strong>Содержание CO₂:</strong> ок. 2 800 мг/л — одно из наивысших значений среди всех источников</li>
      <li><strong>Показания:</strong> Заболевания пищеварительного тракта, заболевания печени и жёлчного пузыря, нарушения обмена веществ, диабет</li>
      <li><strong>Вкус:</strong> Слегка солоновато-минеральный с выраженной игристостью</li>
    </ul>

    <h3>Каролинин источник (Karolinin pramen)</h3>
    <p><strong>Каролинин источник</strong> также расположен у Главной колоннады и с XIX века специально рекомендуется при <strong>гинекологических заболеваниях</strong>. Его вода содержит уникальную комбинацию минералов, предположительно благотворно влияющих на гормональный баланс и воспалительные заболевания мочеполовой системы.</p>
    <ul>
      <li><strong>Температура:</strong> 8–10 °C</li>
      <li><strong>Минерализация:</strong> ок. 4 200 мг/л (богат кальцием и магнием)</li>
      <li><strong>Показания:</strong> Гинекологические заболевания, бесплодие, инфекции мочевыводящих путей, заболевания почек</li>
    </ul>

    <h3>Амброзиев источник (Ambrozuv pramen)</h3>
    <p><strong>Амброзиев источник</strong> — один из старейших задокументированных источников Марианске-Лазне, впервые упомянутый в XVI веке. Его вода применяется преимущественно при <strong>расстройствах пищеварения</strong> и известна своим мягким, приятным вкусом, что делает его особенно популярным среди курортных гостей.</p>
    <ul>
      <li><strong>Температура:</strong> 9–11 °C</li>
      <li><strong>Минерализация:</strong> ок. 3 800 мг/л (гидрокарбонатно-натриевый тип)</li>
      <li><strong>Показания:</strong> Хронический гастрит, язва желудка, синдром раздражённого кишечника, изжога</li>
    </ul>

    <h2>Лесные источники — Целебная вода в природе</h2>
    <p>В обширных парках и лесах, окружающих центр города, расположены одни из самых знаменитых источников Марианске-Лазне. Прогулка к этим источникам сама по себе является частью терапии — сочетание движения, свежего воздуха и питьевого курса усиливает лечебный эффект.</p>

    <h3>Лесной источник (Lesni pramen)</h3>
    <p><strong>Лесной источник</strong> находится в здании Центральных Лазней (Centralni Lazne), где он свободно доступен для гостей отелей и широкой публики. Это второй по посещаемости источник после Крестового.</p>
    <ul>
      <li><strong>Температура:</strong> 7–9 °C</li>
      <li><strong>Минерализация:</strong> ок. 4 800 мг/л (железосодержащий, сульфатный тип)</li>
      <li><strong>Показания:</strong> Заболевания верхних дыхательных путей, хронический бронхит, астма, аллергические заболевания</li>
      <li><strong>Примечание:</strong> Также используется для ингаляционной терапии</li>
    </ul>

    <h3>Мариин источник (Mariin pramen)</h3>
    <p><strong>Мариин источник</strong> — источник, давший название городу — расположен на тихой лесной поляне чуть в стороне от центра. Его вода особенно богата растворёнными газами и минералами и традиционно рекомендуется при заболеваниях дыхательных путей.</p>
    <ul>
      <li><strong>Температура:</strong> 8–10 °C</li>
      <li><strong>Минерализация:</strong> ок. 5 100 мг/л (натриево-гидрокарбонатный, газонасыщенный)</li>
      <li><strong>Показания:</strong> Заболевания дыхательных путей, хронический бронхит, астма, укрепление иммунной системы</li>
      <li><strong>Примечание:</strong> Исторически первый обнаруженный источник Марианске-Лазне</li>
    </ul>

    <h2>Парковые источники — Между архитектурой и природой</h2>
    <p>Вдоль променадов и в парковых зонах Марианске-Лазне расположены другие важные источники, размещённые в декоративных павильонах и фонтанных сооружениях.</p>

    <h3>Фердинандов источник (Ferdinanduv pramen)</h3>
    <p><strong>Фердинандов источник</strong> — один из самых богатых железом источников Марианске-Лазне, названный в честь императора Фердинанда I. Его вода с ржаво-коричневым оттенком свидетельствует о высоком содержании железа, что делает его особенно ценным для пациентов с анемией.</p>
    <ul>
      <li><strong>Температура:</strong> 9–11 °C</li>
      <li><strong>Минерализация:</strong> ок. 4 600 мг/л (высокое содержание железа, гидрокарбонатный тип)</li>
      <li><strong>Содержание железа:</strong> ок. 20 мг/л — один из самых высоких естественных уровней железа в Европе</li>
      <li><strong>Показания:</strong> Железодефицитная анемия, состояния усталости, реабилитация после операций</li>
    </ul>

    <h3>Рудольфов источник (Rudolfuv pramen)</h3>
    <p><strong>Рудольфов источник</strong> с XIX века целенаправленно используется при <strong>заболеваниях почек и мочевыводящих путей</strong>. Его вода обладает мягким мочегонным действием и способствует промыванию мочевых путей.</p>
    <ul>
      <li><strong>Температура:</strong> 7–9 °C</li>
      <li><strong>Минерализация:</strong> ок. 3 600 мг/л (богат кальцием, слабый диуретик)</li>
      <li><strong>Показания:</strong> Камни в почках, инфекции мочевыводящих путей, хронические воспаления почек, заболевания предстательной железы</li>
    </ul>

    <h2>Практические советы по питьевому курсу</h2>
    <p>Тем, кто хочет использовать минеральные источники Марианске-Лазне в терапевтических целях, следует соблюдать несколько важных правил:</p>

    <ul>
      <li><strong>Консультация врача:</strong> Перед началом питьевого курса проконсультируйтесь с курортным врачом. Он определит, какие источники подходят для вашего состояния и в каком количестве следует пить.</li>
      <li><strong>Питьевая чашечка:</strong> Используйте традиционный <em>lazennsky poharek</em> (курортную чашечку) — плоский носик обеспечивает медленное питьё маленькими глотками.</li>
      <li><strong>Количество:</strong> Обычно 100–200 мл на источник, 2–3 раза в день. Пейте медленно, прогуливаясь.</li>
      <li><strong>Время приёма:</strong> Лучше всего утром натощак, не менее чем за 30 минут до завтрака.</li>
      <li><strong>Температура:</strong> Источники холодные (7–11 °C). Это намеренно — прохлада стимулирует деятельность желудка.</li>
      <li><strong>Продолжительность:</strong> Полный питьевой курс длится не менее 14 дней. Первые эффекты часто проявляются через 5–7 дней.</li>
    </ul>

    <h2>Часы работы и доступ</h2>
    <p>Большинство источников <strong>свободно доступны круглый год</strong>. Колоннадные источники, как правило, открыты с 6:00 до 18:00 (летом — до 19:00). Некоторые источники в лесах доступны только в летний сезон (май–октябрь).</p>

    <p>Прогулка вдоль всех основных источников занимает примерно <strong>2–3 часа</strong> и проходит через красивейшие части курортного квартала и парковых зон — незабываемый опыт, объединяющий здоровье и удовольствие.</p>
  </PillarPage>
</Base>
