---
/**
 * B2B partner / travel-trade introduction page — marienbad.com/introduce
 *
 * Deliberately unlisted: not linked from the homepage or navigation, kept out
 * of the sitemap (see astro.config NOINDEXED_PATHS) and marked noindex. Reachable
 * only via a direct link shared with partners and travel agencies.
 *
 * English is the default entry point; German lives at /introduce/de and Czech
 * at /introduce/cs. All three render the shared IntroducePartnerPage component,
 * so every partner sees the complete set of materials — each item labelled with
 * the language of the document itself.
 */
import Base from '@/layouts/Base.astro'
import IntroducePartnerPage, {
  introduceAlternates,
  introduceSwitcher,
  introduceMeta,
} from '@/components/IntroducePartnerPage.astro'

export const prerender = true
---

<Base
  locale="en"
  title={introduceMeta.en.title}
  description={introduceMeta.en.description}
  noindex={true}
  alternateUrls={introduceAlternates}
  switcherUrls={introduceSwitcher}
>
  <IntroducePartnerPage lang="en" />
</Base>
