---
import PortalLayout from '../../../layouts/PortalLayout.astro'
import PartnerDetail from '../../../components/portal/PartnerDetail'

export const prerender = false

const role = Astro.locals.portalUser?.role
if (role === 'viewer') {
  return Astro.redirect('/portal', 302)
}

const { id } = Astro.params
---

<PortalLayout title="Detail partnera">
  <div class="space-y-6">
    <a href="/portal/partners" class="text-sm font-semibold text-[#0E6EA8] hover:underline">← Zpět na seznam partnerů</a>
    <PartnerDetail client:load partnerId={id as string} role={role ?? 'viewer'} />
  </div>
</PortalLayout>
