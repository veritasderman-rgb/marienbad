---
import PortalLayout from '../../../layouts/PortalLayout.astro'
import AuditLog from '../../../components/portal/AuditLog'

export const prerender = false
---

<PortalLayout title="Audit">
  <div class="space-y-6">
    <div>
      <h1 class="font-heading text-2xl font-bold text-[#004F71]">Audit log</h1>
      <p class="mt-1 text-sm text-[#5F6B72]">Nemazatelný záznam všech zápisových akcí v portálu.</p>
    </div>
    <AuditLog client:load />
  </div>
</PortalLayout>
