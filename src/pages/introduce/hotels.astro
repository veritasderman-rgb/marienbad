<!-- English-only partner page: declare just the EN alternate so the language
     switcher keeps EN on this page (DE/CS/RU fall back to their homepages) and
     no misleading hreflang is emitted for locales where the page doesn't exist. -->
<Base
  locale="en"
  title={title}
  description={description}
  noindex={true}
  alternateUrls={{ en: '/introduce/hotels' }}
