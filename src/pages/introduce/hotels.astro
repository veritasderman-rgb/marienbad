            <li class="flex items-start gap-2 text-sm text-gray-800 font-medium">
              <svg class="w-3.5 h-3.5 mt-0.5 text-turquoise-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Full treatment list — collapsible to save space -->
    <details class="mt-6 group bg-white rounded-2xl shadow-card border border-gray-100 overflow-hidden">
      <summary class="cursor-pointer list-none px-6 md:px-7 py-5 flex items-center justify-between gap-4 hover:bg-beige-50 transition-colors">
        <span>
          <span class="block font-heading text-lg font-bold text-indigo-800">Full treatment list</span>
          <span class="block text-sm text-gray-500 mt-0.5">{treatmentCount} treatments and examinations — click to expand</span>
        </span>
        <svg class="w-5 h-5 shrink-0 text-indigo-700 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-6 md:px-7 pb-7 pt-1 border-t border-gray-100">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-5">
          {treatmentGroups.map((g) => (
            <div>
              <h4 class="text-[11px] uppercase tracking-wider text-turquoise-700 font-bold mb-2">{g.group}</h4>
              <ul class="space-y-1">
                {g.items.map((it) => <li class="text-sm text-gray-700 leading-snug">{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="text-xs text-gray-400 mt-6">
          Representative list based on the 2026 spa treatment price list. Prices on request — the
          available range differs by hotel and depends on current offers and availability.
        </p>
      </div>
    </details>
  </section>

  <!-- Overview table (desktop) -->
  <section class="container-wide py-10 md:py-14 hidden md:block">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-800 mb-6">At a glance</h2>
    <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-card">
      <table class="w-full text-left text-sm md:text-base border-collapse">
        <thead>
          <tr class="bg-indigo-800 text-white">
            <th class="px-4 py-3 font-semibold">Hotel</th>
            <th class="px-4 py-3 font-semibold whitespace-nowrap">Category</th>
            <th class="px-4 py-3 font-semibold whitespace-nowrap">Capacity</th>
            <th class="px-4 py-3 font-semibold">Built / style</th>
            <th class="px-4 py-3 font-semibold">Restaurant</th>
            <th class="px-4 py-3 font-semibold">Reservations</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {overview.map((r) => (
            <tr class="bg-white align-top">
              <td class="px-4 py-3 font-semibold text-indigo-800 whitespace-nowrap">{r.name}</td>
              <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{r.cat}</td>
              <td class="px-4 py-3 text-gray-700">{r.rooms}</td>
              <td class="px-4 py-3 text-gray-600">{r.built}</td>
              <td class="px-4 py-3 text-gray-600">{r.rest}</td>
              <td class="px-4 py-3 whitespace-nowrap">
                <a href={`mailto:${r.contact}`} class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">{r.contact}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Per-hotel fact sheets -->
  <section class="bg-beige-50 py-10 md:py-16">
    <div class="container-wide space-y-10 md:space-y-14">
      {hotels.map((h) => (
        <article id={h.slug} class="bg-white rounded-2xl shadow-card border border-gray-100 overflow-hidden scroll-mt-24">
          <!-- Hotel hero photo -->
          <div class="relative">
            <Pic
              src={h.cardImage}
              alt={h.name}
              class="w-full h-52 md:h-72 object-cover"
              sizes="(max-width: 1024px) 100vw, 1100px"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-indigo-950/80 via-indigo-950/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 md:p-7">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-yellow-400 text-sm tracking-wide">{'★'.repeat(h.stars)}</span>
              </div>
              <h2 class="font-heading text-2xl md:text-3xl font-bold text-white">{h.name}</h2>
              <p class="text-white/85 text-sm md:text-base mt-1 max-w-2xl">{h.claim}</p>
            </div>
          </div>

          <div class="p-5 md:p-7 lg:p-8">
            <p class="text-gray-700 leading-relaxed max-w-3xl">{h.intro}</p>

            <!-- Key facts -->
            <dl class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
              {h.facts.map((f) => (
                <div class="border-t border-gray-100 pt-2">
                  <dt class="text-[11px] uppercase tracking-wider text-gray-400 font-semibold">{f.label}</dt>
                  <dd class="text-gray-800 font-medium">{f.value}</dd>
                </div>
              ))}
            </dl>

            <!-- Highlights -->
            <ul class="mt-6 flex flex-wrap gap-2">
              {h.highlights.map((hl) => (
                <li class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-turquoise-50 text-turquoise-800 text-xs font-medium">
                  <svg class="w-3 h-3 text-turquoise-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {hl}
                </li>
              ))}
            </ul>

            <!-- Detail blocks -->
            <div class="mt-7 grid gap-6 lg:grid-cols-2">
              {h.blocks.map((b) => (
                <div class="bg-beige-50 rounded-xl p-5 border border-beige-100">
                  <h3 class="font-heading text-base md:text-lg font-bold text-indigo-800 mb-2">{b.heading}</h3>
                  {b.text && <p class="text-sm text-gray-700 leading-relaxed">{b.text}</p>}
                  {b.items && (
                    <ul class="text-sm text-gray-700 leading-relaxed grid sm:grid-cols-2 gap-x-4 gap-y-1 list-disc list-inside">
                      {b.items.map((it) => <li>{it}</li>)}
                    </ul>
                  )}
                </div>
              ))}
            </div>

            <!-- Photo strip from existing galleries -->
            {galleries[h.slug].length > 0 && (
              <div class="mt-7">
                <p class="text-[11px] uppercase tracking-wider text-gray-400 font-semibold mb-2">Photos</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {galleries[h.slug].map((img) => (
                    <div class="overflow-hidden rounded-lg">
                      <Pic
                        src={img.src}
                        alt={img.alt}
                        class="w-full h-28 md:h-32 object-cover"
                        sizes="(max-width: 640px) 50vw, 260px"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Contact & links -->
            <div class="mt-7 pt-6 border-t border-gray-100 flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
              <div class="text-sm text-gray-700 space-y-1">
                <p class="text-gray-500">{h.contact.address}</p>
                <p>
                  <span class="text-gray-500">Reservations:</span>{' '}
                  <a href={`mailto:${h.contact.reservationEmail}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2 break-all">{h.contact.reservationEmail}</a>
                </p>
                {h.contact.hotelEmail && (
                  <p>
                    <span class="text-gray-500">Hotel:</span>{' '}
                    <a href={`mailto:${h.contact.hotelEmail}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2 break-all">{h.contact.hotelEmail}</a>
                  </p>
                )}
                {h.contact.phone && (
                  <p>
                    <span class="text-gray-500">Phone:</span>{' '}
                    <a href={`tel:${h.contact.phone.replace(/\s/g, '')}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2">{h.contact.phone}</a>
                    {h.contact.reservationPhone && (
                      <span>
                        {' · reservations '}
                        <a href={`tel:${h.contact.reservationPhone.replace(/\s/g, '')}`} class="text-turquoise-700 hover:text-turquoise-800 font-medium underline underline-offset-2">{h.contact.reservationPhone}</a>
                      </span>
                    )}
                  </p>
                )}
              </div>
              <div class="flex flex-wrap gap-3 shrink-0">
                <a href={h.detailUrl} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-50 hover:bg-indigo-100 text-indigo-800 text-sm font-semibold transition-colors">
                  Hotel page
                </a>
                <a href={h.bookingUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-yellow-400 hover:bg-yellow-300 text-beige-950 text-sm font-semibold transition-colors">
                  Book on ensanahotels.com
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={extLinkIcon} /></svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Footer note. NB: .container-wide sets the `padding` shorthand, which zeroes
       out padding utilities on this element — so the strip of white space below
       the box is a margin on the box itself, not section padding. -->
  <section class="container-wide">
    <div class="bg-indigo-50 rounded-2xl border border-indigo-100 p-6 md:p-7 mb-4 md:mb-5">
      <h2 class="font-heading text-lg md:text-xl font-bold text-indigo-800 mb-3">Need more?</h2>
      <p class="text-gray-700 leading-relaxed">
        Official presentations, hotel pasports and downloadable photo and video galleries are available
        in the <a href="/introduce" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">partner hub</a>
        and the <a href="/introduce/media" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">media library</a>.
        For parking at each hotel — including group and coach arrivals — see the
        <a href="/en/parking" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">parking overview</a>.
      </p>
      <p class="text-gray-700 leading-relaxed mt-3">
        All properties are operated by <strong>Léčebné lázně Mariánské Lázně a.s.</strong>, part of the
        international <strong>Ensana</strong> spa group. For rates, allotments, FAM trips and group
        offers contact
        <a href="mailto:reservation.cz@ensanahotels.com" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">reservation.cz@ensanahotels.com</a>
        or, for MICE,
        <a href="mailto:conference.cz@ensanahotels.com" class="text-turquoise-700 hover:text-turquoise-800 underline underline-offset-2">conference.cz@ensanahotels.com</a>.
      </p>
    </div>
  </section>
</Base>
