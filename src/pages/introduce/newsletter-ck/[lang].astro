---
/**
 * Archiv newsletterů pro CK — jazykové varianty (/en, /de, /cs).
 * Kanonický český vstup je /introduce/newsletter-ck (index.astro); /cs
 * generujeme taky, protože detaily čísel pod /cs/<slug> existují a partner
 * si tuhle adresu přirozeně zkusí.
 */
import Base from '@/layouts/Base.astro'
import CkNewsletterArchive from '@/components/CkNewsletterArchive.astro'
import {
  newsletterLangs,
  newsletterArchiveAlternates,
  newsletterArchiveSwitcher,
  type NewsletterLang,
} from '@/data/ckNewsletters'

export const prerender = true

export function getStaticPaths() {
  return newsletterLangs.map((lang) => ({ params: { lang }, props: { lang } }))
}

interface Props {
  lang: NewsletterLang
}

const { lang } = Astro.props

const meta: Record<string, { title: string; description: string }> = {
  en: {
    title: 'Ensana News archive | For travel agencies',
    description:
      'Every issue of the Ensana News partner newsletter in one place — with a summary, main points and topic tags for quick reference.',
  },
  de: {
    title: 'Archiv der Ensana News | Für Reisebüros',
    description:
      'Alle Ausgaben des Partner-Newsletters Ensana News an einem Ort — mit Zusammenfassung, den wichtigsten Punkten und Themen-Tags zum schnellen Nachschlagen.',
  },
  cs: {
    title: 'Archiv newsletterů Ensana News | Pro cestovní kanceláře',
    description:
      'Všechna vydání partnerského newsletteru Ensana News na jednom místě — se shrnutím, hlavními body a štítky témat pro rychlé dohledání.',
  },
}

const m = meta[lang]
---

<Base
  locale={lang === 'de' ? 'de' : lang === 'cs' ? 'cs' : 'en'}
  section="accommodation"
  title={m.title}
  description={m.description}
  noindex={true}
  alternateUrls={newsletterArchiveAlternates}
  switcherUrls={newsletterArchiveSwitcher}
>
  <CkNewsletterArchive lang={lang} />
</Base>
