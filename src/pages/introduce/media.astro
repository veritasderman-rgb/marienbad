---
/**
 * Partner media library — marienbad.com/introduce/media
 *
 * A clickable index of all official Ensana / Mariánské Lázně video content
 * (YouTube) and downloadable photo galleries, grouped with short descriptions.
 * Sourced from the Ensana "Download links" media kit.
 *
 * Unlisted like /introduce: noindex + kept out of the sitemap (the astro.config
 * NOINDEXED_PATHS 'introduce' entry matches this path too).
 */
import Base from '@/layouts/Base.astro'

export const prerender = true

type Lang = 'CZ' | 'DE' | 'EN' | 'RU' | 'AR'
interface VideoItem {
  title: string
  desc?: string
  /** single video/channel link */
  href?: string
  /** localized variants */
  langs?: { lang: Lang; href: string }[]
}
interface VideoGroup {
  group: string
  items: VideoItem[]
}

const videoGroups: VideoGroup[] = [
