---
/**
 * Svatební landing page — evergreen, ne kampaň. Obsah drží sdílená
 * komponenta WeddingsPage, texty src/data/weddingsContent.ts.
 */
import Base from '@/layouts/Base.astro'
import WeddingsPage from '@/components/WeddingsPage.astro'

export const prerender = true

const locale = 'en' as const
---

<Base
  locale={locale}
  section="culture"
  title="Your wedding in Mariánské Lázně — venues, halls, dates | Marienbad.com"
  description="A ceremony at the colonnade, a banquet under crystal chandeliers, seven hotels on foot. Venues, hall capacities and the questions couples ask most."
  ogImage="/images/library/wedding/casino-marble-hall-banquet.jpg"
  alternateUrls={{ cs: '/cs/svatba', de: '/de/hochzeit', en: '/en/weddings', ru: '/ru/svadba' }}
>
  <WeddingsPage locale={locale} />
</Base>
