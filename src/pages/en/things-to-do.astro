---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'
import RelatedArticles from '@/components/RelatedArticles.astro'
import DestinationMap from '@/components/DestinationMap.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { getHotelBySlug } from '@/data/hotels'
import { exelyBookingUrl } from '@/utils/booking'

const locale = 'en' as const
const page = await getPage('en-things-to-do')
const hotel = getHotelBySlug('centralni-lazne')!
---

<Base locale={locale} section="things-to-do" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <RelatedArticles locale={locale} category="nature" />
    <HotelRecommendationBox
      locale={locale}
      name={hotel.name}
      stars={hotel.stars}
      badge="Central Location"
      description="Located on Goethe Square in the heart of Marienbad, the Ensana Centrální Lázně is the perfect base for exploring the town's attractions, the Colonnade and the surrounding nature on foot."
      bookingUrl={exelyBookingUrl({ hotelId: hotel.exelyHotelId, locale: 'en', utmMedium: 'editorial', utmCampaign: 'things-to-do' })}
      bookingLabel="Book centrally located hotel"
    />
    <DestinationMap locale={locale} />
  </PillarPage>
</Base>
