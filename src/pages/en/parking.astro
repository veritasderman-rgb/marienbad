---
/**
 * Parking at the Ensana Hotels in Marienbad — /en/parking
 * Content and translations in src/data/parking.ts + ParkingPageContent.astro.
 */
import Base from '@/layouts/Base.astro'
import ParkingPageContent from '@/components/ParkingPageContent.astro'
import { ui, parkingUrls } from '@/data/parking'

export const prerender = true

const locale = 'en' as const
const t = ui[locale]
---

<Base
  locale={locale}
  section="practical-info"
  title={t.metaTitle}
  description={t.metaDescription}
  alternateUrls={parkingUrls}
>
  <ParkingPageContent locale={locale} />
</Base>
