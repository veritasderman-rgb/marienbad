---
import Base from '@/layouts/Base.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'

const locale = 'en' as const
const page = await getPage('en-imprint')
---

<Base locale={locale} title={page?.metaTitle ?? "Imprint"} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/impressum', en: '/en/imprint', cs: '/cs/impressum', ru: '/ru/impressum' }}>
  <main class="container-wide py-16 md:py-24">
    <div class="max-w-3xl mx-auto prose-marienbad">
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mb-8">{page?.title}</h1>
      { page?.body && <MarkdocRenderer content={page.body} /> }
    </div>
  </main>
</Base>
