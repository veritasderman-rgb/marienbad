---
import Base from '@/layouts/Base.astro'
import { hotels } from '@/data/hotels'
import { withUtm } from '@/utils/utm'

const locale = 'en' as const
const hotel = hotels.find((h) => h.slug === 'nove-lazne')!

const pageTitle = '130 Years of Nové Lázně — Anniversary 1896–2026 — Marienbad.com'
const pageDescription = 'Nové Lázně celebrates 130 years since architect Josef Schaffer\'s grand transformation. Discover the history, the Roman Baths, and the Royal Cabin of King Edward VII.'

const milestones = [
  { year: '1828', title: 'The birth of Neubad (New Bath)', description: 'Abbot Karl Kašpar Reitenberger founds a new bathhouse — the Neubad. Sixteen bathing cabins and ten guest rooms welcome visitors arriving to take the iron-rich waters of the Ambrosius and Caroline springs.' },
  { year: '1841', title: 'First expansion', description: 'The number of bathing cabins grows to fourteen, and a separate boiler house is built alongside the main structure. A new Kursaal hall is added — Nové Lázně becomes the social heart of the town.' },
  { year: '1893–1896', title: 'Reborn as a Neo-Renaissance palace', description: 'Architect Josef Schaffer rebuilds the Neubad from the ground up. The modest Classicist building is transformed into a monumental four-towered palace in the Italian Neo-Renaissance style, complete with Roman Baths, marble columns, classical statuary, and pools filled with mineral water.' },
  { year: '1897', title: 'King Edward VII first visits Marienbad', description: 'The future British monarch arrives for the first time and immediately falls in love with the town. A private Royal Cabin is created for him at Nové Lázně, featuring an opulent bathtub and an elegant resting room in the spirit of the belle époque.' },
  { year: '1904', title: 'A historic meeting of two sovereigns', description: 'On 16 August 1904, Emperor Franz Joseph I and King Edward VII meet at the Nové Lázně hotel for an official diplomatic conference. For one day, Marienbad becomes the centre of European politics.' },
  { year: '1905', title: 'Founding of the Royal Golf Club', description: 'Edward VII founds the oldest golf club in Bohemia — the Royal Golf Club Mariánské Lázně. The club has operated continuously ever since.' },
  { year: '1912–1913', title: 'Expansion under Abbot Helmer', description: 'Under Abbot Gilbert Helmer, the capacity of bathing cabins nearly doubles. Nové Lázně responds to growing demand from the international aristocracy.' },
  { year: '2005', title: 'The royal tradition continues', description: 'Prince Edward, Earl of Wessex, stays at the Nové Lázně hotel, continuing the tradition of the British Royal Family in Marienbad.' },
  { year: '2021', title: 'Inscribed on the UNESCO World Heritage List', description: 'Mariánské Lázně becomes part of the transnational inscription "The Great Spa Towns of Europe". Nové Lázně is among the key buildings in the protected zone.' },
  { year: '2026', title: '130 years since Schaffer\'s transformation', description: 'Nové Lázně celebrates its 130th anniversary. The building continues to serve as a five-star spa hotel — with the original Roman Baths, the Royal Cabin, and the Imperial Cabin all in full operation.' },
]

const highlights = [
  {
    title: 'Roman Baths from 1896',
    description: 'Two original mineral-water pools set among massive marble columns and classical statues — an authentic 1896 interior that survived two world wars. A third pool with a counter-current jet was added during the modern renovation. Guests also enjoy a sauna (80 °C), sanarium (50 °C), steam bath, and Kneipp therapy.',
    icon: 'M12 21.5c-3.04 0-5.5-2.09-5.5-6 0-3.91 5.5-11 5.5-11s5.5 7.09 5.5 11c0 3.91-2.46 6-5.5 6z',
  },
  {
    title: 'Royal Cabin of King Edward VII',
    description: 'A private bathing suite built in 1896 for the British king. The original belle époque bathtub, an elegant resting room — and a true curiosity: a carved wooden chair with a hidden mechanical scale built into its frame. The king would discreetly check his weight while seated, sparing himself the indignity of standing on an ordinary scale.',
    icon: 'M5 3a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2H5zm7 2a5 5 0 110 10 5 5 0 010-10z',
  },
  {
    title: 'Imperial Cabin of Emperor Franz Joseph I',
    description: 'A bathing suite with its original historic décor, created for the Austrian emperor. Both the Royal and Imperial Cabins are still used today for specialist balneotherapy treatments, mineral baths, and mud wraps.',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    title: '5,900 m² interconnected complex',
    description: 'Nové Lázně, Centrální Lázně, and Maria Spa are linked by covered promenades and corridors into a single complex. Guests move between buildings without stepping outside — the largest historically original spa complex in Bohemia.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
]

const funFacts = [
  'The Ferdinand Spring was piped to Nové Lázně through a 1,700-metre conduit from Úšovice. A steam engine pushed the water along a route climbing 43 metres in elevation.',
  'In the Royal Cabin stands a carved wooden chair with a mechanical scale hidden inside its frame. Edward VII used it to discreetly check his weight — standing on an ordinary scale would not have been very regal.',
  'Edward VII visited Marienbad so regularly (nine times in twelve years) that the European press dubbed the town "the summer capital of European diplomacy".',
  'Four turrets from the 1896 reconstruction still crown the building today — they have become the hotel\'s iconic silhouette, visible from across the valley.',
  'Distinguished guests have included Tsar Nicholas II, composers Chopin and Wagner, the writer Franz Kafka, and Mark Twain, who in 1892 wrote with characteristic wit about the local spa rituals.',
  'A mineral spring rises in the corridors of the hotel itself — guests can fill their cup without ever stepping out to the colonnade.',
  'The 1904 meeting between Edward VII and Emperor Franz Joseph I is commemorated by a bronze sculpture group on Goethe Square, unveiled in 2014 on the 110th anniversary of the event.',
  'The Royal Restaurant, which adjoins the Roman Baths, was last renovated in 2024 and seats 180 guests. It serves a menu blending Czech and Central European cuisine.',
]
---

<Base locale={locale} section="accommodation" title={pageTitle} description={pageDescription} alternateUrls={{ cs: '/cs/nove-lazne-130-let', de: '/de/neue-baeder-130-jahre', en: '/en/neue-baeder-130-years', ru: '/ru/novye-lazni-130-let' }}>

  <!-- Anniversary Hero -->
  <section class="relative bg-indigo-700 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(138,216,237,0.15)_0%,_transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_rgba(201,163,105,0.1)_0%,_transparent_50%)]"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-yellow-400/40 to-transparent"></div>

    <div class="relative container-wide py-20 md:py-32 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-yellow-400/20 rounded-full text-yellow-300 text-sm font-semibold mb-6">
        <span>★</span>
        <span>1896 — 2026</span>
        <span>★</span>
      </div>

      <h1 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight" style="font-size: clamp(2.25rem, 5vw, 4.5rem);">
        130 Years of Nové Lázně
      </h1>

      <p class="text-white/70 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed mb-8">
        From the monumental transformation by architect <strong class="text-white">Josef Schaffer</strong> in 1896
        to today's five-star spa hotel with the <strong class="text-white">Roman Baths</strong>,
        the <strong class="text-white">Royal Cabin of King Edward VII</strong>, and a mineral spring flowing right through the corridors.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href={withUtm(hotel.bookingUrls.en, 'marienbad', 'anniversary', 'nove-lazne-130')}
          class="inline-flex items-center gap-2 px-8 py-4 bg-yellow-400 text-indigo-900 rounded-lg font-bold hover:bg-yellow-300 transition-colors text-lg"
          target="_blank"
          rel="noopener"
        >
          Book your stay
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#milestones" class="inline-flex items-center gap-2 px-8 py-4 border border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors text-lg">
          Discover history
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-6 md:gap-10 mt-12 text-sm">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">1896</div>
          <div class="text-white/50 mt-1">Year of transformation</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">★★★★★</div>
          <div class="text-white/50 mt-1">5-star hotel</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">5,900 m²</div>
          <div class="text-white/50 mt-1">Spa complex</div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-yellow-400">UNESCO</div>
          <div class="text-white/50 mt-1">World Heritage</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights Grid -->
  <section class="container-wide py-16 md:py-24">
    <div class="text-center mb-12">
      <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">What makes Nové Lázně extraordinary</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Treasures you won't find anywhere else</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {highlights.map((item) => (
        <div class="bg-beige-200 rounded-xl p-6 md:p-8 flex gap-5 items-start">
          <div class="shrink-0 w-12 h-12 rounded-xl bg-indigo-700 flex items-center justify-center">
            <svg class="w-6 h-6 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-lg font-bold text-indigo-700 mb-2">{item.title}</h3>
            <p class="text-beige-700 text-sm leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Architect Section -->
  <section class="bg-indigo-700 text-white py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-turquoise-400 text-xs font-semibold uppercase tracking-wider">The Architect</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mt-3 mb-6">Josef Schaffer (1862–1938)</h2>
        <p class="text-white/70 text-lg leading-relaxed mb-6">
          Schaffer transformed the modest Classicist Neubad of 1828 into a <strong class="text-white">monumental four-towered palace in the Italian Neo-Renaissance style</strong>. The reconstruction took three years (1893–1896), and the result surpassed all expectations — Marienbad suddenly possessed a building that could rival the finest bathhouses in Karlovy Vary, Baden-Baden, or Vichy.
        </p>
        <p class="text-white/70 text-lg leading-relaxed">
          Schaffer designed the Roman Baths with marble columns and pools fed by mineral water, private cabins for royal guests, and the engineering infrastructure to pipe the Ferdinand Spring through 1.7 km of conduit from the village of Úšovice. <strong class="text-white">Nové Lázně remains his greatest masterpiece to this day.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section id="milestones" class="container-wide py-16 md:py-24">
    <div class="text-center mb-12">
      <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">A journey through the centuries</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Milestones of Nové Lázně</h2>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-[27px] top-0 bottom-0 w-px bg-beige-300 hidden md:block"></div>

        <div class="space-y-8">
          {milestones.map((milestone) => (
            <div class="flex gap-5 items-start">
              <div class="shrink-0 w-14 h-14 rounded-full bg-indigo-700 text-white flex items-center justify-center text-xs font-bold z-10 shadow-lg">
                {milestone.year.includes('–') ? milestone.year.split('–')[0] : milestone.year}
              </div>
              <div class="pt-2">
                <div class="text-turquoise-600 text-sm font-semibold">{milestone.year}</div>
                <h3 class="font-heading text-lg font-bold text-indigo-700 mt-1">{milestone.title}</h3>
                <p class="text-beige-700 text-sm leading-relaxed mt-1">{milestone.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Fun Facts -->
  <section class="bg-beige-200 py-16 md:py-24">
    <div class="container-wide">
      <div class="text-center mb-12">
        <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Did you know?</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3">Fascinating facts from the archives</h2>
        <p class="text-beige-700 mt-3 max-w-2xl mx-auto">Stories and curiosities from 130 years of Nové Lázně — drawn from the archives of the Hamelika journal, the Mariánské Lázně Municipal Museum, and the period press.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {funFacts.map((fact, i) => (
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <div class="w-8 h-8 rounded-full bg-yellow-400 text-indigo-900 flex items-center justify-center font-bold text-sm mb-4">{i + 1}</div>
            <p class="text-beige-800 text-sm leading-relaxed">{fact}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- King Edward Section -->
  <section class="container-wide py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <div class="bg-indigo-700 text-white rounded-2xl p-8 md:p-12">
        <span class="text-yellow-400 text-xs font-semibold uppercase tracking-wider">A royal tradition</span>
        <h2 class="font-heading text-2xl md:text-3xl font-bold mt-3 mb-6">The nine visits of King Edward VII</h2>
        <p class="text-white/70 leading-relaxed mb-4">
          When the British Crown Prince (and future King) Edward VII first arrived in Marienbad in 1897, he fell in love with the town at once. Over the following twelve years he returned <strong class="text-white">nine times</strong> — and on every occasion, Nové Lázně was his home base.
        </p>
        <p class="text-white/70 leading-relaxed mb-4">
          His daily ritual never varied: a <strong class="text-white">morning drinking cure at the Cross Spring</strong>, then a short walk to Nové Lázně for a bath in the private <strong class="text-white">Royal Cabin</strong>. Inside it stands an opulent belle époque bathtub, and beside it a remarkable piece of furniture — an <strong class="text-white">elegant carved wooden chair with a built-in mechanical scale</strong>. The king would discreetly check his weight while seated, sparing himself the indignity of standing on an ordinary scale.
        </p>
        <p class="text-white/70 leading-relaxed mb-4">
          Thanks to his regular sojourns, Marienbad became known as the <strong class="text-white">summer capital of European diplomacy</strong>. The crowning moment was the <strong class="text-white">meeting with Emperor Franz Joseph I</strong> on 16 August 1904 — an event now commemorated by a bronze sculpture group on Goethe Square.
        </p>
        <p class="text-white/70 leading-relaxed mb-6">
          In 1905, Edward VII founded the <strong class="text-white">Royal Golf Club Mariánské Lázně</strong> — the oldest golf club in Bohemia, still in continuous operation today. And the royal tradition lives on: in 2005, <strong class="text-white">Prince Edward, Earl of Wessex</strong>, stayed at Nové Lázně.
        </p>
        <blockquote class="border-l-4 border-yellow-400 pl-5 text-white/80 italic">
          "The Royal Cabin — with its original bathtub, resting room, and chair concealing a hidden scale — is a living testament to the era when the history of Europe was being written in Marienbad."
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-indigo-700 text-white py-16 md:py-24">
    <div class="container-wide text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-yellow-400/20 rounded-full text-yellow-300 text-sm font-semibold mb-6">
        <span>130 Years — Anniversary Stay</span>
      </div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">Experience history for yourself</h2>
      <p class="text-white/70 text-lg max-w-2xl mx-auto mb-8">
        Bathe in marble-columned pools dating from 1896, try a mineral bath in the Royal Cabin of King Edward VII, and taste spring water drawn right in the corridors of the hotel.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href={withUtm(hotel.bookingUrls.en, 'marienbad', 'anniversary-cta', 'nove-lazne-130')}
          class="inline-flex items-center gap-2 px-8 py-4 bg-yellow-400 text-indigo-900 rounded-lg font-bold hover:bg-yellow-300 transition-colors text-lg"
          target="_blank"
          rel="noopener"
        >
          Book an anniversary stay
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`/${locale}/accommodation`} class="inline-flex items-center gap-2 px-8 py-4 border border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors text-lg">
          All hotels
        </a>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section class="container-wide py-8 md:py-12">
    <p class="text-beige-500 text-xs text-center">
      Historical information sourced from
      <a href="https://www.hamelika.cz/?cz_marianskolazenske-analy-1193-%E2%80%93-1990%2C49=" class="text-turquoise-600 hover:underline" target="_blank" rel="noopener">Mariánské Lázně Annals (Hamelika)</a>,
      <a href="https://www.hamelika.cz/?cz_shrnuti-historie-marianskych-lazni%2C40=" class="text-turquoise-600 hover:underline" target="_blank" rel="noopener">History Summary (Hamelika)</a>,
      <a href="https://www.e-lazne.eu/marianske-lazne/hotel-nove-lazne" class="text-turquoise-600 hover:underline" target="_blank" rel="noopener">e-lazne.eu</a>
      and <a href="https://ensanahotels.com/en/hotels/nove-lazne" class="text-turquoise-600 hover:underline" target="_blank" rel="noopener">Ensana Hotels</a>.
    </p>
  </section>

</Base>
