---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import { getPage, extractFaqSections } from '@/content/reader'
import ResponsiveImage from '@/components/ResponsiveImage.astro'
import { t } from '@/i18n/ui'

const locale = 'en' as const
const page = await getPage('en-faq')
const { introHtml, sections } = page?.rawBody ? extractFaqSections(page.rawBody) : { introHtml: '', sections: [] }
const faqs = sections.flatMap((s) => s.faqs)

const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: t(locale, 'nav.practicalInfo'), href: `/${locale}/practical-info` },
  { label: 'FAQ' },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
})
---

<Base locale={locale} section="practical-info" title={page?.metaTitle ?? "FAQ"} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/faq', en: '/en/faq', cs: '/cs/faq', ru: '/ru/faq' }}>
  <script type="application/ld+json" set:html={faqSchema} />
  <PillarPage locale={locale} title={page?.title ?? "FAQ"} description={page?.metaDescription ?? ""} breadcrumbs={breadcrumbs}>
    {introHtml && <p class="text-lg text-beige-700 leading-relaxed max-w-3xl mb-10" set:html={introHtml} />}
    <div class="space-y-14">
      {sections.map((section, si) => (
        <section>
          {sections.length > 1 && <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-6">{section.title}</h2>}
          {section.figure && (
            <figure class="mb-6 rounded-2xl overflow-hidden bg-beige-100">
              <ResponsiveImage src={section.figure.src} alt={section.figure.alt} class="w-full h-56 md:h-72 object-cover" sizes="(max-width: 768px) 100vw, 768px" loading={si === 0 ? 'eager' : 'lazy'} />
              {section.figure.caption && <figcaption class="px-4 py-2 text-sm text-beige-700">{section.figure.caption}</figcaption>}
            </figure>
          )}
          <div class="space-y-4">
            {section.faqs.map((faq, i) => (
              <details class="group bg-beige-200 rounded-xl overflow-hidden" open={si === 0 && i === 0}>
                <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 md:p-6 text-indigo-700 font-semibold hover:text-indigo-500 transition-colors list-none">
                  <span>{faq.question}</span>
                  <svg class="w-5 h-5 shrink-0 text-turquoise-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 md:px-6 pb-5 md:pb-6 text-beige-700 leading-relaxed" set:html={faq.answerHtml} />
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </PillarPage>
</Base>
