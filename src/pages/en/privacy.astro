---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'

const locale = 'en' as const
const page = await getPage('en-privacy')
---

<Base locale={locale} title={page?.metaTitle ?? "Privacy Policy"} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/datenschutz', en: '/en/privacy', cs: '/cs/ochrana-soukromi', ru: '/ru/politika-konfidencialnosti' }}>
  <FaqSchema rawBody={page?.rawBody} />
  <main class="container-wide py-16 md:py-24">
    <div class="max-w-3xl mx-auto prose-marienbad">
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mb-8">{page?.title}</h1>
      { page?.body && <MarkdocRenderer content={page.body} /> }
    </div>
  </main>
</Base>
