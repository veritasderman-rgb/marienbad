---
import Base from '@/layouts/Base.astro'
import PodcastPage from '@/components/PodcastPage.astro'

const locale = 'en' as const
---

<Base locale={locale} section="magazine" title="Marienbad Podcast — Video Podcasts" description="Video podcasts from Marienbad — conversations, tips and stories from the spa town." alternateUrls={{ cs: '/cs/podcast', de: '/de/podcast', en: '/en/podcast', ru: '/ru/podcast' }}>
  <PodcastPage locale={locale} />
</Base>
