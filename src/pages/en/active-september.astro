---
/**
 * Aktivní září — kampaňová stránka. Obsah drží sdílená komponenta
 * ActiveSeptemberPage (všechny čtyři jazyky).
 */
import Base from '@/layouts/Base.astro'
import ActiveSeptemberPage from '@/components/ActiveSeptemberPage.astro'

export const prerender = true

const locale = 'en' as const
---

<Base
  locale={locale}
  section="things-to-do"
  title="Active September in Mariánské Lázně | Marienbad.com"
  description="September in Mariánské Lázně is made for movement: forest running, golf, tennis, disc golf, scooters and swimming — plus the exercise video series with physiotherapist Eliška."
  ogImage="/images/content/articles/cs-sport-v-marianskych-laznich/coverImage.jpg"
  alternateUrls={{ cs: '/cs/aktivni-zari', de: '/de/aktiver-september', en: '/en/active-september', ru: '/ru/aktivnyj-sentyabr' }}
>
  <ActiveSeptemberPage locale={locale} />
</Base>
