---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage } from '@/content/reader'

const locale = 'de' as const
const page = await getPage('de-quellen-uebersicht')
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/quellen-uebersicht', en: '/en/springs-overview', cs: '/cs/prehled-pramenu', ru: '/ru/obzor-istochnikov' }}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
  </PillarPage>
</Base>
