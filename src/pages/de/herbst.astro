---
import Base from '@/layouts/Base.astro'
import SeasonPage from '@/components/SeasonPage.astro'
import { seasons } from '@/data/seasons'

export const prerender = true

const locale = 'de' as const
const season = seasons.find((s) => s.id === 'autumn')!

const alternateUrls = {'de': '/de/herbst', 'en': '/en/autumn', 'cs': '/cs/podzim', 'ru': '/ru/osen'}
---

<Base locale={locale} section="things-to-do" title={season.title.de} description={season.metaDescription.de} alternateUrls={alternateUrls}>
  <SeasonPage locale={locale} season={season} />
</Base>
