---
import Base from '@/layouts/Base.astro'
import FaqSchema from '@/components/FaqSchema.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import ArticleSources from '@/components/ArticleSources.astro'
import { getPage } from '@/content/reader'
import { medicalTherapyPage } from '@/lib/medicalSchema'

const locale = 'de' as const
const page = await getPage('de-co2-therapie')

const schema = medicalTherapyPage({
  locale,
  path: '/de/co2-therapie',
  name: page?.title ?? '',
  description: page?.metaDescription ?? '',
  indications: [
    'Peripheral arterial disease',
    'Hypertension',
    'Intermittent claudication',
    'Menopausal syndrome',
    'Chronic wounds',
  ],
  lastReviewed: page?.medicalReviewDate,
})
---

<Base locale={locale} section="mineral-springs" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/co2-therapie', en: '/en/co2-therapy', cs: '/cs/co2-terapie', ru: '/ru/co2-terapiya' }} schema={schema}>
  <FaqSchema rawBody={page?.rawBody} />
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <ArticleSources locale={locale} sources={page?.sources} medicalReviewDate={page?.medicalReviewDate} />
  </PillarPage>
</Base>
