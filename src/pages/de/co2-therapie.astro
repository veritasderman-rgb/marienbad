---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import TreatmentHighlightBox from '@/components/TreatmentHighlightBox.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { t } from '@/i18n/ui'

const locale = 'de' as const
const breadcrumbs = [
  { label: t(locale, 'nav.home'), href: `/${locale}` },
  { label: 'Heilquellen', href: `/${locale}/mineralquellen` },
  { label: 'CO₂-Therapie' },
]
---

<Base locale={locale} section="mineral-springs" title="CO₂-Therapie — Marias Gas — Marienbad.com" description="Die einzigartige CO₂-Therapie in Marienbad: Wie natürliches Kohlendioxid Durchblutung, Blutdruck und Wohlbefinden verbessert." alternateUrls={{ de: '/de/co2-therapie', en: '/en/co2-therapy', cs: '/cs/co2-terapie', ru: '/ru/co2-terapiya' }}>
  <PillarPage locale={locale} title="CO₂-Therapie: Marias Gas" description="Die einzigartige CO₂-Therapie nutzt 99,7% reines natürliches Kohlendioxid zur Verbesserung der Durchblutung und des Wohlbefindens." breadcrumbs={breadcrumbs}>
    <h2>Was ist Marias Gas?</h2>
    <p>Mariánské Lázně verfügt über eine weltweit einzigartige natürliche Ressource: <strong>99,7% reines Kohlendioxidgas (CO₂)</strong>, das auf natürliche Weise aus dem vulkanischen Untergrund des Slavkovský les (Kaiserwald) aufsteigt. Dieses Gas, liebevoll <em>„Marias Gas"</em> genannt, ist eines der vier natürlichen Heilmittel Marienbads und bildet die Grundlage für eine Reihe hochwirksamer therapeutischer Behandlungen.</p>

    <p>Die CO₂-Therapie gehört zu den am besten erforschten Behandlungsformen der Balneologie (Bäderheilkunde) und wird in Marienbad seit über 150 Jahren systematisch angewandt.</p>

    <TreatmentHighlightBox
      title="CO₂-Trockengasbad"
      description="Der Patient wird in einen speziellen Sack eingehüllt, der mit natürlichem CO₂ gefüllt wird. Das Gas wird über die Haut absorbiert und erweitert die Blutgefäße, was die periphere Durchblutung um bis zu 300% steigern kann. Dauer: 20-30 Minuten."
      icon="gas"
    />

    <h2>Wie wirkt die CO₂-Therapie?</h2>
    <p>Wenn Kohlendioxid über die Haut in den Körper aufgenommen wird, löst es eine Kaskade physiologischer Reaktionen aus:</p>

    <ul>
      <li><strong>Gefäßerweiterung:</strong> CO₂ entspannt die glatte Muskulatur der Blutgefäße, was zu einer signifikanten Erweiterung führt. Die Durchblutung in den behandelten Bereichen kann sich verdreifachen.</li>
      <li><strong>Blutdruckregulation:</strong> Die Vasodilatation führt zu einer Senkung des peripheren Widerstands und damit zu einer Reduktion des arteriellen Blutdrucks.</li>
      <li><strong>Verbesserte Sauerstoffversorgung:</strong> Durch den Bohr-Effekt wird die Sauerstoffabgabe des Hämoglobins an das Gewebe erleichtert — die Zellen werden besser mit Sauerstoff versorgt.</li>
      <li><strong>Schmerzlinderung:</strong> Die verbesserte Durchblutung und die direkte Wirkung des CO₂ auf Nervenfasern haben einen analgetischen Effekt.</li>
      <li><strong>Wundheilung:</strong> Die gesteigerte Mikrozirkulation fördert die Regeneration des Gewebes und beschleunigt die Heilung.</li>
    </ul>

    <h2>Formen der CO₂-Therapie in Marienbad</h2>

    <h3>1. CO₂-Trockengasbad (Marienbader Gasumschlag)</h3>
    <p>Die bekannteste Anwendung: Der Patient liegt in einem speziellen Plastikbeutel, der bis zum Hals reicht und mit natürlichem CO₂ gefüllt wird. Die Behandlung dauert 20-30 Minuten und ist völlig schmerzfrei — viele Patienten empfinden ein angenehmes Wärme- und Kribbalgefühl.</p>

    <h3>2. CO₂-Bad (Kohlensäurebad)</h3>
    <p>Mineralbäder, die mit natürlichem CO₂ angereichert sind. Das Gas wird sowohl über die Haut als auch teilweise über die Atemwege aufgenommen. Die Badetemperatur liegt bei 33-34°C, deutlich unter der eines normalen Warmwasserbads — dennoch empfindet der Patient angenehme Wärme durch die gefäßerweiternde Wirkung des CO₂.</p>

    <h3>3. CO₂-Insufflation (Gasinjektionen)</h3>
    <p>Subkutane Injektionen kleiner Mengen CO₂ in schmerzhafte Gelenke oder Muskelbereiche. Diese Methode wird gezielt bei lokalen Beschwerden eingesetzt und kombiniert die durchblutungsfördernde mit einer direkten analgetischen Wirkung.</p>

    <h2>Indikationen</h2>
    <p>Die CO₂-Therapie wird erfolgreich eingesetzt bei:</p>
    <ul>
      <li>Herz-Kreislauf-Erkrankungen (arterielle Hypertonie, periphere Durchblutungsstörungen)</li>
      <li>Erkrankungen des Bewegungsapparates (Arthrose, rheumatische Beschwerden)</li>
      <li>Wundheilungsstörungen und trophische Ulzera</li>
      <li>Diabetische Polyneuropathie</li>
      <li>Post-operative Rehabilitation</li>
      <li>Stressbedingte Beschwerden und Erschöpfungssyndrome</li>
    </ul>

    <h2>Was sagt die Wissenschaft?</h2>
    <p>Die CO₂-Therapie gehört zu den am besten erforschten Formen der Balneotherapie. Klinische Erfahrung und Studien zeigen:</p>
    <ul>
      <li>Eine Senkung des systolischen Blutdrucks um bis zu 10–15 mmHg nach einer zweiwöchigen Kur</li>
      <li>Eine deutliche Verbesserung der peripheren Durchblutung</li>
      <li>Ein Großteil der Patienten berichtet über signifikante Schmerzreduktion bei Gelenkbeschwerden</li>
      <li>Messbare Verbesserung der Wundheilung bei chronischen Ulzera</li>
    </ul>

    <HotelRecommendationBox
      locale={locale}
       locale={locale}
      locale={locale}
      name="Ensana Nové Lázně"
      stars={5}
      badge="CO₂-Experte"
      description="Das Nové Lázně bietet ein umfassendes CO₂-Therapieprogramm mit natürlichem Marienbader Gas — einschließlich Trockengasbäder, Kohlensäurebäder und Gasinjektionen unter ärztlicher Aufsicht."
      bookingUrl="https://ensanahotels.com/de/hotels/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=co2-therapy"
      bookingLabel="CO₂-Therapie buchen"
    />

    <h2>Praktische Informationen</h2>
    <p>Die CO₂-Therapie ist in allen Ensana Spa Hotels in Marienbad verfügbar. Eine Behandlung dauert 20-30 Minuten und wird in der Regel einmal täglich über einen Zeitraum von 7-21 Tagen durchgeführt. Die optimale Wirkung entfaltet sich bei einer Kurdauer von mindestens 14 Tagen.</p>

    <p>Vor Beginn der Behandlung erfolgt eine ärztliche Untersuchung, bei der Ihr individueller Therapieplan erstellt wird. Kontraindikationen umfassen akute Entzündungen, unkontrollierte Herzschwäche und bestimmte Hauterkrankungen.</p>
  </PillarPage>
</Base>
