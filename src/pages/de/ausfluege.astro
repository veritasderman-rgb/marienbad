---
import Base from '@/layouts/Base.astro'
import DayTripsPage from '@/components/DayTripsPage.astro'
import { getPage } from '@/content/reader'

const locale = 'de' as const
const page = await getPage('de-ausfluege')
---

<Base locale={locale} section="things-to-do" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""} alternateUrls={{ de: '/de/ausfluege', en: '/en/day-trips', cs: '/cs/vylety', ru: '/ru/ekskursii' }}>
  <DayTripsPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} />
</Base>
