---
/**
 * Ensana Life — věrnostní program. Obsah drží sdílená komponenta
 * EnsanaLifePage + src/data/ensanaLifeContent.ts; referenční fakta
 * v data/ensana_life_benefits.md.
 */
import Base from '@/layouts/Base.astro'
import EnsanaLifePage from '@/components/EnsanaLifePage.astro'
import { ensanaLifeContent } from '@/data/ensanaLifeContent'

export const prerender = true

const locale = 'de' as const
const c = ensanaLifeContent[locale]
---

<Base
  locale={locale}
  section="accommodation"
  title={c.metaTitle}
  description={c.metaDescription}
  ogImage="/images/content/ensana-life/kolonada-hero.jpg"
  alternateUrls={{ cs: '/cs/ensana-life', de: '/de/ensana-life', en: '/en/ensana-life', ru: '/ru/ensana-life' }}
>
  <EnsanaLifePage locale={locale} />
</Base>
