---
import Base from '@/layouts/Base.astro'
import HeroSection from '@/components/HeroSection.astro'
import SectionCard from '@/components/SectionCard.astro'
import WaveDivider from '@/components/WaveDivider.astro'
import { t } from '@/i18n/ui'
import { localizedHref } from '@/i18n/utils'

const locale = 'de' as const
---

<Base locale={locale}>
  <!-- 1. HERO -->
  <HeroSection
    title="Entdecken Sie Marienbad"
    subtitle="UNESCO Welterbe · Seit 1812 · Vier Heilquellen — Das einzige Kurbad der Welt, das alle vier natürlichen Heilressourcen vereint."
    ctaText="Stadt entdecken"
    ctaHref="#discover"
    badges={['UNESCO Welterbe', 'Seit 1812']}
  />

  <!-- 2. QUICK FACTS STRIP -->
  <section class="relative z-10 -mt-16 md:-mt-20">
    <div class="container-wide">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div class="bg-white rounded-xl shadow-card p-5 md:p-6 text-center card-hover reveal">
          <div class="w-10 h-10 mx-auto mb-2 text-turquoise-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 009-9c0-4.97-9-12-9-12S3 7.03 3 12a9 9 0 009 9z" /></svg></div>
          <div class="font-heading text-lg md:text-xl font-bold text-indigo-500">40+</div>
          <div class="text-sm text-beige-600">Mineralquellen</div>
        </div>
        <div class="bg-white rounded-xl shadow-card p-5 md:p-6 text-center card-hover reveal">
          <div class="w-10 h-10 mx-auto mb-2 text-turquoise-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" /></svg></div>
          <div class="font-heading text-lg md:text-xl font-bold text-indigo-500">UNESCO</div>
          <div class="text-sm text-beige-600">Welterbe 2021</div>
        </div>
        <div class="bg-white rounded-xl shadow-card p-5 md:p-6 text-center card-hover reveal">
          <div class="w-10 h-10 mx-auto mb-2 text-turquoise-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" /></svg></div>
          <div class="font-heading text-lg md:text-xl font-bold text-indigo-500">1812</div>
          <div class="text-sm text-beige-600">Kurtradition</div>
        </div>
        <div class="bg-white rounded-xl shadow-card p-5 md:p-6 text-center card-hover reveal">
          <div class="w-10 h-10 mx-auto mb-2 text-turquoise-600"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0l2.77-.693a9 9 0 016.208.682l.108.054a9 9 0 006.086.71l3.114-.732a48.524 48.524 0 01-.005-10.499l-3.11.732a9 9 0 01-6.085-.711l-.108-.054a9 9 0 00-6.208-.682L3 4.5M3 15V4.5" /></svg></div>
          <div class="font-heading text-lg md:text-xl font-bold text-indigo-500">Royal</div>
          <div class="text-sm text-beige-600">Golf Club 1905</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FOUR HEALING ELEMENTS -->
  <section class="bg-indigo-700 text-white py-20 md:py-28 mt-12 md:mt-16">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-14 reveal">
        <span class="text-turquoise-300 text-sm font-medium tracking-widest uppercase">Was Marienbad einzigartig macht</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mt-4 mb-4" style="font-size: var(--text-h2);">Vier natürliche Heilressourcen</h2>
        <p class="text-white/70 text-lg">Das einzige Kurbad weltweit, das alle vier Elemente der natürlichen Heilung vereint.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Water -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center card-hover reveal">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-turquoise-400/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 009-9c0-4.97-9-12-9-12S3 7.03 3 12a9 9 0 009 9z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-2">Wasser</h3>
          <p class="text-white/70 text-sm leading-relaxed">Über 40 Mineralquellen mit einzigartiger Zusammensetzung — von Trinkkuren bis zu heilenden Bädern.</p>
        </div>
        <!-- Earth (Peat) -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center card-hover reveal">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-turquoise-400/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.211.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76M11.25 2.25c1.184 0 2.33.147 3.428.425" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 12a9.75 9.75 0 11-19.5 0 9.75 9.75 0 0119.5 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-2">Erde</h3>
          <p class="text-white/70 text-sm leading-relaxed">Natürliche Torfpeloide mit entzündungshemmenden und schmerzlindernden Eigenschaften.</p>
        </div>
        <!-- Gas (CO₂) -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center card-hover reveal">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-turquoise-400/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-2">Gas</h3>
          <p class="text-white/70 text-sm leading-relaxed">99,7% reines CO₂ — „Marias Gas" — verbessert die periphere Durchblutung nachweislich.</p>
        </div>
        <!-- Climate -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center card-hover reveal">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-turquoise-400/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-turquoise-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-2">Klima</h3>
          <p class="text-white/70 text-sm leading-relaxed">Zertifiziertes Heilklima auf 630m — reine Waldluft mit natürlichen Aerosolen.</p>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider variant="white-on-indigo" />

  <!-- 4. DISCOVER THE TOWN -->
  <section id="discover" class="py-16 md:py-24 bg-white">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-14 reveal">
        <div class="divider-ornament mb-6">
          <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">Willkommen</span>
        </div>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mb-4" style="font-size: var(--text-h2);">
          Entdecken Sie die Stadt
        </h2>
        <p class="text-beige-700 text-lg leading-relaxed">
          Mariánské Lázně — das weltberühmte Marienbad — verzaubert seit über 200 Jahren Besucher
          aus aller Welt mit heilenden Quellen, prächtiger Architektur und atemberaubender Natur.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <SectionCard
          title={t(locale, 'home.springs')}
          description={t(locale, 'home.springsDesc')}
          href={localizedHref(locale, 'mineral-springs')}
          variant="indigo"
        />
        <SectionCard
          title={t(locale, 'home.thingsToDo')}
          description={t(locale, 'home.thingsToDoDesc')}
          href={localizedHref(locale, 'things-to-do')}
          variant="turquoise"
        />
        <SectionCard
          title={t(locale, 'home.history')}
          description={t(locale, 'home.historyDesc')}
          href={localizedHref(locale, 'history')}
          variant="dark"
        />
      </div>
    </div>
  </section>

  <!-- 5. WHERE TO STAY -->
  <section class="bg-beige-200 py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-14 reveal">
        <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">Unterkünfte</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h2);">
          Wo übernachten in Marienbad
        </h2>
        <p class="text-beige-700 text-lg">Von historischen 5-Sterne-Spa-Hotels bis zu charmanten Pensionen.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Hotel Card: Nové Lázně 5★ -->
        <div class="bg-white rounded-xl overflow-hidden shadow-card card-hover reveal">
          <div class="placeholder-image h-48 relative">
            <span class="text-white/80 text-sm">Nové Lázně — Foto</span>
            <div class="absolute top-3 left-3 flex gap-2">
              <span class="px-2.5 py-1 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full" aria-label="5 Sterne">★★★★★</span>
              <span class="px-2.5 py-1 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full">Editor's Pick</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-heading text-xl font-bold text-indigo-700 mb-2">Nové Lázně</h4>
            <p class="text-beige-700 text-sm mb-3">Historisches 5-Sterne-Juwel mit original Römischem Bad — das Flaggschiff der Ensana Spa Hotels.</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">Römisches Bad</span>
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">CO₂ Therapie</span>
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">Pool</span>
            </div>
            <a
              href="https://www.ensanahotels.com/nove-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=homepage-hotel"
              class="inline-flex items-center gap-1.5 text-indigo-500 hover:text-indigo-700 text-sm font-semibold transition-colors"
              target="_blank" rel="noopener"
            >
              Details & Buchung
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
        </div>

        <!-- Hotel Card: Centrální Lázně 4★ -->
        <div class="bg-white rounded-xl overflow-hidden shadow-card card-hover reveal">
          <div class="placeholder-image h-48 relative">
            <span class="text-white/80 text-sm">Centrální Lázně — Foto</span>
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 bg-yellow-400 text-beige-950 text-xs font-semibold rounded-full" aria-label="4 Sterne">★★★★</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="font-heading text-xl font-bold text-indigo-700 mb-2">Centrální Lázně</h4>
            <p class="text-beige-700 text-sm mb-3">Direkt an der Kolonnade — traditionelle Kur in zentraler Lage mit modernen Behandlungsräumen.</p>
            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">Kolonnade-Lage</span>
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">Trinkkur</span>
              <span class="px-2 py-0.5 bg-turquoise-50 text-turquoise-800 text-xs rounded-full">Wellness</span>
            </div>
            <a
              href="https://www.ensanahotels.com/centralni-lazne?utm_source=marienbad&utm_medium=editorial&utm_campaign=homepage-hotel"
              class="inline-flex items-center gap-1.5 text-indigo-500 hover:text-indigo-700 text-sm font-semibold transition-colors"
              target="_blank" rel="noopener"
            >
              Details & Buchung
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href={localizedHref(locale, 'accommodation')} class="btn-ghost">
          Alle 6 Hotels entdecken →
        </a>
      </div>
    </div>
  </section>

  <!-- 6. PEOPLE OF COLONNADE -->
  <section class="bg-beige-950 text-white py-20 md:py-28">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-14 reveal">
        <span class="text-turquoise-400 text-sm font-medium tracking-widest uppercase">Menschen der Kolonnade</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold mt-3 mb-4" style="font-size: var(--text-h2);">
          Geschichten, die das Wasser erzählt
        </h2>
        <p class="text-beige-600 text-lg">Echte Geschichten von echten Menschen — Kurgäste, Einheimische und Ärzte erzählen, warum Marienbad ein besonderer Ort ist.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Story Card 1 (DE) -->
        <div class="group bg-white/5 rounded-xl overflow-hidden card-hover reveal">
          <div class="placeholder-image h-64 relative" style="background: linear-gradient(135deg, #1A1916 0%, #266782 100%);">
            <span class="text-white/60 text-sm">Portrait — Foto</span>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-5">
              <p class="font-heading text-base italic text-white/90 leading-snug mb-2">„Die Kreuzquelle ist wie ein alter Freund — jedes Jahr bringe ich ihm einen Besuch."</p>
              <div class="flex items-center gap-2">
                <span class="text-white font-semibold text-sm">Ingrid</span>
                <span class="text-white/50 text-sm">· Hamburg 🇩🇪</span>
                <span class="px-2 py-0.5 bg-turquoise-400/30 text-turquoise-300 text-xs rounded-full ml-auto">Zum 12. Mal</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Story Card 2 (EN) -->
        <div class="group bg-white/5 rounded-xl overflow-hidden card-hover reveal">
          <div class="placeholder-image h-64 relative" style="background: linear-gradient(135deg, #1A1916 0%, #004F71 100%);">
            <span class="text-white/60 text-sm">Portrait — Foto</span>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-5">
              <p lang="en" class="font-heading text-base italic text-white/90 leading-snug mb-2">"I came for the treatment, but I stayed for the peace."</p>
              <div class="flex items-center gap-2">
                <span class="text-white font-semibold text-sm">James</span>
                <span class="text-white/50 text-sm">· London 🇬🇧</span>
                <span class="px-2 py-0.5 bg-turquoise-400/30 text-turquoise-300 text-xs rounded-full ml-auto">3rd visit</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Story Card 3 (RU) -->
        <div class="group bg-white/5 rounded-xl overflow-hidden card-hover reveal">
          <div class="placeholder-image h-64 relative" style="background: linear-gradient(135deg, #1A1916 0%, #3A8BA8 100%);">
            <span class="text-white/60 text-sm">Portrait — Foto</span>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-5">
              <p lang="ru" class="font-heading text-base italic text-white/90 leading-snug mb-2">«Мариенбад — это не просто курорт. Это место, где душа отдыхает.»</p>
              <div class="flex items-center gap-2">
                <span class="text-white font-semibold text-sm">Наталья</span>
                <span class="text-white/50 text-sm">· Москва 🇷🇺</span>
                <span class="px-2 py-0.5 bg-turquoise-400/30 text-turquoise-300 text-xs rounded-full ml-auto">8-й визит</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href={localizedHref(locale, 'people')} class="btn-ghost text-white border-white/30 hover:bg-white hover:text-beige-950">
          Alle Geschichten lesen →
        </a>
      </div>
    </div>
  </section>

  <!-- 7. SEASONAL HIGHLIGHT -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center reveal">
        <!-- Image -->
        <div class="placeholder-image rounded-xl h-72 lg:h-96 relative">
          <span class="text-white/80 text-sm">Frühlingsblüte im Kurpark — Foto</span>
          <div class="absolute top-4 left-4">
            <span class="px-3 py-1 bg-turquoise-400 text-indigo-900 text-xs font-semibold uppercase tracking-wider rounded-full">Diese Saison</span>
          </div>
        </div>
        <!-- Content -->
        <div>
          <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">Frühling 2026</span>
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h3);">
            Die Quellen erwachen — Frühlingskur in Marienbad
          </h2>
          <p class="text-beige-700 text-lg leading-relaxed mb-6">
            Im Frühling blüht Marienbad auf: Die Skalníkovy-Gärten erstrahlen in Farben,
            die Singende Fontäne nimmt ihren Betrieb wieder auf, und die milde Frühlingsluft
            auf 630 Metern ist das natürliche Heilmittel für die Atemwege.
          </p>
          <a
            href={localizedHref(locale, 'things-to-do')}
            class="btn-secondary"
          >
            Mehr erfahren
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider variant="beige-on-white" />

  <!-- 8. MAGAZINE PREVIEW -->
  <section class="bg-beige-200 py-16 md:py-24">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-14 reveal">
        <span class="text-turquoise-600 text-sm font-medium tracking-widest uppercase">Magazin</span>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-indigo-700 mt-3 mb-4" style="font-size: var(--text-h2);">
          Aktuelles aus Marienbad
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Article Card 1 -->
        <div class="bg-white rounded-xl overflow-hidden shadow-card card-hover reveal">
          <div class="placeholder-image-light h-44 flex items-center justify-center">
            <span class="text-beige-600 text-sm">Artikelbild</span>
          </div>
          <div class="p-5">
            <span class="text-turquoise-600 text-xs font-semibold uppercase tracking-wider">Gesundheit</span>
            <h3 class="font-heading text-lg font-bold text-indigo-700 mt-1 mb-2">CO₂-Bäder: Was die Wissenschaft sagt</h4>
