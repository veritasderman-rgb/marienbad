---
import Base from '@/layouts/Base.astro'
import HeroSection from '@/components/HeroSection.astro'
import SectionCard from '@/components/SectionCard.astro'
import { t } from '@/i18n/ui'
import { localizedHref } from '@/i18n/utils'

const locale = 'de' as const
---

<Base locale={locale}>
  <HeroSection
    title={t(locale, 'home.heroTitle')}
    subtitle={t(locale, 'home.heroSubtitle')}
    ctaText={t(locale, 'home.heroCta')}
    ctaHref={localizedHref(locale, 'mineral-springs')}
  />

  <!-- Intro section -->
  <section id="discover" class="container-wide py-16 md:py-24">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="divider-ornament mb-6">
        <span class="text-accent-500 text-sm font-medium tracking-widest uppercase">Willkommen</span>
      </div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-primary-900 mb-6">
        Ein Juwel im Herzen Böhmens
      </h2>
      <p class="text-sand-600 text-lg leading-relaxed">
        Mariánské Lázně — das weltberühmte Marienbad — verzaubert seit über 200 Jahren Besucher
        aus aller Welt. Hier fließen über 40 Mineralquellen, umgeben von prächtiger Architektur
        des 19. Jahrhunderts und einer atemberaubenden Parklandschaft. Seit 2021 UNESCO-Welterbe.
      </p>
    </div>

    <!-- Section cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <SectionCard
        title={t(locale, 'home.springs')}
        description={t(locale, 'home.springsDesc')}
        href={localizedHref(locale, 'mineral-springs')}
        gradient="from-primary-700 to-primary-900"
      />
      <SectionCard
        title={t(locale, 'home.thingsToDo')}
        description={t(locale, 'home.thingsToDoDesc')}
        href={localizedHref(locale, 'things-to-do')}
        gradient="from-accent-600 to-accent-800"
      />
      <SectionCard
        title={t(locale, 'home.accommodation')}
        description={t(locale, 'home.accommodationDesc')}
        href={localizedHref(locale, 'accommodation')}
        gradient="from-sand-600 to-sand-800"
      />
      <SectionCard
        title={t(locale, 'home.history')}
        description={t(locale, 'home.historyDesc')}
        href={localizedHref(locale, 'history')}
        gradient="from-primary-800 to-primary-950"
      />
      <SectionCard
        title={t(locale, 'home.people')}
        description={t(locale, 'home.peopleDesc')}
        href={localizedHref(locale, 'people')}
        gradient="from-accent-700 to-accent-950"
      />
      <SectionCard
        title="Magazin"
        description="Saisonale Tipps, Insider-Wissen und aktuelle Reportagen aus Marienbad."
        href={localizedHref(locale, 'magazine')}
        gradient="from-primary-600 to-accent-800"
      />
    </div>
  </section>

  <!-- Highlights section -->
  <section class="bg-primary-950 text-white py-20 md:py-28">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-heading text-3xl md:text-4xl font-bold mb-4">Warum Marienbad?</h2>
        <p class="text-sand-400 text-lg">Drei Gründe, warum Sie kommen — und immer wieder zurückkehren.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-primary-800/60 flex items-center justify-center">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-3">Heilende Quellen</h3>
          <p class="text-sand-400 text-sm leading-relaxed">Über 40 Mineralquellen mit einzigartiger Zusammensetzung — von Trinkkuren bis zu heilenden CO₂-Bädern.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-primary-800/60 flex items-center justify-center">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-3">UNESCO-Erbe</h3>
          <p class="text-sand-400 text-sm leading-relaxed">Die prachtvolle Kurarchitektur gehört seit 2021 zum UNESCO-Welterbe — als Teil der „Great Spa Towns of Europe".</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-primary-800/60 flex items-center justify-center">
            <svg class="w-8 h-8 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl font-bold mb-3">Geschichten & Menschen</h3>
          <p class="text-sand-400 text-sm leading-relaxed">Von Goethe über König Edward VII. bis zu den heutigen Gästen — Marienbad lebt von seinen Menschen und ihren Geschichten.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- People of Colonnade teaser -->
  <section class="container-wide py-20 md:py-28">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-accent-50 to-sand-100 rounded-3xl p-8 md:p-12 border border-accent-200/50">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12 bg-accent-400"></div>
          <span class="text-accent-600 text-sm font-medium tracking-widest uppercase">People of Colonnade</span>
        </div>
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary-900 mb-4">
          „Marienbad hat mein Leben verändert."
        </h2>
        <p class="text-sand-600 text-lg leading-relaxed mb-8">
          Echte Geschichten von echten Menschen — Kurgäste, Einheimische, Künstler und Ärzte erzählen,
          warum Marienbad für sie ein besonderer Ort ist. Entdecken Sie die menschliche Seite dieses
          einzigartigen Kurortes.
        </p>
        <a
          href={localizedHref(locale, 'people')}
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary-800 hover:bg-primary-700 text-white font-semibold rounded-xl transition-all duration-300"
        >
          Geschichten entdecken
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>
