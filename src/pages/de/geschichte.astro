---
import Base from '@/layouts/Base.astro'
import PillarPage from '@/components/PillarPage.astro'
import MarkdocRenderer from '@/components/MarkdocRenderer.astro'
import { getPage, extractFaqs } from '@/content/reader'
import RelatedArticles from '@/components/RelatedArticles.astro'
import HotelRecommendationBox from '@/components/HotelRecommendationBox.astro'
import { getHotelBySlug } from '@/data/hotels'
import { withUtm } from '@/utils/utm'

const locale = 'de' as const
const page = await getPage('de-geschichte')
const faqs = page?.rawBody ? extractFaqs(page.rawBody) : []
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null
const hotel = getHotelBySlug('nove-lazne')!
---

<Base locale={locale} section="history" title={page?.metaTitle ?? ""} description={page?.metaDescription ?? ""}>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <PillarPage locale={locale} title={page?.title ?? ""} description={page?.metaDescription ?? ""} pullQuote={page?.pullQuote ?? ""}>
    { page?.body && <MarkdocRenderer content={page.body} /> }
    <RelatedArticles locale={locale} category="history" />
    <HotelRecommendationBox
      locale={locale}
      name={hotel.name}
      stars={hotel.stars}
      badge="Seit 1828"
      description="Erleben Sie Marienbads Geschichte hautnah im Ensana Nové Lázně, einem der traditionsreichsten Kurhotels Europas. Das Römische Bad, im Originalzustand von 1896 erhalten, ist ein lebendiges Denkmal der böhmischen Bäderkultur."
      bookingUrl={withUtm(hotel.bookingUrls.de, 'marienbad', 'editorial', 'history')}
      bookingLabel="Historisches Hotel buchen"
    />
  </PillarPage>
</Base>
