---
import Base from '@/layouts/Base.astro'
import MagazineFilter from '@/components/MagazineFilter.tsx'
import { getPage, getArticles } from '@/content/reader'
import { routes } from '@/i18n/config'
import { t } from '@/i18n/ui'

const locale = 'de' as const
const page = await getPage('de-magazin')
const articles = await getArticles(locale)
const magazineSlug = routes.magazine[locale]

const featured = articles[0]
const featuredSlug = featured?.slug.replace(/^[a-z]{2}-/, '')
const featuredHref = `/${locale}/${magazineSlug}/${featuredSlug}`

// Serialize articles for React island
const articleData = articles.slice(1).map(a => ({
  slug: a.slug,
  title: a.title,
  category: a.category,
  excerpt: a.excerpt,
  coverImage: a.coverImage,
  readingTime: a.readingTime,
  date: a.date,
}))

const categoryLabels: Record<string, string> = {
  health: 'Gesundheit', healing: 'Gesundheit', wellness: 'Wellness', planning: 'Planung',
  culture: 'Kultur', history: 'Geschichte', food: 'Genuss', nature: 'Natur',
  activities: 'Aktivitäten', springs: 'Quellen', tip: 'Tipp', comparison: 'Vergleich',
}
---

<Base locale={locale} section="magazine" title={page?.metaTitle ?? "Magazin — Marienbad.com"} description={page?.metaDescription ?? ""}>

  <!-- Magazine Hero: Featured Article -->
  {featured && (
    <section class="relative bg-indigo-700 text-white overflow-hidden">
      {featured.coverImage && (
        <img
          src={featured.coverImage}
          alt={featured.title}
          class="absolute inset-0 w-full h-full object-cover opacity-40"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-indigo-900/90 via-indigo-900/50 to-indigo-900/30"></div>

      <div class="relative container-wide py-24 md:py-32 lg:py-40">
        <div class="max-w-2xl">
          <span class="inline-block px-3 py-1 bg-yellow-400/90 text-beige-950 text-xs font-semibold uppercase tracking-wider rounded-full mb-5">
            {categoryLabels[featured.category] ?? featured.category}
          </span>
          <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold mb-5 leading-tight">
            {featured.title}
          </h1>
          <p class="text-white/80 text-lg leading-relaxed mb-8 line-clamp-3">
            {featured.excerpt}
          </p>
          <div class="flex items-center gap-5">
            <a
              href={featuredHref}
              class="inline-flex items-center gap-2 px-7 py-3.5 bg-yellow-400 text-indigo-900 rounded-full font-bold hover:bg-yellow-300 transition-colors text-base"
            >
              {t(locale, 'common.readMore')}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <span class="text-white/50 text-sm">{featured.readingTime}</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Magazine Filter + Article Grid (React Island) -->
  <MagazineFilter
    client:visible
    articles={articleData}
    locale={locale}
    magazineSlug={magazineSlug}
    translations={{
      all: 'Alle',
      readMore: t(locale, 'common.readMore'),
      featured: 'Empfohlen',
    }}
  />

  <!-- Booking CTA Strip -->
  <section class="bg-beige-200 py-12 md:py-16">
    <div class="container-wide text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-indigo-700 mb-3">Planen Sie Ihren Kuraufenthalt</h2>
      <p class="text-beige-700 mb-6 max-w-xl mx-auto">Inspiriert? Entdecken Sie aktuelle Angebote für Kuraufenthalte in Marienbad.</p>
      <a
        href="https://ensanahotels.com/de/destinationen/tschechische-republik/marienbad?utm_source=marienbad&utm_medium=magazine&utm_campaign=booking-cta"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-yellow-400 text-indigo-900 rounded-full font-bold hover:bg-yellow-300 transition-colors text-lg"
      >
        Angebote ansehen
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

</Base>
