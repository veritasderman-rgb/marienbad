    "@payloadcms/plugin-seo": "^3.14.0",
    "@payloadcms/next": "^3.14.0",
    "@payloadcms/ui": "^3.14.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.0.0"
